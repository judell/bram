<!-- query seeds from a deep link when present, else from the pane-lifetime
     carry-over (Globals.xs) — which Search itself publishes below, so
     switching away and back retains the input (2026-08-16 iterate). -->
<Component name="Search" var.query="{$queryParams.q || getLastSearchQuery()}">
  <!-- issue-230 unified search across the local FTS5 index (sessions,
       commits, issues, worklist-history). Each type is queried independently
       (its own top-100) so a length-penalized bucket isn't squeezed out of a
       global top-100; the pills count per-type and the list merges the
       selected buckets by rank. Clicking a title inline-expands that row
       (single-open) and fetches the real per-type source. -->
  <variable name="typeColors"
    value="{{ session: 'blue', commit: 'green', issue: '#c2410c', history: 'purple' }}" />
  <variable name="facetColors"
    value="{{ Sessions: 'blue', Commits: 'green', Issues: '#c2410c', History: 'purple' }}" />
  <!-- selectedTypes (the facet pills) and mode seed from the URL so an
       Evidence "replay" link (Workspace.xmlui) lands here pre-filled. Absent
       => the everyday defaults (AND mode; facets per the Settings toggle
       __bramSearchBadgesInitialAllOn — all four buckets, or none). These stay
       locally mutable working copies; $queryParams only changes on navigation,
       so a fresh replay remounts and re-seeds without clobbering local edits.
       See https://docs.xmlui.org/howto/deep-link-to-a-tab-or-section -->
  <variable name="selectedTypes"
    value="{$queryParams.types ? $queryParams.types.split(',') : (window.__bramSearchBadgesInitialAllOn() ? ['session', 'commit', 'issue', 'worklist-history'] : [])}" />
  <variable name="mode" value="{$queryParams.mode || 'and'}" />
  <!-- `mode` stays the URL/user-controlled state (the reset link assigns to
       it). effectiveMode is what actually ships: a trailing `*` on the typed
       query dispatches FTS5 prefix mode, which the box could not reach before
       — `run*` ran as the bare token `run` and returned strictly narrower
       results than the user asked for. An explicit ?mode= always wins, so
       replay deep links keep phrase/raw. -->
  <variable name="effectiveMode" value="{window.__bramSearchMode(query, mode)}" />
  <variable name="effectiveQuery" value="{window.__bramSearchQuery(query, mode)}" />
  <!-- carry-search-query-to-tabs: publish the live query so Sessions /
       Issues / History seed their filters from it at mount (Globals.xs). -->
  <ChangeListener listenTo="{query}"
    onDidChange="() => setLastSearchQuery(query)" />
  <variable name="ready" value="{!!query &amp;&amp; query.trim().length >= 2}" />
  <!-- Selected date window [lo, hi] (epoch seconds); null = no date filter. -->
  <variable name="dateFilter" value="{null}" />
  <!-- Live thumb position during a drag; dateFilter is its debounced
       commit (search-slider-drag-debounce). Labels read this, `displayed`
       reads dateFilter. -->
  <variable name="dateDraft" value="{null}" />
  <!-- search-results-date-sort: local ordering of the filtered result set.
       'relevance' (default) keeps the bucket-merged rank order; 'newest' /
       'oldest' sort chronologically (sortSearchHits, Globals.xs). Applied
       after facet + date filtering, before the 100-row display cap; purely
       client-side — no refetch. Persisted across sessions via XMLUI's
       readLocalStorage/writeLocalStorage pair (dot-path key nests under the
       'bram' localStorage entry, same as the splitter keys).
       https://docs.xmlui.org/globals#readlocalstorage -->
  <variable name="sortOrder" value="{readLocalStorage('bram.searchSortOrder', 'relevance')}" />

  <!-- issue-251 coverage line: indexer freshness so an absent result is
       legible as un-indexed vs. not-a-keyword-match. Pushed via
       search-index-changed (no polling), the footer's pattern. -->
  <DataSource id="searchIndexStatus" url="/__search-index-status" />
  <PushSource
    id="searchIndexChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('search-index-changed')}" />
  <ChangeListener
    listenTo="{searchIndexChangedEvt.value &amp;&amp; searchIndexChangedEvt.value.tick}"
    onDidChange="() => searchIndexStatus.refetch()" />
  <!-- Precomputed (top-level var, the reactive path — inline ternaries in
       Text bindings froze once already, see the dateLoLabel comment). -->
  <variable name="coverageLine" value="{
    searchIndexStatus.value
      ? Number(searchIndexStatus.value.total || 0).toLocaleString() + ' docs indexed · issues through #'
        + (searchIndexStatus.value.issuesThrough || 0)
        + (searchIndexStatus.value.lastCycleMs
            ? ' · refreshed ' + formatDateTime(new Date(searchIndexStatus.value.lastCycleMs), 'HH:mm:ss')
            : '')
      : ''
  }" />

  <DataSource id="rSession" url="/__search"
    queryParams="{{ q: effectiveQuery, limit: 100, types: 'session', mode: effectiveMode }}" when="{ready}" />
  <DataSource id="rCommit" url="/__search"
    queryParams="{{ q: effectiveQuery, limit: 100, types: 'commit', mode: effectiveMode }}" when="{ready}" />
  <DataSource id="rIssue" url="/__search"
    queryParams="{{ q: effectiveQuery, limit: 100, types: 'issue', mode: effectiveMode }}" when="{ready}" />
  <DataSource id="rHistory" url="/__search"
    queryParams="{{ q: effectiveQuery, limit: 100, types: 'worklist-history', mode: effectiveMode }}" when="{ready}" />

  <!-- Full relevance-ordered set of the selected buckets (no date filter) — the
       stable domain the slider measures, so moving the handles never shifts it. -->
  <variable name="merged" value="{
    [].concat(
      selectedTypes.includes('session') ? (rSession.value || []) : [],
      selectedTypes.includes('commit') ? (rCommit.value || []) : [],
      selectedTypes.includes('issue') ? (rIssue.value || []) : [],
      selectedTypes.includes('worklist-history') ? (rHistory.value || []) : []
    ).sort((a, b) => a.rank - b.rank)
  }" />

  <!-- Pre-filter denominator: every bucket's full hit list, irrespective of
       `selectedTypes` and `dateFilter`. This is what the pills count, and it
       is what separates "the index returned nothing" from "everything it
       returned is filtered out" — two different facts with different fixes
       that the empty state used to render identically. -->
  <variable name="totalHits" value="{
    (rSession.value || []).length + (rCommit.value || []).length
      + (rIssue.value || []).length + (rHistory.value || []).length
  }" />

  <!-- FORENSICS-ONLY since search-slider-domain-from-latch: read by the
       filter-reset and buckets trace lines, gates nothing. The derived
       value goes stale after a backspace-to-empty → retype cycle
       (op=buckets 2026-08-16T21:30:02Z logged every input favorable —
       all loaded, none inProgress, ready — with settled:false), the
       <variable>-staleness class. Kept until that gets an upstream
       reproducer; do not gate UI on it. -->
  <variable name="resultsSettled" value="{
    ready
      &amp;&amp; rSession.loaded &amp;&amp; rCommit.loaded &amp;&amp; rIssue.loaded &amp;&amp; rHistory.loaded
      &amp;&amp; !rSession.inProgress &amp;&amp; !rCommit.inProgress &amp;&amp; !rIssue.inProgress &amp;&amp; !rHistory.inProgress
  }" />

  <!-- Date-slider domain: [min, max] over the latched result set
       (settledHits, 5d8cbb4) rather than the live buckets gated on
       resultsSettled, whose staleness stranded the slider hidden after a
       backspace-to-empty → retype cycle. The latch is settled content by
       construction and ignores dateFilter, so moving the handles never
       shifts the domain; it re-latches on facet toggles, so the domain
       now tracks the visible types (previously facet-independent). Widen
       by a day when all hits share one date so the two thumbs aren't
       coincident. -->
  <variable name="hitDates" value="{
    settledHits.map(h => Number(h.date)).filter(n => n > 0)
  }" />
  <variable name="dateLo" value="{hitDates.length ? hitDates.reduce((a, b) => a &lt; b ? a : b) : null}" />
  <variable name="dateHi" value="{hitDates.length ? hitDates.reduce((a, b) => a &gt; b ? a : b) : null}" />
  <variable name="dateRange"
    value="{dateLo === null ? null : [dateLo, dateHi > dateLo ? dateHi : dateLo + 86400]}" />

  <!-- Domain change => clear the applied filter. The thumbs need no companion
       reset call: the Slider re-seeds itself whenever initialValue/minValue/
       maxValue change together (SliderReact.tsx's initialValue effect depends
       on [initialValue, min, max]), and all three read the same settled
       dateRange, so they commit coherently in one render. A setValue-based
       reset is worse than redundant: setValue clamps against the min/max
       committed at call time (a debounced call can race the new domain props,
       stranding thumbs on the old scale) and it fires didChange, which would
       overwrite dateFilter with the full range instead of null.
       https://docs.xmlui.org/components/Slider#setvalue -->
  <ChangeListener
    listenTo="{dateRange ? (query.trim() + '|' + dateRange[0] + '-' + dateRange[1]) : ''}"
    onDidChange="() => { dateFilter = null; dateDraft = null; window.__bramIframeTrace('search-date', {op: 'filter-reset', settled: resultsSettled, lo: dateRange ? dateRange[0] : -1, hi: dateRange ? dateRange[1] : -1}) }" />

  <!-- The debounced commit this replaced (a ChangeListener on dateDraft at
       120ms) is gone: the Slider now commits on release through didCommit
       (xmlui-org/xmlui#3768). dateDraft stays — didChange still fires per
       step, and the endpoint labels and thumb tooltips read it so they
       track the thumbs while dateFilter waits for the release. -->

  <!-- search-date-filter-forensics (observe-only): the 2026-08-14 iterate
       reported the max thumb not constraining results, with auto-expand
       suspected. Candidate mechanism: a bucket refetch flips the reset
       signature through '' and the listener above clears dateFilter right
       after a drag. These two listeners give the trace a denominator:
       'buckets' marks every inProgress flap, 'displayed' marks every
       recompute with the filter that produced it. A drag followed by
       filter-reset + a bucket flap convicts the refetch path; a drag whose
       'displayed' still shows filtered=false convicts the didChange path. -->
  <ChangeListener
    listenTo="{'' + rSession.inProgress + rCommit.inProgress + rIssue.inProgress + rHistory.inProgress + rSession.loaded + rCommit.loaded + rIssue.loaded + rHistory.loaded}"
    onDidChange="() => window.__bramIframeTrace('search-date', {op: 'buckets', s: rSession.inProgress, c: rCommit.inProgress, i: rIssue.inProgress, h: rHistory.inProgress, ls: rSession.loaded, lc: rCommit.loaded, li: rIssue.loaded, lh: rHistory.loaded, ready: ready, settled: resultsSettled})" />
  <ChangeListener
    listenTo="{displayed.length + '|' + (dateFilter ? dateFilter[0] + '-' + dateFilter[1] : 'none')}"
    onDidChange="() => window.__bramIframeTrace('search-date', {op: 'displayed', count: displayed.length, filtered: !!dateFilter, lo: dateFilter ? dateFilter[0] : -1, hi: dateFilter ? dateFilter[1] : -1})" />

  <!-- search-pin-top-on-result-change: the date filter and the query change
       the result set wholesale, the same way a bucket toggle does — and under
       an outside-scroll virtualized List, shrink-then-grow re-anchoring
       strands a residual scroll (2026-08-14 iterate: drag the min thumb right
       then back, land mid-scroll). Pin the page to the top once the change
       settles; the debounce coalesces per-tick drag events into one pin at
       rest. Same rationale and mechanism as SearchResults' bucket-toggle pin
       (window.scrollAllToTop — not List.scrollToTop, whose outside-scroll
       startMargin goes stale). -->
  <ChangeListener
    listenTo="{(dateFilter ? dateFilter[0] + '-' + dateFilter[1] : 'none') + '|' + query.trim()}"
    debounceWaitInMs="250"
    onDidChange="() => { window.__bramScrollMainToTop(); window.__bramIframeTrace('search-date', {op: 'pin-top', via: 'filter-or-query'}) }" />

  <!-- Slider endpoint labels: show the live drag position when there is one,
       else the applied filter, else the full domain. Precomputed here so the
       Text bindings below are bare var references (see the label comment at
       the Slider). Reading dateDraft ahead of dateFilter is what keeps the
       labels tracking the thumbs at drag speed now that the filter itself
       commits on a 120ms debounce (search-slider-drag-debounce). -->
  <variable name="dateLabelPair" value="{dateDraft || dateFilter || dateRange}" />
  <variable name="dateLoLabel" value="{
    dateRange ? formatDateTime(new Date(dateLabelPair[0] * 1000), 'yyyy-MM-dd') : ''
  }" />
  <variable name="dateHiLabel" value="{
    dateRange ? formatDateTime(new Date(dateLabelPair[1] * 1000), 'yyyy-MM-dd') : ''
  }" />

  <!-- search-rows-confinement: bake the per-row view-model here, once per
       result-set change — formatDateTime ran 576x per keystroke when it
       lived in the row template (probe capture 2026-07-31). -->
  <!-- search-settle-gate: the four buckets settle staggered, and deriving
       rows straight from `merged` rebuilt the full row array (mapping +
       snippet segmentation + List swap + virtualizer re-anchor) once per
       bucket arrival — the 2026-08-16 trace attributed all three remaining
       multi-second main-thread blocks to exactly that shape. `settledHits`
       LATCHES merged, debounced on a content fingerprint (query, length,
       end keys, facets): arrivals inside the window collapse to ONE
       rebuild, and previous rows hold during a refetch. Deliberately NOT
       gated on resultsSettled — the first cut was, and a backspace-below-
       ready + retype-same-query cycle stranded the loaded/inProgress
       flags false (LOADER_LOADED with undefined data clears `loaded`,
       and a cache-equal refetch can skip the re-dispatch), blanking the
       page for good. The latch is a ChangeListener assignment, not a
       conditional binding — conditional variables froze and expression-
       arrows captured stale in this component family. Facet counts keep
       their live per-bucket reads. -->
  <variable name="settledHits" value="{[]}" />
  <!-- The query the latch last processed — the empty-state hint gates on
       it so "No results" can't flash while a fresh query's buckets are
       still in flight (the job resultsSettled used to do). -->
  <variable name="latchedQuery" value="" />
  <ChangeListener
    listenTo="{ready + '|' + query.trim() + '|' + merged.length + '|' + (merged.length ? merged[0].key + '-' + merged[merged.length - 1].key : '') + '|' + selectedTypes.slice().sort().join(',')}"
    debounceWaitInMs="300"
    onDidChange="() => { settledHits = ready ? merged : []; latchedQuery = ready ? query.trim() : ''; window.__bramIframeTrace('search-date', {op: 'latch', count: ready ? merged.length : 0, ready: ready}) }" />

  <!-- The 20-row initial-render cap (81ba145) was reverted once the
       xmlui-org/xmlui#3760 fix landed: outside-scroll Lists virtualize now,
       so mount cost tracks the viewport, not this array's length. -->
  <variable name="displayed" value="{
    sortSearchHits(
      settledHits.filter(h => !dateFilter || (Number(h.date) >= dateFilter[0] &amp;&amp; Number(h.date) &lt;= dateFilter[1])),
      sortOrder
    )
      .slice(0, 100)
      .map(h => Object.assign({}, h, {
        typeLabel: h.type === 'worklist-history' ? 'history' : h.type,
        dateLabel: h.date ? formatDateTime(new Date(Number(h.date) * 1000), 'yyyy-MM-dd HH:mm') : '',
        snippetSegs: snippetSegments(h.snippet, query.trim())
      }))
  }" />


  <!-- Search deliberately keeps Bram's whole-page App scroller. An unbounded
       List delegates to that nearest scroll ancestor; StickySection pins the
       compact controls below the AppHeader in the same proven arrangement as
       Transcript.xmlui. Do not add a competing height/overflow boundary here.
       https://docs.xmlui.org/howto/pin-sticky-content-below-the-appheader -->
  <VStack padding="$space-4" gap="$space-3">
    <StickySection stickTo="top" top="$height-AppHeader" backgroundColor="$backgroundColor">
      <!-- A fit-content column lets the query row establish the width; the date
           control beneath it follows that same width instead of stretching across
           the remainder of the page. Stack sizing:
           https://docs.xmlui.org/components/Stack -->
      <VStack width="fit-content" maxWidth="100%" gap="$space-1">
      <!-- width 100% + a star-sized SearchBox: the query row stretches to the
           fit-content column's width, which the pills+sort row establishes —
           the box tracks that row's width exactly (2026-08-16 commit-gate
           feedback: "expand the search box to match the extra width"). -->
      <HStack gap="$space-3" verticalAlignment="center" width="100%">
        <!-- Back affordance for Evidence-replay arrivals: shown only when the
             page was entered via a deep link (q in the URL). Worklist expansion
             state persists via the window-side UI-state store, so a plain
             navigate restores the item the user replayed from. -->
        <Link when="{!!$queryParams.q}" noIndicator tooltip="Back to the Worklist, restoring the open item"
          onClick="navigate('/worklist')">
          <Text value="← Worklist" />
        </Link>
        <Heading level="h2">Search</Heading>
        <Theme paddingHorizontal-Button-xs="$space-0_5">
          <Button
            label="ⓘ"
            variant="ghost"
            size="xs"
            tooltip="How search works"
            onClick="searchHelpDialog.open()" />
        </Theme>
        <SearchBox
          width="*"
          boxWidth="100%"
          placeholder="Quote for an exact phrase"
          initialValue="{query}"
          inProgress="{rSession.inProgress || rCommit.inProgress || rIssue.inProgress || rHistory.inProgress}"
          onQueryChange="(q) => query = q"
          onClear="query = ''" />
        <!-- Active-mode indicator: shown only when a replay link arrived with a
             non-default mode (raw/phrase/prefix). The generic Search UI keeps no
             permanent mode dropdown by design (quote-for-phrase is the everyday
             surface); this appears exactly when a mode is in play and offers a
             one-click reset to the AND default. -->
        <HStack when="{effectiveMode !== 'and'}" gap="$space-1" verticalAlignment="center">
          <Badge value="{'mode: ' + effectiveMode}" />
          <!-- Reset clears a URL-imposed mode only. A prefix mode derived from
               a trailing `*` is cleared by editing the query, and the `*` in
               the box is its own indicator — a reset link that did nothing
               visible would read as broken. -->
          <Link when="{mode !== 'and'}" noIndicator onClick="mode = 'and'" tooltip="Reset to default (AND) search mode">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="reset" />
          </Link>
        </HStack>
      </HStack>
      <!-- Two-handled date-range filter. The endpoint labels bind to the
           precomputed dateLoLabel/dateHiLabel vars, never to an inline
           ternary: the 2026-08-14 search-date trace showed these labels
           frozen at the first settled domain while the Slider bindings in
           the same subtree tracked fine — the inline
           `dateFilter ? … : dateRange[…]` inside `new Date(...)` defeated
           dependency tracking (the known inline-expression failure mode).
           The var graph is the proven reactive path (`displayed` tracks
           dateFilter in the same trace). -->
      <VStack when="{dateRange}" width="100%" gap="$space-0">
        <HStack>
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{dateLoLabel}" />
          <SpaceFiller />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{dateHiLabel}" />
        </HStack>
        <!-- showValues is the enable flag for Slider's per-thumb hover
             tooltip, not a permanent label: SliderReact.tsx gates it as
             `open={showValues &amp;&amp; showTooltip}`, with showTooltip driven
             by mouseover / pointerdown / focus. Off, the thumbs were silent
             and picking an intermediate date was guesswork. valueFormat
             turns the raw epoch second into the same yyyy-MM-dd the endpoint
             labels use.
             https://docs.xmlui.org/components/Slider#valueformat -->
        <!-- fontSize-Tooltip defaults to 1em (Tooltip.tsx:96), which reads
             large next to the $fontSize-xs endpoint labels; scoped here so
             only the thumb readouts shrink. -->
        <Theme fontSize-Tooltip="$fontSize-sm">
          <Slider
            id="dateSlider"
            minValue="{dateRange[0]}"
            maxValue="{dateRange[1]}"
            step="{86400}"
            initialValue="{dateRange}"
            showValues="true"
            valueFormat="{(v) => formatDateTime(new Date(v * 1000), 'yyyy-MM-dd')}"
            onDidChange="(v) => { dateDraft = v; window.__bramIframeTrace('search-date', {op: 'drag', lo: v[0], hi: v[1]}) }"
            onDidCommit="(v) => { dateFilter = v; window.__bramIframeTrace('search-date', {op: 'commit', via: 'didCommit', lo: v[0], hi: v[1]}) }" />
        </Theme>
      </VStack>
      <!-- Facet pills pin with the query block (2026-08-14 iterate: "the
           buttons don't stick to the header") so bucket toggles stay reachable
           while scrolled deep in results. paddingTop separates them from the
           query/slider block (commit-gate feedback). -->
      <HStack gap="$space-3" verticalAlignment="center" paddingTop="$space-2" paddingBottom="$space-2">
        <Link noIndicator tooltip="{selectedTypes.includes('session') ? 'Hide session matches' : 'Show session matches'}" onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'session', !selectedTypes.includes('session'))">
          <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('session') ? 1 : 0.4}">
            <Badge value="Sessions" colorMap="{facetColors}" />
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rSession.value || []).length}" />
          </HStack>
        </Link>
        <Link noIndicator tooltip="{selectedTypes.includes('commit') ? 'Hide commit matches' : 'Show commit matches'}" onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'commit', !selectedTypes.includes('commit'))">
          <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('commit') ? 1 : 0.4}">
            <Badge value="Commits" colorMap="{facetColors}" />
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rCommit.value || []).length}" />
          </HStack>
        </Link>
        <Link noIndicator tooltip="{selectedTypes.includes('issue') ? 'Hide issue matches' : 'Show issue matches'}" onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'issue', !selectedTypes.includes('issue'))">
          <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('issue') ? 1 : 0.4}">
            <Badge value="Issues" colorMap="{facetColors}" />
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rIssue.value || []).length}" />
          </HStack>
        </Link>
        <Link noIndicator tooltip="{selectedTypes.includes('worklist-history') ? 'Hide history matches' : 'Show history matches'}" onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'worklist-history', !selectedTypes.includes('worklist-history'))">
          <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('worklist-history') ? 1 : 0.4}">
            <Badge value="History" colorMap="{facetColors}" />
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rHistory.value || []).length}" />
          </HStack>
        </Link>
        <!-- Sort control rides the pinned pills row: it reorders the same
             result set the pills scope. https://docs.xmlui.org/components/Select -->
        <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="sort by:" />
        <Select
          width="9rem"
          initialValue="{sortOrder}"
          onDidChange="(v) => { sortOrder = v; writeLocalStorage('bram.searchSortOrder', v) }">
          <Option value="newest" label="Newest" />
          <Option value="relevance" label="Relevance" />
          <Option value="oldest" label="Oldest" />
        </Select>
      </HStack>
      <Text when="{coverageLine}" fontSize="$fontSize-xs" color="$textColor-secondary"
        value="{coverageLine}" />
      </VStack>
    </StickySection>

    <Text when="{!ready}"
      color="$textColor-secondary"
      value="Type at least 2 characters to search the index." />

    <!-- issue-251 absence signals: an empty result set says what kind of
         absence this is. Two cases, and conflating them printed a falsehood:
         gated on post-filter `displayed` alone, a query matching 129 docs
         with every pill off rendered "No matches." directly beneath the
         pills counting those 129, over a keyword-not-semantic note asserting
         no term had matched. Branch on `totalHits` instead. The note is
         load-bearing on a real zero (FTS5 keyword/phrase — a miss is not
         proof of absence) and firing it falsely teaches the reader to
         distrust it in the case it exists for. -->
    <VStack when="{ready &amp;&amp; displayed.length === 0 &amp;&amp; latchedQuery === query.trim() &amp;&amp; totalHits === 0}" gap="$space-0_5">
      <Text color="$textColor-secondary" value="No matches." />
      <Text fontSize="$fontSize-xs" color="$textColor-secondary"
        value="Search matches exact keywords and phrases (quote for a phrase), not meanings — no match means no term matched, not that the item is missing from the index. A trailing * widens the last word to a prefix." />
    </VStack>

    <!-- Hits exist; the filters are hiding them. Name the cause in the
         headline and make it fixable with one control rather than an
         instruction to go operate another one. -->
    <VStack when="{ready &amp;&amp; displayed.length === 0 &amp;&amp; latchedQuery === query.trim() &amp;&amp; totalHits > 0}" gap="$space-1">
      <Text color="$textColor-secondary"
        value="{'All ' + totalHits + ' match' + (totalHits === 1 ? ' is' : 'es are') + ' hidden by your filters.'}" />
      <Text fontSize="$fontSize-xs" color="$textColor-secondary"
        value="{(selectedTypes.length &lt; 4 ? ((4 - selectedTypes.length) + ' of 4 result types are turned off. ') : '') + (dateFilter ? 'A date window is narrowing the results. ' : '')}" />
      <Button label="Show all" themeColor="primary" size="xs"
        onClick="() => { selectedTypes = ['session', 'commit', 'issue', 'worklist-history']; dateFilter = null; dateDraft = null }" />
    </VStack>

    <!-- search-rows-confinement + search-results-virtualize: rows render
         behind the SearchResults boundary (probe receipts in its header) and
         remain virtualized against the App's outside scroll container. -->
    <SearchResults
      hits="{displayed}"
      query="{query.trim()}"
      selectionKey="{selectedTypes.slice().sort().join(',')}" />

    <!-- search-empty-state-and-help-show-dont-tell: the dialog used to be
         a seven-bullet spec of the query language, which a reader had to
         translate into a query themselves. Each row now RUNS instead --
         the button navigates the deep link -- and carries two more
         columns: what the answer looks like, and what the query actually
         becomes.

         The sample is a REAL top hit for that query in this instance,
         trimmed by hand to the few words that carry the point, rendered
         through snippetSegments with the SAME Text props SearchResults
         uses -- so the mark colour and size here are the ones on the
         results page, not an approximation. Static on purpose: a live
         query would make the lesson depend on what happens to be indexed,
         and an AND row whose top hit had its two terms adjacent would
         teach the opposite of the point. Trimmed on purpose too -- two
         marks with a word between them is the lesson, and forty words of
         real snippet buries it.

         The syntax column is the literal FTS5 MATCH expression the host
         builds: fts5_and_query (lib.rs:19871) quotes each term and joins
         with AND, appending * per term in prefix mode; raw passes through
         verbatim (dispatch at lib.rs:40826). It is here because only a
         fraction of that language is reachable from the box today -- the
         column is the map for opening more of it up.

         The two dead-wildcard rows carry no sample. They match as literal
         text, so whatever lone document contains that string is noise
         rather than an illustration. -->
    <Theme maxWidth-ModalDialog="64rem">
    <ModalDialog id="searchHelpDialog" title="Search help">
      <VStack gap="$space-3" padding="$space-2">
        <Markdown content="Searches Bram's local full-text index of this project's history:

- **Sessions** — Claude and Codex transcripts
- **Commits** — the git log, message and patch
- **Issues** — the project forge
- **History** — worklist history (proposals, approvals, commits)" />

        <!-- Two things the layout does not say for itself: that the first
             column is live, and that the middle column is a sample from THIS
             repo rather than a promise about the reader's. Without the second
             half, a reader who clicks and gets different hits reasonably
             concludes the help is wrong. -->
        <Text fontSize="$fontSize-xs" color="$textColor-secondary"
          value="Queries in the first column are clickable — each one runs. What comes back depends on what is indexed in your repo, so your results will differ from the samples shown here." />
        <HStack gap="$space-3" verticalAlignment="center">
          <Text width="13rem" fontWeight="bold" value="Try these" />
          <Text width="*" fontWeight="bold" value="What you get" />
          <Text width="15rem" fontWeight="bold" value="Sent to the index as" />
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="worklist version"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'worklist version' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Two words, ANDed: both must appear, in any order, with anything between them." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('[version] field to [worklist].json', 'worklist version')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;worklist&quot; AND &quot;version&quot;`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="&quot;inflight sentinel&quot;"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: '&quot;inflight sentinel&quot;' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="In quotes: the same two words, but adjacent and in that order." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('the Worklist [inflight sentinel] when approved', '&quot;inflight sentinel&quot;')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;inflight sentinel&quot;`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="&quot;inflight sentinel&quot; clear"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: '&quot;inflight sentinel&quot; clear' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Mix them: a quoted phrase and a loose word, both required." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('no [inflight sentinel] write/[clear]', '&quot;inflight sentinel&quot; clear')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;inflight sentinel&quot; AND &quot;clear&quot;`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="feedback-history"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'feedback-history' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Punctuation splits into adjacent words, so this also finds it written with a space." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('resources/[feedback-history]/ archive', 'feedback-history')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;feedback-history&quot;`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="ledg*"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'ledg*' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Trailing *: what you typed is a prefix, so the match runs longer than the query." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('add outbound-send [ledger]', 'ledg*')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;ledg&quot;*`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="work vers*"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'work vers*' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="One trailing * widens EVERY word in the query, not just the last one." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('bump [version] files from release [workflow]', 'work vers*')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;work&quot;* AND &quot;vers&quot;*`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="*edger"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: '*edger' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="A * anywhere but the very end is not a wildcard: it is searched as literal text." />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;*edger&quot;`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="ledg*r"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'ledg*r' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Same in the middle. Only the end of a word can float; there is no infix match." />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`&quot;ledg*r&quot;`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="ledger OR sentinel"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'ledger OR sentinel', mode: 'raw' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Raw mode: OR widens, so either word alone is a hit." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('send-[ledger] transitions and guards', 'ledger OR sentinel')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`ledger OR sentinel`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="sentinel NOT ledger"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'sentinel NOT ledger', mode: 'raw' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Raw mode: NOT subtracts, keeping hits that lack the second word." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('the inflight [sentinel] cleared at turn-end', 'sentinel NOT ledger')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`sentinel NOT ledger`" />
          </VStack>
        </HStack>
        <HStack gap="$space-3" verticalAlignment="start">
          <Button size="xs" variant="ghost" width="13rem" label="echo NEAR repin"
            onClick="() => { searchHelpDialog.close(); navigate('/search', { queryParams: { q: 'echo NEAR repin', mode: 'raw' } }) }" />
          <VStack width="*" gap="$space-0_5">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Raw mode: NEAR wants the words close together, not just present." />
            <Text width="100%" whiteSpace="pre-wrap"
              fontSize="$fontSize-sm" color="$textColor-secondary"
              segments="{snippetSegments('[echo]-suppressed, then [repin]', 'echo NEAR repin')}" />
          </VStack>
          <VStack width="15rem">
            <Markdown content="`echo NEAR repin`" />
          </VStack>
        </HStack>

        <Markdown content="**Then narrow what you got.** Click the colored pills to show or hide a bucket — each carries its own hit count. When results span dates, drag the two-handled slider to a time window. Click any result title to expand its full detail inline, and again to collapse." />
      </VStack>
    </ModalDialog>
    </Theme>
  </VStack>
</Component>
