<Component name="Transcript"
  var.fullscreenImage="{null}">
  <!-- Bounded List as the sole scroller. The List gets height="*" inside a
       height="100%" parent, so it fills the remaining viewport and scrolls
       within its OWN virtua container (footer stays docked, page does not
       grow) -- the star-fill-through-Page pattern proven by Workspace's
       HSplitter height="*". A bounded List is required for the new native
       scroll event to fire: in the prior unbounded Items/page-scroll layout
       the PAGE scrolled, so the List reported nothing.

       Follow + read-pause are driven explicitly from the List's `scroll`
       event (no DOM access, no opaque scrollAnchor heuristic): onScroll
       tracks atBottom; when new events arrive, follow only if the user is
       parked at the bottom. The event fires only for user-driven scrolls
       (the List's own scrollToBottom is guarded), so following never fights
       reading. -->
  <!-- Projected turns from the single host projection (/__turns). The
       Transcript is a pure consumer: no raw-JSONL parsing, no draft/feedback
       resolution client-side (docs/turn-transport-redesign.md). -->
  <PushSource
    id="turnsEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeProjectedTurns()}" />
  <!-- Pending menus no longer interleave here: the footer in Main.xmlui is
       the single canonical menu surface (same place on every tab, always
       visible). The menu-prose provisional block went with it; the real
       assistant record renders when it lands. -->
  <!-- Session metadata for the header: /__sessions/list flags the live
       session with current:true and carries title/mtime/size. Auto-detects
       the provider when none is passed (see list_sessions). Refetched on
       sessions-list-changed so the size/date track the growing live file. -->
  <DataSource
    id="transcriptSessions"
    url="/__sessions/list"
    queryParams="{{ limit: 20 }}" />
  <!-- Subagent stream for the chip-selected view (agentId prop from the
       footer chips strip). Refreshed by the dedicated subagents-changed
       signal (subagent JSONL appends never reach sessions-list-changed —
       see the watcher's subagents-changed emit). Gated on agentId: with
       none, the fetch degenerated to the FULL main projection and was
       ignored by the viewport switch — on a multi-MB session those
       redundant fetches froze the shared webview main thread and wedged
       the terminal (2026-07-07 codex esc wedge, third recurrence). -->
  <DataSource
    id="subagentTurns"
    url="/__turns"
    queryParams="{{ agent: $props.agentId }}"
    when="{!!$props.agentId}" />
  <PushSource
    id="transcriptSubagentsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('subagents-changed')}" />
  <ChangeListener
    listenTo="{transcriptSubagentsChangedEvt.value &amp;&amp; transcriptSubagentsChangedEvt.value.tick}"
    onDidChange="() => { if ($props.agentId) { subagentTurns.refetch(); } }" />
  <PushSource
    id="transcriptSessionsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{transcriptSessionsChangedEvt.value &amp;&amp; transcriptSessionsChangedEvt.value.tick}"
    onDidChange="() => transcriptSessions.refetch()" />
  <!-- Feedback refs (iterate turns) are resolved inside the host
       projection; no client-side feedback map is needed. -->
  <Theme maxWidth-ModalDialog="95vw">
    <ModalDialog
      when="{!!fullscreenImage}"
      onClose="fullscreenImage = null">
      <Image
        src="{window.imageSrcForPath(fullscreenImage)}"
        fit="contain"
        width="100%"
        height="80vh" />
    </ModalDialog>
  </Theme>
  <VStack
    height="100%"
    padding="$space-4"
    gap="$space-2"
    onInit="window.__bramTranscriptMount()"
    onCleanup="window.__bramSetTranscriptMounted(false)"
    var.events="{window.__bramTranscriptEventsFromTurns($props.agentId ? subagentTurns.value : turnsEvt.value, null)}"
    var.eventsVersion="{($props.agentId ? (subagentTurns.value &amp;&amp; subagentTurns.value.total) : (turnsEvt.value &amp;&amp; turnsEvt.value.revision)) || events.length}"
    var.windowSize="{40}"
    var.windowedEvents="{events.slice(-windowSize)}"
    var.expanded="{[]}"
    var.atBottom="{true}"
    var.repinArmed="{false}"
    var.currentSession="{((transcriptSessions.value || []).find(s => s.current)) || ((transcriptSessions.value || [])[0])}">
    <HStack verticalAlignment="center" gap="$space-2">
      <Heading level="h2">Transcript</Heading>
      <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{events.length + ' events'}" />
    </HStack>
    <Text
      when="{currentSession}"
      fontSize="$fontSize-sm"
      maxLines="1"
      value="{window.__bramSessionMetaLine(currentSession)}" />
    <!-- Subagent-view banner: which agent's stream is showing and whether
         it is still running. The footer's Main chip swaps back. -->
    <Text
      when="{$props.agentId}"
      fontSize="$fontSize-sm"
      fontWeight="bold"
      color="$color-primary-600"
      value="{window.__bramSubagentHeaderLine(subagentTurns.value)}" />
    <Text
      when="{events.length === 0}"
      color="$textColor-secondary"
      value="No transcript yet." />
    <!-- Windowed tail (transcript-windowed-render): the List renders only
         the last windowSize events so a scroll-up fling can never walk the
         virtualizer through the whole session's unmeasured rows (the
         remount-storm freeze named by resizeobserver-flood-detail; virtua
         flushSync-re-renders per measurement batch, virtua #470). Pulling
         in older rows changes the first row id, which flips virtua's
         supported keep-scroll-position prepend path. -->
    <Link
      when="{events.length > windowSize}"
      noIndicator="true"
      onClick="windowSize = windowSize + 100">
      <Text
        fontSize="$fontSize-sm"
        color="$color-primary-600"
        value="{'▲ Show earlier (' + (events.length - windowedEvents.length) + ' more)'}" />
    </Link>
    <List
      id="transcriptList"
      height="*"
      data="{windowedEvents}"
      onScroll="(ev) => { if (atBottom !== ev.atEnd) window.__bramIframeTrace('transcript-follow', {atBottom: ev.atEnd, agentId: $props.agentId || 'main'}); atBottom = ev.atEnd }">
      <property name="emptyListTemplate"><Fragment/></property>
      <VStack gap="$space-1" paddingVertical="$space-1">
        <!-- user message -->
        <VStack
          when="{$item.kind === 'user'}"
          backgroundColor="$color-surface-100"
          padding="$space-2"
          borderRadius="$borderRadius"
          gap="$space-1">
          <Text value="You" fontWeight="bold" color="$color-primary-600" fontSize="$fontSize-sm" />
          <!-- Worklist payloads, feedback refs, and image markers are already
               resolved by the host projection; render the text as-is. -->
          <Markdown content="{$item.text}" />
        </VStack>
        <!-- assistant text -->
        <Markdown
          when="{$item.kind === 'text'}"
          content="{$item.text}" />
        <!-- task notification: quiet system-note row (host-reclassified
             subagent completion report — never rendered as "You") -->
        <Text
          when="{$item.kind === 'notification'}"
          fontSize="$fontSize-sm"
          fontStyle="italic"
          color="$textColor-secondary"
          value="{'🔔 ' + $item.text}" />
        <!-- image strip -->
        <VStack
          when="{$item.kind === 'images'}"
          gap="$space-2"
          paddingVertical="$space-1">
          <Items data="{$item.images || []}">
            <Link onClick="fullscreenImage = $item" noIndicator="true">
              <Image
                src="{window.imageSrcForPath($item)}"
                maxHeight="220px"
                fit="contain" />
            </Link>
          </Items>
        </VStack>
        <!-- thinking (foldable) -->
        <VStack when="{$item.kind === 'thinking'}" gap="$space-0_5">
          <Link noIndicator="true" onClick="expanded = window.__bramToggleInArray(expanded, $item.id)">
            <Text
              fontSize="$fontSize-sm"
              fontStyle="italic"
              color="$textColor-secondary"
              value="{((expanded || []).includes($item.id) ? '▾' : '▸') + '  💭 thinking'}" />
          </Link>
          <VStack
            when="{(expanded || []).includes($item.id)}"
            backgroundColor="$color-surface-50"
            padding="$space-2"
            borderRadius="$borderRadius">
            <Markdown content="{$item.text}" />
          </VStack>
        </VStack>
        <!-- tool call (foldable) -->
        <VStack when="{$item.kind === 'tool'}" gap="$space-0_5">
          <!-- Expand toggles the fold; when the ai.describeCommands opt-in
               is on, opening a command-bearing row also requests a Haiku
               intent header via /__describe-command (no-op otherwise). -->
          <Link noIndicator="true" onClick="expanded = window.__bramExpandTool(expanded, $item)">
            <HStack gap="$space-1" verticalAlignment="center">
              <Text fontSize="$fontSize-sm" fontWeight="bold" value="{((expanded || []).includes($item.id) ? '▾' : '▸') + '  🔧 ' + $item.name}" />
              <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{$item.summary}" />
            </HStack>
          </Link>
          <VStack
            when="{(expanded || []).includes($item.id)}"
            gap="$space-1"
            backgroundColor="$color-surface-50"
            padding="$space-2"
            borderRadius="$borderRadius">
            <Markdown
              when="{$item.commandDisplay &amp;&amp; $item.name === 'apply_patch'}"
              overflowMode="scroll"
              content="{window.__bramFormatToolResult($item.commandDisplay, $item.name, $item.summary)}" />
            <Markdown
              when="{($item.commandDisplay || $item.summary) &amp;&amp; ($item.name !== 'apply_patch' || !$item.commandDisplay)}"
              overflowMode="scroll"
              content="{window.__bramFormatToolCommand($item.commandDisplay || $item.summary, $item.description)}" />
            <!-- Tool result: typed Markdown code-fence when the formatter
                 helper is live (after a rebuild), else the prior raw Text so a
                 hot-reload never blanks or markdown-mangles the expansion.
                 Errors always use the red raw Text. -->
            <Markdown
              when="{$item.result &amp;&amp; !$item.isError &amp;&amp; window.__bramFormatToolResult}"
              overflowMode="scroll"
              content="{window.__bramFormatToolResult($item.result, $item.name, $item.summary)}" />
            <Text
              when="{$item.result &amp;&amp; ($item.isError || !window.__bramFormatToolResult)}"
              fontFamily="$fontFamily-monospace"
              fontSize="$fontSize-xs"
              color="{$item.isError ? '$color-danger-600' : '$textColor-secondary'}"
              value="{$item.result}" />
            <!-- Agent dispatches: in-place peek at the subagent's own
                 transcript (host-tagged agentId via meta.json sidecar) -->
            <SubagentPeek
              when="{$item.agentId}"
              agentId="{$item.agentId}" />
          </VStack>
        </VStack>
      </VStack>
    </List>
    <!-- Explicit follow-bottom (replaces scrollAnchor="bottom" and its
         content-wrapper re-stick ResizeObserver, xmlui #3599). onScroll keeps
         atBottom in sync (fires only on user scrolls; programmatic scrolls are
         guarded), and we re-pin to the end on new content only while the user
         is parked there — so following never fights reading, and there's no
         RO-driven re-stick to loop or yank the viewport. -->
    <ChangeListener
      listenTo="{events.length + ':' + eventsVersion}"
      onDidChange="() => { if (atBottom) { transcriptList.scrollToBottom(); window.__bramIframeTrace('transcript-repin', {events: events.length, agentId: $props.agentId || 'main'}); } }" />
    <!-- Viewport switch (chip click: Main ↔ subagent) always lands at the
         bottom: re-arm follow mode so the async refetch's events swap
         re-pins via the listener above, and pin immediately for the
         already-cached data. The 400ms delayed second pin covers the
         virtualized List's late layout of variable-height rows — the
         suspected cause of unreliable landings; the subagent-switch /
         subagent-switch-repin / transcript-repin / transcript-follow
         traces in bram-trace.log make the next miss self-diagnosing.
         The re-pin rides an armed one-shot Timer, NOT delay(): a
         delay()-suspended handler outliving a remount trips the
         engine's async-unmount lifecycle violation (observed 9× in
         5 min of chip-switching, 2026-07-06); the Timer is
         component-owned and disposes cleanly. -->
    <ChangeListener
      listenTo="{$props.agentId}"
      onDidChange="() => { windowSize = 40; atBottom = true; repinArmed = true; window.__bramIframeTrace('subagent-switch', {agentId: $props.agentId || 'main', events: events.length}); transcriptList.scrollToBottom(); }" />
    <Timer
      interval="400"
      enabled="{repinArmed}"
      onTick="() => { repinArmed = false; transcriptList.scrollToBottom(); window.__bramIframeTrace('subagent-switch-repin', {agentId: $props.agentId || 'main', events: events.length}); }" />
  </VStack>
</Component>
