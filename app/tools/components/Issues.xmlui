<Component name="Issues"
  var.issuesExpanded="{false}"
  var.searchQuery="{getLastSearchQuery()}"
  var.searchNeedle="{searchQuery.trim().toLowerCase()}"
  var.showNewIssueHint="{false}"
  var.newIssueSubmitting="{false}"
  var.closingIssue="{false}"
  var.newIssueStartSig="{''}"
  var.newIssueTurnEnded="{false}"
  var.lastIssuesSig="{''}"
  var.issueRefreshTick="{0}"
  var.sortField="updatedAt"
  var.sortDir="desc"
  var.stateFilter="open"
  var.issuesSource="{(issuesFull.value &amp;&amp; issuesFull.value.length > 0) ? issuesFull.value : (issuesFirstPage.value || [])}"
  var.sortedIssues="{(issuesSource || []).filter(i => stateFilter === 'both' || (stateFilter === 'open') === (i.state === 'OPEN')).sort(function(a, b) {
    const av = sortField === 'number' ? Number(a.number || 0) : (a[sortField] || '');
    const bv = sortField === 'number' ? Number(b.number || 0) : (b[sortField] || '');
    if (av < bv) return sortDir === 'asc' ? -1 : 1;
    if (av > bv) return sortDir === 'asc' ? 1 : -1;
    return 0;
  })}"
  var.filteredIssues="{
    searchNeedle
      ? sortedIssues.filter(i => [
          i.number || '',
          i.title || '',
          i.state || '',
          (i.author &amp;&amp; i.author.login) || '',
          (i.author &amp;&amp; i.author.name) || '',
          i.commentSummary || '',
          i.latestCommentAuthor || ''
        ].join(' ').toLowerCase().includes(searchNeedle)
          || (issuesSearchFts.value || []).some(hit => hit.key === 'issue:' + i.number))
      : sortedIssues
  }"
  var.pageIssues="{filteredIssues.slice(0, searchNeedle ? 999 : (issuesExpanded ? 999 : 20))}"
  var.issueRows="{pageIssues.map(i => Object.assign({}, i, {
    key: 'issue:' + i.number,
    type: 'issue',
    source: '#' + i.number + ' ' + (i.title || '')
  }))}">

  <DataSource
    id="issuesSearchFts"
    url="/__search"
    queryParams="{{ q: searchQuery, limit: 300, types: 'issue' }}"
    when="{searchQuery.trim().length >= 2}" />
  <!-- Browse list with a local metadata filter, inline IssueDetail, and the
       comment/close controls. Unified Search remains the cross-bucket/full-text
       path. No polling — the agent-turn-end event covers locally-filed
       issues, comment/close bump issueRefreshTick, and Refresh is manual for
       remote (GitHub/GitLab) changes with no push channel. -->
  <DataSource
    id="issuesFirstPage"
    url="/__issues"
    queryParams="{{ limit: 20 }}"
    onLoaded="(data) => {
      const currentSig = ((data || []).map(i => i && i.number).filter(Boolean).sort()).join(',');
      if (newIssueSubmitting &amp;&amp; newIssueStartSig &amp;&amp; currentSig !== newIssueStartSig) {
        newIssueSubmitting = false; newIssueStartSig = ''; newIssueTurnEnded = false;
      } else if (newIssueSubmitting &amp;&amp; newIssueTurnEnded) {
        newIssueSubmitting = false; newIssueStartSig = ''; newIssueTurnEnded = false;
      }
      lastIssuesSig = currentSig;
    }" />

  <DataSource
    id="issuesFull"
    url="/__issues"
    when="{issuesFirstPage.loaded || issuesFirstPage.value}"
    onLoaded="(data) => {
      const currentSig = ((data || []).map(i => i && i.number).filter(Boolean).sort()).join(',');
      if (newIssueSubmitting &amp;&amp; newIssueStartSig &amp;&amp; currentSig !== newIssueStartSig) {
        newIssueSubmitting = false; newIssueStartSig = ''; newIssueTurnEnded = false;
      } else if (newIssueSubmitting &amp;&amp; newIssueTurnEnded) {
        newIssueSubmitting = false; newIssueStartSig = ''; newIssueTurnEnded = false;
      }
      lastIssuesSig = currentSig;
    }" />

  <DataSource id="repoOrigin" url="/__repo/origin" />

  <APICall
    id="commentIssueCall"
    url="/__issue/comment"
    method="post"
    queryParams="{{ number: $param.number, body: $param.body }}"
    completedNotificationMessage="Comment posted."
    onSuccess="issueRefreshTick = issueRefreshTick + 1; issuesFirstPage.refetch(); issuesFull.refetch()" />

  <ModalDialog
    when="{showNewIssueHint}"
    title="File an issue"
    onClose="showNewIssueHint = false; newIssueEditor.clear(); setWorklistVoiceTarget('message-agent')">
    <VStack gap="$space-3" padding="$space-2">
      <Text>
        It's helpful to write down the ideas you'll send to the Worklist. Agents can express ideas as GitHub issues where you, your agents, collaborators, and their agents can all share persistent and durable context.
      </Text>
      <VStack gap="$space-2" paddingTop="$space-2" borderTop="1px solid $borderColor">
        <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" value="Ask the agent to file an issue" />
        <IsolatedDraftEditor
          id="newIssueEditor"
          placeholder="Describe what the issue should cover"
          autoFocus="true"
          resize="vertical"
          minRows="4"
          maxRows="16"
          width="100%"
          voiceTarget="new-issue"
          voiceTooltip="Dictate issue request"
          />
        <HStack gap="$space-2">
          <Button
            label="Send"
            enabled="{!newIssueSubmitting}"
            onClick="const text = (newIssueEditor.getValue() || '').trim(); if (text) { newIssueStartSig = lastIssuesSig; newIssueTurnEnded = false; newIssueSubmitting = true; toTurn('File an issue (forge CLI: ' + ((repoOrigin.value &amp;&amp; repoOrigin.value.cli) || 'gh') + '): ' + text); showNewIssueHint = false; newIssueEditor.clear(); setWorklistVoiceTarget('message-agent'); }" />
          <Button
            label="Cancel"
            variant="ghost"
            onClick="showNewIssueHint = false; newIssueEditor.clear(); setWorklistVoiceTarget('message-agent')" />
        </HStack>
      </VStack>
    </VStack>
  </ModalDialog>

  <PushSource
    id="issuesAgentTurnEndEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('agent-turn-end')}" />
  <ChangeListener
    listenTo="{issuesAgentTurnEndEvt.value &amp;&amp; issuesAgentTurnEndEvt.value.tick}"
    onDidChange="() => { if (newIssueSubmitting) { newIssueTurnEnded = true; } issuesFirstPage.refetch(); issuesFull.refetch(); }" />

  <!-- Host synthesizes issues-changed when its background poll of the forge
       detects a change; the client only refetches on the event — no polling,
       no manual refresh. Same pattern as git-status-changed. -->
  <PushSource
    id="issuesChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('issues-changed')}" />
  <ChangeListener
    listenTo="{issuesChangedEvt.value &amp;&amp; issuesChangedEvt.value.tick}"
    onDidChange="() => { issuesFirstPage.refetch(); issuesFull.refetch(); }" />
  <VStack padding="$space-4" gap="$space-4" overflowY="auto" height="100%">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Issues</Heading>
      <RadioGroup
        initialValue="open"
        orientation="horizontal"
        gap="$space-3"
        onDidChange="(v) => stateFilter = v">
        <Option value="open" label="open" />
        <Option value="closed" label="closed" />
        <Option value="both" label="both" />
      </RadioGroup>
      <SearchBox
        boxWidth="22rem"
        placeholder="Filter issues…"
        initialValue="{searchQuery}"
        inProgress="{issuesFirstPage.inProgress || issuesFull.inProgress}"
        onQueryChange="(q) => { searchQuery = q; setLastSearchQuery(q) }"
        onClear="searchQuery = ''; setLastSearchQuery('')" />
      <Button
        when="{repoOrigin.value &amp;&amp; repoOrigin.value.issuesNewUrl}"
        label="+ New issue"
        size="xs"
        enabled="{!newIssueSubmitting}"
        onClick="showNewIssueHint = true" />
      <Theme size-Spinner="16px">
        <Spinner when="{newIssueSubmitting || (issuesFirstPage.inProgress &amp;&amp; !issuesFirstPage.loaded)}" />
      </Theme>
    </HStack>

    <Text
      when="{!repoOrigin.value || !repoOrigin.value.htmlBase}"
      color="$textColor-secondary">
      No forge remote detected for this project. Add an origin remote (GitHub or GitLab) to populate this tab.
    </Text>
    <Text
      when="{repoOrigin.value &amp;&amp; repoOrigin.value.htmlBase &amp;&amp; issuesFirstPage.loaded &amp;&amp; !issuesFirstPage.inProgress &amp;&amp; (!issuesSource || issuesSource.length === 0)}"
      color="$textColor-secondary">
      No issues found. (The repo may have none, `{(repoOrigin.value &amp;&amp; repoOrigin.value.cli) || 'gh'}` may not be installed / authenticated, or the last fetch failed — it will retry shortly.)
    </Text>

    <VStack gap="0" width="100%" when="{pageIssues.length > 0}">
      <HStack
        gap="$space-3"
        paddingHorizontal="$space-3"
        paddingVertical="$space-2"
        backgroundColor="$color-surface-100"
        borderBottom="1px solid $borderColor">
        <Link width="64px" noIndicator
          onClick="const r = window.toggleSort(sortField, sortDir, 'state', 'desc'); sortField = r.field; sortDir = r.dir">
          <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="{window.sortLabel('STATE', sortField, sortDir, 'state')}" />
        </Link>
        <!-- issues-page-bram-lifecycle-column: GitHub state and Bram state
             are different facts; this column answers "is it in the
             lifecycle, and where" (live item stage > queued close >
             committed history > blank). -->
        <Link width="150px" noIndicator
          onClick="const r = window.toggleSort(sortField, sortDir, 'bramState', 'asc'); sortField = r.field; sortDir = r.dir">
          <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="{window.sortLabel('BRAM', sortField, sortDir, 'bramState')}" />
        </Link>
        <Link width="*" noIndicator
          onClick="const r = window.toggleSort(sortField, sortDir, 'number', 'asc'); sortField = r.field; sortDir = r.dir">
          <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="{window.sortLabel('TITLE', sortField, sortDir, 'number')}" />
        </Link>
        <Link width="90px" noIndicator
          onClick="const r = window.toggleSort(sortField, sortDir, 'updatedAt', 'desc'); sortField = r.field; sortDir = r.dir">
          <Text fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="{window.sortLabel('AGE', sortField, sortDir, 'updatedAt')}" />
        </Link>
      </HStack>
      <!-- browse-tabs-adopt-searchresults: rows render through the shared
           ResultList shell (hover Cards, whole-row click → detail modal,
           virtualized). Row anatomy (state / title+meta / age) and the
           comment/close controls stay Issues-owned via the two slots; the
           inline expansion and its expandedNumber state retire. -->
      <ResultList
        data="{issueRows}"
        query="{searchQuery.trim()}"
        detailRefreshTick="{issueRefreshTick}">
        <property name="rowTemplate">
          <HStack gap="$space-3" verticalAlignment="center">
            <HStack width="64px" verticalAlignment="center">
              <Text
                fontSize="$fontSize-sm"
                fontWeight="$fontWeight-bold"
                color="{$item.state === 'OPEN' ? '$color-success-700' : '$textColor-secondary'}"
                value="{$item.state === 'OPEN' ? 'open' : 'closed'}" />
            </HStack>
            <HStack width="150px" verticalAlignment="center">
              <!-- issues-bram-referenced-legible: the referenced tier links its
                   citing commit on the forge (404s until pushed, heals on push —
                   the History-tab convention) and carries the commit's subject
                   and date as the hover tooltip. Other tiers stay plain text. -->
              <Link
                when="{$item.bramStateCommit &amp;&amp; repoOrigin.value &amp;&amp; repoOrigin.value.htmlBase}"
                noIndicator
                tooltip="{$item.bramStateDetail}"
                onClick="openExternal(repoOrigin.value.htmlBase + '/commit/' + $item.bramStateCommit)">
                <Text fontSize="$fontSize-sm" color="$textColor-secondary" maxLines="1"
                  value="{$item.bramState}" />
              </Link>
              <Text
                when="{!($item.bramStateCommit &amp;&amp; repoOrigin.value &amp;&amp; repoOrigin.value.htmlBase)}"
                fontSize="$fontSize-sm" color="$textColor-secondary" maxLines="1"
                tooltip="{$item.bramStateDetail}"
                value="{$item.bramState || '—'}" />
            </HStack>
            <VStack width="*" gap="0">
              <Text value="#{$item.number} {$item.title}" maxLines="1" />
              <Text when="{$item.commentSummary}" fontSize="$fontSize-xs" color="$textColor-secondary" maxLines="1"
                value="{'comments: ' + $item.commentSummary}" />
              <Text fontSize="$fontSize-xs" color="$textColor-secondary" maxLines="1"
                value="{(($item.author &amp;&amp; ($item.author.login || $item.author.name)) || 'unknown') + ' opened ' + getDateUntilNow($item.createdAt) + ' ago'}" />
              <Text when="{$item.latestCommentAuthor &amp;&amp; $item.latestCommentAt}" fontSize="$fontSize-xs" color="$textColor-secondary" maxLines="1"
                value="{$item.latestCommentAuthor + ' commented ' + getDateUntilNow($item.latestCommentAt) + ' ago'}" />
            </VStack>
            <!-- issues-age-cell-overflow: compact form for the 90px gutter,
                 plus the maxLines backstop every sibling Text already had.
                 getDateUntilNow's prose ("less than a minute") escaped the
                 card; it stays in use above, where prose is what's wanted. -->
            <HStack width="90px" verticalAlignment="center">
              <Text fontSize="$fontSize-sm" color="$textColor-secondary" maxLines="1"
                value="{compactAge($item.activityAt || $item.updatedAt || $item.createdAt)}" />
            </HStack>
          </HStack>
        </property>
        <property name="detailFooterTemplate">
          <VStack gap="$space-2" paddingTop="$space-3" borderTop="1px solid $borderColor">
            <!-- IsolatedDraftEditor for dictation. Deliberately NO pasteTarget:
                 a screenshot cannot be attached to a forge comment (neither gh
                 nor glab has an attachment flag, and the web UI's upload is
                 session-authenticated), so inviting a paste here would stage an
                 image that never reaches the comment. The placeholder is the
                 lead sentence only; draft-editor-derived-affordance-placeholder
                 appends affordance text from what is actually wired. -->
            <IsolatedDraftEditor
              id="closeCommentBox"
              placeholder="Optional comment"
              resize="vertical"
              minRows="2"
              maxRows="12"
              voiceTarget="{'issue-comment:' + $item.number}"
              voiceTooltip="Dictate comment"
              enabled="{!commentIssueCall.inProgress &amp;&amp; !closingIssue}" />
            <HStack gap="$space-2">
              <Button
                label="Comment"
                variant="outlined"
                size="sm"
                enabled="{!commentIssueCall.inProgress &amp;&amp; !closingIssue}"
                onClick="const text = (closeCommentBox.getValue() || '').trim(); if (text) { commentIssueCall.execute({ number: $item.number, body: text }); closeCommentBox.clear(); }" />
              <Button
                when="{$item.state === 'OPEN'}"
                label="Close issue"
                variant="outlined"
                size="sm"
                enabled="{!commentIssueCall.inProgress &amp;&amp; !closingIssue}"
                onClick="closingIssue = true; window.__bramCloseIssue($item.number, closeCommentBox.getValue() || '', () => { closingIssue = false; closeCommentBox.clear(); issueRefreshTick = issueRefreshTick + 1; issuesFirstPage.refetch(); issuesFull.refetch(); }, () => { closingIssue = false; })" />
              <Theme size-Spinner="16px">
                <Spinner when="{commentIssueCall.inProgress || closingIssue}" />
              </Theme>
            </HStack>
          </VStack>
        </property>
      </ResultList>
      <HStack
        when="{!searchNeedle &amp;&amp; issuesSource &amp;&amp; issuesSource.length > 20}"
        padding="$space-2"
        horizontalAlignment="center">
        <Link onClick="issuesExpanded = !issuesExpanded" noIndicator>
          <Text fontSize="$fontSize-sm"
            value="{issuesExpanded ? 'Show fewer' : 'More (' + (issuesSource.length - 20) + ' more)'}" />
        </Link>
      </HStack>
    </VStack>
    <Text when="{searchNeedle &amp;&amp; !issuesFull.inProgress &amp;&amp; filteredIssues.length === 0}"
      color="$textColor-secondary" fontSize="$fontSize-sm" value="No matching issues." />
  </VStack>
</Component>
