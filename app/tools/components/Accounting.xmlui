<Component
  name="Accounting"
  var.period="{'7d'}"
  var.tokenInfoKey="{''}"
  var.expandedKey="{''}"
  var.showAllSessions="{false}"
  var.showAllItems="{false}">

  <!-- cost-page-is-a-bill (Jon, 2026-11-23: "the cost page is full of data
       that i can make no sense of. if we cannot tell a story with the data
       let's dial back"): the page is a bill for a period. Period first, the
       total second, the top lines third: by session, by item, two fixed-cost
       sentences. The research readings the earlier page carried (Models,
       Files, lib.rs coverage, This session's stretches) live in the CLI's
       token-accounting flag's JSON and docs/developing-bram-reference.md
       §What the agents spend; the footer's context modal tells the
       this-session story.
       One DataSource: /__token-accounting?since=<ISO>, which already carries
       every figure below. The period's start is the one clock read on the
       page (__bramStorySince, allowlisted); everything else reads the report,
       the rates file, the sessions list (titles) and Settings (the threshold).
       https://www.xmlui.org/docs/howto/hide-an-element-until-its-datasource-is-ready -->
  <DataSource id="costSessions" url="/__sessions/list" queryParams="{{ limit: 500 }}" />
  <DataSource id="tokenRates" url="/tools/resources/model-rates.json" />
  <DataSource id="costSettings" url="/__settings" />
  <DataSource id="tokens" url="{window.__bramCostUrl(window.__bramCostSince(period))}" />

  <VStack padding="$space-6" gap="$space-4" height="*">
    <PinnedHeader gap="$space-4">
    <property name="headerTemplate">
      <VStack gap="$space-4">
    <HStack gap="$space-3" verticalAlignment="center" wrapContent="true">
      <Heading level="h2">Cost</Heading>
      <!-- https://www.xmlui.org/docs/reference/components/Select -->
      <Select
        automationId="cost-period"
        width="180px"
        initialValue="{period}"
        onDidChange="(v) => period = window.__bramCostPeriod(v)">
        <Option value="7d" label="Last 7 days" />
        <Option value="30d" label="Last 30 days" />
        <Option value="all" label="All history" />
      </Select>
      <Text
        when="{tokens.inProgress}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="Adding up every session…" />
    </HStack>

    <!-- The headline: one sentence with the total at list prices, and the
         subscription caveat. https://www.xmlui.org/docs/reference/components/Markdown -->
    <Markdown
      when="{tokens.loaded &amp;&amp; !!tokens.value}"
      interpolateBindings="false" allowHtml="false"
      content="{window.__bramCostHeadline(tokens.value, tokenRates.value, period)}" />
      </VStack>
    </property>
    <VStack when="{tokens.loaded &amp;&amp; !!tokens.value}" gap="$space-4">
      <!-- By session: costliest first. Subagent threads fold into their
           parent's row. A row whose peak passed the Settings threshold says
           so in words. Open mounts the same SessionDetail the Sessions tab
           uses, under the table. -->
      <VStack gap="$space-2">
        <HStack gap="$space-3" verticalAlignment="center" wrapContent="true">
          <Heading level="h4">By session</Heading>
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="— costliest first" />
          <Button size="xs" variant="ghost" icon="info" label="How dollars are figured" onClick="tokenInfoKey = 'listPrices'" />
          <!-- table-headers-explained: Column header is a plain string in
               XMLUI 0.14.28 (no template, no tooltip), so the columns'
               little-i sits here and opens the same modal.
               https://www.xmlui.org/docs/reference/components/Column -->
          <Button size="xs" variant="ghost" icon="info" label="What the columns mean" onClick="tokenInfoKey = 'sessionColumns'" />
        </HStack>
        <Table data="{window.__bramCostSessionRows(tokens.value, costSessions.value, tokenRates.value, costSettings.value, showAllSessions)}">
          <Column bindTo="when" header="When" width="95px" />
          <Column bindTo="title" header="Session"><Text breakMode="anywhere" value="{$item.title}" /></Column>
          <Column bindTo="hours" header="Hours" width="70px" />
          <Column bindTo="calls" header="Calls" width="70px" />
          <Column bindTo="peak" header="Peak context" width="105px" />
          <Column bindTo="compactions" header="Compactions" width="105px" />
          <Column bindTo="context" header="Tokens sent" width="100px" />
          <Column bindTo="usd" header="At list" width="80px" />
          <Column bindTo="note" header="" width="150px"><Text color="$color-warn-700" value="{$item.note}" /></Column>
          <Column header="" width="70px">
            <Button size="xs" variant="ghost" label="{window.__bramCostOpenLabel(expandedKey, $item.key)}" onClick="expandedKey = window.__bramCostToggleKey(expandedKey, $item.key)" />
          </Column>
        </Table>
        <Link when="{!!window.__bramCostSessionsMoreLabel(tokens.value, showAllSessions)}" noIndicator="true" onClick="showAllSessions = !showAllSessions">
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCostSessionsMoreLabel(tokens.value, showAllSessions)}" />
        </Link>
        <VStack when="{!!expandedKey}" gap="$space-1" paddingTop="$space-2">
          <SessionDetail
            sessionId="{window.__bramCostKeyId(expandedKey)}"
            provider="{window.__bramCostKeyProvider(expandedKey)}"
            height="600px"
            query="" />
        </VStack>
      </VStack>

      <!-- By item: what each Worklist item's work used, main thread and
           subagents together; chat outside any item is the last row. -->
      <VStack gap="$space-2">
        <HStack gap="$space-3" verticalAlignment="center" wrapContent="true">
          <Heading level="h4">By item</Heading>
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="— what each Worklist item's work used" />
          <Button size="xs" variant="ghost" icon="info" label="What this credits and omits" onClick="tokenInfoKey = 'itemCredit'" />
          <Button size="xs" variant="ghost" icon="info" label="What the columns mean" onClick="tokenInfoKey = 'itemColumns'" />
        </HStack>
        <Table data="{window.__bramCostItemRows(tokens.value, tokenRates.value, showAllItems)}">
          <Column bindTo="item" header="Item"><Text breakMode="anywhere" value="{$item.item}" /></Column>
          <Column bindTo="calls" header="Calls" width="80px" />
          <Column bindTo="context" header="Tokens sent" width="110px" />
          <Column bindTo="usd" header="At list" width="90px" />
        </Table>
        <Link when="{!!window.__bramCostItemsMoreLabel(tokens.value, showAllItems)}" noIndicator="true" onClick="showAllItems = !showAllItems">
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCostItemsMoreLabel(tokens.value, showAllItems)}" />
        </Link>
      </VStack>

      <!-- Fixed costs: two sentences from the same rows. -->
      <Markdown
        interpolateBindings="false" allowHtml="false"
        content="{window.__bramCostFixedLines(tokens.value)}" />
    </VStack>
    </PinnedHeader>

    <Theme maxWidth-ModalDialog="50vw">
      <ModalDialog when="{!!tokenInfoKey}" title="{window.__bramCostInfoTitle(tokenInfoKey)}" onClose="tokenInfoKey = ''">
        <VStack gap="$space-3" padding="$space-2">
          <Markdown interpolateBindings="false" allowHtml="false"
            content="{window.__bramCostInfoText(tokenInfoKey, tokenRates.value)}" />
        </VStack>
      </ModalDialog>
    </Theme>
  </VStack>
</Component>
