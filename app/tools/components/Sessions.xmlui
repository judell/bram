<Component
  name="Sessions"
  var.currentProvider="{null}"
  var.expandedId="{null}"
  var.sessionsExpanded="{false}"
  var.searchQuery="{getLastSearchQuery()}"
  var.renamingSession="{null}"
  var.renameDraft=""
  var.newSessionOpen="{false}"
  var.newSessionDraft=""
  var.pendingDeletes="{loadPendingSessionDeletes()}"
  var.pendingRenames="{loadPendingSessionRenames()}"
  var.lastDeleteId="{null}"
  var.lastRenameId="{null}"
  var.lastRenameProvider="{null}"
  var.lastRenameOriginalTitle=""
  var.lastRenameTitle="">

  <!-- Browse list with full-text filtering through the shared SQLite index and
       inline SessionDetail. Search hits are joined back to the lightweight
       session metadata rows so browse actions and columns remain available. -->
  <DataSource
    id="sessionsMeta"
    url="/__sessions/meta"
    onLoaded="(data) => {
      if (!data || !data.provider) return;
      if (currentProvider !== data.provider) {
        currentProvider = data.provider;
        expandedId = null;
        sessionsExpanded = false;
      }
    }" />

  <DataSource
    id="sessionsFirstPage"
    url="/__sessions/list"
    queryParams="{{ limit: 20, provider: currentProvider }}"
    when="{!!currentProvider}" />

  <DataSource
    id="sessionsFull"
    url="/__sessions/list"
    queryParams="{{ provider: currentProvider }}"
    when="{(sessionsExpanded || searchQuery.trim().length >= 2) &amp;&amp; !!currentProvider}" />

  <DataSource
    id="sessionsSearch"
    url="/__search"
    queryParams="{{ q: searchQuery, limit: 500, types: 'session' }}"
    when="{searchQuery.trim().length >= 2}" />

  <variable
    name="sessionsSource"
    value="{((sessionsExpanded || searchQuery.trim().length >= 2) &amp;&amp; sessionsFull.value) ? sessionsFull.value : (sessionsFirstPage.value || [])}" />
  <variable name="searchNeedle" value="{searchQuery.trim().toLowerCase()}" />
  <variable name="searchReady" value="{searchNeedle.length >= 2}" />
  <variable name="filteredSessions" value="{
    searchReady
      ? (sessionsSearch.value || [])
          .map(hit => (sessionsSource || []).find(s => s.id === hit.id &amp;&amp; s.provider === hit.provider))
          .filter(s => !!s)
      : (searchNeedle ? [] : (sessionsSource || []))
  }" />
  <!-- sessions-delete-pending-self-heal: drop pending ids still present in the
       list so a stuck "pending" row re-enables. -->
  <ChangeListener
    listenTo="{sessionsSource}"
    onDidChange="pendingDeletes = pendingDeletes.filter(id => !(sessionsSource || []).some(s => s.id === id)); savePendingSessionDeletes(pendingDeletes)" />

  <APICall
    id="deleteSession"
    url="/__sessions/delete"
    method="get"
    queryParams="{{ id: $param.id, provider: $param.provider }}"
    confirmTitle="Delete session?"
    confirmMessage="This cannot be undone."
    completedNotificationMessage="Session deleted. Reload Bram to refresh the session list; you do not need to restart the agent."
    onSuccess="pendingDeletes = pendingDeletes.concat([lastDeleteId]); savePendingSessionDeletes(pendingDeletes); if (expandedId === lastDeleteId) { expandedId = null; } sessionsFirstPage.refetch(); if (sessionsExpanded || searchNeedle) sessionsFull.refetch();" />

  <APICall
    id="renameSession"
    url="/__sessions/rename"
    method="get"
    queryParams="{{ id: $param.id, provider: $param.provider, title: $param.title }}"
    onSuccess="sessionsFirstPage.refetch(); if (sessionsExpanded || searchNeedle) sessionsFull.refetch();"
    onError="pendingRenames = pendingRenames.filter(id => id !== lastRenameId); savePendingSessionRenames(pendingRenames); renamingSession = { id: lastRenameId, provider: lastRenameProvider, title: lastRenameOriginalTitle }; renameDraft = lastRenameTitle" />

  <ModalDialog
    id="renameDialog"
    when="{!!renamingSession}"
    onClose="renamingSession = null; renameDraft = ''"
    title="Rename session">
    <VStack gap="$space-3" padding="$space-4">
      <TextBox
        id="renameBox"
        width="*"
        initialValue="{renamingSession &amp;&amp; (renamingSession.title || '')}"
        autoComplete="off"
        autoCorrect="{false}"
        spellCheck="{false}"
        autoCapitalize="off"
        onDidChange="(v) => renameDraft = v" />
      <Text
        color="$textColor-secondary"
        fontSize="$fontSize-sm"
        value="Note: codex /resume can create additional bootstrap-only session files. Bram hides those from this list and keeps [current] on the live session file when it can identify it." />
      <HStack horizontalAlignment="end" gap="$space-2">
        <Button label="Cancel" variant="outlined" onClick="renamingSession = null; renameDraft = ''" />
        <Button
          label="Rename"
          enabled="{renameDraft &amp;&amp; renameDraft.trim().length > 0}"
          onClick="let target = renamingSession; let title = renameDraft; lastRenameId = target.id; lastRenameProvider = target.provider; lastRenameOriginalTitle = target.title || ''; lastRenameTitle = title; pendingRenames = pendingRenames.includes(target.id) ? pendingRenames : pendingRenames.concat([target.id]); savePendingSessionRenames(pendingRenames); renamingSession = null; renameDraft = ''; toast('Session renamed. Reload Bram to see the new title in the session list.'); renameSession.execute({ id: target.id, provider: target.provider, title: title })" />
      </HStack>
    </VStack>
  </ModalDialog>

  <ModalDialog
    id="newSessionDialog"
    when="{newSessionOpen}"
    onClose="newSessionOpen = false; newSessionDraft = ''"
    title="New session">
    <VStack gap="$space-3" padding="$space-4">
      <TextBox
        id="newSessionBox"
        width="*"
        placeholder="Session name"
        autoComplete="off"
        autoCorrect="{false}"
        spellCheck="{false}"
        autoCapitalize="off"
        onDidChange="(v) => newSessionDraft = v" />
      <Text
        color="$textColor-secondary"
        fontSize="$fontSize-sm"
        value="Stops the running agent and starts a fresh one, then sends this name as the first message so the new session is created and becomes current right away. The prior session stays in the list, resumable." />
      <HStack horizontalAlignment="end" gap="$space-2">
        <Button label="Cancel" variant="outlined" onClick="newSessionOpen = false; newSessionDraft = ''" />
        <Button
          label="Create"
          enabled="{newSessionDraft &amp;&amp; newSessionDraft.trim().length > 0}"
          onClick="let name = newSessionDraft; newSessionOpen = false; newSessionDraft = ''; window.__bramCreateNewSessionClick(currentProvider, name, toast)" />
      </HStack>
    </VStack>
  </ModalDialog>

  <PushSource
    id="sessionsListChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{sessionsListChangedEvt.value &amp;&amp; sessionsListChangedEvt.value.tick}"
    onDidChange="() => { sessionsMeta.refetch(); sessionsFirstPage.refetch(); if (sessionsExpanded || searchNeedle) sessionsFull.refetch(); }" />

  <VStack padding="$space-4" gap="$space-3" overflowY="auto" height="100%">
    <HStack gap="$space-3" verticalAlignment="center">
      <Link when="{$queryParams.from === 'tip'}" noIndicator
        tooltip="Back to where you were" onClick="navigate(-1)">
        <Text value="← Back" />
      </Link>
      <Heading level="h2">Sessions</Heading>
      <SearchBox
        boxWidth="22rem"
        placeholder="Filter sessions…"
        initialValue="{searchQuery}"
        inProgress="{searchReady &amp;&amp; (sessionsSearch.inProgress || sessionsFull.inProgress)}"
        onQueryChange="(q) => { searchQuery = q; setLastSearchQuery(q) }"
        onClear="searchQuery = ''; setLastSearchQuery(''); expandedId = null" />
      <Button
        label="+ New session"
        variant="solid"
        size="sm"
        tooltip="Start a fresh session and make it current"
        onClick="newSessionDraft = ''; newSessionOpen = true" />
    </HStack>
    <Text
      when="{sessionsMeta.value}"
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="{sessionsMeta.value.count > 0 ? ('Auto-detected provider: ' + sessionsMeta.value.provider + ' (' + sessionsMeta.value.count + ' session' + (sessionsMeta.value.count === 1 ? '' : 's') + ')') : ('Auto-detected provider: ' + sessionsMeta.value.provider + ' (no sessions yet)')}" />
    <VStack
      when="{sessionsMeta.value &amp;&amp; sessionsMeta.value.discoveryNotes &amp;&amp; sessionsMeta.value.discoveryNotes.length > 0}"
      gap="$space-1"
      padding="$space-2"
      borderRadius="$borderRadius"
      backgroundColor="$color-warning-50">
      <Items data="{sessionsMeta.value.discoveryNotes}">
        <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{$item}" />
      </Items>
    </VStack>

    <VStack gap="0" width="100%">
      <HStack
        gap="$space-3"
        paddingHorizontal="$space-3"
        paddingVertical="$space-2"
        backgroundColor="$color-surface-100"
        borderBottom="1px solid $borderColor">
        <Text width="*" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="TITLE" />
        <Text width="140px" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="MODIFIED" />
        <Text width="70px" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="SIZE" />
      </HStack>
      <Items data="{filteredSessions}">
        <VStack gap="0" borderBottom="1px solid $borderColor">
          <HStack
            gap="$space-2"
            paddingHorizontal="$space-3"
            paddingVertical="$space-2"
            verticalAlignment="start"
            opacity="{(pendingDeletes.includes($item.id) || pendingRenames.includes($item.id)) ? 0.5 : 1}">
            <Button
              label="⟳"
              variant="ghost"
              size="xs"
              enabled="{!(pendingDeletes.includes($item.id) || pendingRenames.includes($item.id))}"
              tooltip="{pendingDeletes.includes($item.id) ? 'delete pending' : (pendingRenames.includes($item.id) ? 'rename pending' : 'Reload: kill the running agent and resume this session')}"
              onClick="window.__bramReloadAgentSessionClick($item.provider, $item.id, toast)" />
            <Button
              label="✕"
              variant="ghost"
              size="xs"
              enabled="{!(pendingDeletes.includes($item.id) || pendingRenames.includes($item.id))}"
              tooltip="{pendingDeletes.includes($item.id) ? 'delete pending' : (pendingRenames.includes($item.id) ? 'rename pending' : 'Delete session')}"
              onClick="lastDeleteId = $item.id; deleteSession.execute({ id: $item.id, provider: $item.provider })" />
            <Button
              label="✎"
              variant="ghost"
              size="xs"
              enabled="{!(pendingDeletes.includes($item.id) || pendingRenames.includes($item.id))}"
              tooltip="{pendingDeletes.includes($item.id) ? 'delete pending' : (pendingRenames.includes($item.id) ? 'rename pending' : 'Rename session')}"
              onClick="renamingSession = { id: $item.id, provider: $item.provider, title: ($item.title || '') }; renameDraft = ($item.title || '')" />
            <Link
              width="*"
              onClick="expandedId = (expandedId === $item.id) ? null : $item.id"
              noIndicator>
              <Text
                width="100%"
                fontWeight="{expandedId === $item.id ? '$fontWeight-bold' : '$fontWeight-normal'}"
                value="{($item.current ? '[current] ' : '') + ($item.title || '(untitled)')}" />
            </Link>
            <Text width="140px" fontSize="$fontSize-sm" value="{formatDateTime(new Date($item.mtime * 1000), 'yyyy-MM-dd HH:mm')}" />
            <Text width="70px" fontSize="$fontSize-sm" value="{Math.round($item.size / 1024) + ' KB'}" />
          </HStack>
          <VStack when="{expandedId === $item.id}" paddingBottom="$space-2">
            <SessionDetail sessionId="{$item.id}" provider="{$item.provider}"
              height="600px" query="{searchQuery.trim()}" />
          </VStack>
        </VStack>
      </Items>
      <Link
        when="{!searchNeedle &amp;&amp; !sessionsExpanded &amp;&amp; sessionsMeta.value &amp;&amp; sessionsMeta.value.count > 20}"
        onClick="sessionsExpanded = true"
        noIndicator="true">
        <Text
          paddingHorizontal="$space-3"
          paddingVertical="$space-2"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="More ({sessionsMeta.value.count - 20} more)" />
      </Link>
      <Link
        when="{!searchNeedle &amp;&amp; sessionsExpanded &amp;&amp; sessionsSource.length > 20}"
        onClick="sessionsExpanded = false"
        noIndicator="true">
        <Text
          paddingHorizontal="$space-3"
          paddingVertical="$space-2"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Show fewer" />
      </Link>
      <Text when="{searchNeedle &amp;&amp; !searchReady}"
        color="$textColor-secondary" fontSize="$fontSize-sm"
        value="Type at least 2 characters to search session transcripts." />
      <Text
        when="{searchReady &amp;&amp; sessionsSearch.loaded &amp;&amp; sessionsFull.loaded &amp;&amp; !sessionsSearch.inProgress &amp;&amp; !sessionsFull.inProgress &amp;&amp; filteredSessions.length === 0}"
        color="$textColor-secondary" fontSize="$fontSize-sm" value="No matching sessions." />
    </VStack>
  </VStack>
</Component>
