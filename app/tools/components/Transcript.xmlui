<Component name="Transcript"
  var.fullscreenImage="{null}">
  <!-- Bounded List as the sole scroller. The List gets height="*" inside a
       height="100%" parent, so it fills the remaining viewport and scrolls
       within its OWN virtua container (footer stays docked, page does not
       grow) -- the star-fill-through-Page pattern proven by Workspace's
       HSplitter height="*". A bounded List is required for the new native
       scroll event to fire: in the prior unbounded Items/page-scroll layout
       the PAGE scrolled, so the List reported nothing.

       Follow + read-pause are driven explicitly from the List's `scroll`
       event (no DOM access, no opaque scrollAnchor heuristic): onScroll
       tracks atBottom; when new events arrive, follow only if the user is
       parked at the bottom. Scroll events are NOT all user-driven — see
       the classification rule in the contract below.

       THE FOLLOW CONTRACT (transcript-follow-contract; authoritative).
       Two states: FOLLOWING (viewport pinned to the live edge) and
       READING (viewport anchored where the user put it).
       - Enter FOLLOWING: user scrolls to bottom; footer down-arrow; agent
         chip switch; mount when the saved state was following.
       - Enter READING: user scrolls up; find-step; tool-row expand; footer
         up-arrow (jump without re-arm); mount when the saved state was
         reading (restore position).
       - While FOLLOWING: every content/layout change ends at the bottom.
       - While READING: nothing moves the viewport.
       - Every transition that promises the bottom is VERIFIED against the
         List's own layout (window.__bramFollowVerify, double-rAF ->
         visibleRange), never assumed.
       - CLASSIFICATION (transcript-follow-echo-guard, layer 2): a scroll
         event is user intent only when (a) no echo window is open — every
         deliberate transition (non-user-scroll cause) and mount opens one
         — AND (b) user input corroborates it: wheel, keydown, or a
         held/recent pointer within 400ms. Machine scrolls (virtua shift
         compensation, expanded-content growth, repins) have no input
         beside them at any latency — the first live soak caught an
         expand echo re-arming FOLLOWING 2.7s after the click, past any
         plausible fixed window (03:53:48). Suppressed events log
         `follow-state op=echo-suppressed` (cause: the window opener, or
         `uncorroborated`), never a state flip. Layer-1 receipts: 1,056
         bottom-promises, zero violations, while echoes phantom-flipped
         state on every tool-expand.
       Every state flip logs `follow-state op=transition` with its cause;
       every bottom-promise logs op=verify or op=violation. A new
       transition MUST route through window.__bramFollowTransition /
       __bramFollowVerify, and onScroll classification through
       window.__bramFollowClassify — an untraced flip is a contract bug
       even when the scroll behaves. Repins gate on the SYNCHRONOUS
       window truth (window.__bramFollowRepinOk), never on the xs
       atBottom var alone: the var's assignment rides the engine's state
       pipeline and a repin can fire before it lands (2026-08-01
       04:40:01 — a repin 240ms into READING, invisible to verify
       because a misfired repin still logs landed=True). A blocked
       misfire logs op=repin-blocked. scrollAnchor="bottom" is deliberately
       NOT used: its re-stick ResizeObserver yanks readers on height
       changes (c4c14ed; xmlui #3599). -->

  <!-- Projected turns from the single host projection (/__turns). The
       Transcript is a pure consumer: no raw-JSONL parsing, no draft/feedback
       resolution client-side (docs/turn-transport-redesign.md). -->
  <PushSource
    id="turnsEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeProjectedTurns()}" />
  <PushSource
    id="transcriptFindClearEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTranscriptFindClear()}" />
  <!-- Pending menus no longer interleave here: the footer in Main.xmlui is
       the single canonical menu surface (same place on every tab, always
       visible). The menu-prose provisional block went with it; the real
       assistant record renders when it lands. -->
  <!-- Session metadata for the header: /__sessions/list flags the live
       session with current:true and carries title/mtime/size. Auto-detects
       the provider when none is passed (see list_sessions). Refetched on
       sessions-list-changed so the size/date track the growing live file. -->
  <DataSource
    id="transcriptSessions"
    url="/__sessions/list"
    queryParams="{{ limit: 20 }}" />
  <!-- Subagent stream for the chip-selected view (agentId prop from the
       footer chips strip). Refreshed by the dedicated subagents-changed
       signal (subagent JSONL appends never reach sessions-list-changed —
       see the watcher's subagents-changed emit). Gated on agentId: with
       none, the fetch degenerated to the FULL main projection and was
       ignored by the viewport switch — on a multi-MB session those
       redundant fetches froze the shared webview main thread and wedged
       the terminal (2026-07-07 codex esc wedge, third recurrence). -->
  <!-- subagent-transcript-describe: each load/refetch feeds the payload to
       the eager-describe scan (the main-projection scan never sees this
       stream). Completions come back via the flush's refetch thunk — the
       host injects cached descriptions on every /__turns?agent= fetch. -->
  <DataSource
    id="subagentTurns"
    url="/__turns"
    queryParams="{{ agent: $props.agentId }}"
    when="{!!$props.agentId}"
    onLoaded="(data) => window.__bramEagerDescribeSubagent(data, () => subagentTurns.refetch())" />
  <PushSource
    id="transcriptSubagentsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('subagents-changed')}" />
  <ChangeListener
    listenTo="{transcriptSubagentsChangedEvt.value &amp;&amp; transcriptSubagentsChangedEvt.value.tick}"
    onDidChange="() => { if ($props.agentId) { subagentTurns.refetch(); } }" />
  <PushSource
    id="transcriptSessionsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{transcriptSessionsChangedEvt.value &amp;&amp; transcriptSessionsChangedEvt.value.tick}"
    onDidChange="() => transcriptSessions.refetch()" />
  <!-- Feedback refs (iterate turns) are resolved inside the host
       projection; no client-side feedback map is needed. -->
  <Theme maxWidth-ModalDialog="95vw">
    <ModalDialog
      when="{!!fullscreenImage}"
      onClose="fullscreenImage = null">
      <Image
        src="{window.imageSrcForPath(fullscreenImage)}"
        fit="contain"
        width="100%"
        height="80vh" />
    </ModalDialog>
  </Theme>
  <VStack
    height="100%"
    padding="$space-4"
    gap="$space-2"
    onInit="window.__bramRegisterTranscriptScroll(() => { atBottom = window.__bramFollowTransition(false, 'footer-arrow-up', $props.agentId); transcriptList.scrollToTop(); }, () => { window.__bramClearTranscriptFind('footer-arrow-down'); atBottom = window.__bramFollowTransition(true, 'footer-arrow-down', $props.agentId); transcriptList.scrollToBottom(); window.__bramFollowVerify('footer-arrow-down', $props.agentId); }); window.__bramTranscriptMount()"
    onCleanup="window.__bramSetTranscriptMounted(false); window.__bramSetVisibleRange(Object.assign({}, window.__bramVisibleRange || {}, { atBottom: atBottom, total: events.length }))"
    var.events="{window.__bramTranscriptEventsFromTurns($props.agentId ? subagentTurns.value : turnsEvt.value, null)}"
    var.eventsVersion="{($props.agentId ? (subagentTurns.value &amp;&amp; subagentTurns.value.total) : (turnsEvt.value &amp;&amp; turnsEvt.value.revision)) || events.length}"
    var.expanded="{[]}"
    var.atBottom="{!window.__bramVisibleRange || window.__bramVisibleRange.atBottom !== false}"
    var.repinArmed="{false}"
    var.settleArmed="{false}"
    var.mountReturnState="{window.__bramVisibleRange || null}"
    var.mountFollow="{!mountReturnState || mountReturnState.atBottom !== false}"
    var.mountPinArmed="{true}"
    var.mountPinTicks="{0}"
    var.findText="{''}"
    var.appliedNeedle="{''}"
    var.findCursor="{0}"
    var.findPlan="{null}"
    var.currentSession="{((transcriptSessions.value || []).find(s => s.current)) || ((transcriptSessions.value || [])[0])}">
    <!-- transcript-find-in-page-v2: inline find row, no UDC — the FindBar
         factoring is parked (stash@{0}) on the xmlui #3584 emitEvent-in-UDC
         silent-failure family. The pane's scroller is the App's
         mainContentArea, so the heading + find row pin via StickySection —
         CSS position:sticky against that scrollport. In vertical-sticky the
         AppHeader is ALSO sticky at top:0 inside the same scroller, so
         without an offset the pinned row is hidden exactly behind it (the
         2026-07-29 'still not sticky' failure, reproduced + fixed in a
         standalone replica); top=$height-AppHeader pins it flush below
         instead — the same theme var the framework itself uses to align
         NavPanel with the header (NavPanel.module.scss), present from
         first paint (unlike the engine's measured --header-height, whose
         size observer races at load). Needs an explicit backgroundColor
         or scrolled content shows through (per the sticky-header
         how-to). -->
    <StickySection stickTo="top" top="$height-AppHeader" backgroundColor="$backgroundColor">
      <HStack verticalAlignment="center" gap="$space-2" paddingVertical="$space-2">
        <Heading level="h2">Transcript</Heading>
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{events.length + ' events'}" />
        <FindBar id="transcriptFindBar" placeholder="Find in transcript…"
          clearRevision="{transcriptFindClearEvt.value &amp;&amp; transcriptFindClearEvt.value.tick}"
          matchCount="{findPlan ? findPlan.total : 0}"
          current="{findPlan ? findPlan.cursor : findCursor}"
          showCount="{findText.trim().length >= 2}"
          onNeedleChange="(v) => findText = v"
          onStep="(d) => findCursor = window.__bramFindCursorStep(findPlan ? findPlan.total : 0, findCursor, d)" />
      </HStack>
    </StickySection>
    <Text
      when="{currentSession}"
      fontSize="$fontSize-sm"
      maxLines="1"
      value="{window.__bramSessionMetaLine(currentSession)}" />
    <!-- Subagent-view banner: which agent's stream is showing and whether
         it is still running. The footer's Main chip swaps back. -->
    <Text
      when="{$props.agentId}"
      fontSize="$fontSize-sm"
      fontWeight="bold"
      color="$color-primary-600"
      value="{window.__bramSubagentHeaderLine(subagentTurns.value)}" />
    <Text
      when="{events.length === 0}"
      color="$textColor-secondary"
      value="No transcript yet." />
    <List
      id="transcriptList"
      height="*"
      data="{(findPlan &amp;&amp; findPlan.rows) || events}"
      idKey="{findPlan ? '__findKey' : 'id'}"
      onScroll="(ev) => atBottom = window.__bramFollowClassify(atBottom, ev.atEnd, $props.agentId)"
      onVisibleRangeDidChange="(range) => window.__bramSetVisibleRange(range)">
      <property name="emptyListTemplate"><Fragment/></property>
      <VStack gap="$space-1" paddingVertical="$space-1">
        <!-- user message -->
        <VStack
          when="{$item.kind === 'user'}"
          backgroundColor="$color-surface-100"
          padding="$space-2"
          borderRadius="$borderRadius"
          gap="$space-1">
          <Text value="You" fontWeight="bold" color="$color-primary-600" fontSize="$fontSize-sm" />
          <!-- Worklist payloads, feedback refs, and image markers are already
               resolved by the host projection; render the text as-is.
               highlightText/highlightActiveIndex ride the find decoration
               (__needle/__activeOcc/__blockIdx baked by the find plan; inert
               otherwise). -->
          <Markdown content="{$item.text}" interpolateBindings="false" allowHtml="false"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
        </VStack>
        <!-- assistant text -->
        <Markdown
          when="{$item.kind === 'text'}"
          interpolateBindings="false" allowHtml="false"
          content="{$item.text}"
          highlightText="{window.__bramSearchTerms($item.__needle)}"
          highlightActiveIndex="{$item.__activeOcc}" />
        <!-- task notification: quiet system-note row (host-reclassified
             subagent completion report — never rendered as "You") -->
        <Text
          when="{$item.kind === 'notification'}"
          fontSize="$fontSize-sm"
          fontStyle="italic"
          color="$textColor-secondary"
          value="{'🔔 ' + $item.text}" />
        <Markdown
          when="{$item.kind === 'notification' &amp;&amp; $item.__findPreview}"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          content="{window.__bramMarkdownLiteral($item.__findPreview)}"
          highlightText="{window.__bramSearchTerms($item.__needle)}"
          highlightActiveIndex="{$item.__activeOcc}" />
        <!-- image strip -->
        <VStack
          when="{$item.kind === 'images'}"
          gap="$space-2"
          paddingVertical="$space-1">
          <Items data="{$item.images || []}">
            <Link onClick="fullscreenImage = $item" noIndicator="true">
              <Image
                src="{window.imageSrcForPath($item)}"
                maxHeight="220px"
                fit="contain" />
            </Link>
          </Items>
        </VStack>
        <!-- thinking (foldable) -->
        <VStack when="{$item.kind === 'thinking'}" gap="$space-0_5">
          <Link noIndicator="true" onClick="expanded = window.__bramToggleInArray(expanded, $item.id)">
            <Text
              fontSize="$fontSize-sm"
              fontStyle="italic"
              color="$textColor-secondary"
              value="{((expanded || []).includes($item.id) ? '▾' : '▸') + '  💭 thinking'}" />
          </Link>
          <Markdown
            when="{$item.__findPreview}"
            fontSize="$fontSize-sm"
            color="$textColor-secondary"
            content="{window.__bramMarkdownLiteral($item.__findPreview)}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
          <VStack
            when="{(expanded || []).includes($item.id)}"
            backgroundColor="$color-surface-50"
            padding="$space-2"
            borderRadius="$borderRadius">
            <!-- Expanded body: unmarked while finding (the preview above
                 is the counted, active-highlighted surface). -->
            <Markdown content="{$item.text}" interpolateBindings="false" allowHtml="false"
              highlightText="{$item.__findPreview ? [] : window.__bramSearchTerms($item.__needle)}" />
          </VStack>
        </VStack>
        <!-- tool call (foldable) -->
        <VStack when="{$item.kind === 'tool'}" gap="$space-0_5">
          <!-- Expand toggles the fold; when the ai.describeCommands opt-in
               is on, opening a command-bearing row also requests a Haiku
               intent header via /__describe-command (no-op otherwise). -->
          <!-- Expanding a row is a read-pause gesture, like scrolling up:
               clear atBottom so the describe-splice repin (and its settle
               Timer) stop yanking the viewport to the absolute bottom while
               the eager describe queue streams aiDescription lines into edit
               rows (describe-edit-write-rows made every edit row a describe
               target — 4 repins/1.5s on one expand, 2026-07-24 trace). Follow
               resumes when the user scrolls back to the bottom. -->
          <Link noIndicator="true" onClick="expanded = window.__bramExpandTool(expanded, $item); atBottom = window.__bramFollowTransition(false, 'tool-expand', $props.agentId)">
            <HStack gap="$space-1" verticalAlignment="center">
              <!-- promote-tool-descriptions-to-row (inverted): the row leads
                   with the Haiku-resolved intent (aiDescription, requested
                   eagerly as rows arrive); hover shows the RAW command line —
                   the opposite of the original command-first, describe-on-
                   expand arrangement. Summary fills in until the description
                   resolves. -->
              <Text
                fontSize="$fontSize-sm"
                fontWeight="bold"
                tooltip="{($item.commandDisplay || $item.summary || '').slice(0, 500)}"
                value="{((expanded || []).includes($item.id) ? '▾' : '▸') + '  🔧 ' + $item.name + ($item.nameDetail ? ' (' + $item.nameDetail + ')' : '')}" />
              <Text
                when="{$item.aiDescription}"
                fontSize="$fontSize-sm"
                color="$textColor-secondary"
                maxLines="1"
                tooltip="{($item.commandDisplay || $item.summary || '').slice(0, 500)}"
                value="{'— ' + $item.aiDescription}" />
              <Text
                when="{!$item.aiDescription &amp;&amp; $item.summary &amp;&amp; $item.summary !== $item.name}"
                fontSize="$fontSize-sm"
                color="$textColor-secondary"
                tooltip="{($item.commandDisplay || $item.summary || '').slice(0, 500)}"
                value="{$item.summary}" />
            </HStack>
          </Link>
          <!-- The matcher includes collapsed tool metadata and command text.
               Surface a compact excerpt while finding so every counted match
               has an actual <mark>, including a match that exists only in the
               folded command body. -->
          <Markdown
            when="{$item.__findPreview}"
            fontSize="$fontSize-sm"
            color="$textColor-secondary"
            content="{window.__bramMarkdownLiteral($item.__findPreview)}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
          <!-- transcript-render-menu-answers: the user's menu answer (host
               menu-answer overlay, keyed by tool_use id). AskUserQuestion
               rows only — a bare '✔ Yes' under a permission-prompted
               Read/Bash row is clutter (2026-07-23 specimen); permission
               answers stay captured host-side but render nothing. Hidden
               while expanded — the expansion's Q/A prose shows the same
               answer. User-authored affordance: same primary color as the
               You label. -->
          <Text
            when="{$item.menuAnswer &amp;&amp; $item.name === 'AskUserQuestion' &amp;&amp; !(expanded || []).includes($item.id)}"
            fontSize="$fontSize-sm"
            fontWeight="bold"
            color="$color-primary-600"
            tooltip="Your answer to this permission menu"
            value="{'✔ ' + $item.menuAnswer}" />
          <VStack
            when="{(expanded || []).includes($item.id)}"
            gap="$space-1"
            backgroundColor="$color-surface-50"
            padding="$space-2"
            borderRadius="$borderRadius">
            <DiffView
              when="{$item.commandDisplay &amp;&amp; $item.name === 'apply_patch'}"
              compact="true"
              text="{$item.commandDisplay}" />
            <!-- Command/summary block: hidden for feedback-draft Reads (the
                 path already heads the row; the wrapped content stands alone).
                 The ternary guards a hot-reload against pre-rebuild helpers.js. -->
            <Markdown
              when="{window.__bramShowToolCommand ? window.__bramShowToolCommand($item) : (($item.commandDisplay || $item.summary) &amp;&amp; ($item.name !== 'apply_patch' || !$item.commandDisplay))}"
              overflowMode="scroll"
              interpolateBindings="false" allowHtml="false"
              content="{window.__bramFormatToolCommand($item.commandDisplay || $item.summary, $item.aiDescription || $item.description)}"
              highlightText="{$item.__findPreview ? [] : window.__bramSearchTerms($item.__needle)}" />
            <Markdown
              when="{$item.commandMarkdown}"
              overflowMode="flow"
              content="{$item.commandMarkdown}" interpolateBindings="false" allowHtml="false" />
            <DiffView
              when="{$item.diff}"
              compact="true"
              text="{$item.diff}" />
            <!-- Tool result: typed Markdown code-fence when the formatter
                 helper is live (after a rebuild), else the prior raw Text so a
                 hot-reload never blanks or markdown-mangles the expansion.
                 Errors always use the red raw Text. Feedback-draft Reads wrap
                 as prose (flow); everything else keeps horizontal scroll. The
                 ternary guards a hot-reload against pre-rebuild helpers.js. -->
            <Markdown
              when="{$item.result &amp;&amp; !$item.isError &amp;&amp; window.__bramFormatToolResult}"
              overflowMode="{window.__bramFreeformResultMode ? window.__bramFreeformResultMode($item) : 'scroll'}"
              breakMode="word"
              interpolateBindings="false" allowHtml="false"
              content="{window.__bramFormatToolResult($item.result, $item.name, $item.summary)}" />
            <Text
              when="{$item.result &amp;&amp; ($item.isError || !window.__bramFormatToolResult)}"
              fontFamily="$fontFamily-monospace"
              fontSize="$fontSize-xs"
              color="{$item.isError ? '$color-danger-600' : '$textColor-secondary'}"
              value="{$item.result}" />
            <!-- Agent dispatches: in-place peek at the subagent's own
                 transcript (host-tagged agentId via meta.json sidecar) -->
            <SubagentPeek
              when="{$item.agentId}"
              agentId="{$item.agentId}" />
          </VStack>
        </VStack>
      </VStack>
    </List>
    <!-- Explicit follow-bottom (replaces scrollAnchor="bottom" and its
         content-wrapper re-stick ResizeObserver, xmlui #3599). onScroll keeps
         atBottom in sync (fires only on user scrolls; programmatic scrolls are
         guarded), and we re-pin to the end on new content only while the user
         is parked there — so following never fights reading, and there's no
         RO-driven re-stick to loop or yank the viewport. -->
    <!-- transcript-find-in-page-v2 wiring. Match recompute + cursor reset +
         needle mirror are debounced together (200ms); the decorated-rows
         rebuild is keyed (needle, cursor, events length + revision) so the
         RO-flood fix holds — no per-render data identity churn. Stepping and
         fresh matches disarm follow (atBottom=false): a read-pause gesture,
         same anti-yank contract as scrolling up; re-arm stays the user's
         explicit scroll to bottom. The List switches from its normal `id`
         identity to each decorated row's `__findKey` while find is active.
         That key includes the needle and an active-occurrence suffix only on
         the active row, forcing virtua's mounted row to consume the changed
         $item without remounting the rest of the visible batch. Newly
         virtualized rows and the first batch follow the same path.
         https://docs.xmlui.org/components/List#idkey -->
    <ChangeListener
      listenTo="{transcriptFindClearEvt.value &amp;&amp; transcriptFindClearEvt.value.tick}"
      onDidChange="() => findText = ''" />
    <ChangeListener
      listenTo="{findText}"
      debounceWaitInMs="200"
      onDidChange="() => findCursor = 0" />
    <ChangeListener
      listenTo="{findText}"
      debounceWaitInMs="200"
      onDidChange="() => appliedNeedle = findText" />
    <!-- Occurrence-granular find plan: matches, per-event occurrence counts,
         total, and the active event/occurrence for the current cursor. The
         plan computes matches internally (no separate findMatches var), which
         removes the debounce race between the matcher and the plan. -->
    <ChangeListener
      listenTo="{appliedNeedle + '|' + findCursor + '|' + events.length + ':' + eventsVersion}"
      onDidChange="() => findPlan = window.__bramTranscriptFindPlan ? window.__bramTranscriptFindPlan(events, appliedNeedle, findCursor) : null" />
    <!-- Scroll only when the active EVENT changes (stepping between
         occurrences within one event keeps it in view). -->
    <ChangeListener
      listenTo="{(findPlan &amp;&amp; findPlan.total) ? findPlan.activeEventIndex : -1}"
      onDidChange="() => (findPlan &amp;&amp; findPlan.total) ? transcriptList.scrollToIndex(findPlan.activeEventIndex) : null" />
    <!-- Reveal the active mark within a tall event: scrollToIndex reaches the
         event TOP, and Markdown paints <mark data-active> but does not scroll it
         (__bramRevealActiveMark, shared with the migrated consumers). Fires on
         findPlan.cursor (post-recompute) so within-event steps land too. -->
    <ChangeListener
      listenTo="{(findPlan &amp;&amp; findPlan.total) ? findPlan.cursor : -1}"
      onDidChange="() => window.__bramRevealActiveMark()" />
    <!-- Every step disarms follow (read-pause), same anti-yank contract. -->
    <ChangeListener
      listenTo="{findCursor}"
      onDidChange="() => (findPlan &amp;&amp; findPlan.total) ? (atBottom = window.__bramFollowTransition(false, 'find-step', $props.agentId)) : null" />
    <ChangeListener
      listenTo="{events.length + ':' + eventsVersion}"
      onDidChange="() => { if (window.__bramFollowRepinOk(atBottom, $props.agentId)) { transcriptList.scrollToBottom(); settleArmed = true; window.__bramFollowVerify('content-append-repin', $props.agentId); window.__bramIframeTrace('transcript-repin', {events: events.length, agentId: $props.agentId || 'main'}); } }" />
    <!-- Settle re-assert: content keeps growing for a beat after the repin
         (async Markdown layout, eager tool descriptions splicing in), so one
         delayed re-scroll pins the true bottom once measurements settle.
         Guarded by atBottom, so a user who scrolled up is never yanked down.
         Same one-shot Timer pattern as subagent-switch-repin below (a
         delay()-suspended handler outliving a remount trips the engine's
         async-unmount lifecycle violation; the Timer disposes cleanly). -->
    <Timer
      interval="200"
      enabled="{settleArmed}"
      onTick="() => { settleArmed = false; if (window.__bramFollowRepinOk(atBottom, $props.agentId)) { transcriptList.scrollToBottom(); window.__bramFollowVerify('settle-repin', $props.agentId); window.__bramIframeTrace('transcript-settle-repin', {events: events.length, agentId: $props.agentId || 'main'}); } }" />
    <!-- Viewport switch (chip click: Main ↔ subagent) always lands at the
         bottom: re-arm follow mode so the async refetch's events swap
         re-pins via the listener above, and pin immediately for the
         already-cached data. The 400ms delayed second pin covers the
         virtualized List's late layout of variable-height rows — the
         suspected cause of unreliable landings; the subagent-switch /
         subagent-switch-repin / transcript-repin / transcript-follow
         traces in bram-trace.log make the next miss self-diagnosing.
         The re-pin rides an armed one-shot Timer, NOT delay(): a
         delay()-suspended handler outliving a remount trips the
         engine's async-unmount lifecycle violation (observed 9× in
         5 min of chip-switching, 2026-07-06); the Timer is
         component-owned and disposes cleanly. -->
    <!-- transcript-tab-return-bottom-pin: restore the pre-switch state on
         every mount. mountReturnState snapshots the window-side stash the
         previous mount wrote at cleanup (atBottom + visible range), BEFORE
         this mount's own range events overwrite it. Following: pin until
         confirmed - the List's scroll event is user-driven only, so landing
         is confirmed via the visible range reaching the last index
         (https://docs.xmlui.org/components/List#scroll), bounded at 8
         ticks. Reading: one scrollToIndex back to the stored first visible
         row (https://docs.xmlui.org/components/List#scrolltoindex), and
         follow stays off so arrivals never yank the reader. Armed in the
         var initializer, not onInit - f846258's onInit arming was
         clobberable by declaration order. -->
    <Timer
      interval="250"
      enabled="{mountPinArmed}"
      onTick="() => { mountPinTicks = mountPinTicks + 1; if (!mountFollow) { mountPinArmed = false; atBottom = window.__bramFollowTransition(false, 'mount-restore-reading', $props.agentId); if (mountReturnState &amp;&amp; mountReturnState.startIndex > 0) { transcriptList.scrollToIndex(mountReturnState.startIndex); } window.__bramIframeTrace('transcript-mount-restore', {index: (mountReturnState &amp;&amp; mountReturnState.startIndex) || 0, events: events.length}); } else if ((window.__bramVisibleRange &amp;&amp; window.__bramVisibleRange.endIndex >= events.length - 1) || mountPinTicks > 8) { mountPinArmed = false; window.__bramFollowVerify('mount-pin', $props.agentId); window.__bramIframeTrace('transcript-mount-pin', {landed: (window.__bramVisibleRange &amp;&amp; window.__bramVisibleRange.endIndex >= events.length - 1) || false, ticks: mountPinTicks, events: events.length}); } else { transcriptList.scrollToBottom(); } }" />
    <ChangeListener
      listenTo="{$props.agentId}"
      onDidChange="() => { atBottom = window.__bramFollowTransition(true, 'agent-chip-switch', $props.agentId); repinArmed = true; window.__bramIframeTrace('subagent-switch', {agentId: $props.agentId || 'main', events: events.length}); transcriptList.scrollToBottom(); }" />
    <Timer
      interval="400"
      enabled="{repinArmed}"
      onTick="() => { repinArmed = false; transcriptList.scrollToBottom(); window.__bramFollowVerify('subagent-switch-repin', $props.agentId); window.__bramIframeTrace('subagent-switch-repin', {agentId: $props.agentId || 'main', events: events.length}); }" />
  </VStack>
</Component>
