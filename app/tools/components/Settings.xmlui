<Component
  name="Settings"
  var.infoTitle="{''}"
  var.infoBody="{''}"
  var.highlightKey="{$queryParams.highlight || ''}">

  <APICall
    id="saveSettings"
    method="post"
    url="/__settings"
    body="{$param}" />

  <DataSource
    id="traceArchiveStatus"
    url="/__trace-archive-status" />

  <PushSource
    id="settingsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('settings-changed')}" />

  <VStack
    padding="$space-6"
    gap="$space-5"
    var.settingsValue="{settingsChangedEvt.value &amp;&amp; settingsChangedEvt.value.payload}">
    <!-- Each explicit-save group is a scoped Form. A successful POST installs
         its canonical response with reset(data); pushed snapshots reset only a
         pristine form, so they cannot overwrite a dirty draft.
         https://www.xmlui.org/docs/reference/components/Form#reset -->
    <!-- settings-highlight-deeplink: on inbound ?highlight=<key>, scroll the
         matching setting into view. Two triggers cover both arrivals: the
         pushed settings snapshot and re-targeting while already on the tab.
         The tint itself is reactive on highlightKey (the per-setting wrappers
         below); the helper retries across frames until the row is laid out. -->
    <ChangeListener
      listenTo="{settingsValue}"
      onDidChange="() => { if (highlightKey) window.__bramHighlightSetting(highlightKey); }" />
    <ChangeListener
      listenTo="{highlightKey}"
      onDidChange="() => { if (highlightKey) window.__bramHighlightSetting(highlightKey); }" />
    <Timer
      interval="500"
      enabled="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'pending'}"
      onTick="traceArchiveStatus.refetch()" />

    <!-- issue-231: tip arrivals carry from=tip; the back link returns to
         wherever the tip was clicked. Hidden on normal visits. -->
    <Link when="{$queryParams.from === 'tip'}" noIndicator
      tooltip="Back to where you were" onClick="navigate(-1)">
      <Text value="← Back" />
    </Link>
    <Heading level="h2">Settings</Heading>
    <Text
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="Mirrors .bram.json in the project root. Most changes save immediately; agent and retention changes require Save. All changes persist there." />

    <VStack when="{settingsValue}" gap="$space-5">
      <VStack gap="$space-4">
        <HStack
          width="fit-content"
          gap="$space-1"
          verticalAlignment="center"
          paddingHorizontal="$space-2"
          paddingVertical="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="$color-surface-100">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Agent"
            onClick="infoTitle = 'Agent'; infoBody = window.settingsInfoBodies.shell; settingInfoDialog.open()" />
          <Heading level="h3">Agent</Heading>
        </HStack>
        <Form
          id="agentSettingsForm"
          testId="settings-agent-form"
          data="{window.__bramSettingsFormData(settingsValue, 'shell')}"
          submitUrl="/__settings"
          submitMethod="post"
          cancelLabel=""
          saveLabel="Save agent changes"
          saveInProgressLabel="Saving…"
          hideButtonRowUntilDirty="{true}"
          marginRight-submitButton="auto"
          onWillSubmit="(data) => window.__bramSettingsSectionUpdate('shell', data)"
          onSuccess="(response) => window.__bramAdoptSettingsForm(agentSettingsForm, response, 'shell')">
          <RadioGroup
            id="agentBox"
            bindTo="agent"
            orientation="horizontal">
            <Option value="claude" label="Claude" />
            <Option value="codex" label="Codex" />
          </RadioGroup>
          <Select
            id="startupPolicyBox"
            bindTo="startupPolicy"
            label="On Bram launch"
            labelPosition="start"
            labelWidth="10rem"
            width="70%"
            data="{[
              { value: 'agentRecent', label: 'Resume selected agent’s most recent session' },
              { value: 'lastActive', label: 'Resume most-recently-active agent’s session' },
              { value: 'newSession', label: 'Start a new session' }
            ]}" />
          <Theme paddingLeft-summary-ExpandableItem="0">
            <ExpandableItem
              summary="Advanced"
              initiallyExpanded="{false}"
              contentWidth="50%">
              <VStack gap="$space-2">
                <TextBox
                  id="argsBox"
                  bindTo="args"
                  label="Launch arguments"
                  placeholder="{agentBox.value === 'claude' ? 'e.g. --model sonnet' : 'e.g. --sandbox workspace-write'}"
                  autoComplete="off"
                  autoCorrect="{false}"
                  spellCheck="{false}"
                  autoCapitalize="off" />
                <TextBox
                  id="firstCommandBox"
                  bindTo="firstCommand"
                  label="First command"
                  placeholder="{agentBox.value === 'claude' ? 'e.g. Summarize this project' : 'e.g. Review the current changes'}"
                  autoComplete="off"
                  autoCorrect="{false}"
                  spellCheck="{false}"
                  autoCapitalize="off" />
              </VStack>
            </ExpandableItem>
          </Theme>
        </Form>
        <ChangeListener
          listenTo="{settingsValue}"
          onDidChange="window.__bramSyncSettingsForm(settingsValue, agentSettingsForm, 'shell')" />
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-4">
        <HStack
          width="fit-content"
          gap="$space-1"
          verticalAlignment="center"
          paddingHorizontal="$space-2"
          paddingVertical="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="$color-surface-100">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Worklist"
            onClick="infoTitle = 'Worklist'; infoBody = window.settingsInfoBodies.batchCommitActions; settingInfoDialog.open()" />
          <Heading level="h3">Worklist</Heading>
        </HStack>
        <!-- Post-cutover (#267 A2): "Batch commit actions" switch removed —
             batch is selection in the Worklist gate, no setting gates it.
             The worklist.batchCommitActions config key still deserializes
             for compat; only the UI row is gone. The "One-click Approve &
             commit" switch followed in the 0.5.3 run: the offer is always
             available (retire-one-click-approve-commit-setting). -->
        <Switch
          id="mirrorIssuesSwitch"
          label="Mirror Worklist lifecycle to GitHub issues"
          initialValue="{!!(settingsValue &amp;&amp; settingsValue.mirrorWorklistLifecycleToIssue)}"
          onDidChange="(v) => saveSettings.execute({ mirrorWorklistLifecycleToIssue: v })" />
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-4">
        <HStack
          width="fit-content"
          gap="$space-1"
          verticalAlignment="center"
          paddingHorizontal="$space-2"
          paddingVertical="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="$color-surface-100">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About UI"
            onClick="infoTitle = 'UI'; infoBody = window.settingsInfoBodies.ui; settingInfoDialog.open()" />
          <Heading level="h3">UI</Heading>
        </HStack>
        <Switch
          id="targetAppSwitch"
          label="Show target app"
          initialValue="{settingsShowTargetApp(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ ui: { showTargetApp: v } })" />
        <Switch
          id="hotReloadSwitch"
          label="Agent-pane hot-reload"
          initialValue="{settingsToolsPaneHotReload(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ ui: { toolsPaneHotReload: v } })" />
        <!-- issue-231: per-user preferences, localStorage-backed (not project
             settings) — tips dismissal state is per-user too. The interval
             governs how long a dismissed tip stays hidden; the footer's
             dismiss tooltip echoes it. -->
        <Switch
          label="Show tips in the footer"
          initialValue="{window.__bramTipsEnabled ? window.__bramTipsEnabled() : true}"
          onDidChange="(v) => window.__bramSetTipsEnabled(v)" />
        <!-- turn-complete-beep: per-user (localStorage) audio cue; toggling
             on plays the beep once as confirmation. -->
        <Switch
          label="Soft beep on menus and turn completion"
          initialValue="{window.__bramBeepEnabled ? window.__bramBeepEnabled() : false}"
          onDidChange="(v) => window.__bramSetBeepEnabled(v)" />
        <VStack
          testId="setting-tipsDismissInterval"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'tipsDismissInterval' ? '$color-primary-100' : 'transparent'}">
          <Select
            label="Dismissed tips return after"
            width="14rem"
            initialValue="{window.__bramTipsDismissInterval ? window.__bramTipsDismissInterval() : '7d'}"
            onDidChange="(v) => window.__bramSetTipsDismissInterval(v)">
            <Option value="1m" label="1 minute" />
            <Option value="1d" label="1 day" />
            <Option value="7d" label="1 week" />
            <Option value="30d" label="1 month" />
            <Option value="forever" label="Never (dismiss forever)" />
          </Select>
        </VStack>
        <!-- search-badges-initial-state: per-user (localStorage). Whether the
             Search tab opens with all facet badges selected or none. -->
        <Switch
          label="Search badges start all on"
          initialValue="{window.__bramSearchBadgesInitialAllOn ? window.__bramSearchBadgesInitialAllOn() : true}"
          onDidChange="(v) => window.__bramSetSearchBadgesInitialAllOn(v)" />
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-4">
        <HStack
          width="fit-content"
          gap="$space-1"
          verticalAlignment="center"
          paddingHorizontal="$space-2"
          paddingVertical="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="$color-surface-100">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About AI"
            onClick="infoTitle = 'AI'; infoBody = window.settingsInfoBodies.ai; settingInfoDialog.open()" />
          <Heading level="h3">AI</Heading>
        </HStack>
        <VStack
          testId="setting-describeCommands"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'describeCommands' ? '$color-primary-100' : 'transparent'}">
          <Switch
            id="descriptionsSwitch"
            label="Tool Descriptions"
            initialValue="{settingsDescribeCommands(settingsValue)}"
            onDidChange="(v) => saveSettings.execute({ ai: { describeCommands: v } })" />
        </VStack>
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-4">
        <HStack
          width="fit-content"
          gap="$space-1"
          verticalAlignment="center"
          paddingHorizontal="$space-2"
          paddingVertical="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="$color-surface-100">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Traces"
            onClick="infoTitle = 'Traces'; infoBody = window.settingsInfoBodies.traces; settingInfoDialog.open()" />
          <Heading level="h3">Traces</Heading>
        </HStack>
        <Switch
          id="tracingSwitch"
          label="Tracing enabled"
          initialValue="{settingsTracingEnabled(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ traces: { enabled: v } })" />
        <Switch
          id="inspectorTapSwitch"
          label="Inspector trace tap"
          initialValue="{settingsInspectorTap(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ traces: { inspectorTap: v } })" />
        <Form
          id="archiveSettingsForm"
          testId="settings-archive-form"
          width="12rem"
          data="{window.__bramSettingsFormData(settingsValue, 'traces')}"
          submitUrl="/__settings"
          submitMethod="post"
          cancelLabel=""
          saveLabel="Save retention change"
          saveInProgressLabel="Saving…"
          hideButtonRowUntilDirty="{true}"
          marginRight-submitButton="auto"
          onWillSubmit="(data) => window.__bramSettingsSectionUpdate('traces', data)"
          onSuccess="(response) => window.__bramAdoptSettingsForm(archiveSettingsForm, response, 'traces')">
          <NumberBox
            id="archiveDaysBox"
            bindTo="archiveAfterDays"
            label="Keep raw traces for (days)"
            width="100%"
            integersOnly="{true}"
            minValue="{1}"
            maxValue="{3650}" />
        </Form>
        <ChangeListener
          listenTo="{settingsValue}"
          onDidChange="window.__bramSyncSettingsForm(settingsValue, archiveSettingsForm, 'traces')" />
        <Text
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="At startup, older raw archives are sanitized and compressed. Compressed history is retained indefinitely." />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'not-run'}"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Archival has not run in this host process." />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'pending'}"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Archival is running…" />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'completed'}"
          fontSize="$fontSize-xs"
          color="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.failures ? '$color-danger-700' : '$textColor-secondary'}"
          value="{'Last startup: ' + traceArchiveStatus.value.candidateFiles + ' candidate(s) older than ' + traceArchiveStatus.value.archiveAfterDays + ' days; ' + traceArchiveStatus.value.archivedFiles + ' archived, ' + traceArchiveStatus.value.failures + ' failed.'}" />
      </VStack>

      <ContentSeparator />

      <!-- search-depth-settings: per-project depth bounds for the search
           index (issue #250 follow-up). Values persist in .bram.json under
           `search`; the host clamps at read time and each indexing pass
           reads them fresh, so a change applies on the next pass. -->
      <VStack gap="$space-4">
        <HStack
          width="fit-content"
          gap="$space-1"
          verticalAlignment="center"
          paddingHorizontal="$space-2"
          paddingVertical="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="$color-surface-100">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Search"
            onClick="infoTitle = 'Search'; infoBody = window.settingsInfoBodies.search; settingInfoDialog.open()" />
          <Heading level="h3">Search</Heading>
        </HStack>
        <Form
          id="searchSettingsForm"
          testId="settings-search-form"
          width="12rem"
          data="{window.__bramSettingsFormData(settingsValue, 'search')}"
          submitUrl="/__settings"
          submitMethod="post"
          cancelLabel=""
          saveLabel="Save search limits"
          saveInProgressLabel="Saving…"
          hideButtonRowUntilDirty="{true}"
          marginRight-submitButton="auto"
          onWillSubmit="(data) => window.__bramSettingsSectionUpdate('search', data)"
          onSuccess="(response) => window.__bramAdoptSettingsForm(searchSettingsForm, response, 'search')">
          <NumberBox
            id="commitDepthBox"
            bindTo="commitDepth"
            label="Commit depth"
            width="100%"
            integersOnly="{true}"
            minValue="{100}"
            maxValue="{20000}" />
          <NumberBox
            id="issueLimitBox"
            bindTo="issueLimit"
            label="Issue limit"
            width="100%"
            integersOnly="{true}"
            minValue="{50}"
            maxValue="{2000}" />
        </Form>
        <ChangeListener
          listenTo="{settingsValue}"
          onDidChange="window.__bramSyncSettingsForm(settingsValue, searchSettingsForm, 'search')" />
        <Text
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Changes apply on the next indexing pass. Deeper commit indexing lengthens the next cold rebuild." />
      </VStack>

    </VStack>

    <Text
      when="{!settingsValue}"
      color="$textColor-secondary"
      fontSize="$fontSize-sm"
      value="Loading settings…" />

    <ModalDialog id="settingInfoDialog" title="{infoTitle}">
      <!-- Markdown line-spacing is tuned app-wide in themes/bram.json
           (marginTop/Bottom-H2-markdown, marginTop/Bottom-Text-markdown).
           paddingTop 0 keeps the first ## header from stacking the modal
           title gap on top of the header's own top margin. -->
      <VStack gap="$space-3" padding="$space-2" paddingTop="0">
        <Markdown content="{infoBody}" />
        <HStack>
          <Button label="Got it" onClick="settingInfoDialog.close()" />
        </HStack>
      </VStack>
    </ModalDialog>

  </VStack>
</Component>
