<Component name="IssueDetail">
  <!-- issue-230 shared detail: full issue (body + comments), external forge link
       pinned at the top. Props: number, refreshTick, height, query (optional
       initial/current find term).
       findable-list-udc: the occurrence-granular find spine lives in
       FindableList. IssueDetail is flattened from its nested (single row + nested
       comment Items) shape into a flat typed-row array — a body row (block 0,
       header baked in) then one comment row per comment (blocks 1+N). The body
       text is each row's marked surface (__bramIssueMarkedText). See
       xmlui-org/xmlui#3713. -->
  <DataSource id="issue" url="/__issue"
    queryParams="{{ number: $props.number, _r: $props.refreshTick }}" when="{!!$props.number}" />
  <VStack gap="$space-2" padding="$space-2">

    <!-- Loading indicator is a component-scope sibling: the List row is a
         frozen scope that never sees the DataSource land after mount (first
         click stuck "Loading…", second click instant on cache), so gate the
         FindableList on issue.value the way SessionDetail gates on turns.value. -->
    <Text when="{issue.inProgress &amp;&amp; !issue.loaded}" color="$textColor-secondary" value="Loading…" />

    <!-- Mounts only once issue.value is present; the flat rows (header baked
         into the body row) are built here in IssueDetail's scope, not inside a
         frozen row template. Search state is decorated onto each $item by
         FindableList and read back through the rowTemplate slot. -->
    <FindableList when="{issue.value}"
      data="{window.__bramIssueBlockRows(issue.value)}"
      markedText="__bramIssueMarkedText"
      query="{$props.query || ''}"
      placeholder="Find in issue…"
      height="{$props.height || '400px'}">
      <property name="rowTemplate">
        <VStack when="{$item.kind === 'body'}" gap="$space-3">
          <Link when="{$item.url}" noIndicator onClick="openExternal($item.url)">
            <Text fontWeight="$fontWeight-bold"
              value="{'Open issue #' + $item.number + ' on ' + (($item.url || '').includes('gitlab') ? 'GitLab' : 'GitHub') + ' ↗'}" />
          </Link>
          <Text fontSize="$fontSize-sm"
            color="{$item.state === 'OPEN' ? '$color-success-700' : '$textColor-secondary'}"
            value="{($item.state === 'OPEN' ? 'open' : 'closed') + ' · #' + $item.number + ' ' + $item.title}" />
          <Text when="{$item.author}" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="{(($item.author.login || $item.author.name) || 'unknown') + ' opened ' + getDateUntilNow($item.createdAt) + ' ago'}" />
          <Markdown when="{$item.body}" interpolateBindings="false" allowHtml="false" content="{$item.body}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
        </VStack>
        <VStack when="{$item.kind === 'comment'}" gap="$space-1" paddingTop="$space-2" borderTop="1px solid $borderColor">
          <Text fontSize="$fontSize-xs" color="$textColor-secondary"
            value="{(($item.author &amp;&amp; ($item.author.login || $item.author.name)) || 'unknown')}" />
          <Markdown interpolateBindings="false" allowHtml="false" content="{$item.body}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
        </VStack>
      </property>
    </FindableList>
  </VStack>
</Component>
