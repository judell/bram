<Component
  name="Settings"
  var.infoTitle="{''}"
  var.infoBody="{''}"
  var.highlightKey="{$queryParams.highlight || ''}">

  <APICall
    id="saveSettings"
    method="post"
    url="/__settings"
    body="{$param}"
    onBeforeRequest="window.__bramApiTiming('saveSettings', 'before')"
    onSuccess="window.__bramApiTiming('saveSettings', 'success')"
    onError="window.__bramApiTiming('saveSettings', 'error')" />

  <DataSource
    id="traceArchiveStatus"
    url="/__trace-archive-status" />

  <PushSource
    id="settingsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('settings-changed')}" />

  <VStack
    padding="$space-6"
    gap="$space-5"
    var.settingsValue="{settingsChangedEvt.value &amp;&amp; settingsChangedEvt.value.payload}">
    <!-- Each explicit-save group is a scoped Form. A successful POST installs
         its canonical response with reset(data); pushed snapshots reset only a
         pristine form, so they cannot overwrite a dirty draft.
         https://www.xmlui.org/docs/reference/components/Form#reset -->
    <!-- settings-highlight-deeplink: on inbound ?highlight=<key>, scroll the
         matching setting into view. Two triggers cover both arrivals: the
         pushed settings snapshot and re-targeting while already on the tab.
         The tint itself is reactive on highlightKey (the per-setting wrappers
         below); the helper retries across frames until the row is laid out. -->
    <ChangeListener
      listenTo="{settingsValue}"
      onDidChange="() => { if (highlightKey) window.__bramHighlightSetting(highlightKey); }" />
    <ChangeListener
      listenTo="{highlightKey}"
      onDidChange="() => { if (highlightKey) window.__bramHighlightSetting(highlightKey); }" />
    <!-- companion-app-settings: sections start collapsed (Bram Studio's
         Settings pattern, beb5a44), so a deep link opens its section, on
         arrival via initiallyExpanded and when re-targeted here via expand()
         (https://www.xmlui.org/docs/reference/components/ExpandableItem). -->
    <ChangeListener
      listenTo="{highlightKey}"
      onDidChange="(change) => window.__bramSettingsOpenGroup(change.newValue, settingsGroupWorklist, settingsGroupUi, settingsGroupAi)" />
    <Timer
      interval="500"
      enabled="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'pending'}"
      onTick="traceArchiveStatus.refetch()" />

    <!-- issue-231: tip arrivals carry from=tip; the back link returns to
         wherever the tip was clicked. Hidden on normal visits. -->
    <Link when="{$queryParams.from === 'tip'}" noIndicator
      tooltip="Back to where you were" onClick="navigate(-1)">
      <Text value="← Back" />
    </Link>
    <!-- The page's blurb sits behind an info button, like each setting's
         (companion-app-settings, Jon 2026-11-17). -->
    <HStack verticalAlignment="center" gap="$space-1">
      <Button icon="info" size="xs" variant="ghost" tooltip="About Settings"
        onClick="infoTitle = 'Settings'; infoBody = window.settingsInfoBodies.page; settingInfoDialog.open()" />
      <Heading level="h2">Settings</Heading>
    </HStack>

    <VStack when="{settingsValue}" gap="$space-5">
      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupAgent" initiallyExpanded="{false}" iconPosition="start" summary="Agent · which agent, and how it starts">
      <VStack gap="$space-4">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About Agent"
            tooltip="About Agent"
            onClick="infoTitle = 'Agent'; infoBody = window.settingsInfoBodies.shell; settingInfoDialog.open()" />
        </HStack>
        <Form
          id="agentSettingsForm"
          automationId="settings-agent-form"
          data="{window.__bramSettingsFormData(settingsValue, 'shell')}"
          submitUrl="/__settings"
          submitMethod="post"
          cancelLabel=""
          saveLabel="Save agent changes"
          saveInProgressLabel="Saving…"
          hideButtonRowUntilDirty="{true}"
          marginRight-submitButton="auto"
          onWillSubmit="(data) => window.__bramSettingsSectionUpdate('shell', data)"
          onSuccess="(response) => window.__bramAdoptSettingsForm(agentSettingsForm, response, 'shell')">
          <RadioGroup
            id="agentBox"
            bindTo="agent"
            orientation="horizontal">
            <Option value="claude" label="Claude" />
            <Option value="codex" label="Codex" />
            <Option value="opencode" label="OpenCode" />
            <Option value="antigravity" label="Antigravity" />
          </RadioGroup>
          <Select
            id="startupPolicyBox"
            bindTo="startupPolicy"
            label="On Bram launch"
            labelPosition="start"
            labelWidth="10rem"
            width="100%"
            data="{[
              { value: 'agentRecent', label: 'Resume selected agent’s most recent session' },
              { value: 'lastActive', label: 'Resume most-recently-active agent’s session' },
              { value: 'newSession', label: 'Start a new session' },
              { value: 'none', label: 'Do not start an agent (manage the terminal yourself)' }
            ]}">
            <!-- Long labels wrap flush-left instead of centered: the same
                 valueTemplate + width-bound Text as the Worklist's issue
                 Select (dd155b7; Select#valuetemplate). -->
            <property name="valueTemplate">
              <Text width="100%" textAlign="start" value="{$item.label}" />
            </property>
          </Select>
          <!-- issue-389: under "none" the agent choice above no longer
               picks what Bram launches — it tells Bram which agent YOU run in
               the terminal (herdr etc.), so turn-end detection reads the right
               transcripts. -->
          <Text
            when="{startupPolicyBox.value === 'none'}"
            variant="caption"
            value="With this setting, the agent choice above tells Bram which agent you are running in the terminal. Bram will not launch it." />
          <Theme paddingLeft-summary-ExpandableItem="0">
            <ExpandableItem
              summary="Advanced"
              initiallyExpanded="{false}"
              contentWidth="50%">
              <VStack gap="$space-2">
                <TextBox
                  id="argsBox"
                  bindTo="args"
                  label="Launch arguments"
                  placeholder="{agentBox.value === 'claude' ? 'e.g. --model sonnet' : 'e.g. --sandbox workspace-write'}"
                  autoComplete="off"
                  autoCorrect="{false}"
                  spellCheck="{false}"
                  autoCapitalize="off" />
                <TextBox
                  id="firstCommandBox"
                  bindTo="firstCommand"
                  label="First command"
                  placeholder="{agentBox.value === 'claude' ? 'e.g. Summarize this project' : 'e.g. Review the current changes'}"
                  autoComplete="off"
                  autoCorrect="{false}"
                  spellCheck="{false}"
                  autoCapitalize="off" />
              </VStack>
            </ExpandableItem>
          </Theme>
        </Form>
        <ChangeListener
          listenTo="{settingsValue}"
          onDidChange="window.__bramSyncSettingsForm(settingsValue, agentSettingsForm, 'shell')" />
      </VStack>
        </ExpandableItem>
      </Theme>


      <!-- companion-app-settings: the app this repo is (Bram Studio,
           bram-processing-ide) or carries (Bram's own site preview). The keys
           split by audience (Jon, 2026-11-17): what the app's makers author
           for every clone is shown with where it came from, and changed by
           proposing a Worklist item (Bram never writes the tracked
           .bram.json); what the person at this computer prefers saves to
           .bram/settings.json over the repo's default. GET /__companion-app
           attributes each value; it refetches on the settings-changed push
           this page already holds. The run switch keeps the launch-run route
           and its consent rule (launch-run-setting). -->
      <DataSource id="companionApp" url="/__companion-app" />
      <ChangeListener listenTo="{settingsChangedEvt.value &amp;&amp; settingsChangedEvt.value.tick}"
        onDidChange="window.__bramRefetchOnLiveEvent(settingsChangedEvt.value, companionApp)" />
      <DataSource id="launchRunSettings" url="/__launch-run" />
      <PushSource id="launchRunSettingsEvt" initial="{null}"
        subscribe="{window.bramSubscribeTauriEvent('launch-run-changed')}" />
      <ChangeListener listenTo="{launchRunSettingsEvt.value &amp;&amp; launchRunSettingsEvt.value.tick}"
        onDidChange="window.__bramRefetchOnLiveEvent(launchRunSettingsEvt.value, launchRunSettings)" />
      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupCompanion" initiallyExpanded="{false}" iconPosition="start" summary="Companion App · the app that comes with this repo">
      <VStack gap="$space-3">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About Companion App"
            tooltip="About Companion App"
            onClick="infoTitle = 'Companion App'; infoBody = window.settingsInfoBodies.companionApp; settingInfoDialog.open()" />
        </HStack>
        <!-- companion-app-settings: each row is "Title: value (source)" with
             an info button to its left (Jon, 2026-11-17); the long
             explanation opens in the Settings info dialog. Addresses come
             from /__app-info. -->
        <DataSource id="companionAppInfo" url="/__app-info" />
        <VStack when="{companionApp.loaded &amp;&amp; launchRunSettings.loaded}" gap="$space-2">
          <Text fontSize="$fontSize-sm" value="{window.__bramCompanionText(companionApp.value, 'intro', companionAppInfo.value)}" />
          <HStack verticalAlignment="center" gap="$space-1">
            <Button icon="info" size="xs" variant="ghost" tooltip="About From the repo"
              onClick="infoTitle = 'From the repo'; infoBody = window.__bramCompanionText(companionApp.value, 'fromRepoInfo'); settingInfoDialog.open()" />
            <Text fontWeight="$fontWeight-bold" value="From the repo" />
          </HStack>
          <!-- Rows sit indented under their group heading (Jon, 2026-11-17). -->
          <VStack paddingLeft="$space-6" gap="$space-2">
          <Items data="{window.__bramCompanionAuthored(companionApp.value)}">
            <HStack verticalAlignment="center" gap="$space-1">
              <Button icon="info" size="xs" variant="ghost" tooltip="{'About ' + $item.title}"
                onClick="infoTitle = $item.title; infoBody = $item.info; settingInfoDialog.open()" />
              <Text fontSize="$fontSize-sm" value="{$item.line}" />
            </HStack>
          </Items>
          <HStack verticalAlignment="center" gap="$space-1">
            <Button icon="info" size="xs" variant="ghost" tooltip="About Propose a change"
              onClick="infoTitle = 'Propose a change'; infoBody = window.__bramCompanionText(companionApp.value, 'fromRepoInfo'); settingInfoDialog.open()" />
            <Button label="Propose a change…" size="sm" variant="outlined" onClick="window.__bramCompanionPropose()" />
          </HStack>
          </VStack>
          <HStack verticalAlignment="center" gap="$space-1" marginTop="$space-2">
            <Button icon="info" size="xs" variant="ghost" tooltip="About For this computer"
              onClick="infoTitle = 'For this computer'; infoBody = window.__bramCompanionText(companionApp.value, 'thisComputerInfo'); settingInfoDialog.open()" />
            <Text fontWeight="$fontWeight-bold" value="For this computer" />
          </HStack>
          <VStack paddingLeft="$space-6" gap="$space-2">
          <HStack verticalAlignment="center" gap="$space-1" wrapContent="true">
            <Button icon="info" size="xs" variant="ghost" tooltip="About Run the launch command"
              onClick="infoTitle = 'Run the launch command'; infoBody = window.__bramCompanionText(companionApp.value, 'runInfo', launchRunSettings.value); settingInfoDialog.open()" />
            <Switch
              id="launchRunSwitch"
              label="Run the launch command"
              labelPosition="end"
              enabled="{!!window.__bramLaunchRunText(launchRunSettings.value, 'command')}"
              initialValue="{window.__bramLaunchRunText(launchRunSettings.value, 'on')}"
              onDidChange="(v) => window.__bramLaunchRunSwitch(v, launchRunSettings.value)" />
            <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCompanionText(companionApp.value, 'runTag', launchRunSettings.value)}" />
          </HStack>
          <!-- The handler gets {prevValue, newValue}, not the value
               (https://www.xmlui.org/docs/reference/components/ChangeListener).
               Passing the object made setValue turn the switch on, and that
               fired didChange, so the switch wouldn't stay off. -->
          <ChangeListener
            listenTo="{window.__bramLaunchRunText(launchRunSettings.value, 'on')}"
            onDidChange="(change) => launchRunSwitch.setValue(change.newValue)" />
          <HStack verticalAlignment="center" gap="$space-1" wrapContent="true">
            <Button icon="info" size="xs" variant="ghost" tooltip="About Start Bram minimized"
              onClick="infoTitle = 'Start Bram minimized'; infoBody = window.__bramCompanionText(companionApp.value, 'minimizedInfo'); settingInfoDialog.open()" />
            <Switch
              label="Start Bram minimized"
              labelPosition="end"
              initialValue="{companionApp.value.minimized.value}"
              onDidChange="(v) => saveSettings.execute({ launch: { minimized: v } })" />
            <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCompanionText(companionApp.value, 'minimizedTag')}" />
          </HStack>
          <HStack verticalAlignment="center" gap="$space-1" wrapContent="true">
            <Button icon="info" size="xs" variant="ghost" tooltip="About Show the app inside Bram"
              onClick="infoTitle = 'Show the app inside Bram'; infoBody = window.__bramCompanionText(companionApp.value, 'showAppInfo', companionAppInfo.value); settingInfoDialog.open()" />
            <!-- targetAppSwitch moved here from UI (companion-app-settings). -->
            <Switch
              id="targetAppSwitch"
              label="Show the app inside Bram"
              labelPosition="end"
              initialValue="{settingsShowTargetApp(settingsValue)}"
              onDidChange="(v) => saveSettings.execute({ ui: { showTargetApp: v } })" />
            <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCompanionText(companionApp.value, 'showAppTag')}" />
          </HStack>
          <!-- launch.openApp: false, true (home page), or a path. Typed:
               Bram can't list a web app's pages. -->
          <HStack verticalAlignment="center" gap="$space-1" wrapContent="true">
            <Button icon="info" size="xs" variant="ghost" tooltip="About Open the app at launch"
              onClick="infoTitle = 'Open the app at launch'; infoBody = window.__bramCompanionText(companionApp.value, 'openAppInfo', companionAppInfo.value); settingInfoDialog.open()" />
            <Text fontSize="$fontSize-sm" value="Open the app at launch" />
            <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCompanionText(companionApp.value, 'openAppTag')}" />
          </HStack>
          <RadioGroup
            id="openAppMode"
            paddingLeft="$space-6"
            initialValue="{window.__bramCompanionText(companionApp.value, 'openMode')}"
            onDidChange="(v) => saveSettings.execute({ launch: { openApp: window.__bramOpenAppValue(v, openAppPage.value) } })">
            <Option value="off" label="Off" />
            <Option value="home" label="{window.__bramCompanionText(companionApp.value, 'homeLabel', companionAppInfo.value)}" />
            <Option value="page" label="A specific page" />
          </RadioGroup>
          <HStack when="{openAppMode.value === 'page'}" paddingLeft="$space-6" verticalAlignment="center" gap="$space-2" wrapContent="true">
            <TextBox
              id="openAppPage"
              width="16rem"
              placeholder="/architecture"
              initialValue="{window.__bramCompanionText(companionApp.value, 'openPage')}" />
            <Button
              label="Save"
              size="sm"
              enabled="{openAppPage.value !== window.__bramCompanionText(companionApp.value, 'openPage')}"
              onClick="saveSettings.execute({ launch: { openApp: window.__bramOpenAppValue('page', openAppPage.value) } })" />
            <Text fontSize="$fontSize-sm" color="$textColor-secondary"
              value="{window.__bramCompanionPageUrl(companionAppInfo.value, openAppPage.value)}" />
          </HStack>
          <!-- launch.placement: false (off), "left" or "right". Bram fills that
               half of its screen when it opens the app in the browser. -->
          <HStack verticalAlignment="center" gap="$space-1" wrapContent="true">
            <Button icon="info" size="xs" variant="ghost" tooltip="About Make room for the app's window"
              onClick="infoTitle = 'Make room for the app window'; infoBody = window.__bramCompanionText(companionApp.value, 'placementInfo'); settingInfoDialog.open()" />
            <Text fontSize="$fontSize-sm" value="Make room for the app's window" />
            <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramCompanionText(companionApp.value, 'placementTag')}" />
          </HStack>
          <RadioGroup
            id="placementMode"
            paddingLeft="$space-6"
            enabled="{openAppMode.value !== 'off'}"
            initialValue="{window.__bramCompanionText(companionApp.value, 'placementMode')}"
            onDidChange="(v) => saveSettings.execute(window.__bramPlacementSetting(v))">
            <Option value="off" label="Off" />
            <Option value="left" label="Bram on the left" />
            <Option value="right" label="Bram on the right" />
          </RadioGroup>
          <Text when="{openAppMode.value === 'off'}" paddingLeft="$space-6" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="Turn on Open the app at launch first." />
          </VStack>
        </VStack>
      </VStack>
        </ExpandableItem>
      </Theme>


      <!-- suggest-fresh-session: the host serves sessions.{suggestOnNewItem,
           suggestOnNewIssue,suggestOnTopicShift} from GET /__settings. Same
           save-on-change shape as the hot-reload switch below; the read goes
           through window.__bramSuggestSetting so the defaults (true/true/false)
           live in one place. https://www.xmlui.org/docs/reference/components/Checkbox -->
      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupSessions" initiallyExpanded="{false}" iconPosition="start" summary="Suggest a fresh session · when the agent offers one">
      <VStack gap="$space-2">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About Suggest a fresh session"
            tooltip="About Suggest a fresh session"
            onClick="infoTitle = 'Suggest a fresh session'; infoBody = window.settingsInfoBodies.sessions; settingInfoDialog.open()" />
        </HStack>
        <!-- settings-info-says-storage-and-default: the same heading-with-info
             chip as the other cards, so this card's settings say their kind
             and default too. -->
        <Text
          color="$textColor-secondary"
          fontSize="$fontSize-sm"
          value="The agent can offer to continue new work in a fresh session. It always asks first." />
        <Checkbox
          label="When the agent is about to propose a new worklist item"
          labelPosition="end"
          initialValue="{window.__bramSuggestSetting(settingsValue, 'suggestOnNewItem')}"
          onDidChange="(v) => saveSettings.execute({ sessions: { suggestOnNewItem: v } })" />
        <Checkbox
          label="When the agent is about to file a new issue"
          labelPosition="end"
          initialValue="{window.__bramSuggestSetting(settingsValue, 'suggestOnNewIssue')}"
          onDidChange="(v) => saveSettings.execute({ sessions: { suggestOnNewIssue: v } })" />
        <Checkbox
          label="When the conversation shifts to a significantly different topic"
          labelPosition="end"
          initialValue="{window.__bramSuggestSetting(settingsValue, 'suggestOnTopicShift')}"
          onDidChange="(v) => saveSettings.execute({ sessions: { suggestOnTopicShift: v } })" />
        <!-- session-context-pane: thousands in the box, tokens on disk; the
             conversions live in helpers.js. NumberBox label/initialValue/
             integersOnly/minValue: https://www.xmlui.org/docs/reference/components/NumberBox -->
        <NumberBox
          label="Ask at the next natural pause once the context passes (thousands of tokens; 0 = never)"
          labelPosition="end"
          integersOnly="{true}"
          minValue="{0}"
          initialValue="{window.__bramSuggestContextSetting(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ sessions: { suggestAtContextTokens: window.__bramSuggestContextTokens(v) } })" />
        <!-- provider-session-pair-offer: a Switch, not a fourth checkbox,
             because it isn't a "when to suggest" trigger: it turns the pair
             offer after a provider switch on or off. Default on, read through
             __bramSuggestSetting like its neighbours. label/labelPosition as
             on the Mirror switch below: input-level label props, per
             https://www.xmlui.org/docs/howto/arrange-form-fields-side-by-side
             https://www.xmlui.org/docs/reference/components/Switch -->
        <Switch
          label="Pair new sessions across providers"
          labelPosition="end"
          initialValue="{window.__bramSuggestSetting(settingsValue, 'pairAcrossProviders')}"
          onDidChange="(v) => saveSettings.execute({ sessions: { pairAcrossProviders: v } })" />
      </VStack>
        </ExpandableItem>
      </Theme>


      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupWorklist" initiallyExpanded="{highlightKey === 'worklistEnforcement'}" iconPosition="start" summary="Worklist · issue comments, enforcement">
      <VStack gap="$space-4">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About Worklist"
            tooltip="About Worklist"
            onClick="infoTitle = 'Worklist'; infoBody = window.settingsInfoBodies.batchCommitActions; settingInfoDialog.open()" />
        </HStack>
        <!-- Post-cutover (#267 A2): "Batch commit actions" switch removed —
             batch is selection in the Worklist gate, no setting gates it.
             The worklist.batchCommitActions config key still deserializes
             for compat; only the UI row is gone. The "One-click Approve &
             commit" switch followed in the 0.5.3 run: the offer is always
             available (retire-one-click-approve-commit-setting). -->
        <Switch
          id="mirrorIssuesSwitch"
          label="Mirror Worklist lifecycle to GitHub issues"
          labelPosition="end"
          initialValue="{!!(settingsValue &amp;&amp; settingsValue.mirrorWorklistLifecycleToIssue)}"
          onDidChange="(v) => saveSettings.execute({ mirrorWorklistLifecycleToIssue: v })" />
        <!-- issue-466-pause-install-uninstall (v1): worklist.enforcement,
             Claude only. Same Switch pattern as the mirror switch above;
             the info note is in settingsInfoBodies.batchCommitActions.
             https://www.xmlui.org/docs/reference/components/Switch -->
        <!-- The header's "Enforcement paused" link lands here via
             ?highlight=worklistEnforcement (settings-highlight-deeplink). -->
        <VStack
          automationId="setting-worklistEnforcement"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'worklistEnforcement' ? '$color-primary-100' : 'transparent'}">
          <Switch
            id="pauseEnforcementSwitch"
            label="Pause Worklist enforcement for Claude (advanced)"
            labelPosition="end"
            initialValue="{window.__bramEnforcementPaused(settingsValue)}"
            onDidChange="(v) => saveSettings.execute(window.__bramEnforcementUpdate(v))" />
        </VStack>
      </VStack>
        </ExpandableItem>
      </Theme>


      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupUi" initiallyExpanded="{highlightKey === 'tipsDismissInterval'}" iconPosition="start" summary="UI · terminal, reloads, tips, sounds">
      <VStack gap="$space-4">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About UI"
            tooltip="About UI"
            onClick="infoTitle = 'UI'; infoBody = window.settingsInfoBodies.ui; settingInfoDialog.open()" />
        </HStack>
        <!-- terminal-open-at-startup-setting: per-user preference,
             localStorage-backed like the tips and beep switches below. The
             parent shell reads it at launch; the toolbar toggle is
             session-only. -->
        <Switch
          label="Terminal open at startup"
          labelPosition="end"
          initialValue="{window.__bramTerminalOpenAtStartup ? window.__bramTerminalOpenAtStartup() : false}"
          onDidChange="(v) => window.__bramSetTerminalOpenAtStartup(v)" />
        <Switch
          id="hotReloadSwitch"
          label="Agent-pane hot-reload"
          labelPosition="end"
          initialValue="{settingsToolsPaneHotReload(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ ui: { toolsPaneHotReload: v } })" />
        <!-- review-overlaps-optional-setting: per-user (localStorage), default
             off. Hides the Worklist header's overlap line, Review overlaps
             button and disclosure; the commit gate's checks are unaffected. -->
        <Switch
          label="Show files several items touch"
          labelPosition="end"
          initialValue="{window.__bramReviewOverlapsEnabled ? window.__bramReviewOverlapsEnabled() : false}"
          onDidChange="(v) => window.__bramSetReviewOverlapsEnabled(v)" />
        <!-- pane-idle-flush-when-degraded: default-on workaround for an unexplained
             pane slowdown (judell/bram#482 for the underlying leak). -->
        <Switch
          label="Reload a slowed pane when idle"
          labelPosition="end"
          initialValue="{!(settingsValue &amp;&amp; settingsValue.ui &amp;&amp; settingsValue.ui.paneIdleFlush === false)}"
          onDidChange="(v) => saveSettings.execute({ ui: { paneIdleFlush: v } })" />
        <!-- issue-231: per-user preferences, localStorage-backed (not project
             settings) — tips dismissal state is per-user too. The interval
             governs how long a dismissed tip stays hidden; the footer's
             dismiss tooltip echoes it. -->
        <Switch
          label="Show tips in the footer"
          labelPosition="end"
          initialValue="{window.__bramTipsEnabled ? window.__bramTipsEnabled() : true}"
          onDidChange="(v) => window.__bramSetTipsEnabled(v)" />
        <!-- turn-complete-beep: per-user (localStorage) audio cue; toggling
             on plays the beep once as confirmation. -->
        <Switch
          label="Soft beep on menus and turn completion"
          labelPosition="end"
          initialValue="{window.__bramBeepEnabled ? window.__bramBeepEnabled() : false}"
          onDidChange="(v) => window.__bramSetBeepEnabled(v)" />
        <VStack
          automationId="setting-tipsDismissInterval"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'tipsDismissInterval' ? '$color-primary-100' : 'transparent'}">
          <Select
            label="Dismissed tips return after"
            width="14rem"
            initialValue="{window.__bramTipsDismissInterval ? window.__bramTipsDismissInterval() : '7d'}"
            onDidChange="(v) => window.__bramSetTipsDismissInterval(v)">
            <Option value="1m" label="1 minute" />
            <Option value="1d" label="1 day" />
            <Option value="7d" label="1 week" />
            <Option value="30d" label="1 month" />
            <Option value="forever" label="Never (dismiss forever)" />
          </Select>
        </VStack>
        <!-- search-badges-initial-state: per-user (localStorage). Whether the
             Search tab opens with all facet badges selected or none. -->
        <Switch
          label="Search badges start all on"
          labelPosition="end"
          initialValue="{window.__bramSearchBadgesInitialAllOn ? window.__bramSearchBadgesInitialAllOn() : true}"
          onDidChange="(v) => window.__bramSetSearchBadgesInitialAllOn(v)" />
        <!-- issue-470-compaction-summary-collapsed: per-user (localStorage,
             bram.compactSummaryExpanded). Off: the Transcript shows Claude
             Code's compaction summary as one line with a Show toggle; on:
             those rows start expanded. Same shape as the switches above.
             https://www.xmlui.org/docs/reference/components/Switch -->
        <Switch
          label="Show compaction summaries in full"
          labelPosition="end"
          initialValue="{window.__bramCompactSummaryExpanded ? window.__bramCompactSummaryExpanded() : false}"
          onDidChange="(v) => window.__bramSetCompactSummaryExpanded(v)" />
      </VStack>
        </ExpandableItem>
      </Theme>


      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupAi" initiallyExpanded="{highlightKey === 'describeCommands'}" iconPosition="start" summary="AI · describing what commands do">
      <VStack gap="$space-4">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About AI"
            tooltip="About AI"
            onClick="infoTitle = 'AI'; infoBody = window.settingsInfoBodies.ai; settingInfoDialog.open()" />
        </HStack>
        <VStack
          automationId="setting-describeCommands"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'describeCommands' ? '$color-primary-100' : 'transparent'}">
          <Switch
            id="descriptionsSwitch"
            label="Tool Descriptions"
            labelPosition="end"
            initialValue="{settingsDescribeCommands(settingsValue)}"
            onDidChange="(v) => saveSettings.execute({ ai: { describeCommands: v } })" />
        </VStack>
      </VStack>
        </ExpandableItem>
      </Theme>


      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupTraces" initiallyExpanded="{false}" iconPosition="start" summary="Traces · logging and retention">
      <VStack gap="$space-4">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About Traces"
            tooltip="About Traces"
            onClick="infoTitle = 'Traces'; infoBody = window.settingsInfoBodies.traces; settingInfoDialog.open()" />
        </HStack>
        <Switch
          id="tracingSwitch"
          label="Tracing enabled"
          labelPosition="end"
          initialValue="{settingsTracingEnabled(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ traces: { enabled: v } })" />
        <Switch
          id="inspectorTapSwitch"
          label="Inspector trace tap"
          labelPosition="end"
          initialValue="{settingsInspectorTap(settingsValue)}"
          onDidChange="(v) => saveSettings.execute({ traces: { inspectorTap: v } })" />
        <Form
          id="archiveSettingsForm"
          automationId="settings-archive-form"
          width="12rem"
          data="{window.__bramSettingsFormData(settingsValue, 'traces')}"
          submitUrl="/__settings"
          submitMethod="post"
          cancelLabel=""
          saveLabel="Save retention change"
          saveInProgressLabel="Saving…"
          hideButtonRowUntilDirty="{true}"
          marginRight-submitButton="auto"
          onWillSubmit="(data) => window.__bramSettingsSectionUpdate('traces', data)"
          onSuccess="(response) => window.__bramAdoptSettingsForm(archiveSettingsForm, response, 'traces')">
          <NumberBox
            id="archiveDaysBox"
            bindTo="archiveAfterDays"
            label="Keep raw traces for (days)"
            width="100%"
            integersOnly="{true}"
            minValue="{1}"
            maxValue="{3650}" />
        </Form>
        <ChangeListener
          listenTo="{settingsValue}"
          onDidChange="window.__bramSyncSettingsForm(settingsValue, archiveSettingsForm, 'traces')" />
        <Text
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="At startup, older raw archives are sanitized and compressed. Compressed history is retained indefinitely." />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'not-run'}"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Archival has not run in this host process." />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'pending'}"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Archival is running…" />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'completed'}"
          fontSize="$fontSize-xs"
          color="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.failures ? '$color-danger-700' : '$textColor-secondary'}"
          value="{'Last startup: ' + traceArchiveStatus.value.candidateFiles + ' candidate(s) older than ' + traceArchiveStatus.value.archiveAfterDays + ' days; ' + traceArchiveStatus.value.archivedFiles + ' archived, ' + traceArchiveStatus.value.failures + ' failed.'}" />
      </VStack>
        </ExpandableItem>
      </Theme>


      <!-- search-depth-settings: per-project depth bounds for the search
           index (issue #250 follow-up). Values persist in .bram.json under
           `search`; the host clamps at read time and each indexing pass
           reads them fresh, so a change applies on the next pass. -->
      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem id="settingsGroupSearch" initiallyExpanded="{false}" iconPosition="start" summary="Search · how much history is indexed">
      <VStack gap="$space-4">
        <HStack>
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            label="About Search"
            tooltip="About Search"
            onClick="infoTitle = 'Search'; infoBody = window.settingsInfoBodies.search; settingInfoDialog.open()" />
        </HStack>
        <Form
          id="searchSettingsForm"
          automationId="settings-search-form"
          width="12rem"
          data="{window.__bramSettingsFormData(settingsValue, 'search')}"
          submitUrl="/__settings"
          submitMethod="post"
          cancelLabel=""
          saveLabel="Save search limits"
          saveInProgressLabel="Saving…"
          hideButtonRowUntilDirty="{true}"
          marginRight-submitButton="auto"
          onWillSubmit="(data) => window.__bramSettingsSectionUpdate('search', data)"
          onSuccess="(response) => window.__bramAdoptSettingsForm(searchSettingsForm, response, 'search')">
          <NumberBox
            id="commitDepthBox"
            bindTo="commitDepth"
            label="Commit depth"
            width="100%"
            integersOnly="{true}"
            minValue="{100}"
            maxValue="{20000}" />
          <NumberBox
            id="issueLimitBox"
            bindTo="issueLimit"
            label="Issue limit"
            width="100%"
            integersOnly="{true}"
            minValue="{50}"
            maxValue="{2000}" />
        </Form>
        <ChangeListener
          listenTo="{settingsValue}"
          onDidChange="window.__bramSyncSettingsForm(settingsValue, searchSettingsForm, 'search')" />
        <Text
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Changes apply on the next indexing pass. Deeper commit indexing lengthens the next cold rebuild." />
      </VStack>
        </ExpandableItem>
      </Theme>

    </VStack>

    <Text
      when="{!settingsValue}"
      color="$textColor-secondary"
      fontSize="$fontSize-sm"
      value="Loading settings…" />

    <ModalDialog id="settingInfoDialog" title="{infoTitle}">
      <!-- Markdown line-spacing is tuned app-wide in themes/bram.json
           (marginTop/Bottom-H2-markdown, marginTop/Bottom-Text-markdown).
           paddingTop 0 keeps the first ## header from stacking the modal
           title gap on top of the header's own top margin. -->
      <VStack gap="$space-3" padding="$space-2" paddingTop="0">
        <Markdown content="{infoBody}" />
        <HStack>
          <Button label="Got it" onClick="settingInfoDialog.close()" />
        </HStack>
      </VStack>
    </ModalDialog>

  </VStack>
</Component>
