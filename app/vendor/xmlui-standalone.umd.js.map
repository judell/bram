{
  "name": "xmlui",
  "version": "0.14.1",
  "sideEffects": [
    "**/*.css",
    "src/components-core/analyzer/rules/**/*.ts"
  ],
  "type": "module",
  "scripts": {
    "start-test-bed": "cd src/testing/infrastructure && xmlui start",
    "build:xmlui-test-bed": "cd src/testing/infrastructure && xmlui build --build-mode=INLINE_ALL --withHostingMetaFiles --withMock",
    "build:for-node": "tsdown",
    "build:xmlui": "node --max-old-space-size=8192 ../node_modules/vite/bin/vite.js build --mode lib",
    "build:xmlui-standalone": "vite build --mode standalone",
    "build:xmlui-metadata": "vite build --mode metadata",
    "build:inspector-parser": "vite build --mode inspector-parser",
    "test:unit": "vitest run",
    "test:e2e": "playwright test -c ..",
    "test:e2e:compiled-scripts": "cross-env XMLUI_COMPILE_SCRIPTS=true playwright test -c .. --max-failures=25",
    "measure:compiled-bindings": "tsx scripts/measure-compiled-bindings.ts",
    "test:e2e-summary": "node scripts/e2e-test-summary.js",
    "test:e2e-website-examples": "playwright test -c .. --grep \"@website\"",
    "check:metadata-purity": "node scripts/check-metadata-purity.mjs",
    "check:metadata": "tsx scripts/check-metadata-drift.ts",
    "check:metadata-snapshot": "npm run build:xmlui-metadata && npm run gen:langserver-metadata && git diff --exit-code src/language-server/xmlui-metadata-generated.js",
    "check:api-diff": "tsx scripts/api-diff/release-guard.ts",
    "check:css-chunks": "node scripts/inspect-css-chunks.mjs",
    "check:example-tests": "node scripts/check-example-tests.mjs",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "pack:local": "clean-package && npm pack && clean-package restore",
    "prepublishOnly": "clean-package",
    "postpublish": "clean-package restore",
    "generate-docs-summaries": "node scripts/generate-docs/generate-summary-files.mjs",
    "generate-docs": "node scripts/generate-docs/get-docs.mjs",
    "generate-all-docs": "npm run build:xmlui-metadata && npm run generate-docs && npm run generate-docs-summaries",
    "export-themes": "npm run build:xmlui-metadata && node scripts/generate-docs/create-theme-files.mjs",
    "generate-context-vars-summary": "npm run build:xmlui-metadata && node scripts/generate-docs/generate-context-vars-summary.mjs",
    "gen:langserver-metadata": "node scripts/get-langserver-metadata.js"
  },
  "dependencies": {
    "@ark-ui/react": "5.36.2",
    "@eslint-community/regexpp": "4.10.0",
    "@formkit/auto-animate": "0.7.0",
    "@babel/parser": "7.29.2",
    "@modyfi/vite-plugin-yaml": "1.1.1",
    "@popperjs/core": "2.11.6",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "1.2.4",
    "@react-spring/web": "^10.0.2",
    "@remix-run/react": "2.17.5",
    "@tanstack/react-query": "^4.36.1",
    "@tanstack/react-table": "8.17.3",
    "@vitejs/plugin-react": "^6.0.0",
    "adm-zip": "0.6.0",
    "chroma-js": "^3.1.2",
    "classnames": "2.5.1",
    "color": "4.2.3",
    "date-fns": "2.30.0",
    "dexie": "3.2.4",
    "dotenv": "16.3.1",
    "embla-carousel-autoplay": "^8.3.0",
    "embla-carousel-react": "^8.3.0",
    "framer-motion": "^12.18.1",
    "get-user-locale": "^3.0.0",
    "glob": "11.1.0",
    "immer": "9.0.16",
    "js-yaml": "^4.1.0",
    "lodash-es": "4.18.1",
    "memoize-one": "6.0.0",
    "msw": "2.8.4",
    "node-html-parser": "7.1.0",
    "overlayscrollbars": "2.13.0",
    "overlayscrollbars-react": "0.5.6",
    "papaparse": "^5.5.2",
    "react": "18.2.0",
    "react-day-picker": "9.7.0",
    "react-dom": "18.2.0",
    "react-dropzone": "14.3.8",
    "react-helmet-async": "1.3.0",
    "react-hot-toast": "2.4.1",
    "react-markdown": "^9.0.1",
    "react-popper": "2.3.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "7.18.1",
    "react-sticky-el": "^2.1.1",
    "react-textarea-autosize": "8.5.3",
    "recharts": "^2.15.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sass": "1.93.3",
    "scroll-into-view-if-needed": "^3.1.0",
    "tsx": "4.20.6",
    "unist-util-visit": "^5.0.0",
    "use-context-selector": "1.4.1",
    "virtua": "^0.48.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-plugin-svgr": "5.2.0",
    "vscode-languageserver": "^9.0.1",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@rollup/pluginutils": "5.1.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.1",
    "@types/adm-zip": "0.5.4",
    "@types/chroma-js": "^3.1.2",
    "@types/color": "3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "4.17.6",
    "@types/node": "22.18.13",
    "@types/papaparse": "5.5.2",
    "@types/react": "18.2.23",
    "@types/react-dom": "18.2.8",
    "@types/yargs": "17.0.31",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "clean-package": "2.2.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "29.0.1",
    "prettier": "^3.3.3",
    "rollup-plugin-copy": "^3.5.0",
    "serve": "14.2.0",
    "terser": "^5.44.0",
    "tsdown": "^0.21.4",
    "typescript": "5.7.3",
    "vite-plugin-css-injected-by-js": "5.0.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "@remix-run/router": "1.23.3",
    "react-router": {
      ".": "7.11.0",
      "@remix-run/router": "1.23.3"
    },
    "react-router-dom": {
      ".": "7.18.1",
      "@remix-run/router": "1.23.3",
      "react-router": "7.11.0"
    }
  },
  "files": [
    "dist",
    "src/styles",
    "src/syntax"
  ],
  "bin": {
    "xmlui": "./src/nodejs/bin/bootstrap.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./src/parsers/xmlui-parser/index.ts",
    "./*.css": "./dist/lib/*.css",
    "./index.scss": "./src/index.scss",
    "./themes.scss": "./src/components-core/theming/_themes.scss",
    "./vite-xmlui-plugin": "./src/nodejs/vite-xmlui-plugin.ts",
    "./nodejs": "./src/nodejs/index.ts",
    "./language-server": "./src/language-server/server.ts",
    "./syntax/monaco": "./src/syntax/monaco/index.ts",
    "./syntax/textmate": "./src/syntax/textMate/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "clean-package": {
    "replace": {
      "bin": {
        "xmlui": "dist/nodejs/bin/index.mjs"
      },
      "types": "./dist/lib/xmlui.d.ts",
      "exports": {
        ".": {
          "import": "./dist/lib/xmlui.js",
          "require": "./dist/standalone/xmlui-standalone.umd.js"
        },
        "./language-server": {
          "import": "./dist/nodejs/server.mjs",
          "require": "./dist/nodejs/server.cjs"
        },
        "./parser": {
          "import": "./dist/lib/xmlui-parser.js"
        },
        "./*.css": {
          "import": "./dist/lib/*.css"
        },
        "./index.scss": {
          "import": "./dist/lib/scss/index.scss"
        },
        "./themes.scss": {
          "import": "./dist/lib/scss/components-core/theming/_themes.scss"
        },
        "./vite-xmlui-plugin": {
          "import": "./dist/nodejs/vite-xmlui-plugin.mjs",
          "require": "./dist/nodejs/vite-xmlui-plugin.cjs"
        },
        "./nodejs": {
          "import": "./dist/nodejs/index.mjs",
          "require": "./dist/nodejs/index.cjs"
        },
        "./syntax/monaco": {
          "import": "./dist/lib/syntax-monaco.js"
        },
        "./syntax/textmate": {
          "import": "./dist/lib/syntax-textmate.js"
        },
        "./testing": {
          "import": "./dist/lib/testing.js"
        }
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "repository": {
    "url": "https://github.com/xmlui-org/xmlui.git"
  },
  "msw": {
    "workerDirectory": "src/testing/infrastructure/public"
  }
}
