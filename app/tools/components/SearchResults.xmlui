<Component name="SearchResults">
  <!-- search-rows-confinement: the result rows live behind this component
       boundary so bindings re-evaluate on THIS component's prop changes
       only (probe capture 2026-07-31: 5 composer COMPONENT_STATE_CHANGED
       actions cascaded ~950 row evaluations each; see xmlui-org/xmlui#3710
       and the confine-a-hot-input howto). Rows arrive as a precomputed
       view-model (typeLabel/dateLabel/snippetSegs baked by Search once per
       result set).

       browse-tabs-adopt-searchresults: the shell mechanics (hover Cards,
       whole-row click → per-type detail modal, virtualized outside-scroll
       List, pin-on-change, render forensics) moved to ResultList.xmlui;
       this component supplies only the search-hit row anatomy. Slot content
       evaluates in this scope, so typeColors resolves here.
       https://docs.xmlui.org/howto/pass-a-template-slot-to-a-component -->
  <variable name="typeColors"
    value="{{ session: 'blue', commit: 'green', issue: '#c2410c', history: 'purple' }}" />
  <ResultList
    data="{$props.hits}"
    query="{$props.query}"
    pinKey="{$props.selectionKey}"
    pinVia="buckets">
    <property name="rowTemplate">
      <HStack gap="$space-3" verticalAlignment="start">
        <VStack gap="$space-0_5" width="7rem">
          <!-- Compact row metadata; facet badges remain at the default size.
               https://docs.xmlui.org/howto/theme-badge-colors-and-sizes -->
          <Theme fontSize-Badge="0.7rem"
            paddingHorizontal-Badge="$space-0_5" paddingVertical-Badge="0">
            <Badge value="{$item.typeLabel}" colorMap="{typeColors}" />
          </Theme>
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{$item.dateLabel}" />
        </VStack>
        <VStack width="*" gap="$space-0_5">
          <Text maxLines="1" fontWeight="$fontWeight-bold" value="{$item.source}" />
          <!-- Snippet with matched terms highlighted: segments precomputed
               by snippetSegments (Globals.xs) from the server's FTS5
               [ / ] markers, term-verified against the query so literal
               brackets in content stay literal. Outer Text (line box,
               pre-wrap) hosting inline segment Texts so a highlighted
               match stays whole mid-word — the DiffView pattern
               (judell/bram#239). Passive-match yellow matches the
               find-in-diff marks (rgba(250, 204, 21, 0.45)). -->
          <Text width="100%" whiteSpace="pre-wrap"
            fontSize="$fontSize-sm" color="$textColor-secondary">
            <Items data="{$item.snippetSegs}">
              <Text inline="true" whiteSpace="pre-wrap"
                fontSize="$fontSize-sm" color="$textColor-secondary"
                backgroundColor="{$item.hit ? 'rgba(250, 204, 21, 0.45)' : 'transparent'}"
                value="{$item.text}" />
            </Items>
          </Text>
        </VStack>
      </HStack>
    </property>
  </ResultList>
</Component>
