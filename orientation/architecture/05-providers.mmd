flowchart TD
  claude["Claude"]
  codex["Codex"]
  opencode["OpenCode"]
  antigravity["Antigravity (agy)"]
  host["Bram host"]
  guard["bram-guard"]
  routes["Worklist routes"]
  tx["Provider transcripts"]
  conv["Seeded conventions"]

  host -->|"launches opencode --standalone"| opencode
  claude -->|"hook in project-local settings"| guard
  codex -->|"hook in ~/.codex/config.toml"| guard
  opencode -->|"plugin in .opencode/plugins"| guard
  antigravity -->|"hook group in .agents/hooks.json"| guard
  claude -->|"loopback curl (Claude)"| routes
  opencode -->|"loopback curl (OpenCode)"| routes
  antigravity -->|"loopback curl (Antigravity)"| routes
  codex -->|"intent and result files"| routes
  claude -->|"JSONL under ~/.claude/projects"| tx
  codex -->|"rollouts under ~/.codex/sessions"| tx
  opencode -->|"SQLite plus plugin events"| tx
  antigravity -->|"exported from ~/.gemini/antigravity-cli"| tx
  antigravity -->|"OSC 7501 turn state"| host
  antigravity -->|"permission menus read from the screen"| host
  conv -.->|"CLAUDE.md import"| claude
  conv -.->|"AGENTS.md block and developer instructions"| codex
  conv -.->|"opencode.json instructions"| opencode
  conv -.->|"always-on rules in .agents/rules"| antigravity

  %% Invisible links stack the shared targets so the page reads top to bottom.
  guard ~~~ routes
  routes ~~~ tx

%% tip: Claude :: Claude Code. Launched as the claude command in the PTY. Can be given a pre-allocated session id.
%% tip: Codex :: Codex CLI. Launched as codex, with --no-daemon added when its help lists it.
%% tip: OpenCode :: OpenCode. Launched as opencode --standalone when its help lists the flag; sessions are rows in SQLite, not files.
%% tip: Antigravity (agy) :: Antigravity CLI, the agy command (1.4.12 in the specimens). It updates itself, so its behaviour can change without a Bram release.
%% tip: Bram host :: The Rust process: it launches each CLI in the PTY, reads the terminal, and accepts provider events.
%% tip: bram-guard :: One Rust binary with four registrations: claude-worklist, codex-worklist, opencode-worklist and antigravity-worklist all reach the same decider.
%% tip: Worklist routes :: The host's handlers for resolve, mutate, commit and end. Codex reaches them by a different transport but the same handlers.
%% tip: Provider transcripts :: Where each provider records turns. Bram reads them for turn state and the Transcript tab.
%% tip: Seeded conventions :: app/__shell/conventions.md, copied into managed projects by Setup. Each provider has its own way of loading it.
%% tip: launches opencode --standalone :: A private OpenCode server under this terminal, so the plugin carries this Bram's token; events without it are dropped once a tokened one has been seen.
%% tip: hook in project-local settings :: Registered in the ignored .claude/settings.local.json by Setup.
%% tip: hook in ~/.codex/config.toml :: A user-global marker block; Codex may ask the user to review and approve the hook.
%% tip: plugin in .opencode/plugins :: execute.before asks the guard and throws on deny; fails closed.
%% tip: hook group in .agents/hooks.json :: Bram's group in the project's own hooks file: antigravity-worklist before tools, antigravity-session to name the session.
%% tip: loopback curl (Claude) :: The agent reads the port from .bram-port in the state folder and calls the HTTP routes.
%% tip: loopback curl (OpenCode) :: Same transport as Claude; OpenCode has no Bram allowlist and an unsandboxed shell.
%% tip: loopback curl (Antigravity) :: Same transport as Claude; agy asks before running a command unless the user has allowed it.
%% tip: intent and result files :: Codex's sandbox refuses loopback connections, so it writes .worklist-intent.json and reads .worklist-result.json.
%% tip: JSONL under ~/.claude/projects :: One file per session, found by the encoded project path.
%% tip: rollouts under ~/.codex/sessions :: Rollout files; the host also polls their mtime for turn end.
%% tip: SQLite plus plugin events :: No transcript file; the plugin forwards turn boundaries to the host.
%% tip: exported from ~/.gemini/antigravity-cli :: agy's records are not Claude-shaped; Bram writes a Claude-shaped projection in its cache.
%% tip: OSC 7501 turn state :: agy reports working, done or idle in terminal escape sequences; Bram sets AGY_CLI_OSC7501=on so it does.
%% tip: permission menus read from the screen :: agy's approval dialogs are recognized by their titles and numbered options on screen.
%% tip: CLAUDE.md import :: Dashed: Claude loads the conventions only through an @-import the agent obeys.
%% tip: AGENTS.md block and developer instructions :: Dashed: instructions the model is asked to follow.
%% tip: opencode.json instructions :: Dashed: files listed in instructions load each session; following them is up to the model.
%% tip: always-on rules in .agents/rules :: Dashed: the conventions cut into rule files under agy's 24,000-byte limit; following them is up to the model.
