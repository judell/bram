<Component
  name="Sessions"
  var.currentProvider="{null}"
  var.expandedId="{null}"
  var.sessionsExpanded="{false}"
  var.searchQuery="{getLastSearchQuery()}"
  var.renamingSession="{null}"
  var.renameDraft=""
  var.newSessionOpen="{false}"
  var.newSessionDraft=""
  var.newSessionNext=""
  var.newSessionSuggested="{false}"
  var.newSessionSuggestedName=""
  var.newSessionSuggestedNext=""
  var.pendingDeletes="{loadPendingSessionDeletes()}"
  var.pendingRenames="{loadPendingSessionRenames()}"
  var.lastDeleteId="{null}"
  var.lastRenameId="{null}"
  var.lastRenameProvider="{null}"
  var.lastRenameOriginalTitle=""
  var.lastRenameTitle="">

  <!-- session-links-by-id: /sessions?session=<provider>:<id> shows that
       session in a panel above the list, whatever the active provider.
       Derived <variable>s, not var.s, so they follow the route as it changes.
       https://docs.xmlui.org/howto/deep-link-to-a-tab-or-section -->
  <variable name="linked" value="{window.__bramSessionAddress($queryParams.session)}" />
  <variable name="linkedRow" value="{window.__bramLinkedSessionRow(linkedList.value, linked)}" />
  <DataSource
    id="linkedList"
    url="/__sessions/list"
    queryParams="{{ provider: linked &amp;&amp; linked.provider }}"
    when="{!!linked}" />

  <!-- Browse list with full-text filtering through the shared SQLite index and
       inline SessionDetail. Search hits are joined back to the lightweight
       session metadata rows so browse actions and columns remain available. -->
  <DataSource
    id="sessionsMeta"
    url="/__sessions/meta"
    onLoaded="(data) => {
      if (!data || !data.provider) return;
      if (currentProvider !== data.provider) {
        currentProvider = data.provider;
        expandedId = null;
        sessionsExpanded = false;
      }
    }" />

  <DataSource
    id="sessionsFirstPage"
    url="/__sessions/list"
    queryParams="{{ limit: 20, provider: currentProvider }}"
    when="{!!currentProvider}" />

  <DataSource
    id="sessionsFull"
    url="/__sessions/list"
    queryParams="{{ provider: currentProvider }}"
    when="{(sessionsExpanded || searchQuery.trim().length >= 2) &amp;&amp; !!currentProvider}" />

  <!-- sessions-search-all-providers: while a query is active, every provider's
       full list is fetched so a hit from any provider joins to its row. The
       current provider's list is sessionsFull above, so it is not fetched
       twice. https://www.xmlui.org/docs/reference/components/DataSource -->
  <DataSource
    id="searchListClaude"
    url="/__sessions/list"
    queryParams="{{ provider: 'claude' }}"
    when="{searchReady &amp;&amp; currentProvider !== 'claude'}" />
  <DataSource
    id="searchListCodex"
    url="/__sessions/list"
    queryParams="{{ provider: 'codex' }}"
    when="{searchReady &amp;&amp; currentProvider !== 'codex'}" />
  <DataSource
    id="searchListOpencode"
    url="/__sessions/list"
    queryParams="{{ provider: 'opencode' }}"
    when="{searchReady &amp;&amp; currentProvider !== 'opencode'}" />
  <DataSource
    id="searchListAntigravity"
    url="/__sessions/list"
    queryParams="{{ provider: 'antigravity' }}"
    when="{searchReady &amp;&amp; currentProvider !== 'antigravity'}" />

  <DataSource
    id="sessionsSearch"
    url="/__search"
    queryParams="{{ q: searchQuery, limit: 500, types: 'session' }}"
    when="{searchQuery.trim().length >= 2}" />

  <!-- The context threshold (sessions.suggestAtContextTokens) that colors a
       row's CONTEXT cell, read the way Settings and the footer tip read it. -->
  <DataSource id="contextThresholdSettings" url="/__settings" />

  <variable
    name="sessionsSource"
    value="{((sessionsExpanded || searchQuery.trim().length >= 2) &amp;&amp; sessionsFull.value) ? sessionsFull.value : (sessionsFirstPage.value || [])}" />
  <variable name="searchNeedle" value="{searchQuery.trim().toLowerCase()}" />
  <variable name="searchReady" value="{searchNeedle.length >= 2}" />
  <!-- sessions-search-all-providers: every provider's list is in (the current
       one is sessionsFull) before hits are joined, so a hit is not shown as
       unlisted just because its list is still loading. A list that failed
       counts as settled (its hits show as unlisted rows), so one provider's
       error can't blank the whole search. -->
  <variable name="searchListsLoaded" value="{
    (sessionsFull.loaded || !!sessionsFull.error)
      &amp;&amp; (currentProvider === 'claude' || searchListClaude.loaded || !!searchListClaude.error)
      &amp;&amp; (currentProvider === 'codex' || searchListCodex.loaded || !!searchListCodex.error)
      &amp;&amp; (currentProvider === 'opencode' || searchListOpencode.loaded || !!searchListOpencode.error)
      &amp;&amp; (currentProvider === 'antigravity' || searchListAntigravity.loaded || !!searchListAntigravity.error)
  }" />
  <variable name="filteredSessions" value="{
    searchReady
      ? (searchListsLoaded &amp;&amp; sessionsSearch.value
          ? window.__bramSessionsSearchRows(sessionsSearch.value, [sessionsFull.value, searchListClaude.value, searchListCodex.value, searchListOpencode.value, searchListAntigravity.value])
          : [])
      : (searchNeedle ? [] : (sessionsSource || []))
  }" />

  <!-- sessions-search-all-providers: the tab follows an agent switch. Meta's
       onLoaded resets currentProvider (and the expansion) when the provider
       differs; before this the tab got no prop and refetched meta only on
       sessions-list-changed.
       https://www.xmlui.org/docs/reference/components/ChangeListener -->
  <ChangeListener
    listenTo="{$props.activeProvider}"
    onDidChange="sessionsMeta.refetch()" />
  <!-- sessions-delete-pending-self-heal: drop pending ids still present in the
       list so a stuck "pending" row re-enables. -->
  <ChangeListener
    listenTo="{sessionsSource}"
    onDidChange="pendingDeletes = pendingDeletes.filter(id => !(sessionsSource || []).some(s => s.id === id)); savePendingSessionDeletes(pendingDeletes)" />

  <!-- pane-buttons-acknowledge-clicks: delete and rename were APICalls,
       whose onSuccess reached the pane ~30 s after the host answered, so a
       deleted row lingered that long. window.__bramPaneAction (a plain
       fetch) publishes busy / done; these ChangeListeners run what onSuccess
       / onError ran, including the toasts APICall showed
       (https://www.xmlui.org/docs/howto/show-toast-notifications-from-code).
       The delete confirmation is the global confirm()
       (https://www.xmlui.org/docs/howto/open-a-confirmation-before-delete). -->
  <PushSource
    id="deleteSessionAct"
    initial="{null}"
    subscribe="{window.__bramSubscribePaneAction('deleteSession')}" />
  <ChangeListener
    listenTo="{deleteSessionAct.value &amp;&amp; deleteSessionAct.value.tick}"
    onDidChange="() => { const a = deleteSessionAct.value; if (a &amp;&amp; !a.busy) { if (a.ok) { toast('Session deleted.'); pendingDeletes = pendingDeletes.concat([lastDeleteId]); savePendingSessionDeletes(pendingDeletes); if (expandedId === lastDeleteId) { expandedId = null; } sessionsFirstPage.refetch(); if (sessionsExpanded || searchNeedle) sessionsFull.refetch(); } else { toast.error('Could not delete: ' + a.error); } } }" />

  <PushSource
    id="renameSessionAct"
    initial="{null}"
    subscribe="{window.__bramSubscribePaneAction('renameSession')}" />
  <ChangeListener
    listenTo="{renameSessionAct.value &amp;&amp; renameSessionAct.value.tick}"
    onDidChange="() => { const a = renameSessionAct.value; if (a &amp;&amp; !a.busy) { if (a.ok) { sessionsFirstPage.refetch(); if (sessionsExpanded || searchNeedle) sessionsFull.refetch(); } else { pendingRenames = pendingRenames.filter(id => id !== lastRenameId); savePendingSessionRenames(pendingRenames); renamingSession = { id: lastRenameId, provider: lastRenameProvider, title: lastRenameOriginalTitle }; renameDraft = lastRenameTitle; } } }" />

  <ModalDialog
    id="renameDialog"
    when="{!!renamingSession}"
    onClose="renamingSession = null; renameDraft = ''"
    title="Rename session">
    <VStack gap="$space-3" padding="$space-4">
      <TextBox
        id="renameBox"
        width="*"
        initialValue="{renamingSession &amp;&amp; (renamingSession.title || '')}"
        autoComplete="off"
        autoCorrect="{false}"
        spellCheck="{false}"
        autoCapitalize="off"
        onDidChange="(v) => renameDraft = v" />
      <Text
        color="$textColor-secondary"
        fontSize="$fontSize-sm"
        value="Note: codex /resume can create additional bootstrap-only session files. Bram hides those from this list and keeps [current] on the live session file when it can identify it." />
      <HStack horizontalAlignment="end" gap="$space-2">
        <Button label="Cancel" variant="outlined" onClick="renamingSession = null; renameDraft = ''" />
        <Button
          label="Rename"
          enabled="{renameDraft &amp;&amp; renameDraft.trim().length > 0}"
          onClick="let target = renamingSession; let title = renameDraft; lastRenameId = target.id; lastRenameProvider = target.provider; lastRenameOriginalTitle = target.title || ''; lastRenameTitle = title; pendingRenames = pendingRenames.includes(target.id) ? pendingRenames : pendingRenames.concat([target.id]); savePendingSessionRenames(pendingRenames); renamingSession = null; renameDraft = ''; toast('Session renamed. Reload Bram to see the new title in the session list.'); window.__bramPaneAction('renameSession', '/__sessions/rename', { query: { id: target.id, provider: target.provider, title: title } })" />
      </HStack>
    </VStack>
  </ModalDialog>

  <!-- suggest-fresh-session: an agent suggestion (session-suggest) opens the
       dialog pre-filled. The vars are set BEFORE newSessionOpen flips, because
       the dialog mounts only when newSessionOpen and the fields take them as
       initialValue (real editable text, not placeholders). Delivery is via a
       helpers.js factory that also hands over a suggestion that arrived before
       this tab mounted; consumed once, never replayed on reload.
       https://www.xmlui.org/docs/reference/components/PushSource
       https://www.xmlui.org/docs/reference/components/ChangeListener -->
  <PushSource
    id="sessionSuggestEvt"
    initial="{null}"
    subscribe="{window.__bramSubscribeSessionSuggest()}" />
  <ChangeListener
    listenTo="{sessionSuggestEvt.value &amp;&amp; sessionSuggestEvt.value.at}">
    <event name="didChange">
      const s = sessionSuggestEvt.value || null;
      if (s) {
        newSessionDraft = s.name;
        newSessionNext = s.whatsNext;
        newSessionSuggestedName = s.name;
        newSessionSuggestedNext = s.whatsNext;
        newSessionSuggested = true;
        newSessionOpen = true;
        window.__bramSuggestTrace('suggest-opened', true, s.name, s.whatsNext, s.name, s.whatsNext);
      }
    </event>
  </ChangeListener>

  <ModalDialog
    id="newSessionDialog"
    when="{newSessionOpen}"
    onClose="window.__bramClearPairOfferForCreate(); window.__bramSuggestTrace('suggest-cancelled', newSessionSuggested, newSessionDraft, newSessionNext, newSessionSuggestedName, newSessionSuggestedNext); newSessionOpen = false; newSessionSuggested = false; newSessionDraft = ''; newSessionNext = ''; window.__bramVoiceStopOnSend('new-session'); setWorklistVoiceTarget('message-agent')"
    title="New session">
    <VStack gap="$space-3" padding="$space-4">
      <Text
        when="{newSessionSuggested}"
        fontWeight="$fontWeight-bold"
        fontSize="$fontSize-sm"
        value="Suggested by the agent. Edit the name and what's next to say it your way, then click Create." />
      <TextBox
        id="newSessionBox"
        width="*"
        placeholder="Session name (descriptive: it's how you'll find this session later)"
        initialValue="{newSessionDraft}"
        autoComplete="off"
        autoCorrect="{false}"
        spellCheck="{false}"
        autoCapitalize="off"
        onDidChange="(v) => newSessionDraft = v" />
      <IsolatedDraftEditor
        id="newSessionNextEditor"
        placeholder="What's next? (optional, in your own words)"
        initialValue="{newSessionNext}"
        resize="vertical"
        minRows="4"
        maxRows="16"
        width="100%"
        voiceTarget="new-session"
        voiceTooltip="Dictate what's next" />
      <Text
        color="$textColor-secondary"
        fontSize="$fontSize-sm"
        value="Create stops the running agent and starts a new session with this name. If you say what's next, the new session builds its context from your words (project history, and the session you're leaving), reports what it found, and waits for you to settle the framing together. The current session stays in the list, resumable." />
      <HStack horizontalAlignment="end" gap="$space-2">
        <Button label="Cancel" variant="outlined" onClick="window.__bramClearPairOfferForCreate(); window.__bramSuggestTrace('suggest-cancelled', newSessionSuggested, newSessionDraft, newSessionNextEditor.getValue(), newSessionSuggestedName, newSessionSuggestedNext); newSessionOpen = false; newSessionSuggested = false; newSessionDraft = ''; newSessionNext = ''; window.__bramVoiceStopOnSend('new-session'); setWorklistVoiceTarget('message-agent')" />
        <Button
          label="Create"
          enabled="{newSessionDraft &amp;&amp; newSessionDraft.trim().length > 0}"
          onClick="let name = newSessionDraft; let next = newSessionNextEditor.getValue(); window.__bramSuggestTrace('suggest-created', newSessionSuggested, name, next, newSessionSuggestedName, newSessionSuggestedNext); newSessionOpen = false; newSessionSuggested = false; newSessionDraft = ''; newSessionNext = ''; window.__bramVoiceStopOnSend('new-session'); setWorklistVoiceTarget('message-agent'); window.__bramCreateNewSessionClick(currentProvider, name, toast, next, window.__bramCurrentSessionOf(sessionsFirstPage.value))" />
      </HStack>
    </VStack>
  </ModalDialog>

  <PushSource
    id="sessionsListChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{sessionsListChangedEvt.value &amp;&amp; sessionsListChangedEvt.value.tick}"
    onDidChange="() => { sessionsMeta.refetch(); sessionsFirstPage.refetch(); if (sessionsExpanded || searchNeedle) sessionsFull.refetch(); }" />

  <!-- pinned-header: heading, filters and the column-header row stay put;
       the session rows scroll under them (PinnedHeader.xmlui). No emitEvent
       in the moved markup. -->
  <VStack padding="$space-4" gap="0" height="*">
   <PinnedHeader gap="0">
    <property name="headerTemplate">
     <VStack gap="$space-3">
    <HStack gap="$space-3" verticalAlignment="center">
      <BackLink when="{$queryParams.from === 'tip' || !!linked}" />
      <Heading level="h2">Sessions</Heading>
      <SearchBox
        boxWidth="22rem"
        placeholder="Filter sessions…"
        initialValue="{searchQuery}"
        inProgress="{searchReady &amp;&amp; (sessionsSearch.inProgress || sessionsFull.inProgress || searchListClaude.inProgress || searchListCodex.inProgress || searchListOpencode.inProgress || searchListAntigravity.inProgress)}"
        onQueryChange="(q) => { searchQuery = q; setLastSearchQuery(q) }"
        onClear="searchQuery = ''; setLastSearchQuery(''); expandedId = null" />
      <Button
        label="+ New session"
        variant="solid"
        size="sm"
        tooltip="Start a fresh session and make it current"
        onClick="newSessionSuggested = false; newSessionDraft = ''; newSessionNext = ''; newSessionOpen = true" />
    </HStack>
    <!-- sessions-search-all-providers (Jon, 2026-11-25): no provider header.
         The tab follows the agent dropdown, so "Auto-detected provider" only
         repeated it, and a "Matches across …" line under search was noise;
         each search row names its provider. -->
    <VStack
      when="{sessionsMeta.value &amp;&amp; sessionsMeta.value.discoveryNotes &amp;&amp; sessionsMeta.value.discoveryNotes.length > 0}"
      gap="$space-1"
      padding="$space-2"
      borderRadius="$borderRadius"
      backgroundColor="$color-warning-50">
      <Items data="{sessionsMeta.value.discoveryNotes}">
        <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{$item}" />
      </Items>
    </VStack>

      <HStack
        gap="$space-3"
        paddingHorizontal="$space-3"
        paddingVertical="$space-2"
        backgroundColor="$color-surface-100"
        borderBottom="1px solid $borderColor">
        <Text width="*" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="TITLE" />
        <Text width="140px" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="MODIFIED" />
        <!-- sessions-table-context-and-floor: tooltip is plain text,
             https://www.xmlui.org/docs/howto/show-a-multi-line-or-formatted-tooltip -->
        <Text width="70px" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="CONTEXT" tooltip="Tokens in this session's last call: what its next turn would send. Past the threshold in Settings it turns the warning color: start a new session for that work." />
        <Text width="70px" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="FLOOR" tooltip="Tokens in its first call: about where a fresh session starts." />
        <Text width="70px" fontWeight="$fontWeight-bold" fontSize="$fontSize-sm" color="$textColor-secondary" value="SIZE" />
      </HStack>
     </VStack>
    </property>
      <VStack when="{!!linked}" gap="$space-2" padding="$space-3" borderBottom="1px solid $borderColor">
        <!-- session-links-by-id: labelled as the Context tab labels it; the
             way back is the header's BackLink, as on Context. -->
        <Text fontWeight="$fontWeight-bold" value="{window.__bramLinkedSessionLabel(linked)}" />
        <Text when="{!!linkedRow}" value="{linkedRow &amp;&amp; linkedRow.title}" />
        <Text when="{linkedList.loaded &amp;&amp; !linkedRow}" fontSize="$fontSize-sm" color="$textColor-secondary"
          value="Not in this project's session list" />
        <SessionDetail when="{!!linkedRow || linkedList.loaded}" sessionId="{linked &amp;&amp; linked.id}" provider="{linked &amp;&amp; linked.provider}"
          height="600px" />
      </VStack>
      <Items data="{filteredSessions}">
        <VStack gap="0" borderBottom="1px solid $borderColor">
          <HStack
            gap="$space-2"
            paddingHorizontal="$space-3"
            paddingVertical="$space-2"
            verticalAlignment="start"
            opacity="{(pendingDeletes.includes($item.id) || pendingRenames.includes($item.id)) ? 0.5 : 1}">
            <!-- sessions-switch-icon-and-land-on-transcript: icon-only switch/reload button -->
            <Button
              when="{!$item.unlisted}"
              icon="{$item.current ? 'restart' : 'swap'}"
              variant="ghost"
              size="xs"
              enabled="{!$item.pending &amp;&amp; !(pendingDeletes.includes($item.id) || pendingRenames.includes($item.id))}"
              tooltip="{$item.pending ? 'Available after the first message creates the Codex session' : (pendingDeletes.includes($item.id) ? 'delete pending' : (pendingRenames.includes($item.id) ? 'rename pending' : ($item.current ? 'Reload this session (restarts the agent)' : 'Switch to this session (restarts the agent on it)')))}"
              onClick="window.__bramReloadAgentSessionClick($item.provider, $item.id, toast)" />
            <!-- Rename before delete (Jon, 2026-11-23): the common action sits
                 next to the switch button, the destructive one at the end.
                 Delete confirms before it sends. -->
            <Button
              when="{!$item.unlisted}"
              label="✎"
              variant="ghost"
              size="xs"
              enabled="{window.__bramSessionEditEnabled($item, 'rename', pendingDeletes, pendingRenames)}"
              tooltip="{window.__bramSessionEditTooltip($item, 'rename', pendingDeletes, pendingRenames)}"
              onClick="renamingSession = { id: $item.id, provider: $item.provider, title: ($item.title || '') }; renameDraft = ($item.title || '')" />
            <Button
              when="{!$item.unlisted}"
              label="{deleteSessionAct.value &amp;&amp; deleteSessionAct.value.busy &amp;&amp; lastDeleteId === $item.id ? '…' : '✕'}"
              variant="ghost"
              size="xs"
              enabled="{window.__bramSessionEditEnabled($item, 'delete', pendingDeletes, pendingRenames) &amp;&amp; !(deleteSessionAct.value &amp;&amp; deleteSessionAct.value.busy)}"
              tooltip="{window.__bramSessionEditTooltip($item, 'delete', pendingDeletes, pendingRenames)}"
              onClick="lastDeleteId = $item.id; if (confirm('Delete session?', 'This cannot be undone.', 'Delete')) window.__bramPaneAction('deleteSession', '/__sessions/delete', { query: { id: $item.id, provider: $item.provider } })" />
            <!-- session-groups: a loose session can join a group that has no
                 session on this agent yet, and takes the group's name. Each
                 entry carries this row's id (inside Items, $item is the
                 entry). Peer: the agent overflow menu in Main.xmlui;
                 https://www.xmlui.org/docs/reference/components/DropdownMenu -->
            <DropdownMenu
              when="{!$item.group &amp;&amp; ($item.joinable || []).length > 0}"
              label="+"
              tooltip="Add to a group (it takes the group's name)"
              triggerButtonVariant="ghost">
              <Items data="{$item.joinable}">
                <MenuItem
                  label="{window.__bramSessionAddToGroupLabel($item)}"
                  onClick="window.__bramSessionAddToGroup($item, toast)" />
              </Items>
            </DropdownMenu>
            <Link
              when="{!$item.pending &amp;&amp; !$item.unlisted}"
              width="*"
              onClick="expandedId = (expandedId === $item.id) ? null : $item.id"
              noIndicator>
              <Text
                width="100%"
                fontWeight="{expandedId === $item.id ? '$fontWeight-bold' : '$fontWeight-normal'}"
                value="{($item.current ? '[current] ' : '') + ($item.title || '(untitled)')}" />
            </Link>
            <Text
              when="{$item.pending}"
              width="*"
              color="$textColor-secondary"
              value="{window.__bramPendingSessionLabel($item)}" />
            <!-- sessions-search-all-providers: a hit with no listed row: title and
                 a note, no actions -->
            <VStack when="{$item.unlisted}" width="*" gap="0">
              <Text width="100%" value="{$item.title || '(untitled)'}" />
              <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Not in this project's session list" />
            </VStack>
            <Text when="{searchReady}" fontSize="$fontSize-xs" color="$textColor-secondary" value="{window.__bramProviderLabel($item.provider)}" />
            <Text when="{!$item.unlisted}" width="140px" fontSize="$fontSize-sm" value="{formatDateTime(new Date($item.mtime * 1000), 'yyyy-MM-dd HH:mm')}" />
            <Text when="{!$item.unlisted}" width="70px" fontSize="$fontSize-sm" color="{window.__bramSessionTokensCellColor($item.context, contextThresholdSettings.value, $item.provider)}" value="{window.__bramSessionTokensCell($item.context)}" />
            <Text when="{!$item.unlisted}" width="70px" fontSize="$fontSize-sm" value="{window.__bramSessionTokensCell($item.floor)}" />
            <Text when="{!$item.unlisted}" width="70px" fontSize="$fontSize-sm" value="{window.__bramSessionSizeLabel($item)}" />
          </HStack>
          <!-- session-groups: the session's group (switching agents moves
               among its members), with Leave for when one has drifted. -->
          <HStack
            when="{!!$item.group}"
            gap="$space-2"
            paddingHorizontal="$space-3"
            paddingBottom="$space-2"
            verticalAlignment="center">
            <Text
              width="*"
              fontSize="$fontSize-sm"
              color="$textColor-secondary"
              value="{window.__bramSessionGroupLabel($item)}" />
            <Button
              label="Leave"
              variant="ghost"
              size="xs"
              tooltip="{window.__bramSessionLeaveTooltip($item)}"
              onClick="window.__bramUnpairSession($item.provider, $item.id, toast)" />
          </HStack>
          <VStack when="{expandedId === $item.id &amp;&amp; !$item.unlisted}" paddingBottom="$space-2">
            <SessionDetail sessionId="{$item.id}" provider="{$item.provider}"
              height="600px" query="{searchQuery.trim()}" />
          </VStack>
        </VStack>
      </Items>
      <Link
        when="{!searchNeedle &amp;&amp; !sessionsExpanded &amp;&amp; sessionsMeta.value &amp;&amp; sessionsMeta.value.count > 20}"
        onClick="sessionsExpanded = true"
        noIndicator="true">
        <Text
          paddingHorizontal="$space-3"
          paddingVertical="$space-2"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="More ({sessionsMeta.value.count - 20} more)" />
      </Link>
      <Link
        when="{!searchNeedle &amp;&amp; sessionsExpanded &amp;&amp; sessionsSource.length > 20}"
        onClick="sessionsExpanded = false"
        noIndicator="true">
        <Text
          paddingHorizontal="$space-3"
          paddingVertical="$space-2"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Show fewer" />
      </Link>
      <Text when="{searchNeedle &amp;&amp; !searchReady}"
        color="$textColor-secondary" fontSize="$fontSize-sm"
        value="Type at least 2 characters to search session transcripts." />
      <Text
        when="{searchReady &amp;&amp; sessionsSearch.loaded &amp;&amp; searchListsLoaded &amp;&amp; !sessionsSearch.inProgress &amp;&amp; !sessionsFull.inProgress &amp;&amp; filteredSessions.length === 0}"
        color="$textColor-secondary" fontSize="$fontSize-sm" value="No matching sessions." />
   </PinnedHeader>
  </VStack>
</Component>
