<!-- context-stack-viewer (Jon, 2026-11-24): the Context tab is the stack
     the model is sent this session, block by block. The instruction files
     and the memory index are blocks in the stack, so the old list of files
     is gone, and so are the old file search and the hooks/settings/skills
     list (Jon: "too confusing"; "remove the items"). The right half shows
     a clicked block's exact text, or the memory file another surface asked
     this tab to open. -->
<Component name="Context"
  var.selectedPath="{null}"
  var.selectedDisplay="{null}"
  var.selectedBlock="{null}">

  <!-- The stack for the active session; refetched when the host samples a
       new context reading at turn end (push over polling).
       https://www.xmlui.org/docs/reference/components/DataSource -->
  <DataSource id="stack" url="/__context-stack" />
  <PushSource
    id="stackTick"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('session-context-changed')}" />
  <ChangeListener listenTo="{stackTick.value}" onDidChange="stack.refetch()" />
  <DataSource
    id="blockText"
    url="/__context-stack/block"
    queryParams="{{ i: selectedBlock &amp;&amp; selectedBlock.i }}"
    when="{!!selectedBlock}" />

  <DataSource id="ctxList" url="/__context/list" queryParams="{{ provider: activeProvider || '' }}" />
  <DataSource
    id="ctxFile"
    url="/__context/file"
    queryParams="{{ path: selectedPath }}"
    when="{!!selectedPath}" />

  <ChangeListener
    listenTo="{activeProvider}"
    onDidChange="selectedPath = null; selectedDisplay = null; selectedBlock = null; stack.refetch()" />

  <HSplitter height="100%"
    initialPrimarySize="{window.__bramRestoreSplitterSize('context', '45%')}"
    onResize="(px) => window.__bramSaveSplitterSize('context', px)">
    <VStack
      padding="$space-4"
      gap="$space-4"
      overflowY="auto"
      onInit="registerContextMemorySelector((basename) => { let memorySection = ((ctxList.value &amp;&amp; ctxList.value.sections) || []).find((s) => s.key === 'memory'); let f = ((memorySection &amp;&amp; memorySection.items) || []).find((x) => x.display === basename); if (f) { selectedPath = f.path; selectedDisplay = f.display; selectedBlock = null; } })"
      onCleanup="clearContextMemorySelector()">
      <ModalDialog id="contextInfoDialog" title="About Context">
        <VStack gap="$space-3">
          <Text value="{window.__bramStackIntro()}" />
          <Text value="Sizes are the bytes each block takes in the session file, scaled by a bytes-per-token figure measured on this session so they total the context the last call reported. The remainder no block accounts for is shown as such." />
          <!-- One line per kind, the way the tables say what their columns
               mean (table-headers-explained). -->
          <VStack gap="$space-1">
            <Text fontWeight="$fontWeight-bold" value="What the kinds are" />
            <Items data="{window.__bramStackKindGlossary()}">
              <HStack gap="$space-2" verticalAlignment="start">
                <Stack width="10px" height="10px" backgroundColor="{$item.color}" marginTop="$space-1" />
                <Text fontSize="$fontSize-sm" width="*" value="{$item.line}" />
              </HStack>
            </Items>
          </VStack>
        </VStack>
      </ModalDialog>
      <HStack verticalAlignment="center" gap="$space-2">
        <Heading level="h4">Context</Heading>
        <Button
          label="ⓘ"
          variant="ghost"
          size="sm"
          tooltip="About Context"
          onClick="contextInfoDialog.open()" />
      </HStack>

      <ContextStack
        stack="{stack.value}"
        onSelect="(b) => { selectedBlock = b; selectedPath = null; selectedDisplay = null; }" />
    </VStack>

    <VStack when="{selectedPath || selectedBlock}" padding="$space-4" gap="$space-2" overflowY="auto">
      <!-- A closer, so the right half can be put away (Jon, 2026-11-24). -->
      <HStack verticalAlignment="center">
        <SpaceFiller />
        <Button label="✕" variant="ghost" size="xs" tooltip="Close" onClick="selectedBlock = null; selectedPath = null; selectedDisplay = null" />
      </HStack>
      <!-- A block: its label, what it weighs, and the exact text sent; a
           Markdown file renders as Markdown, as the Runs under files do. -->
      <VStack when="{!!selectedBlock &amp;&amp; !selectedPath}" gap="$space-2">
        <Text value="{window.__bramStackRowLabel(selectedBlock)}" fontWeight="$fontWeight-bold" />
        <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{window.__bramStackBlockHeader(selectedBlock)}" />
        <Text when="{selectedBlock.onDisk}" value="{selectedBlock.onDisk}" variant="code" fontSize="$fontSize-xs" color="$textColor-secondary" />
        <Markdown
          when="{selectedBlock.onDisk &amp;&amp; selectedBlock.onDisk.endsWith('.md')}"
          content="{window.__bramStackBlockBody(selectedBlock, blockText.value)}"
          interpolateBindings="false" allowHtml="false" />
        <Text
          when="{!(selectedBlock.onDisk &amp;&amp; selectedBlock.onDisk.endsWith('.md'))}"
          fontFamily="$fontFamily-monospace"
          fontSize="$fontSize-sm"
          whiteSpace="pre-wrap"
          value="{window.__bramStackBlockBody(selectedBlock, blockText.value)}" />
      </VStack>
      <!-- A file the memory selector opened here (the composer's memory
           widget calls registerContextMemorySelector). -->
      <VStack when="{!!selectedPath}" gap="$space-2">
        <Text value="{selectedPath}" variant="code" fontSize="$fontSize-xs" color="$textColor-secondary" />
        <Markdown
          when="{selectedDisplay &amp;&amp; selectedDisplay.endsWith('.md')}"
          content="{ctxFile.value &amp;&amp; ctxFile.value.content}"
          interpolateBindings="false" allowHtml="false" />
        <Text
          when="{selectedDisplay &amp;&amp; !selectedDisplay.endsWith('.md')}"
          fontFamily="$fontFamily-monospace"
          fontSize="$fontSize-sm"
          whiteSpace="pre"
          value="{ctxFile.value &amp;&amp; ctxFile.value.content}" />
      </VStack>
    </VStack>
  </HSplitter>
</Component>
