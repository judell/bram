<Component
  name="Worklist"
  var.expandedKeys="{window.__bramRestoreWorklist2Expansion()}"
  var.worklist2Feedback="{{}}"
  var.worklist2Close="{{}}"
  var.worklist2NewItemOpen="{false}"
  var.worklist2NewItemIssue="{null}"
  var.worklist2VoiceRecording="{false}"
  var.worklist2VoiceItemId="{''}"
  var.worklist2Sent="{{}}"
  var.worklist2Selected="{(window.__bramW2Selection || []).slice()}"
  var.worklist2OverlapOpen="{false}"
  var.worklist2ShareMode="{'together'}"
  >
  <!-- Worklist2: the redesigned, evidence-first gate (tutorial gist v3).
       Binds the same /__worklist payload Workspace uses, so the two tabs
       cannot disagree about state. Two-level compression: a row-level
       expander with the file table plus Before / After / Diff sections.

       worklist2-keyed-expansion: expansion is CONTROLLED — it lives only
       in expandedKeys (persisted, id-keyed), never in component
       internals. ExpandableItem is uncontrolled (initiallyExpanded reads
       once at mount), so positional row reuse in the Items loop carried
       expansion state across items when the list changed (pruned-item
       state transfer, 2026-08-20). Chevron Button + when-bound body per
       https://www.xmlui.org/docs/howto/keep-per-item-state-in-a-loop —
       the old tab's proven shape. -->
  <DataSource
    id="worklist"
    url="/__worklist"
    onLoaded="(d) => expandedKeys = window.__bramPruneWorklist2Expansion(d &amp;&amp; d.items ? d.items.map(i => i.id) : [])" />
  <!-- The component-local selection resets on a Worklist remount, but the
       Footer's shared selection bridge survives it. Reconcile on the
       authoritative item set so a prune/remount publishes [] instead of
       leaving buttons lit for an id whose row no longer exists. Surviving
       selected ids are retained. -->
  <ChangeListener
    listenTo="{worklist.value &amp;&amp; worklist.value.items}"
    onDidChange="() => worklist2Selected = window.__bramSelectionIds(worklist.value &amp;&amp; worklist.value.items, worklist2Selected)" />
  <!-- instrument-w2-selection-handoff: the prune's own view, logged before the
       assignment above lands, so a refetch that arrives with zero items is
       visible as the cause rather than inferred from the publish that follows. -->
  <ChangeListener
    listenTo="{worklist.value &amp;&amp; worklist.value.items}"
    onDidChange="() => window.__bramIframeTrace('w2-selection', {op: 'prune-input', items: ((worklist.value &amp;&amp; worklist.value.items) || []).length, selected: (worklist2Selected || []).length})" />
  <!-- one-click-approve-commit-shared-setting: the host enforces this
       setting for apply-and-commit from every Worklist surface. Default
       on while the config loads, matching the host's missing-key default;
       refetch from the settings push event so toggling it takes effect
       without polling or a pane reload. -->
  <DataSource id="worklistConfig" url="/__worklist-config" />
  <PushSource
    id="worklistSettingsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('settings-changed')}" />
  <ChangeListener
    listenTo="{worklistSettingsChangedEvt.value &amp;&amp; worklistSettingsChangedEvt.value.tick}"
    onDidChange="worklistConfig.refetch()" />
  <!-- strip-label-tense-for-applied-items: the summary strip's first
       priority is the host's claim record (Approving…/Iterating…/…), so
       read /__inflight and refetch on its push event — the same payload
       and idiom as the old tab's #265 indicators, so the two tabs cannot
       tell different stories about what is in flight. -->
  <DataSource id="inflightClaim" url="/__inflight" />
  <PushSource
    id="inflightClaimEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('inflight-claim-changed')}" />
  <ChangeListener
    listenTo="{inflightClaimEvt.value &amp;&amp; inflightClaimEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(inflightClaimEvt.value, inflightClaim, worklist)" />
  <!-- count-changed-files-rung1: the payload's change activity derives
       from git status, so refetch on the host's git-status-changed event
       (push over polling; same idiom as Commits.xmlui). -->
  <PushSource
    id="gitStatusEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('git-status-changed', false)}" />
  <ChangeListener
    listenTo="{gitStatusEvt.value &amp;&amp; gitStatusEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(gitStatusEvt.value, worklist)" />
  <!-- worklist2-first-action sync fix: worklist-changed is the event
       every worklist.json write emits and the old tab's primary refetch
       trigger; without it the board desyncs exactly when items are added
       or pruned (observed live 2026-08-20: one row shown, two on disk). -->
  <PushSource
    id="worklistChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('worklist-changed')}" />
  <ChangeListener
    listenTo="{worklistChangedEvt.value &amp;&amp; worklistChangedEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(worklistChangedEvt.value, worklist)" />
  <!-- Parity: the old tab's last-exchange dock rides the projection
       subscription (workspace-tail-subscription). -->
  <!-- worklist2-feedback-input-parity: voice transcripts arrive on the
       shared subscription; per-row listeners below route by target. -->
  <PushSource
    id="w2VoiceArrival"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceArrival()}" />
  <!-- issue-278: publish the selection so the Footer's gate bar can read it.
       The gate row is moving to the Footer because that is the one surface
       this App layout pins ("vertical-sticky ... the footer sticks to the
       bottom"); the rows keep owning the selection, they just announce it. -->
  <ChangeListener
    listenTo="{worklist2Selected}"
    onDidChange="() => window.__bramW2SetSelection(worklist2Selected)" />
  <!-- instrument-w2-selection-handoff (observe only, TRIPWIRE).
       A sibling listener rather than extra statements in the one above:
       attribute handlers stay a single call.
       `items` is the discriminator. The leading hypothesis is that the prune
       listener above fires during a refetch when `worklist.value.items` is
       momentarily empty, wiping the selection - while the row Checkbox uses
       `initialValue` (UNCONTROLLED, same class as the ExpandableItem trap) so
       it keeps showing ticked. That shape reads `op=publish count=0 items=0`
       and settles it in one grep, which reading the code twice did not. -->
  <ChangeListener
    listenTo="{worklist2Selected}"
    onDidChange="() => window.__bramIframeTrace('w2-selection', {op: 'publish', count: (worklist2Selected || []).length, items: ((worklist.value &amp;&amp; worklist.value.items) || []).length, store: (window.__bramW2Selection || []).length})" />
  <!-- The close-issue toggles live in the row expansions but the Commit
       buttons are now in the Footer, so the map has to cross too. -->
  <ChangeListener
    listenTo="{worklist2Close}"
    onDidChange="() => window.__bramW2SetCloseMap(worklist2Close)" />
  <ChangeListener
    listenTo="{worklist2ShareMode}"
    onDidChange="() => window.__bramW2SetShareMode(worklist2ShareMode)" />
  <PushSource
    id="projectedTurnsDS"
    initial="{window.__bramProjectedLastExchange(null)}"
    subscribe="{window.bramSubscribeProjectedLastExchange()}" />
  <VStack padding="$space-4" gap="$space-3">
    <HStack gap="$space-3" verticalAlignment="center" paddingBottom="$space-2">
      <H2>Worklist</H2>
      <!-- Parity: + New item. Inline ask (the old tab's dialog distilled):
           items are proposed by the agent; this composes that ask. -->
      <Button
        label="+ New item"
        size="xs"
        onClick="worklist2NewItemOpen = !worklist2NewItemOpen" />
      <!-- issue-278 rung 1: the board states its own overlap total, so a
           reader knows the per-row marks are exhaustive without reading every
           row. Says "no shared files" when there are none - the absence is
           worth one word, and it keeps the line from appearing and vanishing.
           "across all N items" marks universality, which is what the clique
           degenerates to and the useful collapsed fact when everyone claims
           one file. -->
      <SpaceFiller />
      <Text
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{window.__bramOverlapHeaderLine(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}" />
      <Button
        when="{window.__bramOverlapAny(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}"
        label="{worklist2OverlapOpen ? 'Hide overlaps' : 'Review overlaps'}"
        variant="ghost"
        size="xs"
        onClick="worklist2OverlapOpen = !worklist2OverlapOpen" />
    </HStack>
    <!-- issue-278 rung 2: the overlap index. One disclosure owns the graph,
         so a row never has to render its peer set - at twenty dense items that
         is the same news twenty times. Ordered HAZARD BEFORE POPULARITY by
         __bramOverlapIndex: a file with begun claimants outranks a more
         popular one with none, because whole-file staging makes the begun case
         the one that can produce a mixed commit. In document flow, NOT pinned:
         a large index stuck to the top would consume the viewport it exists to
         summarise. -->
    <VStack
      when="{worklist2OverlapOpen}"
      gap="$space-1"
      padding="$space-3"
      border="1px solid $color-surface-200"
      borderRadius="$borderRadius">
      <Text fontWeight="$fontWeight-bold" value="Shared files" />
      <!-- Table with proportional Columns, not hand-rolled HStacks with fixed
           rem widths. The hand-rolled version wasted horizontal space on every
           row (a 22rem FILE column for paths that are mostly shorter) and then
           had nothing left for CLAIMED BY. Reaching for `FlowLayout` to fix
           that cell made it worse still - every badge stretched to full
           container width, one per line - and it was the wrong component
           regardless: FlowLayout carries an upstream deprecation notice,
           "Please use HStack with wrapContent set to true; it will overtake
           the role of FlowLayout" (xmlui `FlowLayout.tsx:26`). Checking the
           component docs first would have said so; reaching for a layout by
           name is how a deprecated one gets into a file.

           Jon: "Terrible layout solution. Just wasting all kinds of space. We
           want these things natural width and wrappable. We already had a
           solution to that."

           We did: the expanded row's file table right below, which has used
           `Table` + proportional `Column` + `HStack wrapContent="true"` all
           along (see the shared-with Column). Same shape, same problem, and it
           was solved once already - this is that solution, reused rather than
           reinvented. -->
      <Table data="{window.__bramOverlapIndex(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}">
        <Column header="file" width="2*">
          <Text value="{$item.path}" variant="code" fontSize="$fontSize-sm" tooltip="{$item.path}" />
        </Column>
        <Column header="items" width="110px">
          <Text
            fontSize="$fontSize-sm"
            color="$textColor-secondary"
            value="{window.__bramOverlapRowCount($item, worklist.value &amp;&amp; worklist.value.items)}" />
        </Column>
        <!-- Natural-width badges that wrap: `wrapContent="true"`, the same
             property the shared-with Column below already uses. The one
             surviving colour tie is row badge <-> here, so these keep the
             item's own colour; the short label carries identity when two
             items collide on a hue, which they do past six items. -->
        <Column header="claimed by" width="3*">
          <Text overflowMode="flow" value="{window.__bramJoinIds($item.claimants)}" />
        </Column>
      </Table>
    </VStack>
    <!-- worklist2-new-item-parity: thin composition of existing pieces.
         IsolatedDraftEditor brings the placeholder protocol, voice, paste
         and drag-resize as a unit (voice/paste target new-item, shared
         with the old dialog's machinery); the issue Select restores the
         issue-driven path (issue-<N>- ids + closesIssues key off the
         composed phrasing). The instructional prose is gone by design. -->
    <DataSource
      id="w2OpenIssues"
      url="/__issues"
      when="{worklist2NewItemOpen}" />
    <VStack
      when="{worklist2NewItemOpen}"
      gap="$space-2"
      padding="$space-3"
      border="1px solid $color-surface-200"
      borderRadius="$borderRadius">
      <Select
        when="{!!w2OpenIssues.value}"
        placeholder="Optional: cite an open issue"
        data="{((w2OpenIssues.value) || []).filter(i => i.state === 'OPEN').map(i => ({value: i.number, label: '#' + i.number + ' ' + i.title}))}"
        initialValue="{worklist2NewItemIssue}"
        onDidChange="(v) => worklist2NewItemIssue = v" />
      <IsolatedDraftEditor
        id="w2NewItemEditor"
        placeholder="Describe what the item should change"
        minRows="2"
        maxRows="16"
        width="100%"
        voiceTarget="new-item"
        pasteTarget="new-item"
        inlineImagePreview="true"
        voiceTooltip="Dictate worklist item" />
      <HStack gap="$space-2">
        <Button
          label="Propose item"
          size="sm"
          onClick="(() => {
            const issuesArr = (w2OpenIssues.value) || [];
            const issueObj = worklist2NewItemIssue ? issuesArr.find(i => String(i.number) === String(worklist2NewItemIssue)) : null;
            const text = (w2NewItemEditor.getValue() || '').trim();
            if (!issueObj &amp;&amp; !text) return;
            let msg;
            if (issueObj &amp;&amp; text) { msg = 'Propose a worklist item to address #' + issueObj.number + ' (' + issueObj.title + '): ' + text; }
            else if (issueObj) { msg = 'Propose a worklist item to address #' + issueObj.number + ' (' + issueObj.title + ').'; }
            else { msg = 'Propose a worklist item: ' + text; }
            window.__bramIframeTrace('click', {target: 'worklist2-new-item', issue: issueObj ? issueObj.number : 0});
            toTurn(window.__bramWithStagedImageMarkers(msg, 'new-item'));
            worklist2NewItemOpen = false; worklist2NewItemIssue = null; setWorklistVoiceTarget('message-agent'); w2NewItemEditor.clear();
          })()" />
        <Button
          label="Cancel"
          variant="ghost"
          size="sm"
          onClick="worklist2NewItemOpen = false; worklist2NewItemIssue = null; setWorklistVoiceTarget('message-agent'); w2NewItemEditor.clear()" />
      </HStack>
    </VStack>
    <!-- Cutover complete: this IS the Worklist (nav label, heading,
         component name). Only the /worklist2 route remembers the preview
         era; the legacy tab survives behind Settings -> Show legacy
         Worklist as OldWorklist on the /worklist route. -->
    <Text
      when="{worklist.value &amp;&amp; (!worklist.value.items || worklist.value.items.length === 0)}"
      color="$textColor-secondary">
      (no items)
    </Text>
    <Items data="{worklist.value &amp;&amp; worklist.value.items ? worklist.value.items : []}">
      <!-- Row separation (review 2026-08-20): breathing room between
           items, which matters most when rows are expanded. Tightened
           2026-08-24 from $space-4 to $space-2 — with the stage glyph column
           gone (6d5d05b) each collapsed row is a single line of text, and
           four units of padding under a one-line row read as a gap rather
           than as separation. Expanded rows still get their air from the
           inner gap. -->
      <VStack gap="$space-1" paddingBottom="$space-2">
        <!-- worklist2-remove-expander-chrome: no indicator glyphs (History's
             chrome-free section headers are the precedent); the header line
             itself is the toggle. The selection Checkbox sits OUTSIDE the
             toggling region so ticking never flips expansion. -->
        <HStack gap="$space-2" verticalAlignment="center">
          <Checkbox
            initialValue="{(worklist2Selected || []).includes($item.id) || window.__bramWorklist2RowClaimed(inflightClaim.value, $item.id)}"
            enabled="{window.__bramWorklist2RowSelectable(inflightClaim.value)}"
            onDidChange="(v) => worklist2Selected = window.__bramToggleRowSelection(worklist2Selected || [], $item.id, v)" />
          <HStack
            gap="$space-2"
            verticalAlignment="center"
            width="*"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id)">
          <!-- rethink-activity-indicators: row-prepended spinner while
               the HOST's claim covers this item — a decision being
               carried out, host state, never inferred agent activity.
               A plural (batch) claim lights all its rows. -->
          <Theme size-Spinner="14px">
            <Spinner when="{window.__bramItemInflightKind(inflightClaim.value, $item.id, '', '', 0)}" />
          </Theme>
          <!-- Badge's text prop is `value` (not `label` — the
               ExpandableItem doc's summary example is wrong, filed
               upstream as xmlui-org/xmlui#3814). Contrast matched to
               Search's facet chips via theme vars:
               https://www.xmlui.org/docs/howto/theme-badge-colors-and-sizes -->
          <!-- The stage glyph column is GONE (2026-08-24). It sat in a
               fixed-width slot precisely so state could be read vertically
               without reading any row - but the strip beside it already names
               the same state in words, three characters to the right, so the
               glyph said nothing the word did not and cost a legend to learn.
               Same argument that retired the per-item colours: an accelerator
               that stopped paying for itself.
               The four designed states collapsed to three in practice (Jon:
               "with the agent, proposed, and will commit are the only three
               states you are likely to see"), and encoding that few as shapes
               is a legend for a distinction nobody needed help with.
               What was genuinely lost: the glyphs formed a straight left edge,
               and the strip text cannot, since it trails a variable-length id.
               That was judged not load-bearing because the states differ by
               length and colour, not subtly - a lone "Will commit +70 -2 ..."
               row is unmissable among "Proposed" rows. If state-scanning ever
               does get hard at higher density, the fix is an aligned column for
               the TEXT, not new glyphs - and note the 18rem fixed-width badge
               slot tried earlier wrapped to two lines and was worse than the
               raggedness it fixed.
               `__bramWorklist2Stage` is now DEAD - the icon was its only
               caller, so `.icon`, `.label` and `.yours` all have zero consumers.
               Left in `helpers.js` rather than deleted in this edit, which
               would mean separating hunks in a file already carrying another
               item's uncommitted work. Its removal is a follow-up. -->
          <!-- The badge carries the item's colour, and the Shared files
               table's claimant names carry the same one, so a claimant can be
               matched to its row without reading either id. -->

            <!-- The id, not a derived short label. Rung 3 shortened these to
                 `#278 · SEMANTIC` and it did fix the measured problem - badge
                 width spread fell 22 -> 12 chars, which is what made the
                 strip's left edge ragged at ten items. But it invented a
                 SECOND NAME for something that already had one, and the alias
                 leaked into prose: "commit #278 · OVERLAP" is not an
                 instruction anyone can act on without translating it back.
                 Jon: "The short names are making it hard for me to follow your
                 instructions and that is an indictment of the method."

                 Truncation preserves identity; a derived label creates an
                 alias. So the raggedness is fixed with WIDTH - a fixed slot
                 the badge clips inside - and the name stays the id. -->
          <!-- Plain primary text, no background. This was the last Badge in
               the Worklist; the grey chip was the residue of the colour
               encoding after the colour itself was removed, and a chip with no
               colour is just a background asking to be read as one.
               Natural width, so it never wraps (Jon: "make the main badges not
               wrap"); the earlier fixed-width slot is what forced two-line
               ids. -->
          <Text value="{$item.id}" tooltip="{$item.id}" />
          <!-- Basenames in the line, full paths in the tooltip: the row is a
               scan line and repo-relative paths would swamp it.

               Base size, not -sm (Jon, on the first live render: "messages
               need larger font so the new colorized text has a chance to stand
               out"). At -sm the amber had too little ink to register as a
               signal at all - the colour was carrying meaning the type was too
               small to deliver. -->
          <Text
            color="$textColor-secondary"
            tooltip="{window.__bramWorklist2StripTooltip($item, inflightClaim.value, worklist.value &amp;&amp; worklist.value.items)}"
            value="{window.__bramWorklist2Strip($item, inflightClaim.value, worklist.value &amp;&amp; worklist.value.items)}" />
          <!-- issue-278: the row backlink is GONE, on live evidence.
               It was redundant and, worse, it put a SECOND meaning of "shared"
               on a line that already had one. Live board, 2026-08-24:

                 Will commit +323 -2 in 2 of 2 planned - 1 shared - last: ...
                                                        ^ shared CHANGED files
                                        ... shares 2 files with 2 items
                                                   ^ shared CLAIMED files

               Two numbers, two meanings, one line. Jon: "I don't think the
               colorized message is helping us here ... they just make the whole
               message row too long ... a more compact and less misleading
               solution."

               The expanded row's SHARED WITH column already does this job and
               does it better: colour-matched claimant badges, per file, where
               the file is the subject. Overlap is a property of files, so the
               file table is where it belongs; the scan line keeps one sentence
               with one meaning. Board-level total stays in the header. -->
          </HStack>
        </HStack>
        <VStack
          when="{(expandedKeys || []).includes($item.id)}"
          gap="$space-2"
          paddingLeft="$space-6">
          <!-- No section header: the table renders directly on row expand
               (review 2026-08-20: "On expand the table tells the story with
               one less click"). Plan-vs-activity survives in the CONTENT:
               plain name list for plans, activity table for begun rows. -->
          <VStack
            when="{($item.changedFiles || window.__bramWorklistItemFiles($item)).length > 0}"
            gap="$space-1"
            var.rowBegun="{window.__bramWorklist2Begun($item, inflightClaim.value)}">
            <!-- Files touched as a Table (Status.xmlui idiom). Per-file
                 shared-files flags live here beside the file they concern,
                 not on the status line. Plain-path fallback covers payloads
                 without the rung-1 enrichment. -->
            <!-- The table renders for plan rows too (review 2026-08-20:
                 "the table display with the file overlap is important for
                 understanding what to do next and possible entanglement").
                 Only the activity numbers are begun-gated - a plan row
                 shows path + shared-with, never sibling bleed as its own
                 changes. -->
            <!-- The table renders for every row, including plan rows with
                 nothing in the numeric columns. Swapping to a plain list when
                 there was nothing to report made the shape jump between rows
                 and read as two different displays; the header carries the
                 meaning instead. "files expected to change" is true before any
                 work happens (it is the plan) and stays true after (it is what
                 changed), so one label covers the whole lifecycle and the
                 empty cells read as not-yet rather than missing. -->
            <Table
              when="{$item.changedFiles}"
              data="{$item.changedFiles}">
              <Column header="files expected to change" width="2*">
                <Text value="{$item.path}" variant="code" fontSize="$fontSize-sm" />
              </Column>
              <Column header="changes" width="140px">
                <Text
                  variant="code"
                  fontSize="$fontSize-sm"
                  value="{!rowBegun || $item.status === 'unchanged' ? '' : '+' + $item.added + ' −' + $item.removed + ($item.status === 'new' ? ' (new)' : ($item.status === 'deleted' ? ' (deleted)' : ''))}" />
              </Column>
              <!-- Plain text, not badges. This column started as coloured
                   badges matching each claimant's row badge, then lost its
                   colour (too many coloured chips in one plane), and now loses
                   the chip too. Jon: "We don't want the shared with to be
                   badges at all. Now, just normal primary text."

                   The reasoning that survives from the badge era: a chip is a
                   recognition affordance, and recognition is what the ONE
                   surviving colour tie - row badge to CLAIMED BY in the
                   overlap index - is for. Repeating the shape here, inside
                   every expanded row, spent the affordance on a surface that
                   only needs to be read. Short labels made that affordable:
                   `#278 · SEMANTIC` is legible as prose in a way a 45-char id
                   never was.

                   Tooltip still carries the full id, because the label is a
                   derived shortening and `tooltip` feeds aria-label. -->
              <Column header="shared with" width="3*">
<Text
                  when="{$item.sharedWith &amp;&amp; $item.sharedWith.length > 0}"
                  overflowMode="flow"
                  value="{window.__bramJoinIds($item.sharedWith)}" />
              </Column>
            </Table>
            <!-- Fallback for payloads without the rung-1 enrichment, where
                 there is no changedFiles array to build a table from. -->
            <Items
              when="{!$item.changedFiles}"
              data="{window.__bramWorklistItemFiles($item)}">
              <Text value="{$item}" variant="code" fontSize="$fontSize-sm" />
            </Items>
          </VStack>
          <HStack
            when="{$item.before}"
            gap="$space-1"
            verticalAlignment="center"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::before')">
            <Text value="Before" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::before') &amp;&amp; $item.before}"
            paddingLeft="$space-6">
            <Markdown content="{$item.before}" interpolateBindings="false" allowHtml="false" />
          </VStack>
          <HStack
            when="{$item.after}"
            gap="$space-1"
            verticalAlignment="center"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::after')">
            <Text value="After" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::after') &amp;&amp; $item.after}"
            paddingLeft="$space-6">
            <Markdown content="{$item.after}" interpolateBindings="false" allowHtml="false" />
          </VStack>
          <HStack
            when="{$item.diff}"
            gap="$space-1"
            verticalAlignment="center"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::diff')">
            <Text value="Diff" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::diff') &amp;&amp; $item.diff}"
            gap="$space-1"
            paddingLeft="$space-6">
            <DiffView text="{cappedDiffText($item.diff || '')}" />
          </VStack>
          <!-- worklist2-commit-action: the close declaration as stated fact
               with tickbox override on begun rows (default ticked; untick
               to keep an issue open) — the old tab's inline pattern, at
               its final home. Plan rows keep the plain declaration. -->
          <!-- worklist2-dim-sent-feedback (as clarified): a Feedback
               SECTION under Diff - multiple entries, reverse
               chronological, rendered exactly as worklist-history does.
               Entries accumulate per verb-send for the item's life on
               the board. -->
          <HStack
            when="{(((worklist2Sent || {})[$item.id] || []).concat($item.feedbackHistory || [])).length > 0}"
            gap="$space-1"
            verticalAlignment="center"
            onClick="expandedKeys = window.__bramFlipExpansionKey(expandedKeys, $item.id + '::feedback')">
            <Text value="Feedback" />
          </HStack>
          <VStack
            when="{(expandedKeys || []).includes($item.id + '::feedback') &amp;&amp; (((worklist2Sent || {})[$item.id] || []).concat($item.feedbackHistory || [])).length > 0}"
            gap="$space-2"
            paddingLeft="$space-6">
            <Items data="{(((worklist2Sent || {})[$item.id] || []).concat($item.feedbackHistory || []))}">
              <VStack gap="$space-1">
                <Text
                  fontSize="$fontSize-xs"
                  color="$textColor-secondary"
                  value="{'Feedback · ' + new Date($item.atMs).toLocaleTimeString()}" />
                <Markdown content="{$item.text}" interpolateBindings="false" allowHtml="false" />
              </VStack>
            </Items>
          </VStack>
          <!-- worklist2-closes-once: the strip already declares closes for
               plans; this row appears only once begun, when its tickboxes
               and comment box are interactive. -->
          <HStack
            when="{$item.closesIssues &amp;&amp; $item.closesIssues.length > 0 &amp;&amp; window.__bramWorklist2Begun($item, inflightClaim.value)}"
            gap="$space-2"
            verticalAlignment="center"
            var.witem="{$item}">
            <Text value="closes" fontSize="$fontSize-sm" color="$textColor-secondary" />
            <Items data="{$item.closesIssues}">
              <HStack gap="$space-0_5" verticalAlignment="center" var.issue="{normalizeCloseIssue($item)}">
                <Checkbox
                  when="{window.__bramWorklist2Begun(witem, inflightClaim.value)}"
                  initialValue="{true}"
                  onDidChange="(v) => worklist2Close = window.__bramInlineCloseToggle(worklist2Close, witem.id, issue.number, v, witem.closesIssues)" />
                <Text value="{'#' + issue.number}" fontSize="$fontSize-sm" tooltip="{issue.title || ''}" />
                <TextBox
                  when="{window.__bramWorklist2Begun(witem, inflightClaim.value)}"
                  width="16rem"
                  placeholder="comment (optional)"
                  onDidChange="(v) => worklist2Close = window.__bramInlineCloseComment(worklist2Close, witem.id, issue.number, v, witem.closesIssues)" />
              </HStack>
            </Items>
          </HStack>
        </VStack>
      </VStack>
    </Items>
    <!-- worklist2-batch-selection (as clarified): ONE control row serves
         one or several — the Iterate-N principle applied to every verb.
         Appears when anything is ticked; the message is about the set and
         fans out to each selected item's payload entry. -->
    <!-- issue-278 rung 4: the gate row is never out of reach while a
         selection is live.

         The failure it fixes is structural, not incidental. This surface is
         gated on a selection existing and rendered INLINE after the list, so:
         tick a row -> the controls appear below the list -> expand the row you
         are deciding about -> the list grows -> the controls leave the
         viewport. Reading the thing you are deciding about is what hides the
         control for deciding. Jon: "the problem is losing the button row below
         the fold. That is the first, most important next thing to fix."

         StickySection stickTo="bottom" is the XMLUI-native answer and already
         the pane's idiom for the top edge (Transcript.xmlui:162,
         Search.xmlui:253).
         https://www.xmlui.org/docs/reference/components/StickySection

         Sticky gives most of the agreed contract structurally rather than by
         care: it IS an inline anchor that pins only when it would scroll out
         of view, so "inline when visible, docked when not" and the reserved
         height are the primitive's own behaviour. It repositions rather than
         re-creates, which satisfies the rule with teeth - the message box
         calls setWorklistVoiceTarget('feedback') on focus and paste routing
         reads that mirror, so a remount would drop focus, a half-typed
         message, or the paste target, and a pasted screenshot would land in
         the wrong box. Sticky cannot remount it.

         What sticky does NOT give is the latch (dock on first occlusion, stay
         docked until the selection clears): native sticky releases as soon as
         the anchor scrolls back into view, so collapsing a row pops the bar
         back inline. Deliberately not added yet - the flap may not be
         perceptible when the trigger is a deliberate expand/collapse rather
         than incidental scrolling, and that is worth observing before it is
         engineered around. -->
    <VStack
      when="{(worklist2Selected || []).length > 0}"
      gap="$space-1"
      padding="$space-2"
      borderRadius="$borderRadius"
      backgroundColor="$color-surface-50">
    <!-- issue-278: the composer and the gate buttons moved to the Footer.
         There were two message boxes - this one and the agent composer - and
         the fix is one box whose target is named by its placeholder (Jon: "The
         duplication of the message box here is resolved by only having one of
         them ... when you're on the Worklist page, it's targeting the selected
         set"). The buttons went with it, because the Footer is the only
         surface `vertical-sticky` pins; see WorklistGateBar.xmlui.
         What stays here is selection-scoped CONTENT - the shared-files table
         and the share-mode choice - which is reading material, not controls. -->
    <!-- Shared files. Not a banner: a plain table of state, always present
         while an overlap exists and NOT dismissible. It became dismissible
         when it was a warning written in prose, and dismissal outlived its
         usefulness the moment it stopped asserting a consequence and started
         reporting disk facts — a fact panel you can hide is a fact panel
         that silently lies by omission. (Live 2026-08-22: one ✕ click
         suppressed it across every later selection, which read as the table
         reacting to selection.) Removing it also removed the per-overlap
         dismissal signature that existed only to key that ✕. -->
    <VStack
      when="{window.__bramWorklistOverlapRows(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value).length > 0}"
      gap="$space-1"
      marginTop="$space-3">
      <Text fontSize="$fontSize-xs" color="$textColor-secondary"
        value="Shared files" />
      <!-- One ROW per entangled path, not one sentence per pair. The columns
           are the two things Bram can verify: what is on disk, and which items
           claim the path. It never asserts WHOSE changes those are — counts
           are per-path and no per-item attribution exists, so naming a source
           is a guess (see __bramWorklistOverlapRows). Selection is
           deliberately not an input: without an attribution claim the
           consequence is the same whatever is ticked, so the table holds still
           while you work. -->
      <Table data="{window.__bramWorklistOverlapRows(worklist.value &amp;&amp; worklist.value.items, inflightClaim.value)}">
        <Column header="file" width="2*">
          <Text value="{$item.path}" variant="code" fontSize="$fontSize-sm" />
        </Column>
        <Column header="on disk" width="140px">
          <Text value="{$item.disk}" variant="code" fontSize="$fontSize-sm" />
        </Column>
        <Column header="claimed by" width="3*">
          <!-- One badge per claimant, no colour. Identity is the id; colour
               was an accelerator that stopped being true past six items and is
               now removed everywhere (Jon: "Try getting rid of color entirely
               and make the main badges not wrap"). -->
          <Text overflowMode="flow" value="{window.__bramJoinIds($item.claimantIds)}" />
        </Column>
      </Table>
    </VStack>
    <!-- commit-granularity-and-start-consequence A+B.
         The gate WAS `__bramSelectionCommitSweepsShared`, so the choice
         appeared only when it was CONSTRAINED and never when it was free: two
         disjoint committable items landed in one commit with no way to say
         "these are unrelated". Now `SweepsShared` picks the option LABELS
         rather than deciding the control exists.

         A SIBLING of the Shared files section, not a child of it. It was first
         written nested inside, whose VStack is gated on
         `__bramWorklistOverlapRows(...).length > 0` - so the control asking
         "one commit or two?" could only appear when the BOARD had overlaps
         somewhere, which is exactly the disjoint case it was built to serve.
         Second time in one day: the unclaimed-changes section had the same
         defect (see 78d0e86). Selection-scoped questions do not belong inside
         board-scoped containers.

         `var.` attributes on this wrapper rather than nested `<variable>`
         elements: the documented form is "declare `var.name` on any container
         element" (xmlui.org/docs/howto/use-accessors-to-simplify-complex-expressions),
         every `<variable>` in this codebase sits at component-root level, and
         `Worklist.xmlui:11` already uses the attribute idiom. Extracted at all
         because an inline ternary in a binding defeats dependency tracking -
         the search-date endpoint labels froze for exactly that reason.

         With ONE selected item there is no choice to offer: if its files
         overlap an unselected begun item, the commit feedback requires
         separation and authorizes only the selected id. With two or more, the
         pick says whether those selected items land together or separately.
         Selection itself never expands. The explanatory sentence that used to
         sit under the options is gone - the two options ARE the explanation,
         and a caption restating them is the kind of compensating prose that
         keeps turning out to mean a control was missing. -->
    <VStack
      gap="$space-1"
      var.shareChoiceOpen="{(worklist2Selected || []).length >= 2 &amp;&amp; window.__bramSelectionAllCommittable(worklist.value &amp;&amp; worklist.value.items, worklist2Selected, inflightClaim.value, worklistConfig.value ? worklistConfig.value.oneClickApproveCommit : true)}"
      var.shareChoiceEntangled="{window.__bramSelectionCommitSweepsShared(worklist.value &amp;&amp; worklist.value.items, worklist2Selected, inflightClaim.value, worklistConfig.value ? worklistConfig.value.oneClickApproveCommit : true)}"
      var.shareSplitLabel="{shareChoiceEntangled ? 'A commit each — needs their shared hunks separated first, and that can fail partway' : 'A commit each — selected items land separately'}">
      <RadioGroup
        marginTop="$space-3"
        when="{shareChoiceOpen}"
        initialValue="{worklist2ShareMode}"
        onDidChange="(v) => worklist2ShareMode = v">
        <Option value="together" label="One commit — selected items land together" />
        <Option value="split" label="{shareSplitLabel}" />
      </RadioGroup>
    </VStack>
    </VStack>
    <!-- Parity: You/Agent last-exchange dock (old tab's shape, simplified:
         no fullscreen image viewer; dim while a newer user message awaits
         its answer). -->
    <VStack var.dockExchange="{projectedTurnsDS.value || window.__bramProjectedLastExchange(null)}">
      <!-- Dim the last exchange while a selection is live (Jon: "Dim the last
           message and response while this is going on, while any selections
           are active and while the buttons are then visible below").
           With a selection the gate bar is showing in the Footer and the
           question on screen is what to DO with the ticked rows; the previous
           turn is context, not the subject. Recedes rather than disappears -
           it is often what you are deciding about. -->
      <VStack
        when="{(dockExchange.lastExchange &amp;&amp; dockExchange.lastExchange.userText) || (dockExchange.lastAssistantText &amp;&amp; dockExchange.lastAssistantText.text)}"
        opacity="{(worklist2Selected || []).length > 0 ? 0.4 : 1}"
        gap="$space-2"
        width="100%"
        paddingTop="$space-4">
        <VStack
          when="{dockExchange.lastExchange &amp;&amp; dockExchange.lastExchange.userText}"
          gap="$space-1"
          width="100%">
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="You: last message" />
          <VStack maxHeight="12em" overflowY="auto" width="100%">
            <Markdown content="{dockExchange.lastExchange.userText}" interpolateBindings="false" allowHtml="false" />
          </VStack>
        </VStack>
        <VStack
          when="{dockExchange.lastAssistantText &amp;&amp; dockExchange.lastAssistantText.text}"
          gap="$space-1"
          width="100%"
          opacity="{(dockExchange.lastExchange &amp;&amp; dockExchange.lastExchange.userText &amp;&amp; !dockExchange.lastExchange.assistantText) ? 0.45 : 1}">
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="Agent: last response" />
          <VStack maxHeight="20em" overflowY="auto" width="100%">
            <Markdown content="{window.__bramStripImagePaths(dockExchange.lastAssistantText.text)}" interpolateBindings="false" allowHtml="false" />
          </VStack>
        </VStack>
      </VStack>
    </VStack>
  </VStack>
</Component>
