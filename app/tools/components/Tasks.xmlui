<Component
  name="Tasks"
  var.tick="{0}"
  var.showAll="{false}"
  var.expanded="{[]}">

  <!-- issue-483-task-candidates-report: the measurement before the feature.
       judell/bram#483 asks for Tasks (a repeated command saved to an external
       runner). Before building any of that, this read-only page shows what
       such a feature would have captured: shell commands the agents repeated,
       clustered by recipe. Fetched once on open and on Refresh (a tick in the
       URL); no polling (docs/developing-bram.md Push over polling).
       https://www.xmlui.org/docs/reference/components/DataSource -->
  <DataSource id="cands" url="{'/__tasks/candidates?t=' + tick}" />

  <VStack padding="$space-6" gap="$space-4">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Tasks</Heading>
      <Button label="Refresh" size="xs" variant="outlined" onClick="tick = tick + 1" />
    </HStack>
    <!-- Words for a reader new to repos (Jon, 2026-11-09: "joyce will not
         have any idea what a runner is"): no "runner", "target" or "recipe"
         here. The page talks about commands the agents keep running, and
         about a file of saved commands, named by its filename. -->
    <Text color="$textColor-secondary"
      value="Commands the agents in this project keep running, and how many ways they've been typed. The ways typed are of two kinds: the same job with slightly different arguments, which one saved command would replace, and different jobs done with the same tool, each a saved command of its own. Telling them apart takes the context a command ran in, which the agent has and this page doesn't. This version of the page only reads; nothing here runs or changes anything." />
    <!-- The plan, in Jon's words (2026-11-09): "Let's even be more explicit
         about it": four iterations, this page being the first. Markdown for
         the bullet list, as the Log and History entries render theirs.
         https://www.xmlui.org/docs/reference/components/Markdown -->
    <Heading level="h3">Provisional plan for this feature, staged across releases</Heading>
    <Markdown interpolateBindings="false" allowHtml="false"
      content="{['- **v0.8.6:** Gather evidence about single commands that are typed in several ways: which are one job that could be normalized to one saved command, and which are different jobs sharing a tool. Once normalized, agents can look a command up and use it the same way every time.', '- **v0.8.7:** Offer a Save as Task button. The agent will convert the placeholder name to one derived from context, and you will be able to rewrite it. A Run button will let you run the task interactively, and agents will be able to look it up by name and run it.', '- **v0.8.8:** Gather evidence again, this time looking for compositions of named tasks that can be captured, named, and handled the same way.', '- **v0.8.9:** Add compositions to Save as Task.'].join('\n')}" />
    <!-- Names are placeholders (Jon, 2026-11-09): the real name comes from
         the agent, from the context the command ran in, when a task is
         saved, and is editable then. Not editable here. -->
    <Text fontSize="$fontSize-sm" color="$textColor-secondary"
      value="The names shown are placeholders. When saving arrives, the agent will propose each name from the context the command ran in, and you can change it then." />
    <Spinner when="{!cands.loaded}" />
    <VStack when="{cands.loaded &amp;&amp; !!cands.value}" gap="$space-2">
      <Text value="{'From ' + cands.value.commands + ' shell commands in ' + cands.value.sessions + ' sessions.'}" />
      <!-- tasks-page-prioritizes (Jon, 2026-11-09: "the output is pretty
           overwhelming. how can we help people prioritize?"): one sentence
           naming the few commands that hold most of the repetition, then a
           table of the rows that recur widely, the rest folded. The
           ranking and the fold live in helpers.js (__bramTaskRows). -->
      <Text when="{!!window.__bramTaskHeadline(cands.value)}" fontWeight="$fontWeight-bold"
        value="{window.__bramTaskHeadline(cands.value)}" />
      <Text when="{!cands.value.runner || !cands.value.runner.files || cands.value.runner.files.length == 0}"
        value="This project has no file of saved commands yet." />
      <Text when="{!!cands.value.runner &amp;&amp; !!cands.value.runner.files &amp;&amp; cands.value.runner.files.length > 0}"
        value="{'Saved commands live in ' + cands.value.runner.files.join(', ') + ': ' + (cands.value.runner.targets || []).join(', ')}" />
      <Text fontSize="$fontSize-sm" color="$textColor-secondary"
        value="{'Left out: ' + cands.value.excluded.bramProtocol + ' that talk to Bram, ' + cands.value.excluded.shell + ' that look around or tidy up, ' + cands.value.excluded.git + ' git, ' + cands.value.excluded.forge + ' GitHub/GitLab.'}" />
    </VStack>

    <Text when="{cands.loaded &amp;&amp; !!cands.value &amp;&amp; (cands.value.candidates || []).length == 0}"
      value="No repeated shell commands yet." />

    <!-- A List of rows rather than a Table with a details row: expansion is
         controlled and keyed by candidate key (the Log pattern), because the
         rows change on Refresh and ExpandableItem's own state is positional
         (docs/developing-bram.md Failure modes).
         https://www.xmlui.org/docs/howto/keep-per-item-state-in-a-loop
         https://www.xmlui.org/docs/reference/components/Items -->
    <HStack when="{cands.loaded &amp;&amp; !!cands.value &amp;&amp; (cands.value.candidates || []).length > 0}"
      gap="$space-3" paddingHorizontal="$space-1">
      <Text width="*" fontSize="$fontSize-sm" color="$textColor-secondary" value="Command" />
      <Text width="4rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="Runs" />
      <Text width="5rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="Sessions" />
      <Text width="9rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="Agents" />
      <Text width="6rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="Ways typed" />
    </HStack>
    <Items data="{window.__bramTaskRows(cands.value, showAll)}">
      <VStack gap="$space-1">
        <HStack testId="task-row" gap="$space-3" verticalAlignment="center" cursor="pointer"
          paddingHorizontal="$space-1"
          onClick="expanded = window.__bramToggleInArray(expanded, $item.key)">
          <HStack width="*" gap="$space-2" verticalAlignment="center">
            <Text color="$textColor-secondary" value="{expanded.includes($item.key) ? '▾' : '▸'}" />
            <!-- width="*" gives breakMode a bound to break against; without
                 it the code text sizes to its content and never wraps
                 (Jon, 2026-11-09: "long lines should wrap").
                 https://www.xmlui.org/docs/reference/components/Text -->
            <Text width="*" variant="code" breakMode="anywhere" value="{$item.key}" />
          </HStack>
          <Text width="4rem" value="{$item.runs}" />
          <Text width="5rem" value="{$item.sessions}" />
          <Text width="9rem" value="{($item.agents || []).join(', ')}" />
          <Text width="6rem" value="{($item.spellings || []).length}" />
        </HStack>
        <VStack when="{expanded.includes($item.key)}" paddingLeft="$space-5" gap="$space-1">
          <!-- Same job or different jobs? (Jon, 2026-11-09: "Sometimes, Bram
               Studio uses FFmpeg with slightly different arguments to do the
               same thing. Sometimes, it is using FFmpeg to do completely
               different things. We need to differentiate.") The host can't
               from the text alone: in bram-studio five ffprobe spellings all
               read a duration, while ffmpeg-loudnorm and ffmpeg-silencedetect
               are different jobs. The names are its guess; a trailing number
               means it couldn't tell two spellings apart. -->
          <Text fontSize="$fontSize-sm" color="$textColor-secondary"
            value="Some of these are one job typed differently, some are different jobs with the same tool. The names are a first guess from the command text; a name ending in a number means the guess could not tell two spellings apart. The agent will sort them out, with the context each ran in, when it offers to save." />
          <!-- Each repeated spelling is the unit a saved command would name.
               The host's placeholder name ($item.name) is shown, not edited:
               the agent proposes the real one when a task is saved. -->
          <Items data="{$item.spellings || []}">
            <HStack gap="$space-2" verticalAlignment="start">
              <Text width="3.5rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="{$item.runs + '×'}" />
              <Text width="12rem" fontSize="$fontSize-sm" color="$textColor-secondary" breakMode="anywhere" value="{$item.name}" />
              <Text width="*" variant="code" breakMode="anywhere" value="{$item.text}" />
            </HStack>
          </Items>
        </VStack>
      </VStack>
    </Items>
    <!-- The fold: rows seen in fewer sessions, or past the top 10, are one
         line and a button, so a newcomer's first look is the few that matter. -->
    <HStack when="{cands.loaded &amp;&amp; !!cands.value &amp;&amp; (showAll || window.__bramTaskHidden(cands.value, showAll) > 0)}"
      gap="$space-3" verticalAlignment="center" paddingHorizontal="$space-1">
      <Text fontSize="$fontSize-sm" color="$textColor-secondary"
        value="{window.__bramTaskFoldLine(cands.value, showAll)}" />
      <Button size="xs" variant="outlined" label="{showAll ? 'Show fewer' : 'Show all'}"
        onClick="showAll = !showAll" />
    </HStack>
  </VStack>
</Component>
