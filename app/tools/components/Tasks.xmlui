<Component
  name="Tasks"
  var.tick="{0}"
  var.showAll="{false}"
  var.expanded="{[]}"
  var.infoKey="">

  <!-- issue-483-task-candidates-report: the measurement before the feature.
       judell/bram#483 asks for Tasks (a repeated command saved to an external
       runner). Before building any of that, this read-only page shows what
       such a feature would have captured: shell commands the agents repeated,
       clustered by recipe. Fetched once on open and on Refresh (a tick in the
       URL); no polling (docs/developing-bram.md Push over polling).
       https://www.xmlui.org/docs/reference/components/DataSource -->
  <DataSource id="cands" url="{'/__tasks/candidates?t=' + tick}" />

  <VStack padding="$space-6" gap="$space-4">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Tasks</Heading>
      <Button label="Refresh" size="xs" variant="outlined" onClick="tick = tick + 1" />
    </HStack>
    <!-- Words for a reader new to repos (Jon, 2026-11-09: "joyce will not
         have any idea what a runner is"): no "runner", "target" or "recipe"
         here. The page talks about commands the agents keep running, and
         about a file of saved commands, named by its filename. -->
    <!-- The button's label in bold, so the sentence names what to click
         without looking clickable itself (Jon, 2026-11-12). Inline Text, as
         Main.xmlui's banners nest theirs. -->
    <Text color="$textColor-secondary">
      Commands the agents in this project keep running, and the ways each was typed. Nothing here needs doing.
      <Text inline="true" fontWeight="$fontWeight-bold" value="Save as task" />
      is optional housekeeping: it gives a command one name in the project's Makefile, which agents or you can run instead of retyping it. If you practice continuous integration (CI), this makes the same commands available in that environment.
    </Text>
    <!-- The plan, in Jon's words (2026-11-09): "Let's even be more explicit
         about it": four iterations, this page being the first. A done step
         is struck through (~~…~~: the vendored XMLUI bundles remark-gfm,
         which the Markdown docs don't mention). Markdown for
         the bullet list, as the Log and History entries render theirs.
         https://www.xmlui.org/docs/reference/components/Markdown -->
    <Heading level="h3">Provisional plan for this feature, staged across releases</Heading>
    <Markdown interpolateBindings="false" allowHtml="false"
      content="{['- ~~**v0.8.6:** Gather evidence about single commands that are typed in several ways: which are one job that could be normalized to one saved command, and which are different jobs sharing a tool. Once normalized, agents can look a command up and use it the same way every time.~~', '- ~~**v0.8.7:** A Save as Task button. The agent names each task from the context its command ran in and saves it in the Makefile, where agents look it up and run it by name.~~', '- **v0.?.?:** Gather evidence again, this time looking for compositions of named tasks that can be captured, named, and handled the same way.', '- **v0.?.?:** Add compositions to Save as Task.'].join('\n')}" />
    <Spinner when="{!cands.loaded}" />
    <VStack when="{cands.loaded &amp;&amp; !!cands.value}" gap="$space-2">
      <Text value="{'From ' + cands.value.commands + ' shell commands in ' + cands.value.sessions + ' sessions.'}" />
      <!-- tasks-page-prioritizes (Jon, 2026-11-09: "the output is pretty
           overwhelming. how can we help people prioritize?"): one sentence
           naming the few commands that hold most of the repetition, then a
           table of the rows that recur widely, the rest folded. The
           ranking and the fold live in helpers.js (__bramTaskRows). -->
      <Text when="{!!window.__bramTaskHeadline(cands.value)}" fontWeight="$fontWeight-bold"
        value="{window.__bramTaskHeadline(cands.value)}" />
      <Text when="{!cands.value.runner || !cands.value.runner.files || cands.value.runner.files.length == 0}"
        value="This project has no file of saved tasks yet." />
      <!-- The saved-tasks line and the "Left out" counts moved into the
           header's ⓘ for Saved and Command (Jon, 2026-11-12: "remove this
           clutter"). -->
    </VStack>

    <Text when="{cands.loaded &amp;&amp; !!cands.value &amp;&amp; (cands.value.candidates || []).length == 0}"
      value="No repeated shell commands yet." />

    <!-- A List of rows rather than a Table with a details row: expansion is
         controlled and keyed by candidate key (the Log pattern), because the
         rows change on Refresh and ExpandableItem's own state is positional
         (docs/developing-bram.md Failure modes).
         https://www.xmlui.org/docs/howto/keep-per-item-state-in-a-loop
         https://www.xmlui.org/docs/reference/components/Items -->
    <HStack when="{cands.loaded &amp;&amp; !!cands.value &amp;&amp; (cands.value.candidates || []).length > 0}"
      gap="$space-3" paddingHorizontal="$space-1">
      <!-- ⓘ per header (Jon, 2026-11-12), Status's info-button look. The
           click sets infoKey; the dialog below shows when it is set, as
           newSessionDialog does, so the handler stays one assignment.
           https://www.xmlui.org/docs/reference/components/ModalDialog -->
      <HStack width="*" gap="0" verticalAlignment="center">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="Command" />
        <Button icon="info" size="xs" variant="ghost" tooltip="About Command" onClick="infoKey = 'command'" />
      </HStack>
      <HStack width="4rem" gap="0" verticalAlignment="center">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="Runs" />
        <Button icon="info" size="xs" variant="ghost" tooltip="About Runs" onClick="infoKey = 'runs'" />
      </HStack>
      <HStack width="5rem" gap="0" verticalAlignment="center">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="Sessions" />
        <Button icon="info" size="xs" variant="ghost" tooltip="About Sessions" onClick="infoKey = 'sessions'" />
      </HStack>
      <HStack width="9rem" gap="0" verticalAlignment="center">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="Agents" />
        <Button icon="info" size="xs" variant="ghost" tooltip="About Agents" onClick="infoKey = 'agents'" />
      </HStack>
      <HStack width="6rem" gap="0" verticalAlignment="center">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="Ways typed" />
        <Button icon="info" size="xs" variant="ghost" tooltip="About Ways typed" onClick="infoKey = 'ways'" />
      </HStack>
      <HStack width="9rem" gap="0" verticalAlignment="center">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="Saved" />
        <Button icon="info" size="xs" variant="ghost" tooltip="About Saved" onClick="infoKey = 'saved'" />
      </HStack>
    </HStack>
    <Items data="{window.__bramTaskVisibleRows(cands.value, showAll, expanded)}">
      <VStack gap="$space-1">
        <HStack testId="task-row" gap="$space-3" verticalAlignment="center"
          paddingHorizontal="$space-1">
          <!-- The toggle is on the cells, not the row, so a click on the Save
               as task button does not also expand the row. -->
          <HStack width="*" gap="$space-2" verticalAlignment="center" cursor="pointer"
            onClick="expanded = window.__bramToggleInArray(expanded, $item.key)">
            <!-- Full-size ▶ / ▼ in xl, as the Worklist files table's
                 disclosure triangle (Jon, 2026-11-12: "make the right and down
                 arrows bigger as they are there"). -->
            <Text fontSize="$fontSize-xl" color="$textColor-secondary" value="{window.__bramTaskChevron(expanded, $item.key)}" />
            <!-- width="*" gives breakMode a bound to break against; without
                 it the code text sizes to its content and never wraps
                 (Jon, 2026-11-09: "long lines should wrap").
                 https://www.xmlui.org/docs/reference/components/Text -->
            <!-- A saved row names its tasks under the command, in this flexible
                 cell: the fixed cells to the right overflow a narrow pane, and
                 the names were cut off there (Jon, 2026-11-12). -->
            <VStack width="*" gap="0">
              <Text variant="code" breakMode="anywhere" value="{$item.key}" />
              <Text when="{!!($item.savedAs &amp;&amp; $item.savedAs.length > 0)}" fontSize="$fontSize-sm"
                color="$textColor-secondary" breakMode="word" value="{window.__bramTaskSavedLine($item)}" />
            </VStack>
          </HStack>
          <Text width="4rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{$item.runs}" />
          <Text width="5rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{$item.sessions}" />
          <Text width="9rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{($item.agents || []).join(', ')}" />
          <Text width="6rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{($item.spellings || []).length}" />
          <!-- Save as task: one call, the payload is built in helpers.js. A
               saved row reads its names instead. The click must not toggle
               the row, hence the wrapper stops propagation.
               https://www.xmlui.org/docs/reference/components/Button -->
          <HStack width="9rem" verticalAlignment="center">
            <Button when="{!($item.savedAs &amp;&amp; $item.savedAs.length > 0)}" size="xs" variant="outlined"
              label="Save as task" onClick="window.__bramSaveTaskTurn($item)" />
            <Button when="{!!($item.savedAs &amp;&amp; $item.savedAs.length > 0)}" size="xs" variant="ghost"
              label="View" tooltip="Open the Makefile at these saved tasks"
              onClick="window.__bramTaskViewSaved($item)" />
          </HStack>
        </HStack>
        <VStack when="{expanded.includes($item.key)}" paddingLeft="$space-5" gap="$space-1">
          <!-- Same job or different jobs? (Jon, 2026-11-09: "Sometimes, Bram
               Studio uses FFmpeg with slightly different arguments to do the
               same thing. Sometimes, it is using FFmpeg to do completely
               different things. We need to differentiate.") The host can't
               from the text alone: in bram-studio five ffprobe spellings all
               read a duration, while ffmpeg-loudnorm and ffmpeg-silencedetect
               are different jobs. The names are its guess; a trailing number
               means it couldn't tell two spellings apart. -->
          <!-- breakMode="word": wrap between words, inside one only when it
               can't fit (https://www.xmlui.org/docs/reference/components/Text).
               issue-483-save-as-task (Jon, 2026-11-12: "the explanation under
               cargo test is completely confusing"): a saved row says what it
               was saved as; an unsaved row says what saving would do. -->
          <Text fontSize="$fontSize-sm" color="$textColor-secondary"
            value="{window.__bramTaskRowNote($item, cands.value)}" />
          <!-- A saved row's runs by name, one row per task: a small Table, as
               the Worklist's files table and Status use.
               https://www.xmlui.org/docs/reference/components/Table -->
          <Table when="{window.__bramTaskByNameRows($item, cands.value).length > 0}"
            data="{window.__bramTaskByNameRows($item, cands.value)}" idKey="name">
            <Column header="Saved task" width="2*">
              <Text variant="code" fontSize="$fontSize-sm" value="{$item.name}" />
            </Column>
            <Column header="Runs by name" width="*" bindTo="runs" />
            <Column header="Sessions" width="*" bindTo="sessions" />
          </Table>
          <!-- Each repeated spelling is the unit a saved command would name.
               The host's placeholder names aren't shown (Jon, 2026-11-12:
               "lose the provisional names"); they still go to the agent in
               the save-task payload as hints. -->
          <Items data="{window.__bramTaskSpellings($item)}">
            <HStack gap="$space-2" verticalAlignment="start">
              <Text width="3.5rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="{$item.runs + '×'}" />
              <Text width="*" variant="code" breakMode="anywhere" value="{$item.text}" />
              <Text when="{!!$item.nowLine}" width="20rem" fontSize="$fontSize-sm"
                color="$textColor-secondary" breakMode="word" value="{$item.nowLine}" />
            </HStack>
          </Items>
        </VStack>
      </VStack>
    </Items>
    <!-- The fold: rows seen in fewer sessions, or past the top 10, are one
         line and a button, so a newcomer's first look is the few that matter. -->
    <HStack when="{cands.loaded &amp;&amp; !!cands.value &amp;&amp; !window.__bramTaskAnyOpen(cands.value, showAll, expanded) &amp;&amp; (showAll || window.__bramTaskHidden(cands.value, showAll) > 0)}"
      gap="$space-3" verticalAlignment="center" paddingHorizontal="$space-1">
      <Text fontSize="$fontSize-sm" color="$textColor-secondary"
        value="{window.__bramTaskFoldLine(cands.value, showAll)}" />
      <Button size="xs" variant="outlined" label="{showAll ? 'Show fewer' : 'Show all'}"
        onClick="showAll = !showAll" />
    </HStack>

    <!-- task-protocol-filter-sees-url-variables: the calls agents make to
         Bram itself (search, advance an item, commit), clustered by route.
         Same row, expansion (shared `expanded`, keys start with /__) and
         Save as task as the list above. Hidden when empty. -->
    <VStack when="{cands.loaded &amp;&amp; window.__bramTaskHasRoutes(cands.value)}" gap="$space-2">
      <Heading level="h3">Bram's own routes</Heading>
      <!-- tasks-bram-routes-not-saveable (2026-11-12): wrapped in make, a
           route call would hide its route from the guard's lifecycle check
           (WORKLIST_LIFECYCLE_ROUTES, guard_policy.rs) and need `make *`
           allowed. Dimmed, not hidden, so the choice stays visible. -->
      <Text color="$textColor-secondary">Calls the agents make to Bram itself. These aren't saved as tasks: wrapped in make, a call would hide its route from Bram's guard.</Text>
      <Items data="{window.__bramTaskRouteRows(cands.value, expanded)}">
        <VStack gap="$space-1">
          <HStack testId="task-route-row" gap="$space-3" verticalAlignment="center"
            paddingHorizontal="$space-1">
            <HStack width="*" gap="$space-2" verticalAlignment="center" cursor="pointer"
              onClick="expanded = window.__bramToggleInArray(expanded, $item.key)">
              <Text fontSize="$fontSize-xl" color="$textColor-secondary" value="{window.__bramTaskChevron(expanded, $item.key)}" />
              <VStack width="*" gap="0">
                <Text variant="code" breakMode="anywhere" value="{$item.key}" />
                <Text when="{!!($item.savedAs &amp;&amp; $item.savedAs.length > 0)}" fontSize="$fontSize-sm"
                  color="$textColor-secondary" breakMode="word" value="{window.__bramTaskSavedLine($item)}" />
              </VStack>
            </HStack>
            <Text width="4rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{$item.runs}" />
            <Text width="5rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{$item.sessions}" />
            <Text width="9rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{($item.agents || []).join(', ')}" />
            <Text width="6rem" cursor="pointer" onClick="expanded = window.__bramToggleInArray(expanded, $item.key)" value="{($item.spellings || []).length}" />
            <HStack width="9rem" verticalAlignment="center">
              <Button when="{!($item.savedAs &amp;&amp; $item.savedAs.length > 0)}" size="xs" variant="outlined"
                label="Save as task" enabled="false" />
              <Button when="{!!($item.savedAs &amp;&amp; $item.savedAs.length > 0)}" size="xs" variant="ghost"
                label="View" tooltip="Open the Makefile at these saved tasks"
                onClick="window.__bramTaskViewSaved($item)" />
            </HStack>
          </HStack>
          <VStack when="{expanded.includes($item.key)}" paddingLeft="$space-5" gap="$space-1">
            <Text fontSize="$fontSize-sm" color="$textColor-secondary"
              value="{window.__bramTaskRowNote($item, cands.value)}" />
            <Table when="{window.__bramTaskByNameRows($item, cands.value).length > 0}"
              data="{window.__bramTaskByNameRows($item, cands.value)}" idKey="name">
              <Column header="Saved task" width="2*">
                <Text variant="code" fontSize="$fontSize-sm" value="{$item.name}" />
              </Column>
              <Column header="Runs by name" width="*" bindTo="runs" />
              <Column header="Sessions" width="*" bindTo="sessions" />
            </Table>
            <Items data="{window.__bramTaskSpellings($item)}">
              <HStack gap="$space-2" verticalAlignment="start">
                <Text width="3.5rem" fontSize="$fontSize-sm" color="$textColor-secondary" value="{$item.runs + '×'}" />
                <Text width="*" variant="code" breakMode="anywhere" value="{$item.text}" />
                <Text when="{!!$item.nowLine}" width="20rem" fontSize="$fontSize-sm"
                  color="$textColor-secondary" breakMode="word" value="{$item.nowLine}" />
              </HStack>
            </Items>
          </VStack>
        </VStack>
      </Items>
    </VStack>
  </VStack>
  <Theme maxWidth-ModalDialog="50vw">
    <ModalDialog when="{!!infoKey}" title="{window.__bramTaskInfoTitle(infoKey)}" onClose="infoKey = ''">
      <VStack gap="$space-3" padding="$space-2">
        <Markdown interpolateBindings="false" allowHtml="false"
          content="{window.__bramTaskInfoText(infoKey, cands.value)}" />
      </VStack>
    </ModalDialog>
  </Theme>
</Component>
