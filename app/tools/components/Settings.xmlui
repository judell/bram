<Component
  name="Settings"
  var.agentDraft="{''}"
  var.argsDraft="{''}"
  var.firstDraft="{''}"
  var.continueDraft="{false}"
  var.archiveDaysDraft="{14}"
  var.archiveDaysSaved="{14}"
  var.infoTitle="{''}"
  var.infoBody="{''}"
  var.highlightKey="{$queryParams.highlight || ''}">

  <DataSource
    id="settingsConfig"
    url="/__settings"
    onLoaded="(v) => { agentDraft = settingsAgent(v); argsDraft = settingsArgs(v); firstDraft = settingsFirstCommand(v); continueDraft = settingsContinueLast(v); const days = Number((v &amp;&amp; v.traces &amp;&amp; v.traces.archiveAfterDays) || 14); archiveDaysSaved = days; if (!saveArchiveSettings.inProgress) archiveDaysDraft = days; }" />

  <APICall
    id="saveSettings"
    method="post"
    url="/__settings"
    body="{$param}"
    onSuccess="settingsConfig.refetch()" />

  <APICall
    id="saveArchiveSettings"
    method="post"
    url="/__settings"
    body="{$param}"
    onSuccess="archiveDaysSaved = Number(archiveDaysDraft); settingsConfig.refetch()" />

  <DataSource
    id="traceArchiveStatus"
    url="/__trace-archive-status" />

  <VStack
    padding="$space-6"
    gap="$space-5">
    <PushSource
      id="settingsChangedEvt"
      initial="{null}"
      subscribe="{window.bramSubscribeTauriEvent('settings-changed')}" />
    <ChangeListener
      listenTo="{settingsChangedEvt.value &amp;&amp; settingsChangedEvt.value.tick}"
      onDidChange="() => { window.__bramIframeTrace('refetch-called', {context: 'settings-changed'}); settingsConfig.refetch(); }" />
    <!-- settings-highlight-deeplink: on inbound ?highlight=<key>, scroll the
         matching setting into view. Two triggers cover both arrivals: a fresh
         mount (settingsConfig loads) and re-targeting while already on the tab
         (highlightKey changes with the query param, settingsConfig unchanged).
         The tint itself is reactive on highlightKey (the per-setting wrappers
         below); the helper retries across frames until the row is laid out. -->
    <ChangeListener
      listenTo="{settingsConfig.value}"
      onDidChange="() => { if (highlightKey) window.__bramHighlightSetting(highlightKey); }" />
    <ChangeListener
      listenTo="{highlightKey}"
      onDidChange="() => { if (highlightKey) window.__bramHighlightSetting(highlightKey); }" />
    <Timer
      interval="500"
      enabled="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'pending'}"
      onTick="traceArchiveStatus.refetch()" />

    <!-- issue-231: tip arrivals carry from=tip; the back link returns to
         wherever the tip was clicked. Hidden on normal visits. -->
    <Link when="{$queryParams.from === 'tip'}" noIndicator
      tooltip="Back to where you were" onClick="navigate(-1)">
      <Text value="← Back" />
    </Link>
    <Heading level="h2">Settings</Heading>
    <Text
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="Mirrors .bram.json in the project root. Changes save immediately and persist there." />

    <VStack when="{settingsConfig.value}" gap="$space-5">

      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Shell"
            onClick="infoTitle = 'Shell'; infoBody = window.settingsInfoBodies.shell; settingInfoDialog.open()" />
          <Heading level="h3">Shell</Heading>
        </HStack>
        <Select
          id="agentBox"
          width="25%"
          initialValue="{settingsAgent(settingsConfig.value)}"
          onDidChange="(v) => agentDraft = v">
          <Option value="claude" label="Claude" />
          <Option value="codex" label="Codex" />
        </Select>
        <TextBox
          id="argsBox"
          width="25%"
          placeholder="optional launch arguments"
          initialValue="{settingsArgs(settingsConfig.value)}"
          autoComplete="off"
          autoCorrect="{false}"
          spellCheck="{false}"
          autoCapitalize="off"
          onDidChange="(v) => argsDraft = v" />
        <TextBox
          id="firstCommandBox"
          width="25%"
          placeholder="optional first command"
          initialValue="{settingsFirstCommand(settingsConfig.value)}"
          autoComplete="off"
          autoCorrect="{false}"
          spellCheck="{false}"
          autoCapitalize="off"
          onDidChange="(v) => firstDraft = v" />
        <Switch
          label="Continue most recent session on startup"
          initialValue="{settingsContinueLast(settingsConfig.value)}"
          onDidChange="(v) => continueDraft = v" />
        <HStack>
          <Button
            label="Save"
            enabled="{(agentDraft !== settingsAgent(settingsConfig.value) || argsDraft !== settingsArgs(settingsConfig.value) || firstDraft !== settingsFirstCommand(settingsConfig.value) || continueDraft !== settingsContinueLast(settingsConfig.value)) &amp;&amp; agentDraft.trim().length > 0}"
            onClick="saveSettings.execute({ shell: { agent: agentDraft, args: argsDraft, firstCommand: firstDraft, continueLast: continueDraft } })" />
        </HStack>
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Worklist"
            onClick="infoTitle = 'Worklist'; infoBody = window.settingsInfoBodies.batchCommitActions; settingInfoDialog.open()" />
          <Heading level="h3">Worklist</Heading>
        </HStack>
        <VStack
          testId="setting-batchCommitActions"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'batchCommitActions' ? '$color-primary-100' : 'transparent'}">
          <Switch
            label="Batch commit actions"
            initialValue="{settingsBatch(settingsConfig.value)}"
            onDidChange="(v) => saveSettings.execute({ worklist: { batchCommitActions: v } })" />
        </VStack>
        <VStack
          testId="setting-oneClickApproveCommit"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'oneClickApproveCommit' ? '$color-primary-100' : 'transparent'}">
          <Switch
            label="One-click Approve &amp; commit"
            initialValue="{settingsOneClickApproveCommit(settingsConfig.value)}"
            onDidChange="(v) => saveSettings.execute({ worklist: { oneClickApproveCommit: v } })" />
        </VStack>
        <Switch
          label="Mirror worklist lifecycle to GitHub issues"
          initialValue="{!!(settingsConfig.value &amp;&amp; settingsConfig.value.mirrorWorklistLifecycleToIssue)}"
          onDidChange="(v) => saveSettings.execute({ mirrorWorklistLifecycleToIssue: v })" />
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About UI"
            onClick="infoTitle = 'UI'; infoBody = window.settingsInfoBodies.ui; settingInfoDialog.open()" />
          <Heading level="h3">UI</Heading>
        </HStack>
        <Switch
          label="Show target app"
          initialValue="{settingsShowTargetApp(settingsConfig.value)}"
          onDidChange="(v) => saveSettings.execute({ ui: { showTargetApp: v } })" />
        <Switch
          label="Agent-pane hot-reload"
          initialValue="{settingsToolsPaneHotReload(settingsConfig.value)}"
          onDidChange="(v) => saveSettings.execute({ ui: { toolsPaneHotReload: v } })" />
        <!-- issue-231: per-user preferences, localStorage-backed (not project
             settings) — tips dismissal state is per-user too. The interval
             governs how long a dismissed tip stays hidden; the footer's
             dismiss tooltip echoes it. -->
        <Switch
          label="Show tips in the footer"
          initialValue="{window.__bramTipsEnabled ? window.__bramTipsEnabled() : true}"
          onDidChange="(v) => window.__bramSetTipsEnabled(v)" />
        <!-- turn-complete-beep: per-user (localStorage) audio cue; toggling
             on plays the beep once as confirmation. -->
        <Switch
          label="Soft beep on menus and turn completion"
          initialValue="{window.__bramBeepEnabled ? window.__bramBeepEnabled() : false}"
          onDidChange="(v) => window.__bramSetBeepEnabled(v)" />
        <VStack
          testId="setting-tipsDismissInterval"
          padding="$space-1"
          borderRadius="$borderRadius"
          backgroundColor="{highlightKey === 'tipsDismissInterval' ? '$color-primary-100' : 'transparent'}">
          <Select
            label="Dismissed tips return after"
            width="14rem"
            initialValue="{window.__bramTipsDismissInterval ? window.__bramTipsDismissInterval() : '7d'}"
            onDidChange="(v) => window.__bramSetTipsDismissInterval(v)">
            <Option value="1m" label="1 minute" />
            <Option value="1d" label="1 day" />
            <Option value="7d" label="1 week" />
            <Option value="30d" label="1 month" />
            <Option value="forever" label="Never (dismiss forever)" />
          </Select>
        </VStack>
        <!-- search-badges-initial-state: per-user (localStorage). Whether the
             Search tab opens with all facet badges selected or none. -->
        <Switch
          label="Search badges start all on"
          initialValue="{window.__bramSearchBadgesInitialAllOn ? window.__bramSearchBadgesInitialAllOn() : true}"
          onDidChange="(v) => window.__bramSetSearchBadgesInitialAllOn(v)" />
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About AI"
            onClick="infoTitle = 'AI'; infoBody = window.settingsInfoBodies.ai; settingInfoDialog.open()" />
          <Heading level="h3">AI</Heading>
        </HStack>
        <Switch
          label="Tool Descriptions"
          initialValue="{settingsDescribeCommands(settingsConfig.value)}"
          onDidChange="(v) => saveSettings.execute({ ai: { describeCommands: v } })" />
      </VStack>

      <ContentSeparator />

      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="center">
          <Button
            icon="info"
            size="xs"
            variant="ghost"
            tooltip="About Traces"
            onClick="infoTitle = 'Traces'; infoBody = window.settingsInfoBodies.traces; settingInfoDialog.open()" />
          <Heading level="h3">Traces</Heading>
        </HStack>
        <Switch
          label="Tracing enabled"
          initialValue="{settingsTracingEnabled(settingsConfig.value)}"
          onDidChange="(v) => saveSettings.execute({ traces: { enabled: v } })" />
        <Switch
          label="Inspector trace tap"
          initialValue="{settingsInspectorTap(settingsConfig.value)}"
          onDidChange="(v) => saveSettings.execute({ traces: { inspectorTap: v } })" />
        <VStack gap="$space-2" width="12rem">
          <NumberBox
            label="Keep raw traces for (days)"
            width="100%"
            integersOnly="{true}"
            minValue="{1}"
            maxValue="{3650}"
            initialValue="{settingsConfig.value.traces.archiveAfterDays || 14}"
            onDidChange="(v) => archiveDaysDraft = v" />
          <HStack>
            <Button
              label="Save"
              enabled="{!saveArchiveSettings.inProgress &amp;&amp; Number.isInteger(Number(archiveDaysDraft)) &amp;&amp; Number(archiveDaysDraft) >= 1 &amp;&amp; Number(archiveDaysDraft) &lt;= 3650 &amp;&amp; Number(archiveDaysDraft) !== Number(archiveDaysSaved)}"
              onClick="saveArchiveSettings.execute({ traces: { archiveAfterDays: Number(archiveDaysDraft) } })" />
          </HStack>
        </VStack>
        <Text
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="At startup, older raw archives are sanitized and compressed. Compressed history is retained indefinitely." />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'not-run'}"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Archival has not run in this host process." />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'pending'}"
          fontSize="$fontSize-xs"
          color="$textColor-secondary"
          value="Archival is running…" />
        <Text
          when="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.state === 'completed'}"
          fontSize="$fontSize-xs"
          color="{traceArchiveStatus.value &amp;&amp; traceArchiveStatus.value.failures ? '$color-danger-700' : '$textColor-secondary'}"
          value="{'Last startup: ' + traceArchiveStatus.value.candidateFiles + ' candidate(s) older than ' + traceArchiveStatus.value.archiveAfterDays + ' days; ' + traceArchiveStatus.value.archivedFiles + ' archived, ' + traceArchiveStatus.value.failures + ' failed.'}" />
      </VStack>

    </VStack>

    <Text
      when="{settingsConfig.error}"
      color="$color-danger-700"
      fontSize="$fontSize-sm"
      value="Settings failed to load." />

    <ModalDialog id="settingInfoDialog" title="{infoTitle}">
      <!-- Markdown line-spacing is tuned app-wide in themes/bram.json
           (marginTop/Bottom-H2-markdown, marginTop/Bottom-Text-markdown).
           paddingTop 0 keeps the first ## header from stacking the modal
           title gap on top of the header's own top margin. -->
      <VStack gap="$space-3" padding="$space-2" paddingTop="0">
        <Markdown content="{infoBody}" />
        <HStack>
          <Button label="Got it" onClick="settingInfoDialog.close()" />
        </HStack>
      </VStack>
    </ModalDialog>

  </VStack>
</Component>
