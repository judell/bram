<Component name="HistoryDetail">
  <!-- issue-230: the worklist-history detail block. Takes a WorklistHistoryGroup
       as `group`; optional `height` and `query` (initial/current find term).
       findable-list-udc: the occurrence-granular find spine lives in
       FindableList. Flattened from its nested VStack+overflowY shape into a flat
       typed-row array (__bramHistoryBlockRows) preserving section order — a
       header row (metadata baked in), before, after, files, committed, commit, a
       phases-header, then one row per phase. Searchable rows (before / after /
       feedback-phase) mark their body via __bramHistoryMarkedText; every other
       kind is a zero-match metadata row. See xmlui-org/xmlui#3713. -->
  <VStack gap="$space-2" padding="$space-2">
    <FindableList when="{$props.group}"
      data="{window.__bramHistoryBlockRows($props.group)}"
      markedText="__bramHistoryMarkedText"
      query="{$props.query || ''}"
      placeholder="Find in history entry…"
      height="{$props.height || '400px'}">
      <property name="rowTemplate">
        <VStack when="{$item.kind === 'header'}" gap="$space-1">
          <Text value="{$item.dateRange}" color="$textColor-secondary" fontSize="$fontSize-sm" />
          <Text value="{$item.phasePath}" fontWeight="$fontWeight-bold" />
          <Text when="{$item.filesCount > 0}"
            value="{$item.filesCount + ' file' + ($item.filesCount === 1 ? '' : 's')}"
            color="$textColor-secondary" fontSize="$fontSize-sm" />
          <Text when="{$item.commitContextLabel}" value="{$item.commitContextLabel}"
            color="$textColor-secondary" fontSize="$fontSize-sm" />
          <Text when="{$item.detailsRestoredLabel}" value="{$item.detailsRestoredLabel}"
            color="$textColor-secondary" fontSize="$fontSize-sm" />
          <Link when="{$item.commitUrl}" noIndicator onClick="openExternal($item.commitUrl)">
            <Text value="view commit" fontSize="$fontSize-sm" />
          </Link>
        </VStack>

        <VStack when="{$item.kind === 'before'}" gap="$space-2">
          <Text value="Before" fontWeight="$fontWeight-bold" />
          <Markdown content="{$item.body}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
        </VStack>

        <VStack when="{$item.kind === 'after'}" gap="$space-2">
          <Text value="After" fontWeight="$fontWeight-bold" />
          <Markdown content="{$item.body}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
        </VStack>

        <VStack when="{$item.kind === 'files'}" gap="$space-2">
          <Text value="Files" fontWeight="$fontWeight-bold" />
          <Items data="{$item.files}">
            <Text value="{$item}" variant="code" fontSize="$fontSize-sm" />
          </Items>
        </VStack>

        <VStack when="{$item.kind === 'committed'}" gap="$space-2">
          <Text value="Committed with" fontWeight="$fontWeight-bold" />
          <Items data="{$item.ids}">
            <Text value="{$item}" variant="code" fontSize="$fontSize-sm" />
          </Items>
        </VStack>

        <VStack when="{$item.kind === 'commit'}" gap="$space-2">
          <Text value="Commit" fontWeight="$fontWeight-bold" />
          <Link noIndicator onClick="openExternal($item.url)">
            <Text value="{$item.url}" variant="code" fontSize="$fontSize-sm" />
          </Link>
        </VStack>

        <VStack when="{$item.kind === 'phases-header'}" gap="$space-2">
          <Text value="Phases" fontWeight="$fontWeight-bold" />
        </VStack>

        <VStack when="{$item.kind === 'phase'}" gap="$space-1" paddingVertical="$space-1" borderTop="1px solid $borderColor">
          <Text value="{$item.label}" fontSize="$fontSize-sm" />
          <Markdown when="{$item.isFeedback}" content="{$item.body}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
          <Text when="{!$item.isFeedback}" value="{$item.summary}" color="$textColor-secondary" fontSize="$fontSize-xs" />
        </VStack>
      </property>
    </FindableList>
  </VStack>
</Component>
