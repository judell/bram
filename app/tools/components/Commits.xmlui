<Component
  name="Commits"
  var.commitsExpanded="{false}"
  var.searchQuery="{getLastSearchQuery()}"
  var.pullError="{null}"
  var.pushError="{null}"
  var.searchNeedle="{searchQuery.trim().toLowerCase()}"
  var.filteredCommits="{filterCommitList(commits.value, searchNeedle)}"
  var.visibleCommits="{filteredCommits.slice(0, searchNeedle ? 999 : (commitsExpanded ? 999 : 20))}"
  var.commitRows="{visibleCommits.map(c => Object.assign({}, c, {
    key: 'commit:' + c.sha,
    type: 'commit',
    source: c.sha.slice(0, 7) + ' ' + ((c.commit &amp;&amp; c.commit.message) || '').split('\n')[0],
    link: c.html_url || ''
  }))}">

  <!-- Browse list with a local metadata filter and inline CommitDetail.
       Unified Search remains the cross-bucket/full-text path. -->
  <DataSource id="commits" url="/__commits" />
  <!-- The filter is local-fields only: sha, author, and the FULL commit
       message (subject + body). The former FTS union (commits-issues-
       filter-use-fts) was retired at the browse-tabs-adopt-searchresults
       iterate: since search-index-commit-diffs, commit FTS docs include
       patch text, so common terms matched nearly every commit ("search":
       260 of ~250 indexed) and the browse filter read as inert. Diff-text
       matching is the Search tab's job — one click away, with the query
       carried both directions. -->

  <DataSource id="gitStatus" url="/__git/status" />
  <!-- The needle/filter/rows chain lives in ROOT var. attributes (above),
       not <variable> elements: element-declared variables in this component
       went stale against the root searchQuery (DEBUG receipt 2026-08-16:
       sibling Text bindings showed needle "subagent" while the element
       variables computed with '' and admitted all rows). Issues uses the
       root-attr shape and never exhibited the staleness. Filtering itself
       is filterCommitList (Globals.xs) with the needle passed explicitly. -->
  <APICall
    id="pullRebase"
    method="post"
    url="/__git/pull-rebase"
    onSuccess="pullError = null; commits.refetch(); gitStatus.refetch()"
    onError="(e) => pullError = (e &amp;&amp; e.message) ? e.message : String(e)" />

  <PushSource
    id="gitStatusEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('git-status-changed', false)}" />
  <ChangeListener
    listenTo="{gitStatusEvt.value &amp;&amp; gitStatusEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(gitStatusEvt.value, commits, gitStatus)" />
  <ChangeListener
    listenTo="{gitStatus.value &amp;&amp; gitStatus.value.branch}"
    onDidChange="() => { commitsExpanded = false; }" />

  <VStack padding="$space-4" gap="$space-4" overflowY="auto" height="100%">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Commits</Heading>
      <SearchBox
        boxWidth="22rem"
        placeholder="Filter commits…"
        initialValue="{searchQuery}"
        inProgress="{commits.inProgress}"
        onQueryChange="(q) => { searchQuery = q; setLastSearchQuery(q) }"
        onClear="searchQuery = ''; setLastSearchQuery('')" />
      <Text
        when="{gitStatus.value &amp;&amp; gitStatus.value.branch}"
        maxWidth="260px"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        tooltip="{gitStatus.value.branch}"
        value="{'on ' + gitStatus.value.branch}" />
      <Button
        when="{(commits.value || []).filter(c => !c.pushed).length > 0}"
        label="Push {(commits.value || []).filter(c => !c.pushed).length}{gitStatus.value &amp;&amp; gitStatus.value.branch ? ' to ' + gitStatus.value.branch : ''}"
        size="xs"
        tooltip="{gitStatus.value &amp;&amp; gitStatus.value.upstream ? 'Push unpublished commits to ' + gitStatus.value.upstream : 'Push unpublished commits and set upstream on origin'}"
        onClick="pushError = null; gitPush(commits, gitStatus, gitStatus.value &amp;&amp; gitStatus.value.branch, (e) => pushError = e)" />
      <Button
        label="{gitStatus.value &amp;&amp; gitStatus.value.behind > 0 ? 'Pull ' + gitStatus.value.behind : 'Pull'}"
        size="xs"
        enabled="{!pullRebase.inProgress &amp;&amp; gitStatus.value &amp;&amp; gitStatus.value.behind > 0}"
        onClick="pullError = null; pullRebase.execute()" />
    </HStack>

    <HStack when="{pullError}" backgroundColor="$color-danger-100" padding="$space-2" gap="$space-2" verticalAlignment="start">
      <Text fontSize="$fontSize-sm" color="$color-danger-700" width="*">Pull failed: {pullError}</Text>
      <Button label="✕" variant="ghost" size="xs" tooltip="Dismiss" onClick="pullError = null" />
    </HStack>
    <HStack when="{pushError}" backgroundColor="$color-danger-100" padding="$space-2" gap="$space-2" verticalAlignment="start">
      <Text fontSize="$fontSize-sm" color="$color-danger-700" width="*">Push failed: {pushError}</Text>
      <Button label="✕" variant="ghost" size="xs" tooltip="Dismiss" onClick="pushError = null" />
    </HStack>

    <!-- commits-pending-closes-visibility: name the issues the next Push
         will auto-close (close-on-push queue, joined by the host onto each
         commit row as pendingCloses). Visible exactly at the Push decision. -->
    <Text
      when="{(commits.value || []).filter(c => !c.pushed &amp;&amp; c.pendingCloses &amp;&amp; c.pendingCloses.length > 0).length > 0}"
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="{'Push will close ' + (commits.value || []).filter(c => !c.pushed &amp;&amp; c.pendingCloses &amp;&amp; c.pendingCloses.length > 0).map(c => c.pendingCloses.map(p => '#' + p.issue).join(', ')).join(', ')}" />

    <VStack gap="$space-1" when="{commits.value &amp;&amp; commits.value.length > 0}">
      <!-- browse-tabs-adopt-searchresults: rows render through the shared
           ResultList shell; the commit row anatomy (pushed check, sha, date,
           author, +/- stats, pending-close annotation) stays Commits-owned
           in the slot. Inline CommitDetail expansion and selectedSha retire
           in favor of the shell's modal. -->
      <ResultList data="{commitRows}" query="{searchQuery.trim()}">
        <property name="rowTemplate">
          <HStack gap="$space-3" verticalAlignment="center">
            <Text when="{$item.pushed}" value="✓" color="$color-success-600" fontSize="$fontSize-xs" width="12px" />
            <Text when="{!$item.pushed}" value=" " width="12px" />
            <Text value="{$item.sha.slice(0, 7)}" variant="code" fontSize="$fontSize-xs" color="$textColor-secondary" width="64px" />
            <Text value="{formatDateTime($item.commit.author.date, 'MM-dd HH:mm')}" fontSize="$fontSize-xs" color="$textColor-secondary" overflowMode="none" width="74px" />
            <HStack width="232px" gap="$space-1" verticalAlignment="center">
              <Text value="{$item.commit.author.login || $item.commit.author.name}" fontSize="$fontSize-sm" color="$textColor-secondary" width="*" maxLines="1" />
              <HStack gap="8px" verticalAlignment="center">
                <Text value="{'+' + ($item.additions || 0)}" textAlign="right" width="64px" fontFamily="$fontFamily-monospace" fontSize="$fontSize-xs" color="$color-success-700" />
                <Text value="{($item.deletions || 0) > 0 ? '-' + $item.deletions : ''}" textAlign="right" width="64px" fontFamily="$fontFamily-monospace" fontSize="$fontSize-xs" color="$color-danger-700" />
              </HStack>
            </HStack>
            <Text
              value="{$item.commit.message.split('\n')[0]}"
              fontSize="$fontSize-sm"
              width="*"
              maxLines="1" />
            <Text
              when="{!$item.pushed &amp;&amp; $item.pendingCloses &amp;&amp; $item.pendingCloses.length > 0}"
              value="{'closes ' + $item.pendingCloses.map(p => '#' + p.issue).join(' ') + ' on push'}"
              fontSize="$fontSize-xs"
              color="$color-primary-600"
              overflowMode="none" />
          </HStack>
        </property>
      </ResultList>
      <Link
        when="{!searchNeedle &amp;&amp; commits.value &amp;&amp; commits.value.length > 20}"
        onClick="commitsExpanded = !commitsExpanded"
        noIndicator="true">
        <Text fontSize="$fontSize-xs" color="$textColor-secondary"
          value="{commitsExpanded ? 'Show fewer' : 'More (' + (commits.value.length - 20) + ' more)'}" />
      </Link>
      <Text when="{searchNeedle &amp;&amp; filteredCommits.length === 0}"
        color="$textColor-secondary" fontSize="$fontSize-sm" value="No matching commits." />
    </VStack>
  </VStack>
</Component>
