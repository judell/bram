<Component name="CommitDetail">
  <!-- issue-230 shared detail: full commit message, external forge link pinned
       at the top. Props: sha (for /__commit), url (the html_url), height,
       query (optional initial/current find term).
       findable-list-udc phase 2: the occurrence-granular find spine (FindBar,
       cursor, plan, cross-block scroll) now lives in FindableList. CommitDetail
       supplies only the raw block objects (__bramCommitBlockRows), the marked
       surface helper name (__bramCommitMarkedText), and the row markup; the
       head block renders the message as Markdown, each file block a DiffView.
       The invariant FindableList can't enforce: the surface markedText counts
       (message / patch) must be the one the template highlights — see
       xmlui-org/xmlui#3713. -->
  <DataSource id="commit" url="/__commit" queryParams="{{ sha: $props.sha }}" when="{!!$props.sha}" />
  <VStack gap="$space-2" padding="$space-2">

    <!-- Loading indicator is a component-scope sibling: FindableList (and the
         List inside it) is a frozen scope that never sees the DataSource land
         after mount (first click stuck "Loading…", second click instant on
         cache), so gate the FindableList on commit.value the way SessionDetail
         gates on turns.value. -->
    <Text when="{commit.inProgress &amp;&amp; !commit.loaded}" color="$textColor-secondary" value="Loading…" />

    <!-- Mounts only once commit.value is present; data (raw block objects) is
         baked from the loaded commit here in CommitDetail's scope, not inside a
         frozen row template (the first-click-stuck-Loading trap). Search state
         is decorated onto each $item by FindableList's __bramFindPlan and read
         back through the rowTemplate slot. -->
    <FindableList when="{commit.value}"
      data="{window.__bramCommitBlockRows(commit.value)}"
      markedText="__bramCommitMarkedText"
      query="{$props.query || ''}"
      placeholder="Find in commit…"
      height="{$props.height || '400px'}">
      <property name="rowTemplate">
        <VStack when="{$item.kind === 'head'}" gap="$space-3" paddingBottom="$space-2">
          <Link when="{$props.url}" noIndicator onClick="openExternal($props.url)">
            <Text fontWeight="$fontWeight-bold"
              value="{'Open commit on ' + (($props.url || '').includes('gitlab') ? 'GitLab' : 'GitHub') + ' ↗'}" />
          </Link>
          <Markdown when="{$item.message}" content="{$item.message}"
            highlightText="{window.__bramSearchTerms($item.__needle)}"
            highlightActiveIndex="{$item.__activeOcc}" />
          <Text when="{$item.stats}" fontSize="$fontSize-sm" color="$textColor-secondary"
            value="+{$item.stats.additions} / -{$item.stats.deletions} across {$item.filesCount} file(s)" />
        </VStack>
        <VStack when="{$item.kind === 'file'}" gap="0" borderTop="1px solid $borderColor" paddingTop="$space-2">
          <HStack gap="$space-3" verticalAlignment="center" paddingBottom="$space-2">
            <Text fontWeight="$fontWeight-bold" value="{$item.filename}" />
            <Text color="green" value="+{$item.additions}" />
            <Text color="red" value="-{$item.deletions}" />
          </HStack>
          <DiffView text="{$item.patch || '(no textual diff)'}"
            needle="{$item.__needle}" activeIndex="{$item.__activeOcc}" />
        </VStack>
      </property>
    </FindableList>
  </VStack>
</Component>
