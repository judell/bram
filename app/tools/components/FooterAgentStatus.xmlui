<Component name="FooterAgentStatus">
  <!-- Isolated agent-status labels: this component owns its OWN agent-status
       subscription, so the frequent status pushes (verb/elapsed/state, ~1-2x
       per second while the agent works) re-render only this component and NOT
       the message composer that sits beside it in the footer. Same
       per-component subscription isolation as ActivitySparkline /
       PastedImageStrip. enhanceStatus changes rarely (provider setup), so it
       is passed in as a prop rather than subscribed here. -->
  <!-- footer-status-respects-chip-slot: the labels used to carry
       overflowMode="none", which is licensed to paint past the zone — a
       long status overwrote the "new below" chip. Review verdict: overlap
       is the one intolerable outcome. Every label now ellipsizes within
       the width this component is given (maxLines=1 + overflowMode=
       "ellipsis", per xmlui.org/docs/reference/components/Text#overflowmode)
       and carries its full text as a tooltip. -->
  <HStack
    width="100%"
    gap="$space-0_5"
    verticalAlignment="center"
    var.lastSeenVerb="{''}">
    <!-- Raw (un-deduped) channel: this component shows the running elapsed
         timer in the working/finished label, so it needs every ~1/sec push.
         It re-renders per tick, but that is contained here (isolated
         component) and no longer reaches the composer / header / worklist. -->
    <PushSource
      id="agentStatus"
      initial="{null}"
      subscribe="{window.bramSubscribeAgentStatusRaw()}" />
    <PushSource
      id="suspiciousSilence"
      initial="{null}"
      subscribe="{window.bramSubscribeTerminalSuspiciousSilence()}" />
    <!-- Remember the last non-empty verb so the finished label can name it even
         after the status push clears verb. Mirrors the former App-scope
         lastSeenAgentVerb listener, now local to the isolated component. -->
    <ChangeListener
      listenTo="{agentStatus.value &amp;&amp; agentStatus.value.verb}"
      onDidChange="(c) => { if (c.newValue) { lastSeenVerb = c.newValue; } }" />
    <HStack
      when="{suspiciousSilence.value &amp;&amp; suspiciousSilence.value.active}"
      gap="$space-2"
      verticalAlignment="center"
      paddingHorizontal="$space-2"
      paddingVertical="$space-1"
      backgroundColor="$color-warn-50"
      border="1px solid $color-warn-200"
      borderRadius="$borderRadius">
      <Text
        fontSize="$fontSize-sm"
        color="$color-warn-700"
        value="The terminal is suspiciously silent and might need attention." />
      <Button
        label="Open terminal"
        variant="outlined"
        size="xs"
        onClick="window.__bramOpenTerminalForSuspiciousSilence()" />
    </HStack>
    <Text
      when="{window.shouldShowIdleProvider(agentStatus.value, $props.enhanceStatus)}"
      fontSize="$fontSize-lg"
      fontStyle="italic"
      color="$textColor-secondary"
      maxLines="1"
      overflowMode="ellipsis"
      tooltip="{window.providerDisplayName(agentStatus.value, $props.enhanceStatus)}"
      value="{window.providerDisplayName(agentStatus.value, $props.enhanceStatus)}" />
    <HStack
      when="{agentStatus.value &amp;&amp; agentStatus.value.state === 'working'}"
      width="100%"
      gap="$space-1"
      verticalAlignment="center">
      <Text
        fontSize="$fontSize-lg"
        fontStyle="italic"
        maxLines="1"
        overflowMode="ellipsis"
        tooltip="{window.headerWorkingLabel(agentStatus.value, $props.enhanceStatus)}"
        value="{window.headerWorkingLabel(agentStatus.value, $props.enhanceStatus)}" />
    </HStack>
    <HStack
      when="{agentStatus.value &amp;&amp; agentStatus.value.state === 'finished'}"
      width="100%"
      gap="$space-1"
      verticalAlignment="center">
      <Text
        fontSize="$fontSize-lg"
        fontStyle="italic"
        color="$textColor-secondary"
        maxLines="1"
        overflowMode="ellipsis"
        tooltip="{window.headerFinishedLabel(agentStatus.value, $props.enhanceStatus, lastSeenVerb)}"
        value="{window.headerFinishedLabel(agentStatus.value, $props.enhanceStatus, lastSeenVerb)}" />
    </HStack>
  </HStack>
</Component>
