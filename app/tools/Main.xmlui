<App layout="vertical-sticky" var.rightPaneSize="(measuring…)" var.updateBannerDismissedVersion="{window.__bramRestoreUpdateBannerDismissed ? window.__bramRestoreUpdateBannerDismissed() : ''}" var.toolDescBannerDismissedVersion="{window.__bramRestoreToolDescBannerDismissed ? window.__bramRestoreToolDescBannerDismissed() : ''}" var.setupCompleteProvider="{''}" var.lastSeenAgentVerb="{''}" var.footerVoiceRecording="{false}" var.headerInflightTick="{0}" var.agentSwitcherSelected="{'claude'}" var.agentSwitching="{false}" var.composerFocused="{false}" var.transcriptAgentId="{''}" var.sendNoticeDismissed="{window.__bramRestoreSendNoticeDismissed()}" var.dismissedAgentIds="{window.__bramRestoreDismissedAgents()}"
  onInit="startBramLatestJsonlPush(() => (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '')">
  <PushSource
    id="mainAgentStatus"
    initial="{null}"
    subscribe="{window.bramSubscribeAgentStatus()}" />
  <!-- transcript-new-below-badge: pane-wide unseen counter feed (helpers.js;
       pushed, never polled). The echo guard ended the yank-to-bottom, which
       had doubled as the "agent responded" signal; the header chip replaces
       it — visible on every tab, one click to the transcript's live edge.
       App scope so the AppHeader can bind it. -->
  <PushSource
    id="transcriptUnseen"
    initial="{window.__bramUnseenValue ? window.__bramUnseenValue() : 0}"
    subscribe="{window.bramSubscribeTranscriptUnseen ? window.bramSubscribeTranscriptUnseen() : null}" />
  <!-- PTY-throughput subscription now lives inside ActivitySparkline so its
       per-chunk churn is isolated from the footer composer. -->

  <PushSource
    id="enhanceStatusEvt"
    initial="{0}"
    subscribe="{window.bramSubscribeEnhanceStatusTick()}" />
  <PushSource
    id="rightPaneSizeEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeRightPaneSize()}" />
  <PushSource
    id="footerVoiceArrival"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceArrival()}" />
  <PushSource
    id="whisperNotice"
    initial="{null}"
    subscribe="{window.bramSubscribeWhisperUnavailable()}" />
  <PushSource
    id="voiceBusyNotice"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceBusy()}" />
  <ChangeListener
    listenTo="{whisperNotice.value &amp;&amp; whisperNotice.value.at}"
    onDidChange="() => window.__bramToastWhisperNotice(whisperNotice.value, toast)" />
  <ChangeListener
    listenTo="{voiceBusyNotice.value &amp;&amp; voiceBusyNotice.value.at}"
    onDidChange="(c) => { if (c.newValue) { toast('A voice recording is already in progress. Return to that recording to stop it.'); } }" />
  <ChangeListener
    listenTo="{footerVoiceArrival.value &amp;&amp; footerVoiceArrival.value.at}"
    onDidChange="() => { const ev = footerVoiceArrival.value || null; const t = (ev &amp;&amp; ev.transcript) || ''; const target = (ev &amp;&amp; ev.meta &amp;&amp; ev.meta.target) || ''; if (target === 'message-agent') { if (t &amp;&amp; footerComposerBox) window.__bramAppendVoiceToBox(footerComposerBox, t); footerVoiceRecording = false; worklistVoiceRecordingActive = false; } }" />
  <ChangeListener
    listenTo="{enhanceStatusEvt.value}"
    onDidChange="() => { window.__bramIframeTrace('refetch-called', {context: 'enhance-status-changed'}); enhanceStatus.refetch(); startBramLatestJsonlPush(() => (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || ''); }" />
  <ChangeListener
    listenTo="{rightPaneSizeEvt.value}"
    onDidChange="() => { const s = rightPaneSizeEvt.value || null; rightPaneSize = s ? (s.width + ' × ' + s.height) : '(measuring…)'; }" />
  <DataSource id="enhanceStatus" url="/__enhance/status" />
  <DataSource id="rpInfo" url="/__right-pane-info" />
  <!-- issue-221-skill-launcher: project skills from .claude/skills/*/SKILL.md.
       Refetched on open and when enhance-status-changed fires. -->
  <DataSource id="skillsList" url="/__context/skills" />
  <!-- App-scope read of the inflight worklist claim, so the header can show
       "Approving/Iterating/Dropping <item>" even when you've left the Worklist tab. -->
  <DataSource id="headerInflightClaim" url="/__inflight?t={headerInflightTick}" />
  <PushSource
    id="headerInflightEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('inflight-claim-changed')}" />
  <ChangeListener
    listenTo="{headerInflightEvt.value}"
    onDidChange="() => { headerInflightTick = headerInflightTick + 1; window.__bramIframeTrace('refetch-called', {context: 'header-inflight-claim-changed', tick: headerInflightTick}); }" />
  <!-- Backup driver: the dedicated inflight-claim-changed subscription dedups
       against Workspace's, so also refetch whenever the agent status changes
       (App-scope push that's already proven). An in-flight action always makes
       the agent work, so this reliably picks the claim up and drops it. -->
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state}"
    onDidChange="() => { headerInflightTick = headerInflightTick + 1; window.__bramIframeTrace('header-inflight-refetch', {tick: headerInflightTick, state: (mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state) || ''}); }" />
  <DataSource id="appInfo" url="/__app-info" />
  <!-- issue-231 footer tips: settings snapshot feeds the relevance gates
       (Tool Descriptions / batch actions); tick bumps re-pick on dismiss
       or next. One-shot fetch, no polling. -->
  <DataSource id="footerTipSettings" url="/__settings" />
  <variable name="footerTipTick" value="{0}" />
  <DataSource
    id="headerSettings"
    url="/__settings"
    onLoaded="(v) => window.__bramInitAgentSwitcher(null, settingsAgent(v), agentSwitching, (next) => agentSwitcherSelected = next)" />
  <LocalLinkPreview />
  <!-- Live session meta for the footer echo (mirrors Transcript's source):
       /__sessions/list flags the current session; refetch on changes so the
       footer line tracks the growing live file. -->
  <DataSource
    id="footerSessions"
    url="/__sessions/list"
    queryParams="{{ limit: 20 }}" />
  <PushSource
    id="footerSessionsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{footerSessionsChangedEvt.value &amp;&amp; footerSessionsChangedEvt.value.tick}"
    onDidChange="() => { footerSessions.refetch(); footerAgents.refetch(); }" />
  <!-- footer-indexing-status: search-indexer state for the first-row
       indicator. Pushed via search-index-changed (no polling); refetch on
       its tick. -->
  <DataSource id="footerIndexStatus" url="/__search-index-status" />
  <PushSource
    id="footerIndexChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('search-index-changed')}" />
  <ChangeListener
    listenTo="{footerIndexChangedEvt.value &amp;&amp; footerIndexChangedEvt.value.tick}"
    onDidChange="() => footerIndexStatus.refetch()" />
  <!-- Subagent roster for the footer chips strip, and main-model metadata
       for the footer session line. Refreshed by both session and subagent
       signals: subagent JSONL appends are swallowed by the watcher's
       session-JSONL branch and never reach sessions-list-changed, which
       left chips stale until the main conversation next moved. -->
  <DataSource
    id="footerAgents"
    url="/__agents"
    onError="() => null" />
  <PushSource
    id="subagentsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('subagents-changed')}" />
  <ChangeListener
    listenTo="{subagentsChangedEvt.value &amp;&amp; subagentsChangedEvt.value.tick}"
    onDidChange="() => footerAgents.refetch()" />
  <!-- Pending permission menu for the footer mount — the single canonical
       menu surface: same place on every tab, always visible. Replaces the
       Transcript inline interleave and the Worklist-dock mount. -->
  <PushSource
    id="footerAgentMenuEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeAgentMenu()}" />
  <!-- Send-ledger affordance (esc/resend redesign phase 3): the host's
       outbound-send ledger drives a PASSIVE status note (no buttons) and
       a composer restore for user-caused strands. The old message-bounced
       emit was deleted with the rest of the bounce heuristics in
       delete-phase tranche 3a (#214). -->
  <PushSource
    id="sendLedgerEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('send-ledger-changed')}" />
  <DataSource id="sendLedgerDs" url="/__send-ledger" />
  <ChangeListener
    listenTo="{sendLedgerEvt.value &amp;&amp; sendLedgerEvt.value.tick}"
    onDidChange="() => sendLedgerDs.refetch()" />
  <PushSource
    id="sendRestoreEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('send-restore')}" />
  <ChangeListener
    listenTo="{sendRestoreEvt.value &amp;&amp; sendRestoreEvt.value.tick}"
    onDidChange="() => window.__bramApplySendRestore(sendRestoreEvt.value, footerComposerBox)" />
  <!-- toast-issue-closed-on-push: toast when the user's Push auto-closes a
       queued issue. Host emits issues-closed-on-push after the close flush. -->
  <PushSource
    id="issuesClosedOnPushEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('issues-closed-on-push')}" />
  <ChangeListener
    listenTo="{issuesClosedOnPushEvt.value &amp;&amp; issuesClosedOnPushEvt.value.tick}"
    onDidChange="() => window.__bramToastIssuesClosed(issuesClosedOnPushEvt.value, toast)" />
  <!-- Light-touch backstop: the always-mounted footer never re-mounts, so its
       session meta can stay frozen at launch values. Refetch on agent
       turn-state transitions (the App-scope status push already driving the
       header) so date/size land on current values after each turn — no
       polling, ~once per turn. -->
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state}"
    onDidChange="() => { footerSessions.refetch(); footerAgents.refetch(); }" />
  <!-- Footer perf instrument (instrument-footer-composer-rerender): count how
       often the shared footer scope's sources change while the message composer
       is focused, to correlate with heartbeat-batch drift during a typing
       burst. Relocated/removed by the isolate-footer-composer fix. -->
  <ChangeListener
    listenTo="{mainAgentStatus.value}"
    onDidChange="() => __bramTraceFooterChurn('agent-status', composerFocused)" />
  <ChangeListener
    listenTo="{footerSessions.value}"
    onDidChange="() => __bramTraceFooterChurn('session', composerFocused)" />
  <APICall
    id="restartServer"
    url="/__restart-server"
    method="get"
    onSuccess="rpInfo.refetch()" />
  <APICall
    id="runEnhanceSetup"
    url="/__enhance/run"
    method="get"
    onError="setupCompleteProvider = ''; enhanceStatus.refetch()" />
  <ChangeListener
    listenTo="{enhanceStatus.value &amp;&amp; enhanceStatus.value.providerNeedsSetup}"
    onDidChange="(c) => { if (c.newValue) { if ($pathname !== '/') navigate('/'); window.scrollAllToTop(); } }" />
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.verb}"
    onDidChange="(c) => { if (c.newValue) { lastSeenAgentVerb = c.newValue; } }" />
  <!-- turn-complete-beep: soft audio cue when the agent finishes a turn OR
       a permission menu appears, gated on the per-user localStorage
       preference (default off). -->
  <ChangeListener
    listenTo="{mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state}"
    onDidChange="(c) => window.__bramBeepOnTurnState(c.newValue)" />
  <ChangeListener
    listenTo="{footerAgentMenuEvt.value}"
    onDidChange="() => window.__bramBeepOnMenu(footerAgentMenuEvt.value)" />
  <ChangeListener
    listenTo="{((mainAgentStatus.value &amp;&amp; mainAgentStatus.value.state) || '') + '|' + ((mainAgentStatus.value &amp;&amp; mainAgentStatus.value.provider) || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '') + '|' + ((mainAgentStatus.value || enhanceStatus.value) ? '1' : '0')}"
    onDidChange="() => {
      const s = mainAgentStatus.value || {};
      const provider = s.provider || (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || '';
      const branch = s.state === 'working'
        ? 'working'
        : (s.state === 'finished'
          ? 'finished'
          : ((mainAgentStatus.value || enhanceStatus.value) &amp;&amp; provider ? 'idle-provider' : 'none'));
      if (!window.bramAgentMenu) window.__bramIframeTrace('agent-header-branch', {
        branch,
        state: s.state || '',
        verb: s.verb || '',
        provider,
        source: s.source || '',
        elapsed: s.elapsedText || '',
        lastSeenAgentVerb: lastSeenAgentVerb || ''
      });
    }" />

  <ModalDialog id="setupInfoDialog" title="About agent coordination">
    <VStack gap="$space-3">
      <Text>
        Bram configures this repo so AI agents share a worklist-driven coordination flow. Setup and refresh both install a small, idempotent set of files; rerunning is safe.
      </Text>
      <VStack gap="$space-1">
        <Text fontWeight="bold">What setup and refresh do</Text>
        <Text>• Writes the shared `resources/.worklist-authorization.json` record that every adapter consumes.</Text>
        <Text>• Refreshes the conventions sidecar so Claude and Codex use the current Bram workflow after upgrades.</Text>
        <Text>• Installs the Claude adapter: a `CLAUDE.md` @-import of the conventions sidecar plus worklist-guard and permission-menu hooks.</Text>
        <Text>• Installs the Codex adapter: an `AGENTS.md` block, top-level `developer_instructions`, and worklist-guard plus permission-menu hooks in `~/.codex/config.toml` / `~/.bram`.</Text>
      </VStack>
      <VStack gap="$space-1">
        <Text fontWeight="bold">After setup runs</Text>
        <Text>Later launches of any supported agent in this repo will not prompt again unless the setup artifacts are removed. Additional agent adapters can plug into the same flow in the future.</Text>
      </VStack>
    </VStack>
  </ModalDialog>

  <!-- issue-221-skill-launcher: pick a project skill, add an optional argument,
       and submit it as a /skill turn. Claude-only (the launch button is gated
       on activeProvider). 85% of the available width so the table has room. -->
  <Theme maxWidth-ModalDialog="85%">
  <ModalDialog id="skillsDialog" title="Run a skill">
    <VStack gap="$space-3" padding="$space-2">
      <Text
        when="{!(skillsList.value &amp;&amp; skillsList.value.skills &amp;&amp; skillsList.value.skills.length > 0)}"
        color="$textColor-secondary">
        No project skills found in .claude/skills/.
      </Text>
      <VStack
        gap="$space-2"
        when="{skillsList.value &amp;&amp; skillsList.value.skills &amp;&amp; skillsList.value.skills.length > 0}">
        <TextArea
          id="skillArgsBox"
          placeholder="optional — freeform text passed to the skill (a path, a name, an instruction…)"
          autoComplete="off"
          autoCorrect="{false}"
          spellCheck="{false}"
          autoCapitalize="off"
          minRows="1"
          maxRows="4"
          width="100%" />
        <!-- Table with a custom Link cell for the clickable skill name; the
             description column wraps on its own. Pattern:
             https://docs.xmlui.org/howto/render-a-custom-cell-with-components -->
        <Table data="{skillsList.value.skills}">
          <!-- Star sizing: skill 1 share (1/4), description 3 shares (3/4).
               https://docs.xmlui.org/components/Column#width -->
          <Column header="Skill" width="*">
            <Link
              onClick="window.__bramRunSkill($item.name, skillArgsBox &amp;&amp; skillArgsBox.value); skillsDialog.close(); window.__bramSetVisibleRange(null); navigate('/transcript')"
              noIndicator="true">
              <Text
                value="{$item.name}"
                fontFamily="$fontFamily-monospace"
                fontWeight="$fontWeight-bold"
                whiteSpace="nowrap" />
            </Link>
          </Column>
          <!-- Text cell wraps; a bare bindTo column truncates with an ellipsis.
               https://docs.xmlui.org/howto/modify-a-value-reported-in-a-column -->
          <Column header="Description" width="3*">
            <Text
              value="{$item.description}"
              fontSize="$fontSize-sm"
              overflowMode="flow"
              breakMode="word" />
          </Column>
        </Table>
      </VStack>
    </VStack>
  </ModalDialog>
  </Theme>

  <ModalDialog id="urlInfoDialog" title="Target app info">
    <VStack gap="$space-3">
      <VStack gap="$space-1" var.browserUrl="{rpInfo.value ? (rpInfo.value.spawned ? ('http://localhost:' + rpInfo.value.spawned.port + rpInfo.value.spawned.path) : rpInfo.value.default_right_pane) : ''}">
        <Text fontWeight="bold">URL</Text>
        <Text fontFamily="$fontFamily-monospace" fontSize="$fontSize-sm">{browserUrl}</Text>
        <HStack gap="$space-2">
          <Button
            label="Open in browser"
            size="sm"
            onClick="browserUrl &amp;&amp; openExternal(browserUrl)" />
        </HStack>
      </VStack>

      <VStack gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">Screen size</Text>
        <Text fontFamily="$fontFamily-monospace" value="{rightPaneSize}" />
      </VStack>

      <VStack when="{appInfo.value}" gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">Version</Text>
        <HStack gap="$space-2">
          <Text>current:</Text>
          <Text fontFamily="$fontFamily-monospace">{appInfo.value.current}</Text>
        </HStack>
        <HStack gap="$space-2" when="{appInfo.value.latest}">
          <Text>latest:</Text>
          <Text fontFamily="$fontFamily-monospace">{appInfo.value.latest}</Text>
        </HStack>
        <Text when="{appInfo.value.has_update}" color="$color-warn-600" fontSize="$fontSize-sm">
          A newer release is available.
        </Text>
      </VStack>

      <VStack gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">About Bram</Text>
        <HStack gap="$space-2">
          <Button
            label="README on GitHub"
            size="sm"
            onClick="openExternal('https://github.com/judell/bram/blob/main/README.md')" />
        </HStack>
      </VStack>

      <VStack when="{rpInfo.value &amp;&amp; rpInfo.value.spawned}" gap="$space-1" marginTop="$space-2">
        <Text fontWeight="bold">Project server (.bram.json)</Text>
        <HStack gap="$space-2">
          <Text>command:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.command}</Text>
        </HStack>
        <HStack gap="$space-2" when="{rpInfo.value.spawned.cwd}">
          <Text>cwd:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.cwd}</Text>
        </HStack>
        <HStack gap="$space-2">
          <Text>port:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.port}</Text>
        </HStack>
        <HStack gap="$space-2">
          <Text>path:</Text>
          <Text fontFamily="$fontFamily-monospace">{rpInfo.value.spawned.path}</Text>
        </HStack>
        <HStack gap="$space-2" marginTop="$space-1">
          <Button
            label="Restart project server"
            size="sm"
            onClick="restartServer.execute()" />
        </HStack>
      </VStack>

      <VStack
        when="{rpInfo.value &amp;&amp; !rpInfo.value.spawned &amp;&amp; rpInfo.value.url === rpInfo.value.default_right_pane}"
        gap="$space-1"
        marginTop="$space-2">
        <Text fontSize="$fontSize-sm" color="$textColor-secondary">
          No `.bram.json` declared — using the internal loopback default. Legacy `.xmlui-desktop.json` is also supported.
        </Text>
      </VStack>
    </VStack>
  </ModalDialog>

  <HStack
    when="{appInfo.value &amp;&amp; appInfo.value.has_update &amp;&amp; appInfo.value.latest !== updateBannerDismissedVersion}"
    backgroundColor="$color-warn-100"
    padding="$space-2"
    gap="$space-3"
    verticalAlignment="center">
    <Text fontSize="$fontSize-sm">
      Version {appInfo.value.latest} is available. (Current: {appInfo.value.current}.)
    </Text>
    <Button
      label="Download"
      size="xs"
      onClick="appInfo.value.release_url &amp;&amp; openExternal(appInfo.value.release_url)" />
    <SpaceFiller />
    <Button
      label="✕"
      variant="ghost"
      size="xs"
      tooltip="Dismiss — banner returns when a newer version is released"
      onClick="updateBannerDismissedVersion = appInfo.value.latest; writeLocalStorage('bram.updateBannerDismissedVersion', appInfo.value.latest)" />
  </HStack>

  <AppHeader>
    <Theme fontSize-Button="$fontSize-md">
      <HStack gap="$space-0_5" verticalAlignment="center" width="100%">
        <Select
          id="agentSwitcherSelect"
          when="{headerSettings.loaded}"
          width="9rem"
          initialValue="{window.__bramAgentSwitcherInitialProvider(settingsAgent(headerSettings.value))}"
          enabled="{!agentSwitching}"
          inProgress="{agentSwitching}"
          inProgressNotificationMessage="Switching agent"
          tooltip="{agentSwitching ? 'Agent switch in progress' : 'Switch terminal agent'}"
          onDidChange="(next) => window.__bramHandleAgentSwitcherChange(next, agentSwitcherSelected, agentSwitcherSelect, (v) => agentSwitcherSelected = v, (v) => agentSwitching = v, toast)">
          <Option value="claude" label="Claude" />
          <Option value="codex" label="Codex" />
        </Select>
        <SpaceFiller />
        <Text
          when="{headerInflightClaim.value &amp;&amp; headerInflightClaim.value.ids &amp;&amp; headerInflightClaim.value.ids.length > 0}"
          fontStyle="italic"
          color="$color-primary-600"
          overflowMode="none"
          value="{window.__bramInflightBannerLabel(headerInflightClaim.value)}" />
        <SpaceFiller />
        <Theme fontSize-Button="$fontSize-lg">
          <Button
            label="ⓘ"
            variant="ghost"
            tooltip="Show target app info"
            onClick="rpInfo.refetch(); urlInfoDialog.open()" />
        </Theme>
        <Button
          label="A−"
          variant="ghost"
          tooltip="Decrease app font size"
          onClick="window.setAppFontSize(window.getAppFontSize() - 1)" />
        <Button
          label="A+"
          variant="ghost"
          tooltip="Increase app font size"
          onClick="window.setAppFontSize(window.getAppFontSize() + 1)" />
        <Inspector src="{'/__vendor/xs-diff.html?v=' + window.APP_VERSION}" />
      </HStack>
    </Theme>
  </AppHeader>

  <NavPanel>
    <property name="logoTemplate">
      <Fragment/>
    </property>
    <property name="footerTemplate">
      <Fragment/>
    </property>
    <NavLink label="Worklist" to="/worklist" />
    <NavLink label="Transcript" to="/transcript" />
    <NavLink label="Search" to="/search" />
    <NavLink label="Issues" to="/issues" />
    <NavLink label="Commits" to="/commits" />
    <NavLink label="Queue" to="/queue" />
    <NavLink label="History" to="/history" />
    <NavLink label="Sessions" to="/sessions" />
    <NavLink label="Context" to="/context" />
    <NavLink label="Status" to="/status" />
    <NavLink label="Settings" to="/settings" />
  </NavPanel>

  <VStack
    when="{enhanceStatus.value && enhanceStatus.value.activeProvider && enhanceStatus.value.providerNeedsSetup && !setupCompleteProvider}"
    padding="$space-4"
    gap="$space-3"
    backgroundColor="$color-info-50"
    borderBottom="1px solid $color-info-200">
<HStack verticalAlignment="center" gap="$space-2">
  <Heading level="h3">
    {enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh'
      ? 'Refresh Agent Coordination'
      : 'Set Up Agent Coordination'}
  </Heading>
  <Button
    label="ⓘ"
    variant="ghost"
    size="sm"
    tooltip="{enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh' ? 'About agent coordination refresh' : 'About agent coordination setup'}"
    onClick="setupInfoDialog.open()" />
</HStack>
<Text
  when="{enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh'}"
  fontSize="$fontSize-sm">
  Bram was upgraded. Refresh the coordination files so Claude and Codex use the current conventions and hooks.
</Text>
<Text
  when="{!(enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh')}"
  fontSize="$fontSize-sm">
  Install Bram's worklist coordination files and agent adapters for this repo.
</Text>
<HStack>
  <Button
    label="{enhanceStatus.value && enhanceStatus.value.providerSetupKind === 'codex-hook-refresh' ? 'Refresh Coordination' : 'Run Setup'}"
    onClick="setupCompleteProvider = (enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider) || ''; runEnhanceSetup.execute()" />
</HStack>
  </VStack>

  <HStack
    when="{setupCompleteProvider}"
    backgroundColor="$color-info-100"
    padding="$space-2"
    gap="$space-3"
    verticalAlignment="center">
    <Text fontSize="$fontSize-sm">
      Setup complete. Restart Bram, then start Claude or Codex again in the terminal to pick up the new coordination files.
    </Text>
    <SpaceFiller />
    <Button
      label="✕"
      variant="ghost"
      size="xs"
      tooltip="Dismiss"
      onClick="setupCompleteProvider = ''" />
  </HStack>

  <!-- Tool-descriptions opt-in discoverability. Version-gated + dismissible
       (same idiom as the update banner): shows on a fresh install and after
       each upgrade until dismissed, so the opt-in feature is findable rather
       than invisible. Deep link goes to Settings; scroll-to-field is a later
       refinement (needs a helpers.js scroll helper). -->
  <VStack
    when="{appInfo.value &amp;&amp; appInfo.value.current &amp;&amp; appInfo.value.current !== toolDescBannerDismissedVersion &amp;&amp; !(footerTipSettings.value &amp;&amp; footerTipSettings.value.ai &amp;&amp; footerTipSettings.value.ai.describeCommands)}"
    backgroundColor="$color-info-100"
    padding="$space-2"
    gap="$space-2">
    <Text fontSize="$fontSize-sm">
      Tool descriptions are opt-in and off by default. Turn them on in Settings (they also need an ANTHROPIC_API_KEY) to get a one-line intent header on each tool call.
    </Text>
    <HStack gap="$space-2" verticalAlignment="center">
      <Button
        label="Open Settings"
        size="xs"
        onClick="navigate('/settings')" />
      <SpaceFiller />
      <Button
        label="✕"
        variant="ghost"
        size="xs"
        tooltip="Dismiss — banner returns after an upgrade"
        onClick="toolDescBannerDismissedVersion = appInfo.value.current; writeLocalStorage('bram.toolDescBannerDismissedVersion', appInfo.value.current)" />
    </HStack>
  </VStack>

  <!-- Explicit warn-scale highlight colors for the Markdown find <mark>
       (active match a shade darker), set app-side so the color is guaranteed
       regardless of the bundle's defaultThemeVars emission. -->
  <Theme paddingVertical-Pages="0" paddingVertical-content-App="0"
    backgroundColor-mark-markdown="$color-warn-200"
    backgroundColor-markActive-markdown="$color-warn-400">
    <Pages fallbackPath="/worklist">
      <Page url="/"><Workspace activeProvider="{enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider}" /></Page>
      <Page url="/worklist"><Workspace activeProvider="{enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider}" /></Page>
      <Page url="/transcript"><Transcript agentId="{transcriptAgentId}" /></Page>
      <Page url="/search"><Search /></Page>
      <Page url="/queue"><AgentMessageQueue /></Page>
      <Page url="/status"><Status /></Page>
      <Page url="/settings"><Settings /></Page>
      <Page url="/sessions"><Sessions /></Page>
      <Page url="/context"><Context activeProvider="{enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider}" /></Page>
      <Page url="/issues"><Issues /></Page>
      <Page url="/commits"><Commits /></Page>
      <Page url="/history"><History /></Page>
    </Pages>
  </Theme>
  <Footer>
    <Theme fontSize-TextArea="$fontSize-lg" fontSize-placeholder-TextArea="$fontSize-lg">
    <VStack width="100%" gap="$space-1">
      <HStack verticalAlignment="center" paddingHorizontal="$space-1" paddingBottom="$space-2" gap="$space-0_5">
        <!-- Isolated in its own component so PTY-throughput churn does not
             re-render this footer's message composer. -->
        <ActivitySparkline />
        <!-- Agent-status labels isolated into their own component (own
             agent-status subscription) so the frequent status pushes no longer
             re-render this footer's message composer. The working-verb/spinner
             rationale now lives in FooterAgentStatus.xmlui. Measured by the
             footer-churn / heartbeat-batch instrument. -->
        <!-- footer-fixed-width-slots: each dynamic element sits in a
             fixed-width slot so the row never reflows as the agent-status
             timer ticks, the chip appears/disappears, or the indexing message
             flips between count and "Indexing…". -->
        <HStack width="28rem" verticalAlignment="center">
          <FooterAgentStatus enhanceStatus="{enhanceStatus.value}" />
        </HStack>
        <!-- transcript-new-below-badge chip: on the footer's first line,
             right after the agent status verb — "the most obvious place to
             look for status" (third placement per review feedback; bottom
             corner got lost, app header wasn't where the eye goes). One
             click to the transcript's live edge from any tab. The slot
             reserves its width even when the chip is hidden. -->
        <HStack width="6rem" verticalAlignment="center">
          <Button
            when="{transcriptUnseen.value > 0}"
            label="{'▼ ' + transcriptUnseen.value + ' new'}"
            size="xs"
            variant="outlined"
            tooltip="New transcript content below — jump to the live edge"
            onClick="window.__bramUnseenJump(); navigate('/transcript')" />
        </HStack>
        <!-- footer-indexing-status: names the bucket being indexed, or the
             idle doc count + last cycle's per-bucket additions. -->
        <HStack width="16rem" verticalAlignment="center">
          <Text
            when="{footerIndexStatus.value &amp;&amp; window.__bramFooterIndexLabel(footerIndexStatus.value)}"
            fontSize="$fontSize-sm"
            color="$textColor-secondary"
            value="{window.__bramFooterIndexLabel(footerIndexStatus.value)}" />
        </HStack>
      </HStack>
      <!-- Canonical pending-menu surface: menus render HERE — below the
           status verb, above the message box — the same place on every tab,
           always visible. Replaces the Transcript inline interleave and the
           Worklist-dock mount (AgentMenuView is self-gating on menu and
           owns its preview modal, so the footer mount is drop-in). -->
      <AgentMenuView menu="{footerAgentMenuEvt.value}" surface="footer" />
      <!-- Form exists only for Enter-to-send: TextArea enterSubmits prompts
           the parent Form to submit, and TextArea exposes no standalone Enter
           event. See https://docs.xmlui.org/components/TextArea#entersubmits .
           Enter and the Send button each run the submit block directly. -->
      <Form
        width="100%"
        onSubmit="const m = (footerComposerBox &amp;&amp; footerComposerBox.value || '').trim(); if (m) { window.__bramPrepareWorklistMessageSubmission({text: m, voiceTarget: 'message-agent'}); footerComposerBox.setValue(''); }">
        <property name="buttonRowTemplate"><Fragment/></property>
        <HStack width="100%" gap="$space-2" verticalAlignment="center">
          <Button
            label="{footerVoiceRecording ? (worklistVoiceRecordingActive ? '⏹' : '⏳') : '🎤'}"
            variant="ghost"
            size="xs"
            width="2.5rem"
            tooltip="Voice message"
            enabled="{!isWorklistVoiceProcessingTarget('message-agent') &amp;&amp; (!footerVoiceRecording || worklistVoiceRecordingActive)}"
            onClick="setWorklistVoiceTarget('message-agent'); footerVoiceRecording = toggleVoiceForCurrentTarget(footerVoiceRecording)" />
          <TextArea
            id="footerComposerBox"
            placeholder="Message agent: Enter sends, Shift+Enter newline, Ctrl-V/Cmd-V paste screenshot."
            enterSubmits="true"
            autoSize="true"
            minRows="2"
            maxRows="4"
            width="*"
            onGotFocus="setWorklistVoiceTarget('message-agent'); setFocusedFeedbackItemId(''); composerFocused = true"
            onLostFocus="composerFocused = false" />
          <VStack width="8rem" horizontalAlignment="start" itemWidth="fit-content" gap="$space-1">
            <Button
              label="send"
              variant="ghost"
              size="xs"
              tooltip="Send message to agent"
              onClick="const m = (footerComposerBox &amp;&amp; footerComposerBox.value || '').trim(); if (m) { window.__bramPrepareWorklistMessageSubmission({text: m, voiceTarget: 'message-agent'}); footerComposerBox.setValue(''); }" />
            <Button
              label="skip worklist"
              variant="ghost"
              size="xs"
              tooltip="Send message prefixed with skip-worklist:"
              onClick="const m = (footerComposerBox &amp;&amp; footerComposerBox.value || '').trim(); if (m) { window.__bramPrepareWorklistMessageSubmission({text: m, mode: 'skip-worklist', voiceTarget: 'message-agent'}); footerComposerBox.setValue(''); }" />
            <Button
              label="esc"
              variant="ghost"
              size="xs"
              tooltip="Send the Escape key"
              onClick="escToolbarClick()" />
            <Button
              when="{enhanceStatus.value &amp;&amp; enhanceStatus.value.activeProvider === 'claude'}"
              label="skills"
              variant="ghost"
              size="xs"
              tooltip="Launch a project skill (.claude/skills)"
              onClick="skillsList.refetch(); skillsDialog.open()" />
          </VStack>
          <!-- transcript-scroll-gestures: quick top/bottom jumps, shown only
               on the Transcript page ($pathname per
               https://docs.xmlui.org/howto/add-a-skip-link-to-main-content).
               Up at the stack's top corner, down at its bottom corner. Down
               re-arms follow; up jumps without re-arming so new arrivals do
               not yank the view back while reading the start. Dispatch rides
               the mount-registered closures in helpers.js because the footer
               cannot reach the Transcript's list id directly. -->
          <VStack
            when="{$pathname === '/transcript'}"
            width="2rem"
            gap="$space-1"
            horizontalAlignment="center">
            <Button
              label="▲"
              variant="ghost"
              size="xs"
              tooltip="Scroll transcript to top"
              onClick="window.__bramTranscriptScroll('top')" />
            <Button
              label="▼"
              variant="ghost"
              size="xs"
              tooltip="Scroll transcript to bottom"
              onClick="window.__bramTranscriptScroll('bottom')" />
          </VStack>
        </HStack>
      </Form>
      <PastedImageStrip target="message-agent" />
      <!-- Subagent chips strip (surface-subagent-activity-in-pane):
           shown only when the active session has subagents. Clicking a
           chip swaps the Transcript viewport to that agent's stream;
           Main swaps back. Placement per approval feedback: footer,
           below the message box, above the session-info line. Capped at
           the 3 most recently started agents; older ones collapse into
           the rightmost "+N more" dropdown so a subagent-heavy session
           can't crowd the footer. Tooltips carry type, description, and
           the model the subagent ran on. -->
      <HStack
        when="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).length > 0 || (window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).length : 0) > 0}"
        gap="$space-1"
        paddingHorizontal="$space-1"
        verticalAlignment="center">
        <Button
          label="Main"
          size="xs"
          variant="outlined"
          tooltip="{window.__bramMainChipTooltip ? window.__bramMainChipTooltip(footerAgents.value) : 'Show the main conversation in the Transcript tab'}"
          onClick="transcriptAgentId = ''; window.__bramSetVisibleRange(null); navigate('/transcript')" />
        <!-- One continuous reverse-chron read: newest chip leftmost (after
             Main), then the dropdown continues newest→oldest top-down. Each
             chip pairs its label with a ghost ✕ that appends the agentId to
             dismissedAgentIds (dismissible-subagent-chips); dismissing a
             visible chip promotes the next agent up from the dropdown. The
             Main chip is intentionally never dismissible. -->
        <Items data="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).slice(-3).reverse()}">
          <HStack gap="0" verticalAlignment="center">
            <Button
              label="{window.__bramAgentChipLabel($item)}"
              size="xs"
              variant="outlined"
              tooltip="{(window.__bramAgentChipTooltip || window.__bramAgentChipLabel)($item)}"
              onClick="transcriptAgentId = $item.agentId; window.__bramSetVisibleRange(null); navigate('/transcript')" />
            <Button
              label="✕"
              size="xs"
              variant="ghost"
              tooltip="Dismiss this subagent — restore it later from the hidden menu"
              onClick="dismissedAgentIds = window.__bramDismissAgent(dismissedAgentIds, $item.agentId)" />
          </HStack>
        </Items>
        <DropdownMenu
          when="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).length > 3}"
          label="{'+' + (window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).length - 3) + ' more'}"
          alignment="end"
          triggerButtonVariant="outlined">
          <Items data="{window.__bramVisibleFooterAgents(footerAgents.value, dismissedAgentIds).slice(0, -3).reverse()}">
            <MenuItem
              label="{window.__bramAgentChipLabel($item)}"
              tooltip="{(window.__bramAgentChipTooltip || window.__bramAgentChipLabel)($item)}"
              onClick="transcriptAgentId = $item.agentId; window.__bramSetVisibleRange(null); navigate('/transcript')" />
          </Items>
        </DropdownMenu>
        <!-- Recover dismissed subagents (subagent-dismiss-recoverable): shown
             only while the live roster still contains dismissed agents. Each
             entry restores that pane; Restore all clears the set. Reachable
             even when every subagent is hidden, because the strip's when also
             opens for hidden-in-roster agents. -->
        <DropdownMenu
          when="{(window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).length : 0) > 0}"
          label="{(window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).length : 0) + ' hidden'}"
          alignment="end"
          triggerButtonVariant="ghost">
          <Items data="{window.__bramDismissedInRoster ? window.__bramDismissedInRoster(footerAgents.value, dismissedAgentIds).slice().reverse() : []}">
            <MenuItem
              label="{'↩ ' + window.__bramAgentChipLabel($item)}"
              tooltip="{'Restore ' + (window.__bramAgentChipTooltip || window.__bramAgentChipLabel)($item)}"
              onClick="dismissedAgentIds = window.__bramRestoreAgent(dismissedAgentIds, $item.agentId)" />
          </Items>
          <MenuItem
            label="Restore all"
            onClick="dismissedAgentIds = window.__bramRestoreAllAgents()" />
        </DropdownMenu>
      </HStack>
      <!-- Session info with the transcript viewport (Main / subagent)
           reported after the provider token — selection lives here, not
           in chip styling, so dropdown-overflow agents indicate the same
           way. Falls back to the plain meta line until a rebuilt
           helpers.js provides __bramFooterSessionLine. -->
      <Text
        when="{window.__bramSessionMetaLine(window.__bramCurrentSessionOf(footerSessions.value))}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        maxLines="1"
        paddingHorizontal="$space-1"
        value="{(window.__bramFooterSessionLine || window.__bramSessionMetaLine)(window.__bramCurrentSessionOf(footerSessions.value), transcriptAgentId, footerAgents.value)}" />
      <!-- Passive send-ledger note — in the sticky footer so it's always
           visible. Text comes from the host ledger's resolved outcomes;
           recovery is automatic. Dismissal is keyed to the producing
           ledger entry's id (esc-banner-dismissable): ✕ hides THIS
           notice instantly and across reloads; a new resolved entry
           notices normally. -->
      <VStack
        when="{window.__bramSendLedgerNotice(sendLedgerDs.value, sendNoticeDismissed)}"
        padding="$space-2"
        gap="$space-1"
        backgroundColor="$color-info-50"
        borderTop="1px solid $color-info-200">
        <HStack gap="$space-2" verticalAlignment="center">
          <Text
            fontSize="$fontSize-sm"
            width="*"
            value="{window.__bramSendLedgerNotice(sendLedgerDs.value, sendNoticeDismissed)}" />
          <Button
            label="✕"
            variant="ghost"
            size="xs"
            tooltip="Dismiss this notice"
            onClick="sendNoticeDismissed = window.__bramDismissSendNotice(window.__bramSendLedgerNoticeKey(sendLedgerDs.value))" />
        </HStack>
      </VStack>
      <!-- issue-231 footer tips: one context-driven, dismissible Tip line at
           the footer bottom, picked by window.__bramPickTip from the settings
           snapshot. Re-picks on mount and on footerTipTick bumps; Next skips
           for this session, the cross dismisses permanently. Existence guard
           keeps a stale binary (pre-tips helpers.js) from throwing. -->
      <HStack
        when="{window.__bramPickTip ? window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) : null}"
        gap="$space-2"
        paddingHorizontal="$space-2"
        paddingVertical="$space-1"
        verticalAlignment="center"
        marginTop="$space-1"
        backgroundColor="$color-surface-50"
        borderTop="1px solid $borderColor">
        <!-- Clickable only when the tip carries a link: external url opens
             in the system browser, internal route navigates in-pane, and a
             linkless tip renders as plain text. -->
        <!-- Plain Text wraps (width=* flex child, same as the send-ledger
             note above); a nested Text inside Link cannot (the anchor is an
             inline-flex whose child never shrinks). So the tip text is always
             plain, and the link rides an explicit Open button. -->
        <Text
          width="*"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          value="{(window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) || {}).text}" />
        <Button
          when="{window.__bramTipLink ? window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick) : ''}"
          label="Open"
          variant="ghost"
          size="xs"
          tooltip="Open the related page"
          onClick="window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick).indexOf('http') === 0 ? openExternal(window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick)) : navigate(window.__bramTipLink(footerTipSettings.value, footerSessions.value, footerTipTick))" />
        <Button
          label="Next"
          variant="ghost"
          size="xs"
          tooltip="Show a different tip"
          onClick="footerTipTick = window.__bramSkipTip((window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) || {}).id, footerTipTick)" />
        <Button
          label="✕"
          variant="ghost"
          size="xs"
          tooltip="{window.__bramTipDismissTooltip ? window.__bramTipDismissTooltip() : 'Dismiss this tip'}"
          onClick="footerTipTick = window.__bramDismissTip((window.__bramPickTip(footerTipSettings.value, footerSessions.value, footerTipTick) || {}).id, footerTipTick)" />
      </HStack>
    </VStack>
    </Theme>
  </Footer>
</App>
