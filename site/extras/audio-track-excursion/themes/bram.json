{
  "id": "bram",
  "name": "Bram theme",
  "extends": "xmlui",
  "themeVars": {
    "maxWidth-phone": "320px",
    "maxWidth-landscape-phone": "360px",
    "maxWidth-tablet": "400px",
    "paddingHorizontal-Button-sm": "$space-1",
    "width-navPanel-App": "$space-32",
    "maxWidth-content-App": "100%",
    "maxWidth-App": "100%",
    "maxWidth-content-Footer": "100%",
    "maxWidth-ModalDialog": "85vw",
    "lineHeight-H2": "1.2",
    "lineHeight-H3": "1.2",
    "lineHeight-H4": "1.2",
    "lineHeight-title-ModalDialog": "1.2",
    "marginTop-H2-markdown": "$space-3",
    "marginBottom-H2-markdown": "$space-1",
    "marginTop-Text-markdown": "0",
    "marginBottom-Text-markdown": "$space-2"
  }
}
