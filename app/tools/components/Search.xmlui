<Component name="Search" var.query="">
  <!-- issue-230 unified search. v1 wires the Claude session bucket via the
       /__search FTS5 route; commits/issues/history buckets and type facets
       are added incrementally. -->
  <variable name="typeColors"
    value="{{ session: 'blue', commit: 'green', issue: 'orange', history: 'purple' }}" />
  <variable name="selectedTypes" value="{['session', 'commit', 'issue', 'worklist-history']}" />

  <DataSource
    id="searchResults"
    url="/__search"
    queryParams="{{ q: query, limit: 100, types: selectedTypes.join(',') }}"
    when="{!!query &amp;&amp; query.trim().length >= 2}" />

  <SearchHitModal id="searchHitModalRef" query="{query}" />

  <VStack padding="$space-4" gap="$space-3" overflowY="auto">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Search</Heading>
      <SpaceFiller />
      <SearchBox
        placeholder="Search sessions, commits, issues…"
        inProgress="{searchResults.inProgress}"
        onQueryChange="(q) => query = q"
        onClear="query = ''; searchHitModalRef.close()" />
    </HStack>

    <HStack gap="$space-3" verticalAlignment="center">
      <Checkbox label="Sessions" initialValue="{true}"
        onDidChange="(v) => selectedTypes = window.__bramToggleType(selectedTypes, 'session', v)" />
      <Checkbox label="Commits" initialValue="{true}"
        onDidChange="(v) => selectedTypes = window.__bramToggleType(selectedTypes, 'commit', v)" />
      <Checkbox label="Issues" initialValue="{true}"
        onDidChange="(v) => selectedTypes = window.__bramToggleType(selectedTypes, 'issue', v)" />
      <Checkbox label="History" initialValue="{true}"
        onDidChange="(v) => selectedTypes = window.__bramToggleType(selectedTypes, 'worklist-history', v)" />
    </HStack>

    <Text when="{!query || query.trim().length &lt; 2}"
      color="$textColor-secondary"
      value="Type at least 2 characters to search indexed sessions." />
    <Text when="{query &amp;&amp; query.trim().length >= 2 &amp;&amp; searchResults.loaded &amp;&amp; (searchResults.value || []).length === 0}"
      color="$textColor-secondary"
      value="No matches." />

    <Theme fontSize-Badge="0.55em">
      <Items data="{searchResults.value || []}">
        <HStack gap="$space-3" paddingVertical="$space-2" borderBottom="1px solid $borderColor" verticalAlignment="start">
          <VStack gap="$space-0_5" width="7rem">
            <Badge value="{$item.type === 'worklist-history' ? 'history' : $item.type}" colorMap="{typeColors}" />
            <Text fontSize="$fontSize-xs" color="$textColor-secondary"
              value="{$item.date ? formatDateTime(new Date(Number($item.date) * 1000), 'yyyy-MM-dd HH:mm') : ''}" />
          </VStack>
          <VStack width="*" gap="$space-0_5">
            <Link noIndicator onClick="searchHitModalRef.open($item.snippet, $item.source)">
              <Text maxLines="1" fontWeight="$fontWeight-bold" value="{$item.source}" />
            </Link>
            <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="…{$item.snippet}…" />
          </VStack>
        </HStack>
      </Items>
    </Theme>
  </VStack>
</Component>
