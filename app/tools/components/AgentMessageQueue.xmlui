<Component name="AgentMessageQueue"
  var.entries="{null}"
  var.fullscreenImage="{null}">
  <!-- A sent message's screenshot opens full size, as in Transcript.xmlui. -->
  <Theme maxWidth-ModalDialog="95vw">
    <ModalDialog
      when="{!!fullscreenImage}"
      onClose="fullscreenImage = null">
      <Image
        src="{window.imageSrcForPath(fullscreenImage)}"
        fit="contain"
        width="100%"
        height="80vh" />
    </ModalDialog>
  </Theme>
  <!-- A note's Send or Delete stops a mic recording into it
       (__bramQueueRemove), but its editor is gone by the time the result
       arrives, so nothing would clear the shared recording flag and the
       other 🎤 buttons would stay disabled. Only one recording runs at a
       time, so any arrival means recording has ended. -->
  <PushSource
    id="queueVoiceArrival"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceArrival()}" />
  <ChangeListener
    listenTo="{queueVoiceArrival.value &amp;&amp; queueVoiceArrival.value.at}"
    onDidChange="() => worklistVoiceRecordingActive = false" />

  <!-- issue-90-q-page: a durable scratch queue. Notes accumulate while the
       agent works; each is re-editable in place and sent manually as a
       fresh turn when the user judges the moment right. Send buttons dim
       (disable) until the terminal is ready: no open turn per the
       turn-completion detector, and no pending menu. Sends ride toTurn, so
       the send-gate, send ledger, and strand forensics all apply. Entries
       persist host-side in resources/.bram-queue.json via /__queue and
       survive reloads and restarts. Order is presentation order only. -->

  <DataSource
    id="queueData"
    url="/__queue" />
  <DataSource
    id="queueWorklist"
    url="/__worklist"
    transformResult="{(d) => window.__bramWorklistAccept(d)}" />
  <PushSource
    id="queueWorklistChanged"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('worklist-changed')}" />
  <ChangeListener
    listenTo="{queueWorklistChanged.value &amp;&amp; queueWorklistChanged.value.tick}"
    onDidChange="() => queueWorklist.refetch()" />
  <ChangeListener
    listenTo="{queueData.value}"
    onDidChange="() => { if (entries === null &amp;&amp; queueData.value) { entries = window.__bramQueueRestore(queueData.value.entries || [], queueData.value.version); } }" />

  <!-- log-queue-entry-opens-message: the Log's Open in Queue link lands here
       as /queue?focus=<id>. An active entry is highlighted and scrolled to;
       a sent or deleted one shows its retained draft read-only below the
       header, and is never recreated. The lookup is one small read; with no
       focus the route answers missing and nothing shows. -->
  <DataSource
    id="queueFocusDraft"
    url="{'/__queue/draft?id=' + encodeURIComponent($queryParams.focus || '')}" />
  <ChangeListener
    listenTo="{($queryParams.focus || '') + '|' + ((entries || []).length)}"
    onDidChange="window.__bramQueueRevealFocus($queryParams.focus)" />

  <PushSource
    id="queueAgentStatus"
    initial="{null}"
    subscribe="{window.bramSubscribeAgentStatus()}" />
  <PushSource
    id="queueMenuEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeAgentMenu()}" />
  <!-- Phase-0 observe (queue-send-readiness-desync): trace every readiness-input
       transition so a lit-but-dead Send can be diagnosed at a turn boundary —
       whether queueAgentStatus.value is itself stale, or the header/button
       bindings diverge on render. Observe-only, no behavior change.
       Grep: subkind=queue op=ready-transition. -->
  <ChangeListener
    listenTo="{((queueAgentStatus.value &amp;&amp; queueAgentStatus.value.state) || '') + '|' + (queueMenuEvt.value ? '1' : '0')}"
    onDidChange="() => window.__bramIframeTrace('queue', {op: 'ready-transition', state: (queueAgentStatus.value &amp;&amp; queueAgentStatus.value.state) || '', menu: queueMenuEvt.value ? 1 : 0, ready: window.__bramQueueReady(queueAgentStatus.value, queueMenuEvt.value)})" />

  <VStack gap="$space-3" padding="$space-2">
    <HStack verticalAlignment="center" gap="$space-2">
      <Link when="{$queryParams.from === 'tip'}" noIndicator
        tooltip="Back to where you were" onClick="navigate(-1)">
        <Text value="← Back" />
      </Link>
      <Heading level="h2">Queue</Heading>
      <!-- issue-324: disabled until the /__queue DataSource hydrates
           (entries !== null). A pre-hydration click used to add one blank
           row and immediately persist it, silently overwriting the whole
           stored queue with no way back. -->
      <Button
        label="+ New item"
        size="xs"
        enabled="{entries !== null}"
        onClick="entries = window.__bramQueueAdd(entries)" />
      <Text
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{window.__bramQueueReadyLabel(queueAgentStatus.value, queueMenuEvt.value)}" />
    </HStack>
    <Text
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="Park thoughts here while the agent works. Edit any note in place; Send delivers it as a fresh turn. Send stays dimmed until the terminal is quiet and no menu is pending." />

    <!-- log-queue-entry-opens-message: a focused message that is no longer
         queued, read-only, with what happened to it and its recorded context. -->
    <!-- Leads with the quoted leading sentence (as the Log does), then what
         happened, then the recorded context. Close clears ?focus. Tinted and
         bordered like the pane's other contained notices (Main.xmlui's
         info-50 / info-200 cards), so it reads as a card, not a band. -->
    <HStack
      when="{!!$queryParams.focus &amp;&amp; queueFocusDraft.value &amp;&amp; !queueFocusDraft.value.active}"
      gap="$space-2" padding="$space-2" verticalAlignment="start"
      backgroundColor="$color-info-50" border="1px solid $color-info-200"
      borderRadius="$borderRadius">
      <VStack width="*" gap="$space-1">
        <Text when="{!!window.__bramQueueFocusTitle(queueFocusDraft.value.entry)}" fontWeight="$fontWeight-bold"
          value="{window.__bramQueueFocusTitle(queueFocusDraft.value.entry)}" />
        <Text value="{window.__bramQueueDraftFate(queueFocusDraft.value.entry)}" />
        <Text when="{!!queueFocusDraft.value.entry}" fontSize="$fontSize-xs" color="$textColor-secondary"
          value="{window.__bramQueueDraftContext(queueFocusDraft.value.entry)}" />
        <!-- Its screenshots, inside the card: maxWidth bounds each to the
             card's width (no inline-flex Link wrapper to size around), and
             Image's own click opens it full size
             (https://www.xmlui.org/docs/reference/components/Image). -->
        <Items data="{(queueFocusDraft.value.entry || {}).images || []}">
          <Image
            src="{window.imageSrcForPath($item)}"
            maxHeight="220px"
            maxWidth="100%"
            fit="contain"
            onClick="fullscreenImage = $item" />
        </Items>
      </VStack>
      <Button icon="close" variant="ghost" size="xs" tooltip="Close"
        onClick="navigate('/queue')" />
    </HStack>

    <Text
      when="{(entries || []).length === 0}"
      color="$textColor-secondary"
      value="No queued notes." />

    <!-- Non-virtualized Items in a scrollable VStack, not List: the queue is
         a small set, and List memoizes its virtualized rows so their direct
         bindings don't re-evaluate on a push-source delivery (the data,
         `entries`, is unchanged) — Send stranded dimmed-while-ready /
         undimmed-while-working, and refreshOn didn't reliably force it.
         Items re-renders every reactive cycle, so the row's live readiness
         binding tracks agent status + menu the way the header badge does.
         Same pattern as Workspace's worklist rows.
         https://www.xmlui.org/docs/reference/components/Items -->
    <VStack
      when="{(entries || []).length > 0}"
      height="*"
      overflowY="auto">
      <DndItems data="{entries || []}"
        dragHandle="true"
        onReorder="(newOrder) => { entries = window.__bramQueueReorder(entries, newOrder); }">
      <!-- queue-compact-rows: one controls row per item (mic + edited +
           Send-as + selects, then SpaceFiller pushing Send/Delete right),
           tight inter-item padding. The former right-hand button column is
           folded into the row. -->
      <HStack
        gap="$space-2"
        verticalAlignment="start"
        paddingVertical="$space-2"
        testId="{'queue-entry-' + $item.id}"
        borderRadius="$borderRadius"
        backgroundColor="{$item.id === $queryParams.focus ? '$color-primary-50' : 'transparent'}">
        <VStack width="*" gap="$space-0_5">
          <IsolatedDraftEditor
            id="queueEditor"
            placeholder="Type a note"
            initialValue="{$item.text}"
            resize="vertical"
            minRows="2"
            maxRows="16"
            width="100%"
            voiceTarget="{'queue-item:' + $item.id}"
            pasteTarget="{'queue-item:' + $item.id}"
            voiceTooltip="Voice note"
            onCommit="(v) => entries = window.__bramQueueUpdate(entries, $itemIndex, v)" />
          <HStack gap="$space-2" verticalAlignment="center">
            <Text
              fontSize="$fontSize-xs"
              color="$textColor-secondary"
              value="{window.__bramQueueEditedLabel($item.updatedAtMs)}" />
            <Text
              fontSize="$fontSize-xs"
              color="$textColor-secondary"
              value="Send as" />
            <Select
              width="8rem"
              initialValue="{window.__bramQueueSendMode($item)}"
              onDidChange="(v) => { entries = window.__bramQueueSetSendMode(entries, $itemIndex, v, (queueWorklist.value &amp;&amp; queueWorklist.value.items) || []); }">
              <Option value="message" label="Message" />
              <Option value="iterate" label="Feedback" />
            </Select>
            <Select
              when="{window.__bramQueueSendMode($item) === 'iterate'}"
              width="*"
              placeholder="Choose worklist item"
              data="{((queueWorklist.value &amp;&amp; queueWorklist.value.items) || []).map(i => ({ value: i.id, label: i.id + ((i.status || 'proposed') === 'applied' ? ' (to commit)' : ' (to apply)') }))}"
              initialValue="{$item.targetItemId || ''}"
              onDidChange="(v) => { entries = window.__bramQueueSetTargetItem(entries, $itemIndex, v); }" />
            <SpaceFiller />
            <!-- Readiness binds LIVE off the push sources, exactly like the
                 header badge above — do NOT route it through a cached var +
                 ChangeListener. That bridge strands: it seeds at one instant
                 and only updates on a transition, so a mount that straddles
                 the PushSource replay leaves it stuck (dimmed-while-ready, or
                 undimmed-while-working). A direct binding recomputes every
                 render and can't strand. On send, land on the surface where
                 the result shows (Message -> Transcript, Feedback ->
                 Worklist); the enabled gate blocks no-op sends, so
                 navigation only runs on a real send. -->
            <Button
              label="Send"
              size="xs"
              opacity="{window.__bramQueueReady(queueAgentStatus.value, queueMenuEvt.value) ? 1 : 0.45}"
              enabled="{window.__bramQueueReady(queueAgentStatus.value, queueMenuEvt.value) &amp;&amp; (window.__bramQueueSendMode($item) !== 'iterate' || ((queueWorklist.value &amp;&amp; queueWorklist.value.items) || []).some(i => i.id === String($item.targetItemId || '')))}"
              tooltip="Send this note to the agent as a fresh turn"
              onClick="const draft = (queueEditor.getValue() || '').trim(); if (draft) { const withDraft = window.__bramQueueUpdate(entries, $itemIndex, draft); entries = window.__bramQueueSend(withDraft, $itemIndex, (queueWorklist.value &amp;&amp; queueWorklist.value.items) || []); navigate(window.__bramQueueSendMode($item) === 'iterate' ? '/worklist' : '/transcript'); }" />
            <Button
              label="Delete"
              size="xs"
              variant="ghost"
              onClick="entries = window.__bramQueueRemove(entries, $itemIndex)" />
          </HStack>
        </VStack>
      </HStack>
      </DndItems>
    </VStack>

  </VStack>
</Component>
