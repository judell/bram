<Component name="FooterSessionContext">
  <!-- session-context-pane: the session line's context figure. Owns its
       sources like FooterContextLine (judell/bram#470): the boot read is
       /__session-size, and the host's replayable `session-context-changed`
       event (emitted at each turn end; payload is the route's `context`
       object) is pushed, not polled. Contract:
         props   sessionTitle — the current session's title, for the
                 "continue: <title>" name of the new session
       Renders nothing until the host sends a `context` with `tokens`.
       https://www.xmlui.org/docs/reference/components/PushSource
       https://www.xmlui.org/docs/reference/components/DataSource -->
  <DataSource id="sessionSize" url="/__session-size" />
  <PushSource id="contextSettingsEvt" initial="{null}" subscribe="{window.bramSubscribeTauriEvent('settings-changed')}" />
  <ChangeListener
    listenTo="{contextSettingsEvt.value &amp;&amp; contextSettingsEvt.value.tick}"
    onDidChange="() => { sessionSize.refetch(); }" />
  <!-- List prices per model, a file the agent maintains (resources/
       model-rates.json, with asOf and source): not fetched live, not in
       the host (Jon, 2026-11-23). Served from the pane's own tree, so the
       path is absolute within the xmlui:// origin. -->
  <DataSource id="modelRates" url="/tools/resources/model-rates.json" />
  <!-- The footer's current session, for ignoring a reading that names
       another (Main's footerSessions, mirrored here to keep Main untouched). -->
  <DataSource id="ctxSessions" url="/__sessions/list" queryParams="{{ limit: 20 }}" />
  <PushSource
    id="ctxSessionsChangedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <!-- context-dialog-measured-compaction-range: a switch changes which
       session the route reads, so re-read it with the list; the picker
       blanks a reading that names another session until then. -->
  <ChangeListener
    listenTo="{ctxSessionsChangedEvt.value &amp;&amp; ctxSessionsChangedEvt.value.tick}"
    onDidChange="() => { ctxSessions.refetch(); sessionSize.refetch(); }" />
  <!-- footer-context-blank-until-first-turn-ends (Jon, 2026-11-23): a new
       session's switch payload has no tokens, and the next pushed reading
       comes only at turn end, so the line was blank for the whole first
       turn. conversation-state-changed is the host's live transcript
       signal (emitted as the transcript grows, deduplicated), so on it the
       route value is re-read; /__session-size reads the transcript live,
       and once it names the current session __bramSessionContextPick shows
       it. Throughout a turn the footer compares that reading with the
       turn-end event by model-call time, including after compaction.
       https://www.xmlui.org/docs/reference/components/PushSource -->
  <PushSource
    id="conversationStateEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('conversation-state-changed')}" />
  <ChangeListener
    listenTo="{conversationStateEvt.value &amp;&amp; conversationStateEvt.value.tick}"
    onDidChange="() => { sessionSize.refetch(); }" />
  <PushSource
    id="sessionContextEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('session-context-changed')}" />
  <HStack
    when="{!!window.__bramSessionContextLine(window.__bramSessionContextPick(sessionContextEvt.value, sessionSize.value &amp;&amp; sessionSize.value.context, window.__bramSessionContextKey(window.__bramCurrentSessionOf(ctxSessions.value))))}"
    gap="$space-1"
    wrapContent="true"
    verticalAlignment="center">
    <HStack
      gap="$space-1"
      wrapContent="true"
      verticalAlignment="center"
      var.ctx="{window.__bramSessionContextPick(sessionContextEvt.value, sessionSize.value &amp;&amp; sessionSize.value.context, window.__bramSessionContextKey(window.__bramCurrentSessionOf(ctxSessions.value)))}"
      var.dismissedBoundaryMs="{0}"
      var.infoKey="{''}">
      <!-- context-dialog-measured-compaction-range: where the agent has
           compacted on its own in this project, for the context dialog's
           sentence and its Details table. Fetched the first time a dialog
           opens (infoKey is set by the little-i buttons and never cleared),
           refetched only when this session's compaction count moves; never
           polled (developing-bram.md, "Push over polling").
           https://www.xmlui.org/docs/reference/components/DataSource
           https://www.xmlui.org/docs/reference/components/ChangeListener -->
      <DataSource id="compactionPoints" url="/__compaction-points" when="{!!infoKey}" />
      <ChangeListener
        listenTo="{ctx &amp;&amp; ctx.compactions}"
        onDidChange="() => { if (infoKey) { compactionPoints.refetch(); } }" />
      <!-- Each figure carries a little-i that opens a modal explaining it,
           the Settings tab's pattern (settingInfoDialog); no tooltips, the
           modal is the explanation (Jon, 2026-11-23). Warning color only
           together with the Start a new session button (developing-bram.md,
           "Warning color is earned").
           https://www.xmlui.org/docs/reference/components/ModalDialog -->
      <Text
        fontSize="$fontSize-sm"
        color="{window.__bramSessionContextColor(ctx)}"
        value="{window.__bramSessionContextTokensLabel(ctx)}" />
      <Button icon="info" size="xs" variant="ghost"
        onClick="infoKey = 'context'; contextInfoDialog.open()" />
      <Text
        when="{!!window.__bramSessionContextFloorLabel(ctx)}"
        fontSize="$fontSize-sm"
        color="{window.__bramSessionContextColor(ctx)}"
        value="{window.__bramSessionContextFloorLabel(ctx)}" />
      <Button
        when="{!!window.__bramSessionContextFloorLabel(ctx)}"
        icon="info" size="xs" variant="ghost"
        onClick="infoKey = 'floor'; contextInfoDialog.open()" />
      <Text
        when="{!!window.__bramSessionContextCompactionsLabel(ctx)}"
        fontSize="$fontSize-sm"
        color="{window.__bramSessionContextColor(ctx)}"
        value="{window.__bramSessionContextCompactionsLabel(ctx)}" />
      <HStack
        when="{window.__bramSessionContextShowButton(ctx, dismissedBoundaryMs)}"
        gap="$space-0_5"
        verticalAlignment="center">
        <!-- new-session-button-writes-the-brief: the click sends the agent a
             `new-session:` turn and goes to the Transcript; the agent writes
             its handoff brief into each begun item's draft, then posts the
             suggestion, which opens the Sessions tab's dialog pre-filled.
             https://www.xmlui.org/docs/reference/components/Button -->
        <Button
          label="Start a new session"
          size="xs"
          variant="outlined"
          onClick="window.__bramSessionContextNewSession(ctx, $props.sessionTitle)" />
        <Button
          label="✕"
          size="xs"
          variant="ghost"
          onClick="dismissedBoundaryMs = (ctx &amp;&amp; ctx.boundaryAtMs) || 0" />
      </HStack>
      <!-- One plain sentence first (the threshold and what a new session
           saves); the rest folds under Details (Jon, 2026-11-23).
           https://www.xmlui.org/docs/reference/components/ExpandableItem -->
      <!-- Wide enough for the five-column saving table: maxWidth-ModalDialog
           defaults to 450px (https://www.xmlui.org/docs/reference/components/ModalDialog). -->
      <Theme maxWidth-ModalDialog="min(760px, 95vw)">
      <ModalDialog id="contextInfoDialog" title="{window.__bramSessionContextInfoTitle(infoKey)}">
        <VStack gap="$space-3" padding="$space-2" paddingTop="0">
          <Markdown content="{window.__bramSessionContextLead(infoKey, ctx, modelRates.value, compactionPoints.value)}" />
          <ExpandableItem summary="Details" initiallyExpanded="{false}" iconPosition="start">
            <Markdown content="{window.__bramSessionContextInfoBody(infoKey, ctx, modelRates.value, compactionPoints.value)}" />
          </ExpandableItem>
          <HStack gap="$space-3" verticalAlignment="center">
            <Button label="Got it" onClick="contextInfoDialog.close()" />
            <!-- context-stack-viewer: the figure's blocks live on the Context
                 tab; close first so the dialog, which belongs to the footer,
                 does not stay over the new page
                 (https://www.xmlui.org/docs/howto/navigate-programmatically). -->
            <Button
              label="See what's in context"
              variant="ghost"
              onClick="contextInfoDialog.close(); navigate('/context')" />
          </HStack>
        </VStack>
      </ModalDialog>
      </Theme>
    </HStack>
  </HStack>
</Component>
