<Component
  name="Status"
  var.refreshTick="{0}"
  var.rowInfoTitle="{''}"
  var.rowInfoDescription="{''}"
  var.tokensNonce="{0}"
  var.tokenInfoKey="{''}">

  <DataSource id="status" url="/__coordination-status?t={refreshTick}" />
  <DataSource id="sessionSize" url="/__session-size?t={refreshTick}" pollIntervalInSeconds="30" />
  <!-- issue-415: live guard self-test. Runs the installed guard chain
       against a throwaway project when the tab opens and on Refresh; no
       polling (docs/developing-bram.md, Push over polling). -->
  <DataSource id="guardSelftest" url="/__guard/selftest?t={refreshTick}" />
  <!-- issue-469-status-dry-run: what the 0.8.4 state-folder move would do.
       Read-only; refetched on Refresh, no polling. -->
  <DataSource id="stateDirPlan" url="/__state-dir/plan?t={refreshTick}" />
  <!-- issue-469-mixed-folder-dialog: Status's way back from Not now. The
       button calls window.__bramStateMoveDecide (a plain fetch); the host
       pushes state-dir-changed and the plan refetches on it, the PushSource
       idiom of AlertsPulse.xmlui. Not an APICall: its completion reached the
       pane ~30 s late (issue-469-state-move-pane-fixes). -->
  <PushSource id="stateDirPlanEvt" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('state-dir-changed')}" />
  <ChangeListener listenTo="{stateDirPlanEvt.value &amp;&amp; stateDirPlanEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(stateDirPlanEvt.value, stateDirPlan)" />

  <VStack padding="$space-6" gap="$space-4">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Status</Heading>
      <SpaceFiller />
      <Text
        when="{status.value}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{'Updated ' + ((status.value.generatedAt || '').slice(11, 19))}" />
      <Button
        label="Refresh"
        size="sm"
        onClick="refreshTick = refreshTick + 1; status.refetch(); sessionSize.refetch(); guardSelftest.refetch(); stateDirPlan.refetch();" />
    </HStack>

    <!-- issue-415: whether the worklist guard actually runs and decides as
         expected, probed rather than presumed. Pass, or the failing cases
         with the guard's own decision and reason. -->
    <VStack when="{guardSelftest.value}" gap="$space-2">
      <HStack gap="$space-3" verticalAlignment="center">
        <Heading level="h3">Guard</Heading>
        <Text
          fontWeight="$fontWeight-bold"
          color="{guardSelftest.value.ok ? '$color-success-700' : '$color-danger-700'}"
          value="{window.__bramGuardSelftestSummary(guardSelftest.value)}" />
      </HStack>
      <Text
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{window.__bramGuardRegistrationLine(guardSelftest.value)}" />
      <Text
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{window.__bramGuardRoutingLine(guardSelftest.value)}" />
      <Table data="{guardSelftest.value.cases || []}">
        <Column header="case" width="230px" bindTo="id" />
        <Column header="expected" width="90px" bindTo="expect" />
        <Column header="guard said" width="100px">
          <Text
            fontWeight="$fontWeight-bold"
            color="{$item.pass ? '$color-success-700' : '$color-danger-700'}"
            value="{$item.got}" />
        </Column>
        <Column header="reason">
          <Text fontSize="$fontSize-sm" value="{$item.reason}" overflowMode="flow" breakMode="word" />
        </Column>
      </Table>
    </VStack>

    <!-- issue-469-status-dry-run: the state folder's plan, formatted by the
         window.__bramStateDirPlan* helpers. Items, not List: short lists
         (tracked is capped at 200 by the host). -->
    <VStack when="{stateDirPlan.value}" gap="$space-2">
      <Heading level="h3">State folder</Heading>
      <!-- issue-469-leftover-folder-reported: state still in resources/, why,
           and the relaunch that retries the move. -->
      <VStack when="{window.__bramStateDirLeftover(stateDirPlan.value, 'show')}" gap="$space-2">
        <Text when="{!window.__bramStateDirLeftover(stateDirPlan.value, 'warn')}" fontWeight="$fontWeight-bold" value="{window.__bramStateDirLeftover(stateDirPlan.value, 'line')}" />
        <Text when="{window.__bramStateDirLeftover(stateDirPlan.value, 'warn')}" fontWeight="$fontWeight-bold" color="$color-warn-700" value="{window.__bramStateDirLeftover(stateDirPlan.value, 'line')}" />
        <Text when="{window.__bramStateDirLeftover(stateDirPlan.value, 'why')}" value="{window.__bramStateDirLeftover(stateDirPlan.value, 'why')}" />
        <Text when="{window.__bramStateDirLeftover(stateDirPlan.value, 'obstacle')}" value="{window.__bramStateDirLeftover(stateDirPlan.value, 'obstacle')}" />
        <Button
          when="{window.__bramStateDirLeftover(stateDirPlan.value, 'offer')}"
          label="Migrate and relaunch"
          variant="outlined"
          size="xs"
          tooltip="{window.__bramStateDirLeftover(stateDirPlan.value, 'tip')}"
          onClick="window.__bramStateMigrateRelaunch()" />
      </VStack>
      <!-- status-reports-a-completed-move: once moved, say what happened;
           the dry run below describes a move that is done, so it hides. -->
      <Text when="{window.__bramStateDirPlanMoved(stateDirPlan.value, 'show')}" fontWeight="$fontWeight-bold" value="{window.__bramStateDirPlanMoved(stateDirPlan.value, 'line')}" />
      <Text when="{window.__bramStateDirPlanMoved(stateDirPlan.value, 'show')}" value="{window.__bramStateDirPlanMoved(stateDirPlan.value, 'left')}" />
      <Text when="{window.__bramStateDirPlanMoved(stateDirPlan.value, 'show')}" value="{window.__bramStateDirPlanMoved(stateDirPlan.value, 'settings')}" />
      <Text when="{!window.__bramStateDirPlanMoved(stateDirPlan.value, 'show')}" fontSize="$fontSize-sm" color="$textColor-secondary" value="{stateDirPlan.value.note}" />
      <Text fontWeight="$fontWeight-bold" value="{window.__bramStateDirPlanFolderLine(stateDirPlan.value)}" />
      <Text value="{window.__bramStateDirPlanLiveClaimLine(stateDirPlan.value)}" />
      <HStack when="{window.__bramStateMoveBanner(window.__bramStateDirPlanKept(stateDirPlan.value), 'pending')}" verticalAlignment="center" wrapContent="true" gap="$space-2">
        <Text value="{window.__bramStateMoveBanner(window.__bramStateDirPlanKept(stateDirPlan.value), 'text')}" />
        <Button
          when="{window.__bramStateMoveBanner(window.__bramStateDirPlanKept(stateDirPlan.value), 'offer')}"
          label="Move at next launch"
          variant="outlined"
          size="xs"
          tooltip="{window.__bramStateMoveBanner(window.__bramStateDirPlanKept(stateDirPlan.value), 'stays')}"
          onClick="window.__bramStateMoveDecide('move')" />
      </HStack>
      <VStack when="{!window.__bramStateDirPlanMoved(stateDirPlan.value, 'show')}" gap="$space-2">
        <Text fontWeight="$fontWeight-bold" value="{window.__bramStateDirPlanHeading(stateDirPlan.value, 'wouldMove')}" />
        <Items data="{stateDirPlan.value.wouldMove || []}">
          <Text fontSize="$fontSize-sm" value="{window.__bramStateDirPlanRow($item)}" />
        </Items>
        <Text fontWeight="$fontWeight-bold" value="{window.__bramStateDirPlanHeading(stateDirPlan.value, 'foreign')}" />
        <Items data="{stateDirPlan.value.foreign || []}">
          <Text fontSize="$fontSize-sm" value="{window.__bramStateDirPlanRow($item)}" />
        </Items>
      </VStack>
      <Text fontWeight="$fontWeight-bold" value="{window.__bramStateDirPlanHeading(stateDirPlan.value, 'tracked')}" />
      <Items data="{window.__bramStateDirPlanTrackedPaths(stateDirPlan.value)}">
        <Text fontSize="$fontSize-sm" value="{window.__bramStateDirPlanRow($item)}" />
      </Items>
      <Text fontWeight="$fontWeight-bold" value="{window.__bramStateDirPlanHeading(stateDirPlan.value, 'nested')}" />
      <Items data="{stateDirPlan.value.nested || []}">
        <Text fontSize="$fontSize-sm" value="{window.__bramStateDirPlanRow($item)}" />
      </Items>
    </VStack>

    <VStack when="{sessionSize.value &amp;&amp; sessionSize.value.humanBytes}" gap="$space-2">
      <Heading level="h3">Session size</Heading>
      <HStack gap="$space-3" verticalAlignment="center">
        <Text fontWeight="$fontWeight-bold" value="{sessionSize.value.humanBytes}" />
        <Text
          when="{sessionSize.value.provider}"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          value="{'(' + sessionSize.value.provider + ')'}" />
      </HStack>
      <Text
        when="{sessionSize.value.guidance}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{sessionSize.value.guidance}" />
    </VStack>

    <Text
      when="{status.inProgress}"
      color="$textColor-secondary"
      fontSize="$fontSize-sm"
      value="Loading coordination signals..." />

    <Text
      when="{status.error}"
      color="$color-danger-700"
      fontSize="$fontSize-sm"
      value="Status signals failed to load." />

    <Text
      when="{!status.inProgress &amp;&amp; !status.error &amp;&amp; !(status.value &amp;&amp; status.value.sections &amp;&amp; status.value.sections.length)}"
      color="$textColor-secondary"
      fontSize="$fontSize-sm"
      value="No coordination signals found." />

    <Items data="{status.value &amp;&amp; status.value.sections || []}">
      <VStack gap="$space-2">
        <HStack gap="$space-2" verticalAlignment="baseline">
          <Heading level="h3" value="{$item.title}" />
          <Text
            when="{statusSectionSubhead($item.title)}"
            fontSize="$fontSize-sm"
            color="$textColor-secondary"
            value="{'— ' + statusSectionSubhead($item.title)}" />
        </HStack>
        <Table data="{$item.rows}">
          <Column header="signal" width="190px">
            <HStack gap="$space-1" verticalAlignment="center">
              <Button
                icon="info"
                size="xs"
                variant="ghost"
                tooltip="About this signal"
                onClick="rowInfoTitle = $item.signal; rowInfoDescription = statusSignalDescription($item.signal); rowInfoDialog.open()" />
              <Text value="{$item.signal}" overflowMode="flow" breakMode="word" />
            </HStack>
          </Column>
          <Column header="level" width="80px">
            <Text
              fontWeight="$fontWeight-bold"
              color="{$item.level === 'error' ? '$color-danger-700' : ($item.level === 'warn' ? '$color-warn-700' : ($item.level === 'ok' ? '$color-success-700' : '$textColor-secondary'))}"
              value="{$item.level || 'n/a'}" />
          </Column>
          <!-- status-dual-source-visibility: rows cross-checked against the
               mirror db carry a `sources` object; the ⇄ marker identifies
               them at a glance and hover reports both sides verbatim
               (Column tooltip evaluates per cell with $item in scope).
               On a warn row the tooltip shows exactly what disagrees. -->
          <Column
            header="state"
            width="150px"
            tooltip="{$item.sources ? 'db: ' + $item.sources.db + ' · file: ' + $item.sources.file : ''}">
            <Text
              fontWeight="$fontWeight-bold"
              value="{$item.state}{$item.sources ? ' ⇄' : ''}" />
          </Column>
          <Column header="detail">
            <Text value="{$item.detail}" overflowMode="flow" breakMode="word" />
          </Column>
          <Column header="last seen" width="175px">
            <Text
              fontSize="$fontSize-sm"
              color="$textColor-secondary"
              value="{$item.seen || 'n/a'}" />
          </Column>
        </Table>
      </VStack>
    </Items>

    <!-- issue-486-token-accounting-instrument: a plain dump of
         /__token-accounting until we know what the UI needs (Jon,
         2026-11-12). The read walks every session (6-7 s), so it runs only
         on Load: `when` holds the DataSource until the nonce moves
         (https://www.xmlui.org/docs/howto/hide-an-element-until-its-datasource-is-ready).
         Columns format with `type` (https://www.xmlui.org/docs/reference/components/Column). -->
    <DataSource id="tokens" url="/__token-accounting?t={tokensNonce}" when="{tokensNonce > 0}" />
    <VStack gap="$space-2">
      <HStack gap="$space-3" verticalAlignment="center">
        <Heading level="h3">Token accounting</Heading>
        <Button
          label="{tokensNonce > 0 ? 'Reload' : 'Load'}"
          size="sm"
          enabled="{!tokens.inProgress}"
          onClick="tokensNonce = tokensNonce + 1" />
        <Text
          when="{tokens.inProgress}"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          value="Reading every session (about 7 s)…" />
        <Text
          when="{tokens.loaded &amp;&amp; !!tokens.value}"
          fontSize="$fontSize-sm"
          color="$textColor-secondary"
          value="{(tokens.value.sessions || []).length + ' sessions, ' + tokens.value.ms + ' ms'}" />
      </HStack>
      <Text
        when="{tokensNonce == 0}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="Per-call token readings from every agent's session files: context per call by model, how much would fit a smaller window, and what each session costs before any work." />
      <VStack when="{tokens.loaded &amp;&amp; !!tokens.value}" gap="$space-2">
        <!-- Real Tables (Jon, 2026-11-12). Column has no header template
             (https://www.xmlui.org/docs/reference/components/Column), so the
             ⓘ explanations sit in a row of labelled buttons above each table,
             each setting tokenInfoKey for the dialog below. Cells format
             through the __bramToken* helpers. -->
        <HStack gap="$space-1" verticalAlignment="center" wrapContent="true">
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="About the columns:" />
          <Button size="xs" variant="ghost" icon="info" label="Provider" onClick="tokenInfoKey = 'provider'" />
          <Button size="xs" variant="ghost" icon="info" label="Calls" onClick="tokenInfoKey = 'calls'" />
          <Button size="xs" variant="ghost" icon="info" label="Context" onClick="tokenInfoKey = 'context'" />
          <Button size="xs" variant="ghost" icon="info" label="Fit" onClick="tokenInfoKey = 'fit'" />
          <Button size="xs" variant="ghost" icon="info" label="Floor" onClick="tokenInfoKey = 'floor'" />
          <Button size="xs" variant="ghost" icon="info" label="Cache hit" onClick="tokenInfoKey = 'cache'" />
        </HStack>
        <Table data="{tokens.value.constrained.byModel}">
          <Column bindTo="provider" header="Provider" width="90px" />
          <Column bindTo="model" header="Model" />
          <Column bindTo="calls" header="Calls" width="90px"><Text value="{window.__bramTokenInt($item.calls)}" /></Column>
          <Column header="Context p50" width="100px"><Text value="{window.__bramTokenK($item.context.p50)}" /></Column>
          <Column header="p90" width="70px"><Text value="{window.__bramTokenK($item.context.p90)}" /></Column>
          <Column header="Peak" width="70px"><Text value="{window.__bramTokenK($item.context.peak)}" /></Column>
          <Column header="Fit 64k" width="75px"><Text value="{window.__bramTokenFit($item, '64k')}" /></Column>
          <Column header="128k" width="65px"><Text value="{window.__bramTokenFit($item, '128k')}" /></Column>
          <Column header="200k" width="65px"><Text value="{window.__bramTokenFit($item, '200k')}" /></Column>
          <Column header="256k" width="65px"><Text value="{window.__bramTokenFit($item, '256k')}" /></Column>
          <Column header="Floor" width="70px"><Text value="{window.__bramTokenFloor($item)}" /></Column>
          <Column bindTo="cacheHitShare" header="Cache hit" width="90px"><Text value="{window.__bramTokenPct($item.cacheHitShare)}" /></Column>
        </Table>
        <Text fontSize="$fontSize-sm" color="$textColor-secondary"
          value="Which files the agents pull into their context, and how: the figures show how much a read returns compared with the file, which is the evidence for whether splitting a big file such as lib.rs would change what they read." />
        <HStack gap="$space-1" verticalAlignment="center" wrapContent="true">
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="About the columns:" />
          <Button size="xs" variant="ghost" icon="info" label="Reads" onClick="tokenInfoKey = 'reads'" />
          <Button size="xs" variant="ghost" icon="info" label="Per read" onClick="tokenInfoKey = 'perRead'" />
          <Button size="xs" variant="ghost" icon="info" label="Read in total" onClick="tokenInfoKey = 'total'" />
          <Button size="xs" variant="ghost" icon="info" label="Via shell" onClick="tokenInfoKey = 'shell'" />
          <Button size="xs" variant="ghost" icon="info" label="Tests" onClick="tokenInfoKey = 'tests'" />
        </HStack>
        <Table data="{window.__bramTokenFileRows(tokens.value)}">
          <Column bindTo="path" header="Path"><Text variant="code" breakMode="anywhere" value="{$item.path}" /></Column>
          <Column bindTo="reads" header="Reads" width="80px"><Text value="{window.__bramTokenInt($item.reads)}" /></Column>
          <Column header="Per read" width="90px"><Text value="{window.__bramTokenPerRead($item)}" /></Column>
          <Column bindTo="bytes" header="Read in total" width="110px"><Text value="{window.__bramTokenBytes($item.bytes)}" /></Column>
          <Column bindTo="sizeBytes" header="File size" width="90px"><Text value="{window.__bramTokenFileSize($item)}" /></Column>
          <Column bindTo="viaShellBytes" header="Via shell" width="90px"><Text value="{window.__bramTokenBytes($item.viaShellBytes)}" /></Column>
          <Column header="Tests" width="70px"><Text value="{window.__bramTokenTests($item)}" /></Column>
        </Table>
      </VStack>
    </VStack>

    <Theme maxWidth-ModalDialog="50vw">
      <ModalDialog when="{!!tokenInfoKey}" title="{window.__bramTokenInfoTitle(tokenInfoKey)}" onClose="tokenInfoKey = ''">
        <VStack gap="$space-3" padding="$space-2">
          <Markdown interpolateBindings="false" allowHtml="false"
            content="{window.__bramTokenInfoText(tokenInfoKey, tokens.value)}" />
        </VStack>
      </ModalDialog>
    </Theme>

    <!-- Row-info popups are short (a signal's description); override the global
         85vw default to a compact 50vw (modals-default-85vw-width iterate). -->
    <Theme maxWidth-ModalDialog="50vw">
    <ModalDialog
      id="rowInfoDialog"
      title="{rowInfoTitle}">
      <VStack gap="$space-3" padding="$space-2">
        <Text value="{rowInfoDescription}" />
        <HStack>
          <Button label="Got it" onClick="rowInfoDialog.close()" />
        </HStack>
      </VStack>
    </ModalDialog>
    </Theme>
  </VStack>
</Component>
