<Component name="Worklist">
  <!-- worklist2-nav-scaffold / worklist-component-rename /
       worklist2-row-expanders: read-only preview of the redesigned,
       evidence-first gate (tutorial gist v3). Binds the same /__worklist
       payload Workspace uses, so the two tabs cannot disagree about state.
       Two-level compression per the old tab's proven shape: a row-level
       expander (title; disk state joins the summary when rung 1 lands),
       with Will touch / Before / After / Diff as nested expanders,
       collapsed by default. Local expansion state only - none of
       Workspace's persistence machinery. No actions: gating still happens
       in the Worklist tab. -->
  <DataSource id="worklist" url="/__worklist" />
  <VStack padding="$space-4" gap="$space-3">
    <H2>Worklist2</H2>
    <!-- Component is named Worklist (the eventual real name); only the nav
         label and route say Worklist2 while the old tab (Workspace.xmlui)
         still owns /worklist. Renaming the label later solves the legacy
         naming in one move. -->
    <Text
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="Read-only preview of the redesigned gate. To approve, iterate, or drop, use the Worklist tab." />
    <Text
      when="{worklist.value &amp;&amp; (!worklist.value.items || worklist.value.items.length === 0)}"
      color="$textColor-secondary">
      (no items)
    </Text>
    <Items data="{worklist.value &amp;&amp; worklist.value.items ? worklist.value.items : []}">
      <Theme paddingLeft-summary-ExpandableItem="0">
        <ExpandableItem
          summary="{$item.id}"
          fullWidthSummary="true">
          <VStack gap="$space-2" paddingLeft="$space-4">
            <ExpandableItem
              when="{window.__bramWorklistItemFiles($item).length > 0}"
              summary="Will touch"
              fullWidthSummary="true">
              <VStack gap="$space-1">
                <Items data="{window.__bramWorklistItemFiles($item)}">
                  <Text value="{$item}" variant="code" fontSize="$fontSize-sm" />
                </Items>
              </VStack>
            </ExpandableItem>
            <ExpandableItem
              when="{$item.before}"
              summary="Before"
              fullWidthSummary="true">
              <Markdown content="{$item.before}" interpolateBindings="false" allowHtml="false" />
            </ExpandableItem>
            <ExpandableItem
              when="{$item.after}"
              summary="After"
              fullWidthSummary="true">
              <Markdown content="{$item.after}" interpolateBindings="false" allowHtml="false" />
            </ExpandableItem>
            <ExpandableItem
              when="{$item.diff}"
              summary="Diff"
              fullWidthSummary="true">
              <VStack gap="$space-1">
                <DiffView text="{cappedDiffText($item.diff || '')}" />
              </VStack>
            </ExpandableItem>
            <HStack
              when="{$item.closesIssues &amp;&amp; $item.closesIssues.length > 0}"
              gap="$space-2"
              verticalAlignment="center">
              <Text value="closes" fontSize="$fontSize-sm" color="$textColor-secondary" />
              <Items data="{$item.closesIssues}">
                <Text value="{'#' + $item.number}" fontSize="$fontSize-sm" />
              </Items>
            </HStack>
          </VStack>
        </ExpandableItem>
      </Theme>
    </Items>
  </VStack>
</Component>
