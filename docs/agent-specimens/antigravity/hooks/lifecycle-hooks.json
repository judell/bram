{
  "specimen-lifecycle": {
    "SessionStart": [
      { "type": "command", "command": "bash <pack>/hooks/log-hook.sh SessionStart" }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash <pack>/hooks/log-hook.sh PreToolUse" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bash <pack>/hooks/log-hook.sh PostToolUse" }
        ]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "bash <pack>/hooks/log-hook.sh PreInvocation" }
    ],
    "PostInvocation": [
      { "type": "command", "command": "bash <pack>/hooks/log-hook.sh PostInvocation" }
    ],
    "Stop": [
      { "type": "command", "command": "bash <pack>/hooks/log-hook.sh Stop" }
    ]
  }
}
