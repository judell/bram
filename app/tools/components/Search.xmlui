<Component name="Search" var.query="{$queryParams.q || ''}">
  <!-- issue-230 unified search across the local FTS5 index (sessions,
       commits, issues, worklist-history). Each type is queried independently
       (its own top-100) so a length-penalized bucket isn't squeezed out of a
       global top-100; the pills count per-type and the list merges the
       selected buckets by rank. Clicking a title inline-expands that row
       (single-open) and fetches the real per-type source. -->
  <variable name="typeColors"
    value="{{ session: 'blue', commit: 'green', issue: '#c2410c', history: 'purple' }}" />
  <variable name="facetColors"
    value="{{ Sessions: 'blue', Commits: 'green', Issues: '#c2410c', History: 'purple' }}" />
  <!-- selectedTypes (the facet pills) and mode seed from the URL so an
       Evidence "replay" link (Workspace.xmlui) lands here pre-filled. Absent
       => the everyday defaults (AND mode; facets per the Settings toggle
       __bramSearchBadgesInitialAllOn — all four buckets, or none). These stay
       locally mutable working copies; $queryParams only changes on navigation,
       so a fresh replay remounts and re-seeds without clobbering local edits.
       See https://docs.xmlui.org/howto/deep-link-to-a-tab-or-section -->
  <variable name="selectedTypes"
    value="{$queryParams.types ? $queryParams.types.split(',') : (window.__bramSearchBadgesInitialAllOn() ? ['session', 'commit', 'issue', 'worklist-history'] : [])}" />
  <variable name="mode" value="{$queryParams.mode || 'and'}" />
  <variable name="ready" value="{!!query &amp;&amp; query.trim().length >= 2}" />
  <variable name="expandedHit" value="{null}" />
  <!-- Selected date window [lo, hi] (epoch seconds); null = no date filter. -->
  <variable name="dateFilter" value="{null}" />

  <DataSource id="rSession" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'session', mode: mode }}" when="{ready}" />
  <DataSource id="rCommit" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'commit', mode: mode }}" when="{ready}" />
  <DataSource id="rIssue" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'issue', mode: mode }}" when="{ready}" />
  <DataSource id="rHistory" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'worklist-history', mode: mode }}" when="{ready}" />

  <!-- Full relevance-ordered set of the selected buckets (no date filter) — the
       stable domain the slider measures, so moving the handles never shifts it. -->
  <variable name="merged" value="{
    [].concat(
      selectedTypes.includes('session') ? (rSession.value || []) : [],
      selectedTypes.includes('commit') ? (rCommit.value || []) : [],
      selectedTypes.includes('issue') ? (rIssue.value || []) : [],
      selectedTypes.includes('worklist-history') ? (rHistory.value || []) : []
    ).sort((a, b) => a.rank - b.rank)
  }" />

  <!-- Date-slider domain: [min, max] hit date across merged; widen by a day when
       all hits share one date so the two thumbs aren't coincident. -->
  <variable name="hitDates" value="{merged.map(h => Number(h.date)).filter(n => n > 0)}" />
  <variable name="dateLo" value="{hitDates.length ? hitDates.reduce((a, b) => a &lt; b ? a : b) : null}" />
  <variable name="dateHi" value="{hitDates.length ? hitDates.reduce((a, b) => a &gt; b ? a : b) : null}" />
  <variable name="dateRange"
    value="{dateLo === null ? null : [dateLo, dateHi > dateLo ? dateHi : dateLo + 86400]}" />

  <!-- New query => new domain; reset the filter and snap the handles to the full
       span (a stale window from the prior query would mis-narrow). Moving the
       slider doesn't touch dateRange, so this never loops. Two listeners because
       ChangeListener.onDidChange is a sync callback: it must be a single arrow
       expression, not a statement block. -->
  <ChangeListener
    listenTo="{dateRange ? (dateRange[0] + '-' + dateRange[1]) : ''}"
    onDidChange="() => dateFilter = null" />
  <ChangeListener
    listenTo="{dateRange ? (dateRange[0] + '-' + dateRange[1]) : ''}"
    onDidChange="() => (dateSlider &amp;&amp; dateRange) ? dateSlider.setValue(dateRange) : null" />

  <!-- search-rows-confinement: bake the per-row view-model here, once per
       result-set change — formatDateTime ran 576x per keystroke when it
       lived in the row template (probe capture 2026-07-31). -->
  <variable name="displayed" value="{
    merged
      .filter(h => !dateFilter || (Number(h.date) >= dateFilter[0] &amp;&amp; Number(h.date) &lt;= dateFilter[1]))
      .slice(0, 100)
      .map(h => Object.assign({}, h, {
        typeLabel: h.type === 'worklist-history' ? 'history' : h.type,
        dateLabel: h.date ? formatDateTime(new Date(Number(h.date) * 1000), 'yyyy-MM-dd HH:mm') : '',
        expanded: !!(expandedHit &amp;&amp; expandedHit.key === h.key)
      }))
  }" />

  <!-- Open the relevance winner only after all four facet requests for the
       current query settle. During a refetch this key falls back to empty,
       which collapses the stale result; when the new values land it changes
       once to the trimmed query and opens displayed[0]. Manual row toggles do
       not change this key, so they are not immediately undone. -->
  <variable name="settledQuery" value="{
    ready
      &amp;&amp; rSession.loaded &amp;&amp; rCommit.loaded &amp;&amp; rIssue.loaded &amp;&amp; rHistory.loaded
      &amp;&amp; !rSession.inProgress &amp;&amp; !rCommit.inProgress &amp;&amp; !rIssue.inProgress &amp;&amp; !rHistory.inProgress
      ? query.trim()
      : ''
  }" />
  <ChangeListener listenTo="{settledQuery}"
    debounceWaitInMs="1"
    onDidChange="() => expandedHit = settledQuery &amp;&amp; displayed.length ? displayed[0] : null" />

  <!-- History detail rides on the hit itself: /__search returns the full
       WorklistHistoryGroup in `extra` (indexed once), so the expander renders it
       directly — no recency-limited re-fetch that missed older items. -->
  <variable name="historyGroup"
    value="{(expandedHit &amp;&amp; expandedHit.type === 'worklist-history') ? (expandedHit.extra || null) : null}" />

  <!-- search-results-virtualize: the page no longer scrolls — the results
       List inside SearchResults is the sole scroller (Transcript's star-fill
       pattern); header, pills, hint, and slider stay fixed above it. -->
  <VStack padding="$space-4" gap="$space-3" height="100%">
    <HStack gap="$space-3" verticalAlignment="center">
      <!-- Back affordance for Evidence-replay arrivals: shown only when the
           page was entered via a deep link (q in the URL). Worklist expansion
           state persists via the window-side UI-state store, so a plain
           navigate restores the item the user replayed from. -->
      <Link when="{!!$queryParams.q}" noIndicator tooltip="Back to the Worklist, restoring the open item"
        onClick="navigate('/worklist')">
        <Text value="← Worklist" />
      </Link>
      <Heading level="h2">Search</Heading>
      <Theme paddingHorizontal-Button-xs="$space-0_5">
        <Button
          label="ⓘ"
          variant="ghost"
          size="xs"
          tooltip="How search works"
          onClick="searchHelpDialog.open()" />
      </Theme>
      <SearchBox
        boxWidth="26rem"
        placeholder="Quote for an exact phrase"
        initialValue="{query}"
        inProgress="{rSession.inProgress || rCommit.inProgress || rIssue.inProgress || rHistory.inProgress}"
        onQueryChange="(q) => query = q"
        onClear="query = ''; expandedHit = null" />
      <!-- Active-mode indicator: shown only when a replay link arrived with a
           non-default mode (raw/phrase/prefix). The generic Search UI keeps no
           permanent mode dropdown by design (quote-for-phrase is the everyday
           surface); this appears exactly when a mode is in play and offers a
           one-click reset to the AND default. -->
      <HStack when="{mode !== 'and'}" gap="$space-1" verticalAlignment="center">
        <Badge value="{'mode: ' + mode}" />
        <Link noIndicator onClick="mode = 'and'" tooltip="Reset to default (AND) search mode">
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="reset" />
        </Link>
      </HStack>
      <!-- Two-handled date-range filter; fills the rest of the row. The dates
           are shown as Text labels above the thumbs (top-level bindings) rather
           than via the Slider's valueFormat, which is a sync render callback the
           xs engine rejects for anything but a bare arrow expression. -->
      <VStack when="{dateRange}" width="*" gap="$space-0">
        <HStack>
          <Text fontSize="$fontSize-xs" color="$textColor-secondary"
            value="{formatDateTime(new Date((dateFilter ? dateFilter[0] : dateRange[0]) * 1000), 'yyyy-MM-dd')}" />
          <SpaceFiller />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary"
            value="{formatDateTime(new Date((dateFilter ? dateFilter[1] : dateRange[1]) * 1000), 'yyyy-MM-dd')}" />
        </HStack>
        <Slider
          id="dateSlider"
          minValue="{dateRange[0]}"
          maxValue="{dateRange[1]}"
          step="{86400}"
          initialValue="{dateRange}"
          showValues="false"
          onDidChange="(v) => dateFilter = v" />
      </VStack>
    </HStack>

    <HStack gap="$space-3" verticalAlignment="center">
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'session', !selectedTypes.includes('session'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('session') ? 1 : 0.4}">
          <Badge value="Sessions" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rSession.value || []).length}" />
        </HStack>
      </Link>
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'commit', !selectedTypes.includes('commit'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('commit') ? 1 : 0.4}">
          <Badge value="Commits" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rCommit.value || []).length}" />
        </HStack>
      </Link>
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'issue', !selectedTypes.includes('issue'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('issue') ? 1 : 0.4}">
          <Badge value="Issues" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rIssue.value || []).length}" />
        </HStack>
      </Link>
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'worklist-history', !selectedTypes.includes('worklist-history'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('worklist-history') ? 1 : 0.4}">
          <Badge value="History" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rHistory.value || []).length}" />
        </HStack>
      </Link>
    </HStack>

    <Text when="{!ready}"
      color="$textColor-secondary"
      value="Type at least 2 characters to search the index." />
    <Text when="{ready &amp;&amp; rSession.loaded &amp;&amp; rCommit.loaded &amp;&amp; rIssue.loaded &amp;&amp; rHistory.loaded &amp;&amp; displayed.length === 0}"
      color="$textColor-secondary"
      value="No matches." />

    <!-- search-rows-confinement + search-results-virtualize: rows render
         behind the SearchResults boundary (probe receipts in its header),
         virtualized, filling the remaining page height (reserved layout
         props on the instance size its wrapper). Badge theming moved inside
         the component so the star chain has no intervening wrapper. -->
    <SearchResults
      height="*"
      hits="{displayed}"
      query="{query.trim()}"
      historyGroup="{historyGroup}"
      onRowToggle="(h) => expandedHit = h.expanded ? null : h" />

    <ModalDialog id="searchHelpDialog" title="Search help">
      <VStack gap="$space-3" padding="$space-2">
        <Markdown content="Searches Bram's local full-text index of this project's history:

- **Sessions** — Claude and Codex transcripts
- **Commits** — the git log
- **Issues** — the project forge
- **History** — worklist history (proposals, approvals, commits)

How queries work:

- Type at least 2 characters.
- Multiple words are ANDed — every term must appear somewhere in the document.
- Wrap the whole query in double quotes for an exact phrase.
- Click the colored pills to include or exclude a bucket; each shows its own hit count.
- When results span dates, drag the two-handled slider to narrow the time window.
- Click any result title to expand its full detail inline; click again to collapse.
- Evidence replay links (from Worklist items) arrive here pre-filled. A non-default match mode (raw / prefix / phrase) shows as a badge next to the box with a one-click reset back to normal AND matching.
- Matching is keyword-based, not semantic: zero hits means those exact words were not found in the index — not proof the thing never happened. Try fewer or different terms." />
      </VStack>
    </ModalDialog>
  </VStack>
</Component>
