<Component name="DiffView" var.pendingRevealKey="{'initial'}">
  <APICall
    id="annotate"
    method="post"
    url="/__diff/annotate"
    body="{ { diff: $props.text } }" />
  <ChangeListener
    listenTo="{$props.text}"
    onDidChange="annotate.execute()" />
  <!-- One plan owns diff counting, decoration, and reveal. It matches across
       annotation-segment boundaries, so CommitDetail's raw-patch count and the
       painted occurrences agree. -->
  <variable name="diffFindPlan"
    value="{window.__bramDiffFindPlan(diffViewRows(annotate.lastResult, $props.text), $props.needle, $props.activeIndex, $props.expectedMatchCount)}" />
  <Theme
    backgroundColor-row-List--hover="transparent"
    backgroundColor-row-List="transparent">
    <VStack
      gap="0"
      padding="$space-2"
      backgroundColor="$color-surface-50"
      borderRadius="$borderRadius"
      overflowX="auto"
      onInit="annotate.execute()">
      <!-- Compact: plain rows that hug their content — no virtualized
           fixed-height List and no inner scroller. For small inline previews
           (e.g. the AgentMenuView menu preview) so a short diff does not
           reserve 60vh or nest a scroller inside an outer scroller. -->
      <Items
        when="{$props.compact}"
        data="{diffFindPlan.rows}">
        <!-- A line WRAPS as continuous text: an outer Text (line box, width:100%,
             pre-wrap) hosts the per-segment inner Texts with inline="true"
             (xmlui-org/xmlui#3713 / the new inline display mode). True inline
             runs share one line-breaking context, so a highlighted match stays
             whole mid-word — inline-block/flex segments split it (hooks ->
             "hook" / "s in..."). See judell/bram#239. -->
        <Text
          width="100%"
          whiteSpace="pre-wrap"
          fontFamily="$fontFamily-monospace"
          fontSize="$fontSize-sm"
          backgroundColor="{$item.bg}"
          paddingHorizontal="$space-2">
          <Items data="{$item.segments}">
            <Text
              inline="true"
              whiteSpace="pre-wrap"
              fontFamily="$fontFamily-monospace"
              fontSize="$fontSize-sm"
              backgroundColor="{$item.bg || 'transparent'}"
              color="{$item.color}"
              testId="{$item.active ? 'diff-active-mark' : ''}"
              value="{$item.text}" />
          </Items>
        </Text>
      </Items>
      <!-- Default: virtualized bounded List for full / potentially large
           diffs (the modal, the TO COMMIT item diff, the Commits patch view).
           maxHeight defaults to 60vh so existing callers are unchanged. -->
      <!-- A plan change arms one reveal. The direct listener handles ordinary
           cursor steps; visibleRangeDidChange retries only until the target row
           is actually mounted, then clears the arm so manual scrolling is not
           yanked back. List documents this event as the mounted-range signal:
           https://docs.xmlui.org/components/List#visiblerangedidchange -->
      <ChangeListener
        listenTo="{diffFindPlan.key}"
        onDidChange="() => pendingRevealKey = window.__bramDiffRevealPlan(diffRowsList, diffFindPlan, diffRowsList ? diffRowsList.getVisibleRange() : null) ? '' : diffFindPlan.key" />
      <!-- fixedItemSize dropped: wrapped lines have variable heights, so virtua
           must measure each row rather than assume the first row's height. -->
      <List
        id="diffRowsList"
        when="{!$props.compact}"
        data="{diffFindPlan.rows}"
        height="{$props.maxHeight || '60vh'}"
        onVisibleRangeDidChange="(range) => diffFindPlan.key &amp;&amp; (pendingRevealKey === 'initial' || pendingRevealKey === diffFindPlan.key) ? (pendingRevealKey = window.__bramDiffRevealPlan(diffRowsList, diffFindPlan, range) ? '' : diffFindPlan.key) : null">
        <!-- A line WRAPS as continuous text: outer Text (line box, width:100%,
             pre-wrap) hosting per-segment inner Texts with inline="true", so a
             highlighted match stays whole mid-word. See judell/bram#239. -->
        <Text
          width="100%"
          whiteSpace="pre-wrap"
          fontFamily="$fontFamily-monospace"
          fontSize="$fontSize-sm"
          backgroundColor="{$item.bg}"
          paddingHorizontal="$space-2">
          <Items data="{$item.segments}">
            <Text
              inline="true"
              whiteSpace="pre-wrap"
              fontFamily="$fontFamily-monospace"
              fontSize="$fontSize-sm"
              backgroundColor="{$item.bg || 'transparent'}"
              color="{$item.color}"
              testId="{$item.active ? 'diff-active-mark' : ''}"
              value="{$item.text}" />
          </Items>
        </Text>
      </List>
    </VStack>
  </Theme>
</Component>
