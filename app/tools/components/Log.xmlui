<Component
  name="Log"
  var.storyTick="{0}"
  var.mountKey="{window.__bramStoryMountKey()}"
  var.expanded="{[]}"
  var.fullscreenImage="{null}">

  <!-- issue-473-readable-launch-log: Bram's story of the last five hours
       (one until log-shows-start-commit-push-search, 2026-11-07; the host's
       trace tail grew to match). The host selects episode lines (/__story/lines);
       helpers.js tells them (__bramStoryTell), so a wording change is a pane
       reload. Fetched when the tab opens and refetched when a turn starts or
       ends (turn-context-changed), or when the host sees a shown kind happen
       (story-changed: a commit, push, search, queue change, selection
       restore or gate click); no polling and no Refresh button, since what it
       shows happens on other tabs. A tick rebuilds the URL, which also moves
       the window's start. The window spans relaunches: the host reads the
       rotated trace archives too (log-reads-across-trace-rotation), and
       `kinds` limits the lines to the ones the shown kinds are told from.
       Push, not polling: docs/developing-bram.md §Push over polling. -->
  <DataSource id="story"
    url="{'/__story/lines?since=' + window.__bramStorySince(300, mountKey + '.' + storyTick) + '&amp;kinds=' + window.__bramStoryShownKinds()}" />
  <PushSource id="storyEvt" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('turn-context-changed')}" />
  <ChangeListener listenTo="{storyEvt.value &amp;&amp; storyEvt.value.tick}"
    onDidChange="storyTick = storyTick + 1" />
  <PushSource id="storyChanged" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('story-changed')}" />
  <ChangeListener listenTo="{storyChanged.value &amp;&amp; storyChanged.value.tick}"
    onDidChange="storyTick = storyTick + 1" />

  <!-- A queue message's screenshot opens full size, as in Transcript.xmlui. -->
  <Theme maxWidth-ModalDialog="95vw">
    <ModalDialog
      when="{!!fullscreenImage}"
      onClose="fullscreenImage = null">
      <Image
        src="{window.imageSrcForPath(fullscreenImage)}"
        fit="contain"
        width="100%"
        height="80vh" />
    </ModalDialog>
  </Theme>

  <VStack padding="$space-6" gap="$space-4">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Log</Heading>
    </HStack>
    <!-- No firm height: the List hands its scroll to the page, which is the
         tab's own scroll container
         (https://www.xmlui.org/docs/howto/pin-a-toolbar-above-a-bounded-scroll-region). -->
    <List data="{window.__bramStoryTell(story.value)}">
      <!-- https://www.xmlui.org/docs/reference/components/List (emptyListTemplate) -->
      <property name="emptyListTemplate">
        <Text color="$textColor-secondary" value="Nothing to show yet. Tell me what you'd like to see here." />
      </property>
      <!-- The time and the sentence share a baseline: Markdown's paragraph
           margins are zeroed (marginTop/marginBottom-Text-markdown, as the
           footer's status line does in Main.xmlui;
           https://www.xmlui.org/docs/reference/components/Markdown), and the
           time, the chevron and the sentence share one 1.5rem line box
           (lineHeight: https://www.xmlui.org/docs/styles-and-themes/layout-props#lineheight).
           With equal line boxes from the same top, a smaller time sits on
           the sentence's baseline to within a fraction of a pixel. -->
      <Theme marginTop-Text-markdown="0" marginBottom-Text-markdown="0">
      <HStack gap="$space-3" paddingVertical="$space-1" verticalAlignment="start">
        <Text width="3rem" fontSize="$fontSize-sm" lineHeight="1.5rem" color="$textColor-secondary" value="{$item.at}" />
        <!-- Transcript's ID-keyed fold, so refresh/reordering preserves the
             expanded message rather than the row's former position.
             https://www.xmlui.org/docs/howto/keep-per-item-state-in-a-loop -->
        <VStack when="{!!$item.queueId}" width="*" gap="$space-2">
          <!-- The label is the Link's own text, not a nested Text, so it
               wraps; breakMode="word" breaks a long URL inside the quote
               (https://www.xmlui.org/docs/howto/wrap-long-text-in-a-link). -->
          <!-- Plain text color for the toggle, scoped to it alone so the
               external-link icon below keeps the link color
               (textColor-Link: https://www.xmlui.org/docs/reference/components/Link). -->
          <Theme textColor-Link="$textColor-primary" textColor-Link--hover="$textColor-secondary"
            textColor-Link--active="$textColor-primary">
            <Link noIndicator="true" breakMode="word" lineHeight="1.5rem"
              label="{(expanded.includes($item.id) ? '▾ ' : '▸ ') + $item.text}"
              onClick="expanded = window.__bramToggleInArray(expanded, $item.id)" />
          </Theme>
          <VStack when="{expanded.includes($item.id)}" padding="$space-2">
            <!-- The message, then Open in Queue at its stable id
                 (https://www.xmlui.org/docs/reference/components/Link), then
                 the context recorded with its draft, in small print. -->
            <!-- The message as an inline Text run inside an outer Text, with
                 the compact Link as the next child: one line-breaking
                 context, so the icon hugs the end of the message's last line
                 however it wraps (Text `inline`:
                 https://www.xmlui.org/docs/reference/components/Text).
                 The link shows only when there is a saved draft to open. -->
            <Text>
              <Text inline="true" whiteSpace="pre-wrap" value="{$item.message}" />
              <Link when="{!!$item.context}" icon="external-link" noIndicator="true" marginLeft="$space-1"
                tooltip="Open in Queue" to="{'/queue?focus=' + $item.queueId}" />
            </Text>
            <!-- Screenshots sent with the message, as Transcript shows a
                 turn's images: a thumbnail that opens full size. -->
            <Items data="{$item.images || []}">
              <Image
                src="{window.imageSrcForPath($item)}"
                maxHeight="220px"
                maxWidth="100%"
                fit="contain"
                onClick="fullscreenImage = $item" />
            </Items>
            <Text when="{!!$item.context}" fontSize="$fontSize-xs" color="$textColor-secondary"
              value="{$item.context}" />
          </VStack>
        </VStack>
        <!-- log-shows-start-commit-push-search: the sentence is Markdown so
             item names link to their History entry (/history?entry=<id>);
             openLinkInNewTab false keeps the links in-app
             (https://www.xmlui.org/docs/reference/components/Markdown).
             A surprising line keeps its warning colour through the
             textColor-Text variable Markdown's prose reads, scoped by Theme
             (https://www.xmlui.org/docs/reference/components/Theme). -->
        <!-- Every other entry expands (same ID-keyed fold as the queue rows)
             to its context: the agent and session it happened in, from the
             teller, and the board as it stood then, fetched only once opened
             (/__worklist-history/at). A pushed commit's sha links to the
             forge, opened in the system browser through openExternal
             (helpers.js routes http links on this tab there); an unpushed
             one links in-app to the Commits tab's local view
             (/commits?sha=). A push's range links to the forge's compare
             view. -->
        <VStack when="{!$item.queueId}" width="*" gap="$space-2">
          <HStack gap="$space-2" verticalAlignment="start">
            <Theme textColor-Link="$textColor-secondary" textColor-Link--hover="$textColor-primary"
              textColor-Link--active="$textColor-secondary">
              <Link noIndicator="true" lineHeight="1.5rem" label="{expanded.includes($item.id) ? '▾' : '▸'}"
                onClick="expanded = window.__bramToggleInArray(expanded, $item.id)" />
            </Theme>
            <Markdown when="{!$item.surprising}" width="*" lineHeight="1.5rem" content="{$item.text}" openLinkInNewTab="{false}" />
            <Theme when="{$item.surprising}" textColor-Text="$color-warn-700">
              <Markdown width="*" lineHeight="1.5rem" content="{$item.text}" openLinkInNewTab="{false}" />
            </Theme>
          </HStack>
          <VStack when="{expanded.includes($item.id)}" paddingLeft="$space-6" gap="$space-1">
            <Text fontSize="$fontSize-xs" color="$textColor-secondary"
              value="{window.__bramStoryEntryContext($item)}" />
            <DataSource id="boardThen" url="/__worklist-history/at" queryParams="{{ ts: $item.t }}" />
            <Text fontSize="$fontSize-xs" color="$textColor-secondary"
              value="{window.__bramStoryBoardLine(boardThen.value, boardThen.loaded)}" />
          </VStack>
        </VStack>
      </HStack>
      </Theme>
    </List>
  </VStack>

</Component>
