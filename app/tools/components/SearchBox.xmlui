<Component name="SearchBox">
  <!-- boxWidth sets the control's fixed width (custom prop name — a bare
       `width` on the instance is a reserved layout prop and wouldn't reach this
       inner HStack). Defaults to 20rem. -->
  <HStack gap="$space-1" verticalAlignment="center" width="{$props.boxWidth || '20rem'}">
    <TextBox
      id="searchBox"
      placeholder="{$props.placeholder || 'Search…'}"
      width="*"
      autoComplete="off"
      autoCorrect="{false}"
      spellCheck="{false}"
      autoCapitalize="off"
      onDidChange="(v) => debounce($props.debounceMs || 250, (q) => emitEvent('queryChange', q), v)" />
    <Button
      label="✕"
      variant="ghost"
      size="xs"
      tooltip="Clear search"
      onClick="searchBox.setValue(''); emitEvent('queryChange', ''); emitEvent('clear')" />
    <Theme size-Spinner="16px">
      <Spinner when="{$props.inProgress}" />
    </Theme>
  </HStack>
</Component>
