<Component
  name="MessageAgentComposer"
  var.voiceRecording="{false}"
  var.skillsRequestTick="{0}">
  <!-- A user-defined component is the deliberate performance boundary: the
       TextArea's high-frequency internal state cannot invalidate Main.xmlui's
       App-scope footer sources, listeners, pages, or status bindings. See
       https://docs.xmlui.org/howto/confine-a-hot-input-to-its-own-component . -->
  <!-- issue-278: one message box. The Worklist's own "Message about the
       selection" box is gone; this one names its target instead. -->
  <PushSource id="w2Sel" subscribe="{window.bramSubscribeW2Selection()}" />
  <PushSource
    id="composerClear"
    initial="{0}"
    subscribe="{window.bramSubscribeComposerClear()}" />
  <ChangeListener
    listenTo="{composerClear.value}"
    onDidChange="() => composerBox.setValue('')" />
  <PushSource
    id="voiceArrival"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceArrival()}" />
  <ChangeListener
    listenTo="{voiceArrival.value &amp;&amp; voiceArrival.value.at}"
    onDidChange="() => { const ev = voiceArrival.value || null; const t = (ev &amp;&amp; ev.transcript) || ''; const target = (ev &amp;&amp; ev.meta &amp;&amp; ev.meta.target) || ''; if (target === 'message-agent') { if (t &amp;&amp; composerBox) window.__bramAppendVoiceToBox(composerBox, t); voiceRecording = false; worklistVoiceRecordingActive = false; } }" />
  <PushSource
    id="sendRestore"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('send-restore')}" />
  <ChangeListener
    listenTo="{sendRestore.value &amp;&amp; sendRestore.value.tick}"
    onDidChange="() => window.__bramApplySendRestore(sendRestore.value, composerBox)" />

  <!-- Form is retained only for TextArea.enterSubmits. Draft persistence is
       debounced in helpers.js; blur and submit flush/clear explicitly. -->
  <Form
    width="100%"
    onSubmit="window.__bramSubmitMessageAgentComposer(composerBox, '')">
    <property name="buttonRowTemplate"><Fragment/></property>
    <HStack width="100%" gap="$space-2" verticalAlignment="center">
      <Button
        label="{voiceRecording ? (worklistVoiceRecordingActive ? '⏹' : '⏳') : '🎤'}"
        variant="ghost"
        size="xs"
        width="2.5rem"
        tooltip="Voice message"
        enabled="{!isWorklistVoiceProcessingTarget('message-agent') &amp;&amp; (!voiceRecording || worklistVoiceRecordingActive)}">
        <event name="click">
          setWorklistVoiceTarget('message-agent');
          voiceRecording = toggleVoiceForCurrentTarget(voiceRecording);
        </event>
      </Button>
      <TextArea
        id="composerBox"
        initialValue="{window.__bramRestoreWorklistDraft()}"
        placeholder="{(w2Sel.value || []).length >= 0 ? window.__bramComposerPlaceholder() : ''}"
        enterSubmits="true"
        autoSize="true"
        minRows="2"
        maxRows="4"
        width="*"
        onDidChange="(value) => window.__bramMessageAgentInputChanged(value)">
        <event name="gotFocus">
          setWorklistVoiceTarget('message-agent');
          setFocusedFeedbackItemId('');
        </event>
        <event name="lostFocus">
          window.__bramMessageAgentBlur();
        </event>
      </TextArea>
      <VStack width="8rem" horizontalAlignment="start" itemWidth="fit-content" gap="$space-1">
        <Button
          label="send"
          variant="ghost"
          size="xs"
          tooltip="Send message to agent"
          onClick="window.__bramSubmitMessageAgentComposer(composerBox, '')" />
        <Button
          label="skip worklist"
          variant="ghost"
          size="xs"
          tooltip="Send message prefixed with skip-worklist:"
          onClick="window.__bramSubmitMessageAgentComposer(composerBox, 'skip-worklist')" />
        <Button
          label="esc"
          variant="ghost"
          size="xs"
          tooltip="Send the Escape key"
          onClick="escToolbarClick()" />
        <Button
          when="{$props.activeProvider === 'claude'}"
          label="skills"
          variant="ghost"
          size="xs"
          tooltip="Launch a project skill (.claude/skills)">
          <event name="click">
            emitEvent('skillsRequested');
            skillsRequestTick = skillsRequestTick + 1;
          </event>
        </Button>
      </VStack>
      <!-- ▲ and ▼ ride opposite ends of the footer column so position
           carries the meaning, instead of leaving it entirely to the two
           glyphs. SpaceFiller is the sanctioned idiom for this
           (https://docs.xmlui.org/howto/align-items-to-row-ends-with-spacefiller),
           and it needs a container with a REAL height to grow into
           (https://docs.xmlui.org/howto/push-a-footer-to-the-bottom).

           height="100%" does not supply one here. The footer row is
           <HStack verticalAlignment="center">, and Stack alignment takes
           only start | center | end — there is no `stretch`, so no row
           child ever matches the row height, and a percentage resolves
           against a parent that never had one. The column collapsed to
           its two buttons and SpaceFiller had nothing to absorb, which
           read as "the change did not land" twice over.

           So the height is explicit. The cost: it does not track the
           composer, which grows from minRows=2 to maxRows=4, so past
           that the arrows stay 6rem apart rather than spanning. Visible
           stable separation beats a silent collapse.

           The glyph size does NOT come from the `size` prop. Button's
           `size` selects padding only — the docs define
           paddingVertical-Button-{xs,sm,md,lg} but a single
           fontSize-Button ($fontSize-sm) shared by every size, so
           xs → sm → md moved the box and left the arrow identical.
           Making the arrows bigger means fontSize-Button; making them
           hug the ends means zero padding. Both go through this Theme
           wrapper, which is why size stays xs.
           https://docs.xmlui.org/components/Button -->
      <Theme fontSize-Button="$fontSize-xl"
             paddingVertical-Button-xs="0" paddingHorizontal-Button-xs="0">
        <VStack
          when="{$pathname === '/transcript'}"
          width="2rem"
          height="6rem"
          horizontalAlignment="center">
          <Button
            label="▲"
            variant="ghost"
            size="xs"
            tooltip="Scroll transcript to top"
            onClick="window.__bramTranscriptScroll('top')" />
          <SpaceFiller />
          <Button
            label="▼"
            variant="ghost"
            size="xs"
            tooltip="Scroll transcript to bottom"
            onClick="window.__bramTranscriptScroll('bottom')" />
        </VStack>
      </Theme>
    </HStack>
  </Form>
  <PastedImageStrip target="message-agent" />
</Component>
