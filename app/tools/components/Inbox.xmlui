<Component
  name="Inbox"
  var.lanesReady="{!!(inbox.value &amp;&amp; inbox.value.lanes)}"
  var.emptyAll="{lanesReady &amp;&amp;
    inbox.value.lanes.needsYouNow.length === 0 &amp;&amp;
    inbox.value.lanes.yourDecision.length === 0 &amp;&amp;
    inbox.value.lanes.othersHands.length === 0 &amp;&amp;
    inbox.value.lanes.looseEnds.length === 0}">

  <!-- The engine's data seam is GET /__needs-you (serve_needs_you, #338).
       This tab renders it; the reconciliation lives host-side. -->
  <DataSource id="inbox" url="/__needs-you" />

  <!-- inbox-dismiss-forge-items: the dismiss POST + refetch is driven
       directly from the button click by window.__bramDismissForgeItem (a
       real-JS fetch). Not because the XMLUI event path is broken — it
       isn't, it clears the row — but because on the 2026-09-05 testbed
       drive it did so ~30 s after the click (root cause unestablished; an
       exact 30 s reads like a timer, NOT the general PushSource latency the
       rest of the pane disproves daily). A user action should drive its own
       feedback synchronously regardless: never round-trip through the host
       event bus to learn what you just did. The needs-you-changed listener
       below still catches background "new activity". -->


  <!-- issue-338 live-refresh: refetch on the same host events the engine's
       ground-truth lanes derive from — no poll (push-over-polling).
       Canonical __bramRefetchOnLiveEvent at top-level attribute position
       (the earlier `() => inbox.refetch()` arrow was the silent-abort trap,
       docs/developing-bram.md). These DO fire — the 2026-09-05 testbed
       drive traced event → __bramRefetchOnLiveEvent → GET — but ~30 s after
       the triggering event (root cause not isolated). Acceptable for
       background updates (an item appearing a beat late is invisible); NOT
       acceptable as the response to a Dismiss click, which is why that path
       is click-driven above. -->
  <PushSource id="inboxWorklistEvt" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('worklist-changed')}" />
  <ChangeListener listenTo="{inboxWorklistEvt.value &amp;&amp; inboxWorklistEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(inboxWorklistEvt.value, inbox)" />
  <PushSource id="inboxGitStatusEvt" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('git-status-changed', false)}" />
  <ChangeListener listenTo="{inboxGitStatusEvt.value &amp;&amp; inboxGitStatusEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(inboxGitStatusEvt.value, inbox)" />
  <PushSource id="inboxIssuesEvt" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('issues-changed')}" />
  <ChangeListener listenTo="{inboxIssuesEvt.value &amp;&amp; inboxIssuesEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(inboxIssuesEvt.value, inbox)" />
  <!-- needs-you-changed also fires from the background forge refresher when
       new activity appears; this listener catches that (latency invisible
       for the appear case). The dismiss click does NOT wait on it. -->
  <PushSource id="inboxDismissEvt" initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('needs-you-changed')}" />
  <ChangeListener listenTo="{inboxDismissEvt.value &amp;&amp; inboxDismissEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(inboxDismissEvt.value, inbox)" />

  <!-- Scope/limitations notes live behind the standard info-icon modal
       (the Context "About Context" pattern), one note per paragraph. -->
  <ModalDialog id="awaitingNotesDialog" title="Notes">
    <VStack gap="$space-3">
      <Items data="{inbox.value &amp;&amp; inbox.value.notes}">
        <Text>{$item}</Text>
      </Items>
    </VStack>
  </ModalDialog>

  <VStack padding="$space-4" gap="$space-4" width="*">
    <HStack verticalAlignment="center" gap="$space-2">
      <Heading level="h2" value="Awaiting You" />
      <Button
        when="{lanesReady &amp;&amp; inbox.value.notes &amp;&amp; inbox.value.notes.length > 0}"
        label="ⓘ"
        variant="ghost"
        size="sm"
        tooltip="Notes"
        onClick="awaitingNotesDialog.open()" />
    </HStack>

    <!-- Progress annotation while the freshness / reconciliation check runs
         (docs/needs-you-inbox.md): a blank inbox must read as *verifying*,
         never as "nothing waiting" — that false negative is the one signal
         this surface exists to prevent. -->
    <Text when="{!lanesReady}" color="$textColor-secondary">
      Checking what's waiting on you…
    </Text>

    <Text when="{emptyAll}" color="$textColor-secondary">
      Nothing is waiting on you right now.
    </Text>

    <!-- Needs you now -->
    <VStack gap="$space-2" when="{lanesReady &amp;&amp; inbox.value.lanes.needsYouNow.length > 0}">
      <Heading level="h4" value="🔴 Needs you now" />
      <Items data="{inbox.value.lanes.needsYouNow}">
        <Card>
          <VStack gap="$space-1">
            <Text>{$item.title}</Text>
            <Text when="{$item.activityAt}" fontSize="$fontSize-xs" color="$textColor-secondary">{getDateUntilNow($item.activityAt) + ' ago'}</Text>
            <Text fontSize="$fontSize-sm" color="$textColor-secondary">{$item.detail}</Text>
            <HStack gap="$space-1">
              <Button when="{!$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="navigate($item.link)" />
              <Button when="{$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="openExternal($item.externalUrl)" />
              <Button when="{$item.source === 'forge' &amp;&amp; $item.activityMarker}" variant="ghost" size="sm" label="Dismiss" tooltip="Hide until this thread has new activity" onClick="window.__bramDismissForgeItem(inbox, $item.id, $item.activityMarker)" />
            </HStack>
          </VStack>
        </Card>
      </Items>
    </VStack>

    <!-- Your decision, when you're ready -->
    <VStack gap="$space-2" when="{lanesReady &amp;&amp; inbox.value.lanes.yourDecision.length > 0}">
      <Heading level="h4" value="🟡 Your decision, when you're ready" />
      <Items data="{inbox.value.lanes.yourDecision}">
        <Card>
          <VStack gap="$space-1">
            <Text>{$item.title}</Text>
            <Text when="{$item.activityAt}" fontSize="$fontSize-xs" color="$textColor-secondary">{getDateUntilNow($item.activityAt) + ' ago'}</Text>
            <Text fontSize="$fontSize-sm" color="$textColor-secondary">{$item.detail}</Text>
            <HStack gap="$space-1">
              <Button when="{!$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="navigate($item.link)" />
              <Button when="{$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="openExternal($item.externalUrl)" />
              <Button when="{$item.source === 'forge' &amp;&amp; $item.activityMarker}" variant="ghost" size="sm" label="Dismiss" tooltip="Hide until this thread has new activity" onClick="window.__bramDismissForgeItem(inbox, $item.id, $item.activityMarker)" />
            </HStack>
          </VStack>
        </Card>
      </Items>
    </VStack>

    <!-- In someone else's hands -->
    <VStack gap="$space-2" when="{lanesReady &amp;&amp; inbox.value.lanes.othersHands.length > 0}">
      <Heading level="h4" value="🟢 In someone else's hands" />
      <Items data="{inbox.value.lanes.othersHands}">
        <Card>
          <VStack gap="$space-1">
            <Text>{$item.title}</Text>
            <Text when="{$item.activityAt}" fontSize="$fontSize-xs" color="$textColor-secondary">{getDateUntilNow($item.activityAt) + ' ago'}</Text>
            <Text fontSize="$fontSize-sm" color="$textColor-secondary">{$item.detail}</Text>
            <HStack gap="$space-1">
              <Button when="{!$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="navigate($item.link)" />
              <Button when="{$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="openExternal($item.externalUrl)" />
              <Button when="{$item.source === 'forge' &amp;&amp; $item.activityMarker}" variant="ghost" size="sm" label="Dismiss" tooltip="Hide until this thread has new activity" onClick="window.__bramDismissForgeItem(inbox, $item.id, $item.activityMarker)" />
            </HStack>
          </VStack>
        </Card>
      </Items>
    </VStack>

    <!-- Loose ends -->
    <VStack gap="$space-2" when="{lanesReady &amp;&amp; inbox.value.lanes.looseEnds.length > 0}">
      <Heading level="h4" value="⚪ Loose ends" />
      <Items data="{inbox.value.lanes.looseEnds}">
        <Card>
          <VStack gap="$space-1">
            <Text>{$item.title}</Text>
            <Text when="{$item.activityAt}" fontSize="$fontSize-xs" color="$textColor-secondary">{getDateUntilNow($item.activityAt) + ' ago'}</Text>
            <Text fontSize="$fontSize-sm" color="$textColor-secondary">{$item.detail}</Text>
            <HStack gap="$space-1">
              <Button when="{!$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="navigate($item.link)" />
              <Button when="{$item.externalUrl}" variant="ghost" size="sm" label="Open" onClick="openExternal($item.externalUrl)" />
              <Button when="{$item.source === 'forge' &amp;&amp; $item.activityMarker}" variant="ghost" size="sm" label="Dismiss" tooltip="Hide until this thread has new activity" onClick="window.__bramDismissForgeItem(inbox, $item.id, $item.activityMarker)" />
            </HStack>
          </VStack>
        </Card>
      </Items>
    </VStack>

  </VStack>
</Component>
