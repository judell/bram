<Component name="WorklistGateBar" var.gateSent="{[]}" var.gateLockTick="{0}" var.gateLastSessionTick="{0}">
  <!-- issue-278: the Worklist gate, in the Footer.
       The gate row cannot be pinned where it lived - `position: sticky` cannot
       escape its containing block, and `dock` needs a bounded parent height
       plus scrollWholePage="false", which this shell does not have. The Footer
       is the one surface `vertical-sticky` genuinely pins.
       Self-contained DataSources so it needs nothing from App scope; the
       selection arrives by PushSource and the message text from the single
       Footer composer, which now serves both roles. -->
  <DataSource id="gateWorklist" url="/__worklist" transformResult="{(d) => window.__bramWorklistAccept(d)}" />
  <DataSource id="gateConfig" url="/__worklist-config" />
  <DataSource id="gateClaim" url="/__inflight" />
  <!-- issue-404-serial-gate-bar-first-cut: the current branch, for
       Commit's hover ("where does this land"), refetched on the same host
       event the Commits tab uses. -->
  <DataSource id="gateGit" url="/__git/status" />
  <PushSource
    id="gateGitEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('git-status-changed', false)}" />
  <ChangeListener
    listenTo="{gateGitEvt.value &amp;&amp; gateGitEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(gateGitEvt.value, gateGit)" />
  <PushSource id="gateSel" subscribe="{window.bramSubscribeW2Selection()}" />
  <!-- The composer is an isolated sibling component. Reading its window
       mirror through a helper is not reactive, so Refine stayed dim after
       typing until some unrelated gate render happened. This push source is
       the explicit dependency: input and clear both publish synchronously. -->
  <PushSource id="gateText" subscribe="{window.bramSubscribeMessageAgentText()}" />
  <PushSource
    id="gateWorklistChanged"
    subscribe="{window.bramSubscribeTauriEvent('worklist-changed')}" />
  <ChangeListener
    listenTo="{gateWorklistChanged.value}"
    onDidChange="() => { gateWorklist.refetch(); gateClaim.refetch(); }" />
  <!-- delegated-work-action-gates: a subagent binding or release changes the
       claim without a worklist write, so refetch on the claim event too.
       Same PushSource + ChangeListener idiom as Worklist.xmlui:90-96. -->
  <PushSource
    id="gateClaimEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('inflight-claim-changed')}" />
  <ChangeListener
    listenTo="{gateClaimEvt.value &amp;&amp; gateClaimEvt.value.tick}"
    onDidChange="window.__bramRefetchOnLiveEvent(gateClaimEvt.value, gateClaim)" />
  <!-- item-last-session-switch-there: the current session, for the "Last
       worked on in" line. The footer's small list fetch, refetched on the
       same event, so a switch updates the line without a board refetch. -->
  <DataSource id="gateSessions" url="/__sessions/list" queryParams="{{ limit: 20 }}" />
  <PushSource
    id="gateSessionsChanged"
    subscribe="{window.bramSubscribeTauriEvent('sessions-list-changed')}" />
  <ChangeListener
    listenTo="{gateSessionsChanged.value}"
    onDidChange="() => gateSessions.refetch()" />
  <!-- instrument-w2-selection-handoff (observe only, TRIPWIRE): the receiving
       half. `render` is the actual gate on the button row below - buttons are
       ABSENT when it is false, as opposed to greyed, since they gate on
       `enabled=`. A `receive count=0` with the page still showing a ticked
       checkbox is the divergence; a publish with no matching receive is the
       boundary dropping it. Steady state emits pairs, so this is not a
       zero-is-success grep - the anomaly is a mismatch, not a count. -->
  <ChangeListener
    listenTo="{gateSel.value}"
    onDidChange="() => window.__bramIframeTrace('w2-selection', {op: 'receive', count: (gateSel.value || []).length, render: (gateSel.value || []).length > 0, store: (window.__bramW2Selection || []).length})" />

  <!-- gate-button-combo-explainer: why THIS button combo, for the current
       selection. The line is derived in `__bramStartConsequence` from the
       same predicates that light the buttons (begun-ness via
       `__bramWorklist2Begun`, exclusivity via `__bramItemChangedSplit`), and
       may only name a lit action - or a dim one together with why it is dim
       and the selection change that would light it. Empty for unsurprising
       combos: an always-on explainer is furniture (the deleted 2026-08-23
       matrix's lesson).
       A message, never a block: shipping two items as one change is legitimate,
       and the gate's job is to inform the decision rather than make it - the
       same reasoning that keeps unclaimed-changes detection report-only.
       `__bramStartConsequence` returns "" when there is nothing to say, so this
       stays one call with no ternary. -->
  <!-- Centered by an HStack wrapper, matching the button row below. A bare
       `horizontalAlignment` on the Text centers content INSIDE the Text's own
       box, which is content-sized - so the line sat wherever its box landed
       rather than centered in the footer. The Text takes width="100%" because
       text wraps by default only in a width-constrained container
       (xmlui.org/docs/howto/wrap-long-text-in-a-link); content-sized, the
       long explainer wordings overflowed the footer edge-to-edge unwrapped.
       Left-justified (Text's default): centered multi-line prose reads
       ragged both sides; the wrapped explainer scans better flush left. -->
  <!-- worklist.gateExplainer: held in RESERVE, not a product surface. A
       .bram.json that says nothing about it never produces the explainer,
       and there is deliberately no Settings toggle — hand-edit .bram.json
       to bring it back for a debugging/wording exercise (0.5.3 gate run:
       useful for articulating the messages in context, not wanted as
       permanent UI). -->
  <!-- worklist-surface-planned-overlap: the gateExplainer flag gate is
       REMOVED. The 0.5.3 run retired this line from permanent UI, but the
       2026-09-03 live case reversed that verdict for the one thing it says:
       a user deciding whether to Start two items had a board reading "no
       shared files changed" and nothing naming the planned entanglement at
       the decision point. __bramStartConsequence already returns "" except
       when the selection makes it consequential (shared files, or a mixed
       begun/unbegun selection), so un-gating shows text only when there is a
       consequence to state. -->
  <!-- next-move-offers-delegation (Jon, 2026-11-10: "top line needs wrap",
       then "always center what's my next move"): a column, the consequence
       centered and wrapping, What's my next move? centered on its own line
       beneath it. Supersedes next-move-button-inline-and-quiet's end-of-line
       placement, which left-aligned the button once the line wrapped.
       https://www.xmlui.org/docs/howto/center-content-on-the-page -->
  <VStack
    when="{window.__bramShowStartConsequence(gateWorklist.value, gateSel.value, gateClaim.value)}"
    horizontalAlignment="center"
    gap="$space-1"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      width="fit-content"
      textAlign="left"
      value="{window.__bramStartConsequence(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value)}" />
    <Theme borderColor-Button-primary-outlined="$textColor-secondary"
      textColor-Button-primary-outlined="$textColor-secondary"
      borderColor-Button-primary-outlined--hover="$textColor-secondary"
      textColor-Button-primary-outlined--hover="$textColor-primary"
      fontSize-Button="$fontSize-sm">
      <Button
        when="{window.__bramNextMoveSlot(gateWorklist.value, gateSel.value, gateClaim.value, gateTake.value) === 'consequence'}"
        label="What's my next move?"
        variant="outlined"
        size="xs"
        tooltip="If unclear, ask the agent."
        enabled="{!window.__bramAgentWorking(gateAgent.value)}"
        onClick="window.__bramAskSequence(gateSel.value)" />
    </Theme>
  </VStack>
  <!-- item-last-session-switch-there: a ticked item last worked on in
       another session offers to switch there. lastSession is computed by the
       host from the state-mirror ledger; the switch is the Sessions tab's,
       and lands on the Transcript. -->
  <HStack
    when="{!!window.__bramGateLastSession(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateSessions.value, gateLastSessionTick)}"
    horizontalAlignment="center"
    verticalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-8"
    paddingTop="$space-1">
    <Text value="{window.__bramGateLastSessionLine(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateSessions.value, gateLastSessionTick)}" />
    <Button
      label="Switch there"
      size="xs"
      variant="outlined"
      icon="swap"
      onClick="window.__bramGateSwitchToLastSession(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateSessions.value, toast)" />
    <!-- gate-last-session-line-dismissable: × declines the offer for this
         selection and session; same ghost × as the composer's. -->
    <Button label="×" variant="ghost" size="xs"
      tooltip="Dismiss: stay in this session"
      onClick="gateLastSessionTick = window.__bramGateLastSessionDismissClick(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateSessions.value, gateLastSessionTick)" />
  </HStack>
  <!-- gate-remove-commit-share-radio: the commit-time "One commit / A commit
       each" radio is gone. For disjoint selections it changed nothing (the
       payload was identical, one worklist-commit, one commit), one approval
       can't yield N commits anyway (#272), and its only live effect was the
       split-shared-files hunk separation #273 froze. Commit on N ticked items
       makes one commit; __bramStartConsequence says so, and separate commits
       are the serial path: commit one at a time. -->
  <!-- `when` carries the full expression rather than a same-element var:
       a `var.` declared on an element scopes to its CHILDREN, so a `when`
       on that element referencing it fails silently and the control never
       renders (caught live, first render after the move). -->
  <!-- gate-withholds-futile-joint-commit-offer: a stale one-at-a-time
       choice from an earlier selection must not silently narrow a new one
       — the field case was precisely a default taken unread. Reset on any
       selection change; the setter/reset helpers return the value so the
       handlers stay single-call. -->
  <ChangeListener
    listenTo="{(gateSel.value || []).join(',')}"
    onDidChange="window.__bramW2ResetStartMode()" />
  <!-- gate-withholds-futile-joint-commit-offer, commit side: Commit is still
       withheld when a still-begun same-click partner is unselected (the host
       would refuse it, op=refuse-joint-interval), but the "Committable
       together with … — select both." line that explained it is gone (Jon,
       2026-11-08: "we can lose this verbiage now"); What's my next move? and
       its plan answer what to tick. -->
  <!-- issue-425-retire-replay (Codex review): what Commit takes for two or
       more ticked items. Each row's "Will commit" assumes that item commits
       alone; together they can route differently (both owners of a file
       ticked leaves no outside owner, so the gate takes the whole file,
       unowned lines included). The host runs the gate's routing for the
       selection. Freshness is push, not polling: the key in queryParams is
       the selection plus the host's membership state key and its freshness,
       which change with anything ownership derives from and when a pending
       compute lands; the host emits worklist-changed when
       a new partition is ready. A stale answer, or one for another state or
       selection, is not shown.
       https://www.xmlui.org/docs/reference/components/DataSource -->
  <DataSource
    id="gateTake"
    when="{!!window.__bramSelectionPredictionKey(gateWorklist.value, gateSel.value)}"
    url="/__worklist/will-commit"
    queryParams="{{ ids: window.__bramSelectionIdsParam(gateSel.value), k: window.__bramSelectionPredictionKey(gateWorklist.value, gateSel.value) }}" />
  <!-- next-move-offers-delegation: same column as the consequence line below,
       so What's my next move? is always centered under its line. -->
  <VStack
    when="{!!window.__bramSelectionTakeLine(gateTake.value, gateSel.value, gateWorklist.value)}"
    horizontalAlignment="center"
    gap="$space-1"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      width="fit-content"
      textAlign="left"
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="{window.__bramSelectionTakeLine(gateTake.value, gateSel.value, gateWorklist.value)}" />
    <Theme borderColor-Button-primary-outlined="$textColor-secondary"
      textColor-Button-primary-outlined="$textColor-secondary"
      borderColor-Button-primary-outlined--hover="$textColor-secondary"
      textColor-Button-primary-outlined--hover="$textColor-primary"
      fontSize-Button="$fontSize-sm">
      <Button
        when="{window.__bramNextMoveSlot(gateWorklist.value, gateSel.value, gateClaim.value, gateTake.value) === 'take'}"
        label="What's my next move?"
        variant="outlined"
        size="xs"
        tooltip="If unclear, ask the agent."
        enabled="{!window.__bramAgentWorking(gateAgent.value)}"
        onClick="window.__bramAskSequence(gateSel.value)" />
    </Theme>
  </VStack>
  <!-- issue-328: close consent AT THE GATE. When the selection carries
       closesIssues, one real checkbox per issue renders here — where the
       decision happens — instead of only inside a row expansion nobody is
       required to open. Default stays ticked (today's behavior, now
       visible); unticking is one click and feeds the same __bramW2CloseMap
       the payload builder reads, so what you see is what the commit sends.
       Fresh rows per evaluation are fine: the checkbox's state lives in
       the map, so a remount re-reads the truth. -->
  <HStack
    when="{(window.__bramGateCloseItems(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value) || []).length > 0}"
    horizontalAlignment="center"
    gap="$space-3"
    paddingTop="$space-1">
    <Items data="{window.__bramGateCloseItems(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value)}">
      <HStack gap="$space-1" verticalAlignment="center">
        <Checkbox
          initialValue="{$item.close}"
          onDidChange="(v) => window.__bramGateCloseToggle($item.itemId, $item.number, v, $item.closesIssues)" />
        <Text
          value="{'closes #' + $item.number}"
          fontSize="$fontSize-sm"
          tooltip="{$item.title}" />
        <!-- issue-328 single surface: the closing comment lives HERE, beside
             the consent it annotates — the row expansion's closes block is
             gone ("i thought we got rid of the double closer"). Same shared
             map as the toggle and the payload builder. -->
        <TextBox
          width="14rem"
          placeholder="closing comment (optional)"
          onDidChange="(v) => window.__bramGateCloseComment($item.itemId, $item.number, v, $item.closesIssues)" />
      </HStack>
    </Items>
  </HStack>
  <!-- issue-345: report-only close/don't-close contradiction warning, beside
       the close-consent ticks it disagrees with. Reactive on BOTH the
       composer text (gateText, the same PushSource mirror the footer
       composer publishes into) and the tick state (window.__bramW2CloseMap,
       read fresh through __bramGateCloseItems inside the detector on every
       evaluation) -- so typing over the contradiction or unticking the box
       clears the row with no extra wiring. Warn, never block: nothing here
       disables a button; per the issue's own framing the guard makes the
       conflict visible and lets the user reconcile it, it never decides. -->
  <HStack
    when="{(window.__bramGateCloseContradiction(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value, gateText.value) || []).length > 0}"
    horizontalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      fontSize="$fontSize-sm"
      color="$color-warn-700"
      value="{window.__bramGateCloseContradictionMessage(gateWorklist.value &amp;&amp; gateWorklist.value.items, gateSel.value, gateClaim.value, gateText.value)}" />
  </HStack>
  <!-- issue-368-commit-caution-while-agent-working: a commit-emitting click
       taken while the agent's turn is in flight is withheld once — this row
       says why, and the same button clicked again proceeds. Ask, never
       block: claims cannot lock this window (execution without a claim is
       #368's very shape), disabling would wedge legitimate unrelated
       commits behind long turns (#348's deadlock class), so the click path
       asks instead. The arm clears on selection change, turn end, or TTL
       (helpers.js, bramSubscribeGateCaution). Same warn styling as the
       close-contradiction row above. -->
  <PushSource id="gateCaution" subscribe="{window.bramSubscribeGateCaution()}" />
  <!-- gate-click-queues-behind-running-turn: a Start / Start & commit /
       Commit click taken mid-turn is queued and delivered when the turn ends
       (helpers.js, bramSubscribeGateQueue). It replaces #368's ask-twice
       caution for those kinds. The queued button is disabled; the row's
       Cancel is the only control. Stopping the turn delivers it sooner. -->
  <PushSource id="gateQueue" subscribe="{window.bramSubscribeGateQueue()}" />
  <!-- issue-368-addressed-turn-context, rung 2: when the RUNNING turn is
       addressed to an id in the selection (an approved:/iterate:/drop: turn
       naming it, per the host's turn-context events), the commit-emitting
       buttons are withheld outright rather than confirmed — the turn
       literally names the item whose files it may still be editing, so
       "edits may still be landing" is a fact, not a guess. Selections
       outside the addressed set keep the coarse caution above. The context
       clears on turn end (host detectors), so the row unlocks itself. -->
  <PushSource id="gateTurnCtx" subscribe="{window.bramSubscribeTurnContext()}" />
  <HStack
    when="{!!window.__bramAddressedBlockMessage(gateSel.value, gateTurnCtx.value)}"
    horizontalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      fontSize="$fontSize-sm"
      color="$color-warn-700"
      value="{window.__bramAddressedBlockMessage(gateSel.value, gateTurnCtx.value)}" />
  </HStack>
  <HStack
    when="{!!gateQueue.value}"
    wrapContent="true"
    horizontalAlignment="center"
    verticalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      fontSize="$fontSize-sm"
      color="$color-warn-700"
      value="{window.__bramGateQueueMessage(gateQueue.value)}" />
    <Button
      size="xs"
      variant="outlined"
      label="Cancel"
      onClick="window.__bramGateQueueCancel()" />
  </HStack>
  <!-- delegated-work-action-gates: shown only while the selection touches an
       item a bound subagent is still working on. Mirrors the queued-click row
       above: one line saying why the buttons are off, one control. Release
       frees the binding when the subagent's stop never arrived. -->
  <!-- wrapContent: in a narrow pane the reason and Release must wrap, or the
       button runs off the edge unseen (Jon, 2026-11-04 demo).
       https://www.xmlui.org/docs/reference/components/Stack#wrapcontent -->
  <HStack
    when="{!!window.__bramDelegatedBlocker(gateClaim.value, gateSel.value)}"
    wrapContent="true"
    horizontalAlignment="center"
    verticalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      fontSize="$fontSize-sm"
      color="$color-warn-700"
      value="{window.__bramDelegatedWhy(gateClaim.value, gateSel.value)}" />
    <Button
      size="xs"
      variant="outlined"
      label="Release"
      tooltip="Release the subagent's hold, e.g. if it was cancelled and never reported stopping"
      onClick="window.__bramDelegatedRelease(gateClaim.value, gateSel.value)" />
  </HStack>
  <!-- locked-board-names-its-own-exit: the escape, stated where the dead
       buttons are. Deliberately NOT gated on a selection, unlike the button
       band below - while a claim is live no row can be ticked, so a
       selection-gated message is invisible in exactly the state it exists for.
       The gate bar sits in the footer directly above the composer, so the
       sentence and the thing it points at are adjacent.
       Silent while an agent is working: that is the system behaving, the
       footer's agent status already shows it, and a second line saying so is
       the noise the predecessor was reverted for. -->
  <PushSource id="gateAgent" initial="{null}" subscribe="{window.bramSubscribeAgentStatus()}" />
  <!-- The tick exists because the predicate is TIME-based and its other two
       inputs go quiet in exactly the shape that matters. Falsified by synth,
       2026-09-12: a claim written while the agent was idle sat for 90s+
       un-reaped (no turn ran, so no turn-end detector fired) with the
       predicate true from t+30s, and neither gateClaim nor gateAgent changed
       once in that window - so the binding never re-evaluated and the line
       never appeared. The earlier reasoning (the agent finishing supplies the
       event) covers the trap where an agent ran; it does NOT cover a claim
       whose agent never runs, which is a real trap shape and not #350's
       stranded-approval case, because here a claim exists.
       Enabled only while potentially stranded, so a healthy board runs no
       timer at all. -->
  <Timer
    interval="5000"
    enabled="{!!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramAgentWorking(gateAgent.value)}"
    onTick="gateLockTick = gateLockTick + 1" />
  <HStack
    when="{!!window.__bramGateStrandedExitLine(gateClaim.value, gateAgent.value, gateLockTick)}"
    horizontalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text
      fontSize="$fontSize-sm"
      color="$textColor-secondary"
      value="{window.__bramGateStrandedExitLine(gateClaim.value, gateAgent.value, gateLockTick)}" />
  </HStack>
  <!-- issue-413: the agent's recommended next steps (POST /__worklist/plan),
       shown while they still apply to the board and two or more items are
       ticked (whats-my-sequence-button: a sequence only matters then). Do
       recommended runs the same Drop, Commit and Start paths as the buttons
       below, for exactly the ids the line names; it grants nothing the
       buttons don't. Dimmed while the agent is working, like Commit's
       caution. × dismisses. -->
  <!-- next-move-offers-delegation: a long plan (nine ids) ran off both
       edges. Now a column (Jon, 2026-11-10: "center the recommended line
       and ensure it'll wrap in a left-justified way. Do recommended and why
       centered on own line"): the line is a block that hugs its words up to
       the pane's width, centered, its wrapped lines left-aligned; the
       buttons sit centered on their own line beneath it.
       https://www.xmlui.org/docs/howto/know-when-to-use-fit-content -->
  <VStack
    when="{window.__bramPlanVisible(gateWorklist.value, gateSel.value)}"
    horizontalAlignment="center"
    gap="$space-1"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <Text width="fit-content" textAlign="left" fontSize="$fontSize-base" value="{window.__bramPlanLine(gateWorklist.value)}" />
    <HStack horizontalAlignment="center" verticalAlignment="center" gap="$space-2">
    <!-- A hover only for a feedback step's text, the one thing the line
         can't show; the reasoning is Why?'s (Jon, 2026-11-08: the old
         summary + feedback + decide-lines hover was "total overkill"). -->
    <Tooltip when="{!!window.__bramPlanTooltip(gateWorklist.value)}">
      <property name="tooltipTemplate">
        <Markdown maxWidth="44ch" content="{window.__bramPlanTooltip(gateWorklist.value)}" />
      </property>
      <Button
        label="Do recommended"
        size="xs"
        enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramAgentWorking(gateAgent.value)}"
        onClick="window.__bramDoRecommended(gateWorklist.value, gateClaim.value)" />
    </Tooltip>
    <Button
      when="{!window.__bramPlanTooltip(gateWorklist.value)}"
      label="Do recommended"
      size="xs"
      enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramAgentWorking(gateAgent.value)}"
      onClick="window.__bramDoRecommended(gateWorklist.value, gateClaim.value)" />
    <!-- whats-my-sequence-button: Why? opens the agent's reasoning for the
         plan (its `why`, else its summary) in a modal; nothing else happens.
         https://www.xmlui.org/docs/reference/components/ModalDialog -->
    <Button
      label="Why?"
      variant="outlined"
      size="xs"
      tooltip="Why this order"
      onClick="planWhyDialog.open()" />
    <Button
      label="×"
      variant="ghost"
      size="xs"
      tooltip="Dismiss the recommendation"
      onClick="window.__bramDismissPlan()" />
    </HStack>
  </VStack>
  <ModalDialog id="planWhyDialog" title="Why this order">
    <Markdown content="{window.__bramPlanWhy(gateWorklist.value)}" />
  </ModalDialog>
  <!-- whats-my-sequence-button (Jon, 2026-11-08: "What's my sequence here?
       ... put that on the surface of the app"). In the plan line's slot,
       while two or more items are ticked and no plan is showing: it asks the
       agent about those items, as chat, and the answer arrives as a plan on
       this line. Dimmed while the agent works, like Do recommended, since it
       starts a turn. -->
  <HStack
    when="{window.__bramNextMoveSlot(gateWorklist.value, gateSel.value, gateClaim.value, gateTake.value) === 'own'}"
    horizontalAlignment="center"
    verticalAlignment="center"
    paddingHorizontal="$space-2"
    paddingTop="$space-1">
    <!-- next-move-button-inline-and-quiet: small and gray, like the gate's
         secondary lines, here and where it joins one of them (above). Button
         theme variables: https://www.xmlui.org/docs/reference/components/Button -->
    <Theme borderColor-Button-primary-outlined="$textColor-secondary"
      textColor-Button-primary-outlined="$textColor-secondary"
      borderColor-Button-primary-outlined--hover="$textColor-secondary"
      textColor-Button-primary-outlined--hover="$textColor-primary"
      fontSize-Button="$fontSize-sm">
      <Button
        label="What's my next move?"
        variant="outlined"
        size="xs"
        tooltip="If unclear, ask the agent."
        enabled="{!window.__bramAgentWorking(gateAgent.value)}"
        onClick="window.__bramAskSequence(gateSel.value)" />
    </Theme>
  </HStack>
  <HStack
    when="{(gateSel.value || []).length > 0}"
    verticalAlignment="center"
    horizontalAlignment="center"
    gap="$space-2"
    paddingHorizontal="$space-1"
    paddingTop="$space-1"
    paddingBottom="$space-3">
    <!-- No "N selected · <id>" label, and the count on each button is the
         whole mechanism.
         The consensus design argued a docked bar MUST name its target, since
         docked it can sit far from the ticked row. The premise is right - Jon:
         "almost any expansion is going to lose disjoint selections whose check
         boxes are below the fold" - but the conclusion was wrong, and for a
         reason worth keeping: the count does not have to identify the
         selection, only to say how big it is.
         `Start 2` with one checkbox visible tells you there is a second one
         and sends you to find it. Scrolling or collapsing to it is cheap.
         Naming both would mean enumerating an unbounded set in a fixed band,
         "competing with the buttons" for the space they need - a losing
         proposition. And the obvious escape, an expand-all/collapse-all
         control, "is always a bad smell".
         So this is deliberately a bounded signal that points, not a complete
         one that describes. -->
    <!-- strip-tooltip-wraps-via-template: each gate button's tooltip is a
         Tooltip template (a width-bound Markdown) instead of tooltipMarkdown,
         so a long reason wraps instead of running off the pane; see the
         strip in Worklist.xmlui.
         https://www.xmlui.org/docs/reference/components/Tooltip#using-the-tooltip-component -->
    <Tooltip>
      <property name="tooltipTemplate">
        <Markdown maxWidth="44ch" content="{window.__bramGateScopeTooltip(gateSel.value, 'start', null, gateClaim.value, gateWorklist.value.items)}" />
      </property>
      <Button
        label="{window.__bramGateQueuedLabel('start', window.__bramStartButtonLabel(gateWorklist.value.items, gateSel.value, gateClaim.value), gateQueue.value)}"
        size="sm"
        enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramDelegatedBlocker(gateClaim.value, gateSel.value) &amp;&amp; window.__bramSelectionAllNeedStart(gateWorklist.value.items, gateSel.value, gateClaim.value) &amp;&amp; !window.__bramGateQueuedAs(gateQueue.value, 'start')}"
        onClick="window.__bramGateAct('start', gateWorklist.value.items, gateSel.value, 'together', gateClaim.value)" />
    </Tooltip>
    <!-- gate-one-way-to-continue-one-to-finish: dimmed whenever Commit can be
         lit. On a begun `proposed` item both send apply-and-commit, so the row
         offers one way to continue (Resume) and one way to finish (Commit). -->
    <Tooltip>
      <property name="tooltipTemplate">
        <Markdown maxWidth="44ch" content="{window.__bramGateScopeTooltip(gateSel.value, 'start-commit', gateGit.value &amp;&amp; gateGit.value.branch, gateClaim.value, gateWorklist.value.items)}" />
      </property>
      <Button
        label="{window.__bramGateQueuedLabel('start-commit', window.__bramStartVerb(gateWorklist.value.items, gateSel.value, gateClaim.value) + ' &amp; commit', gateQueue.value)}"
        size="sm"
        enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramDelegatedBlocker(gateClaim.value, gateSel.value) &amp;&amp; !window.__bramSelectionAddressedBlocked(gateSel.value, gateTurnCtx.value) &amp;&amp; (gateSel.value || []).length === 1 &amp;&amp; window.__bramSelectionAllNeedStart(gateWorklist.value.items, gateSel.value, gateClaim.value) &amp;&amp; !window.__bramSelectionAllCommittable(gateWorklist.value.items, gateSel.value, gateClaim.value) &amp;&amp; !window.__bramGateQueuedAs(gateQueue.value, 'start-commit')}"
        onClick="window.__bramGateAct('start-commit', gateWorklist.value.items, gateSel.value, 'together', gateClaim.value)" />
    </Tooltip>
    <Tooltip>
      <property name="tooltipTemplate">
        <Markdown maxWidth="44ch" content="{window.__bramGateCommitTooltip(gateSel.value, gateGit.value &amp;&amp; gateGit.value.branch, gateWorklist.value.items, gateClaim.value, gateTurnCtx.value)}" />
      </property>
      <Button
        label="{window.__bramGateQueuedLabel('commit', 'Commit', gateQueue.value)}"
        size="sm"
        enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramDelegatedBlocker(gateClaim.value, gateSel.value) &amp;&amp; !window.__bramSelectionAddressedBlocked(gateSel.value, gateTurnCtx.value) &amp;&amp; window.__bramSelectionAllCommittable(gateWorklist.value.items, gateSel.value, gateClaim.value) &amp;&amp; !window.__bramGateQueuedAs(gateQueue.value, 'commit')}"
        onClick="window.__bramGateAct('commit', gateWorklist.value.items, gateSel.value, 'together', gateClaim.value)" />
    </Tooltip>
    <!-- switch-to-transcript-on-action: Refine retired. It was never an
         authorization — the other gate buttons write auth records; Refine
         wrote none, it was conversation squatting among the signatures from
         the era when the gate row was the only item-addressed surface. The
         composer is that surface now: Enter with a selection sends the same
         iterate fan-out Refine sent (__bramComposerEnterSubmit →
         __bramWorklist2BatchIterate — one mechanism, same wire payload,
         guards and host untouched). The gate row is pure lifecycle:
         Start / Start & commit / Commit / Drop. -->
    <Tooltip>
      <property name="tooltipTemplate">
        <Markdown maxWidth="44ch" content="{window.__bramGateScopeTooltip(gateSel.value, 'drop', null, gateClaim.value)}" />
      </property>
      <Button
        label="Drop"
        size="sm"
        enabled="{!window.__bramInflightBlocker(gateClaim.value) &amp;&amp; !window.__bramDelegatedBlocker(gateClaim.value, gateSel.value)}"
        onClick="window.__bramGateAct('drop', gateWorklist.value.items, gateSel.value, 'together', gateClaim.value)" />
    </Tooltip>
  </HStack>
</Component>
