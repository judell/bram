# Local launcher symlink to the current debug build
bram
xmlui-desktop

# Project-local Claude Code permissions (per-user, do not share)
.claude/settings.local.json

# Project shell-startup config (committed as a default; local edits stay local)
.bram.json
.xmlui-desktop.json

# Repo-local agent setup generated by Bram Setup.
AGENTS.md

# This repo opts out of committed worklist-history snapshots for the
# Codex-themed release; revisit whether to track them in a later release.
resources/worklist-history/

# Worklist proposals are per-developer scratch; keep them out of the repo.
resources/worklist.json
resources/worklist-drafts/
resources/feedback-drafts/
resources/feedback-history/
resources/message-drafts/
resources/outbound-turns/
resources/.bram-port
resources/.bram-port.json
resources/.inflight-claim.json
resources/.worklist-authorization.json
resources/.worklist-intent.json
resources/.worklist-result.json
resources/.codex-reload-target.json
resources/.worklist-push-mirror.json
resources/.worklist-issue-close.json
resources/.pending-session-title.json
resources/.bram-queue.json

# issue-229 lean audit ledger: machine-local, append-only record of
# authorization decisions and Bram-gated commits. Untracked by design —
# tracking it would dirty the tree after every gated commit.
resources/audit-ledger.jsonl

# Local startup forensics dumps; per-restart, not shared.
resources/startup-traces/

# Python bytecode (Codex worklist-guard hook etc.)
__pycache__/
*.pyc

# Per-developer dev shortcuts.
/build.sh
/tb.sh

# Per-session permission-hook capture (observe-only, not shared).
resources/codex-permission-hook-capture.jsonl

# Local editor/settings backups.
*.bak

# issue-217 transition: legacy generic hook names, kept on disk so live
# Claude sessions (which snapshot hook config at startup) survive the
# rename until restart; pruned by Bram startup once unregistered.
.claude/hooks/worklist-guard.py
.claude/hooks/permission-menu-hook.py
