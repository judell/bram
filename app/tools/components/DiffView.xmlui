<Component name="DiffView" var.pendingRevealKey="{'initial'}">
  <!-- issue-258: was an APICall driven by onInit + a ChangeListener. Neither
       trigger fired here: ChangeListener does not fire on initial mount
       (documented), and execute() at mount never issued a request, so
       lastResult stayed empty and every diff fell back to plain line-splitting
       with no word-diff segments. DataSource is the documented HTTP-read
       abstraction: it fetches on mount and refetches when its body changes,
       which is exactly the two triggers this needed, declaratively. -->
  <DataSource
    id="annotate"
    method="post"
    url="/__diff/annotate"
    body="{ { diff: $props.text } }" />
  <!-- One plan owns diff counting, decoration, and reveal. It matches across
       annotation-segment boundaries, so CommitDetail's raw-patch count and the
       painted occurrences agree. -->
  <variable name="diffFindPlan"
    value="{window.__bramDiffFindPlan(diffViewRows(annotate.value, $props.text), $props.needle, $props.activeIndex, $props.expectedMatchCount)}" />
  <!-- backgroundColor-mark-diff{Add,Del}-Text below are the word-diff
       emphasis colours, resolved by Text from the segment's `variant`
       (xmlui-org/xmlui#3782). Two names rather than one because the
       backend emits $color-danger-200 for deletions and
       $color-success-200 for additions — a single "emphasis" variant
       would flatten red into green.
       Until xmlui-org/xmlui#3797, inline <Theme> declarations with
       $token values were dropped rather than resolved, so these
       rendered unstyled; keep them as token references rather than
       literals, which would freeze the colours against light/dark and
       any palette change. -->
  <Theme
    backgroundColor-row-List--hover="transparent"
    backgroundColor-row-List="transparent"
    backgroundColor-mark-diffAdd-Text="$color-success-200"
    backgroundColor-mark-diffDel-Text="$color-danger-200">
    <VStack
      gap="0"
      padding="$space-2"
      backgroundColor="$color-surface-50"
      borderRadius="$borderRadius"
      overflowX="auto">
      <!-- Compact: plain rows that hug their content — no virtualized
           fixed-height List and no inner scroller. For small inline previews
           (e.g. the AgentMenuView menu preview) so a short diff does not
           reserve 60vh or nest a scroller inside an outer scroller. -->
      <Items
        when="{$props.compact}"
        data="{diffFindPlan.rows}">
        <!-- One Text per line, rendering pre-computed spans. Was an outer
             line-box Text hosting per-segment inline Texts, so a highlighted
             match stayed whole mid-word (judell/bram#239, xmlui-org/xmlui#3713);
             Text.segments does that natively and additionally carries the
             word-diff emphasis as a named variant, which the two-level shape
             could only express as a baked colour (xmlui-org/xmlui#3782). -->
        <Text
          width="100%"
          whiteSpace="pre-wrap"
          fontFamily="$fontFamily-monospace"
          fontSize="$fontSize-sm"
          backgroundColor="{$item.bg}"
          color="{$item.color}"
          paddingHorizontal="$space-2"
          segments="{$item.segments}" />
      </Items>
      <!-- Default: virtualized bounded List for full / potentially large
           diffs (the modal, the TO COMMIT item diff, the Commits patch view).
           maxHeight defaults to 60vh so existing callers are unchanged. -->
      <!-- A plan change arms one reveal. The direct listener handles ordinary
           cursor steps; visibleRangeDidChange retries only until the target row
           is actually mounted, then clears the arm so manual scrolling is not
           yanked back. List documents this event as the mounted-range signal:
           https://docs.xmlui.org/components/List#visiblerangedidchange -->
      <ChangeListener
        listenTo="{diffFindPlan.key}"
        onDidChange="() => pendingRevealKey = window.__bramDiffRevealPlan(diffRowsList, diffFindPlan, diffRowsList ? diffRowsList.getVisibleRange() : null) ? '' : diffFindPlan.key" />
      <!-- fixedItemSize dropped: wrapped lines have variable heights, so virtua
           must measure each row rather than assume the first row's height. -->
      <List
        id="diffRowsList"
        when="{!$props.compact}"
        data="{diffFindPlan.rows}"
        height="{$props.maxHeight || '60vh'}"
        onVisibleRangeDidChange="(range) => diffFindPlan.key &amp;&amp; (pendingRevealKey === 'initial' || pendingRevealKey === diffFindPlan.key) ? (pendingRevealKey = window.__bramDiffRevealPlan(diffRowsList, diffFindPlan, range) ? '' : diffFindPlan.key) : null">
        <!-- Same shape as the compact branch above: one Text per line,
             rendering pre-computed spans. See judell/bram#239. -->
        <Text
          width="100%"
          whiteSpace="pre-wrap"
          fontFamily="$fontFamily-monospace"
          fontSize="$fontSize-sm"
          backgroundColor="{$item.bg}"
          color="{$item.color}"
          paddingHorizontal="$space-2"
          segments="{$item.segments}" />
      </List>
    </VStack>
  </Theme>
</Component>
