<Component name="SearchResults" var.expansion="{['', null]}">
  <!-- search-rows-confinement: the result rows live behind this component
       boundary so bindings re-evaluate on THIS component's prop changes
       only. Before: rows sat in Search's container scope, and any state
       change there — a composer keystroke, a loader flap — re-evaluated
       every row binding (probe capture 2026-07-31: 5 composer
       COMPONENT_STATE_CHANGED actions cascaded ~950 row evaluations each;
       see xmlui-org/xmlui#3710 and the confine-a-hot-input howto,
       applied here to the victims rather than the hot source).
       Rows arrive as a precomputed view-model (typeLabel/dateLabel baked
       by Search once per result set — formatDateTime is not in scope
       here, by design). Expansion is deliberately local: writing it cannot
       invalidate Search's four parent DataSource signatures. -->
  <variable name="typeColors"
    value="{{ session: 'blue', commit: 'green', issue: '#c2410c', history: 'purple' }}" />
  <!-- expansion = ['', currently open row key]. Expansion is manual-only:
       the auto-open-top-hit latch was removed at the 2026-08-14 iterate
       ("autoexpand still troublesome") — the search-date/search-expand soak
       showed it firing on every settle transition during typing, popping
       rows open unbidden. The first slot is retained so a click-time
       assignment shape stays unchanged. A query change collapses whatever
       is open. -->
  <variable name="displayed" value="{
    ($props.hits || []).map(h => Object.assign({}, h, {
      expanded: expansion[1] === h.key
    }))
  }" />
  <ChangeListener listenTo="{$props.query || ''}"
    onDidChange="() => expansion = ['', null]" />
  <!-- search-results-virtualize: List, not Items — ~10 rows in the DOM
       regardless of result count. The 2026-07-31 Timelines recording showed
       per-keystroke frames Layout-dominated: the auto-growing composer
       forces synchronous layout, and 100 materialized rows made each pass
       250-1300ms. With no firm height, List intentionally uses its outside
       scroll mode and virtualizes against Bram's whole-page App scroller;
       Search's StickySection is a sibling above it. This is the whole-page
       counterpart to the bounded-toolbar pattern:
       https://docs.xmlui.org/howto/pin-a-toolbar-above-a-bounded-scroll-region -->
  <!-- idKey="key": hit ids are unreliable across buckets (issue hits carry
       id="" — every issue row would share one empty identity, and a pill
       toggle's recomposition then overlap-corrupts the virtualizer's row
       reconciliation, 2026-08-01 screenshot). `key` is unique across all
       four buckets. https://docs.xmlui.org/components/List#idkey -->
  <!-- search-pin-top-on-bucket-toggle: a virtualized List anchors its scroll to
       a visible row, so toggling a bucket pill off then on (hits shrinks then
       grows) leaves the user scrolled where the anchor landed instead of at the
       top. selectionKey (Search.xmlui) changes only on bucket-membership change,
       so this ChangeListener pins back to the top on every toggle and nothing
       else. NOT List.scrollToTop: in outside-scroll mode it targets list-start
       minus a startMargin that is only recalculated on container resize, so
       content appearing above the list after mount (the date-slider block on
       settle) leaves it stale and the pin lands short — the "slight unwanted
       scroll" of the 2026-08-14 iterate (useStartMargin, ListReact.tsx;
       upstream candidate). window.scrollAllToTop pins the App scroller itself. -->
  <!-- Debounced like Search's filter/query pin: the 2026-08-15 03:02 trace
       showed undebounced via=buckets pins firing 1-16ms after the displayed
       recompute — inside the same frame as the data change, so virtua's
       re-anchor correction landed after the pin and dragged the page back
       down (the "overlap on toggle" report). 250ms fires past the re-anchor. -->
  <ChangeListener listenTo="{$props.selectionKey}"
    debounceWaitInMs="250"
    onDidChange="() => { window.scrollAllToTop(); window.__bramIframeTrace('search-date', {op: 'pin-top', via: 'buckets'}) }" />
  <List id="resultsList" data="{displayed}" idKey="key">
    <!-- Suppress the List's default "No data available": Search renders its own
         intentional empty states ("Type at least 2 characters…" / "No matches."),
         so an empty results list should render nothing. -->
    <property name="emptyListTemplate">
      <Fragment />
    </property>
    <VStack gap="$space-1" paddingVertical="$space-2" borderBottom="1px solid $borderColor">
      <HStack gap="$space-3" verticalAlignment="start">
        <VStack gap="$space-0_5" width="7rem">
          <!-- Compact row metadata; facet badges remain at the default size.
               https://docs.xmlui.org/howto/theme-badge-colors-and-sizes -->
          <Theme fontSize-Badge="0.7rem"
            paddingHorizontal-Badge="$space-0_5" paddingVertical-Badge="0">
            <Badge value="{$item.typeLabel}" colorMap="{typeColors}" />
          </Theme>
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{$item.dateLabel}" />
        </VStack>
        <VStack width="*" gap="$space-0_5">
          <Link noIndicator onClick="expansion = [expansion[0], $item.expanded ? null : $item.key]">
            <Text maxLines="1" fontWeight="$fontWeight-bold" value="{$item.source}" />
          </Link>
          <Text when="{!$item.expanded}"
            fontSize="$fontSize-sm" color="$textColor-secondary" value="…{$item.snippet}…" />
        </VStack>
      </HStack>

      <!-- Inline expander: real per-type source (the detail components are
           themselves UDCs, confined already). Expansion state rides IN the
           row data ($item.expanded, baked locally), not a component prop:
           virtualized List rows re-render on data-array identity change,
           not on outer prop change — a prop-keyed expander froze at its
           first paint (2026-07-31 "cannot collapse the auto-expand").
           https://docs.xmlui.org/howto/keep-per-item-state-in-a-loop -->
      <VStack when="{$item.expanded}"
        gap="$space-2" paddingLeft="7rem" paddingTop="$space-1">
        <VStack when="{$item.type === 'session'}">
          <SessionDetail sessionId="{$item.id}" provider="{$item.provider || 'claude'}"
            query="{$props.query}" />
        </VStack>
        <VStack when="{$item.type === 'commit'}">
          <CommitDetail sha="{($item.key || '').split(':')[1]}" url="{$item.link}"
            query="{$props.query}" />
        </VStack>
        <VStack when="{$item.type === 'issue'}">
          <IssueDetail number="{($item.key || '').split(':')[1]}"
            query="{$props.query}" />
        </VStack>
        <VStack when="{$item.type === 'worklist-history'}">
          <HistoryDetail when="{$item.extra}" group="{$item.extra}"
            query="{$props.query}" />
        </VStack>
      </VStack>
    </VStack>
  </List>
</Component>
