<!-- context-stack-viewer (Jon, 2026-11-24): the blocks the model is sent in
     this session, as the host projects them at GET /__context-stack
     (src/context_stack.rs). The parent passes the route's value as `stack`
     and hears `select` with the clicked block; it shows the block's text in
     its right half. Presentation only: the sort and the kind filter are this
     component's state, the data is the parent's. Per-row token figures on
     the Transcript were dropped as noise (transcript-shows-context-weight);
     here they are the point.

     pinned-header-standard-everywhere: the title, the bar, the legend and
     the sort buttons are the pinned header (PinnedHeader), the List scrolls
     under them. The row click sets `picked` and the ChangeListener below,
     outside the slot, emits `select`: an emitEvent written inside slot
     content fires in the slot-rendering component's scope, not the
     caller's, so the parent never heard it (2026-11-24, the xmlui #3584
     family the draft named).
     https://www.xmlui.org/docs/reference/components/Stack
     https://www.xmlui.org/docs/reference/components/List
     https://www.xmlui.org/docs/howto/pass-a-template-slot-to-a-component -->
<Component name="ContextStack" var.sort="order" var.kinds="{null}" var.selectedI="{null}" var.picked="{null}">
  <DataSource id="history" when="{sort === 'growth' &amp;&amp; !!($props.stack &amp;&amp; $props.stack.session)}"
    url="/__token-accounting" queryParams="{{ session: $props.stack &amp;&amp; $props.stack.session, calls: 1 }}" />
  <ChangeListener listenTo="{$props.stack &amp;&amp; $props.stack.measured &amp;&amp; $props.stack.measured.calls}"
    onDidChange="() => { if (sort === 'growth') history.refetch(); }" />
  <!-- context-growth-explains-jumps: the user's words for each point, kept
       as [{atMs, text}] (transformResult,
       https://www.xmlui.org/docs/reference/components/DataSource), refetched
       when the stack gains a user block, not on every call. -->
  <DataSource id="userTurns" when="{sort === 'growth' &amp;&amp; !!($props.stack &amp;&amp; $props.stack.supported &amp;&amp; $props.stack.session)}"
    url="/__turns" queryParams="{window.__bramStackTurnsQuery($props.stack &amp;&amp; $props.stack.session)}"
    transformResult="{(r) => window.__bramUserTurns(r)}" />
  <ChangeListener listenTo="{window.__bramStackUserCount($props.stack)}"
    onDidChange="() => { if (sort === 'growth') userTurns.refetch(); }" />
  <variable name="growth" value="{window.__bramContextGrowthChart(history.value, $props.stack &amp;&amp; $props.stack.session, $props.stack, userTurns.value, kinds)}" />
  <ChangeListener listenTo="{picked}" onDidChange="emitEvent('select', picked)" />
  <ChangeListener listenTo="{$props.stack &amp;&amp; $props.stack.session}" onDidChange="selectedI = null; kinds = null" />
  <ModalDialog id="contextInfoDialog" title="About Context">
    <VStack gap="$space-3">
      <!-- Provider parity: one helper says, per provider, what its session
           record holds and how sizes are measured; a provider with no
           reader of its own gets the neutral lines. -->
      <Items data="{window.__bramStackAboutLines($props.stack)}">
        <Text value="{$item}" />
      </Items>
      <!-- One line per kind, the way the tables say what their columns
           mean (table-headers-explained). -->
      <VStack gap="$space-1">
        <Text fontWeight="$fontWeight-bold" value="What the kinds are" />
        <Items data="{window.__bramStackKindGlossary($props.stack)}">
          <HStack gap="$space-2" verticalAlignment="start">
            <Stack width="10px" height="10px" backgroundColor="{$item.color}" marginTop="$space-1" />
            <Text fontSize="$fontSize-sm" width="*" value="{$item.line}" />
          </HStack>
        </Items>
      </VStack>
    </VStack>
  </ModalDialog>
  <VStack height="*" gap="$space-2">
    <!-- The splitter pane bounds this column; the header stays and the
         List scrolls in PinnedHeader's body. -->
    <PinnedHeader gap="$space-2">
    <property name="headerTemplate">
    <VStack gap="$space-2">
      <!-- One title row (Jon, 2026-11-25: the threshold and the blocks /
           tokens / calls go after the title), wrapping in a narrow pane.
           footer-context-refresh-after-settings-change: the threshold
           phrase is for every provider; the intro sentence it replaced is
           in the About dialog. The rates and their provenance stay on the
           route; the pane shows only the headline (Jon, 2026-11-24).
           https://www.xmlui.org/docs/howto/wrap-items-across-multiple-rows -->
      <!-- Centered, with the About ⓘ at the end (Jon, 2026-11-25). -->
      <HStack wrapContent="true" gap="$space-2" verticalAlignment="center">
        <Heading level="h1">Context</Heading>
        <HStack
          when="{$props.stack &amp;&amp; !window.__bramStackUnsupportedLine($props.stack)}"
          gap="$space-1"
          verticalAlignment="center">
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramStackThresholdPrefix($props.stack, $props.settings)}" />
          <Link to="/settings?highlight=suggestAtContextShare" noIndicator="true" fontSize="$fontSize-sm">threshold</Link>
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="·" />
          <Text fontSize="$fontSize-sm" color="$textColor-secondary" value="{window.__bramStackHeadline($props.stack)}" />
        </HStack>
        <Theme paddingVertical-Button-sm="0" paddingHorizontal-Button-sm="$space-1">
          <Button
            label="ⓘ"
            variant="ghost"
            size="sm"
            tooltip="About Context"
            onClick="contextInfoDialog.open()" />
        </Theme>
      </HStack>
      <Text
        when="{!!window.__bramStackUnsupportedLine($props.stack)}"
        fontSize="$fontSize-sm"
        color="$textColor-secondary"
        value="{window.__bramStackUnsupportedLine($props.stack)}" />
      <VStack when="{$props.stack &amp;&amp; !window.__bramStackUnsupportedLine($props.stack)}" gap="$space-2">
      <!-- The segment and chip tooltips are Markdown in a Tooltip's
           tooltipTemplate, 360px at most, so long explanations wrap instead
           of spanning the pane (Jon, 2026-11-25: "narrow the thinking
           tooltip"; "is there not a template for that?"). tooltipMarkdown
           can't do this: a tooltip is as wide as its longest line.
           https://www.xmlui.org/docs/reference/components/Tooltip
           https://www.xmlui.org/docs/howto/show-a-multi-line-or-formatted-tooltip -->
      <!-- One thin stacked bar, a series per kind in the stack's colours; the
           legend is the chip row below, which wraps to the pane's width and
           doubles as the kind filter (ECharts' own legend wrapped over the
           bar in a narrow pane).
           https://www.xmlui.org/docs/howto/wrap-items-across-multiple-rows -->
      <!-- The strip: percentage-width segments, largest kind first, in the
           chips' colours. Percentages that sum to 100 need gap 0
           (https://www.xmlui.org/docs/howto/control-item-spacing-with-gap);
           a Stack takes a click and a tooltip
           (https://www.xmlui.org/docs/reference/components/Stack). A click
           filters to that kind, a second click clears it. ECharts was tried
           and withdrawn: overkill for one strip, and no click for markup. -->
      <HStack gap="0" width="100%" height="20px">
        <Items data="{window.__bramStackSegments($props.stack, kinds)}">
          <Tooltip>
            <property name="tooltipTemplate">
              <Markdown maxWidth="360px" fontSize="$fontSize-sm" content="{$item.tip}" />
            </property>
            <Stack
              width="{$item.width}"
              height="20px"
              backgroundColor="{$item.color}"
              opacity="{$item.opacity}"
              onClick="kinds = window.__bramStackToggleKind(kinds, $item.kind)" />
          </Tooltip>
        </Items>
      </HStack>
      <!-- gap is both axes on a wrapping HStack; $space-2 keeps the wrapped
           rows close (Jon, 2026-11-24: tighten the legend). The little-i
           closes the legend row (Jon: after the legend). -->
      <!-- context-legend-tighter-rows: gap is both axes on a wrapping stack,
           so the 4px gap is the row gap and each chip's paddingRight keeps
           the sideways spacing near 8px; the little-i's Theme drops the
           button padding that made its row taller than a chip. -->
      <HStack wrapContent="true" gap="0" verticalAlignment="center">
        <Items data="{window.__bramStackLegend($props.stack, kinds)}">
          <Tooltip>
            <property name="tooltipTemplate">
              <Markdown maxWidth="360px" fontSize="$fontSize-sm" content="{$item.tip}" />
            </property>
            <!-- context-kind-toggle-vivid: an off chip is a hollow swatch
                 (border in the kind's colour) and a struck-through label.
                 https://www.xmlui.org/docs/styles-and-themes/layout-props -->
            <Link onClick="kinds = window.__bramStackToggleKind(kinds, $item.kind)" noIndicator="true" paddingRight="$space-2">
              <HStack gap="$space-1" verticalAlignment="center" opacity="{window.__bramStackLegendOpacity($item)}">
                <Stack
                  when="{$item.color}"
                  width="10px"
                  height="10px"
                  backgroundColor="{window.__bramStackSwatchFill($item)}"
                  borderWidth="1.5px"
                  borderStyle="solid"
                  borderColor="{$item.color}" />
                <Text
                  fontSize="$fontSize-xs"
                  lineHeight="1.3"
                  color="{window.__bramStackLegendColor($item)}"
                  fontWeight="{window.__bramStackLegendWeight($item)}"
                  textDecorationLine="{window.__bramStackLegendDecoration($item)}"
                  value="{$item.label}" />
              </HStack>
            </Link>
          </Tooltip>
        </Items>
        <!-- context-kind-toggle-vivid (Jon, 2026-11-25): the × replaces the
             About dialog; it shows while any kind is selected and releases
             the whole selection. -->
        <Theme paddingVertical-Button-sm="0" paddingHorizontal-Button-sm="$space-1">
          <Button
            when="{!!kinds}"
            label="×"
            variant="ghost"
            size="sm"
            tooltip="Release filter, show all"
            onClick="kinds = null" />
        </Theme>
      </HStack>
      <!-- The thinking sentence leads the Thinking chip's and segment's
           tooltip now, not a line of its own (Jon, 2026-11-25). -->
      <Text
        when="{!!window.__bramStackCompactedLine($props.stack)}"
        fontSize="$fontSize-sm"
        fontStyle="italic"
        color="$textColor-secondary"
        value="{window.__bramStackCompactedLine($props.stack)}" />
      <HStack gap="$space-2" verticalAlignment="center">
        <Button label="In order" size="xs" variant="{sort === 'order' ? 'solid' : 'ghost'}" tooltip="As the model sees them" onClick="sort = 'order'" />
        <Button label="By size" size="xs" variant="{sort === 'size' ? 'solid' : 'ghost'}" tooltip="What is eating the context" onClick="sort = 'size'" />
        <Button label="Token growth" size="xs" variant="{sort === 'growth' ? 'solid' : 'ghost'}" onClick="sort = 'growth'" />
      </HStack>
      </VStack>
    </VStack>
    </property>
    <!-- https://www.xmlui.org/docs/reference/extensions/xmlui-echart/EChart -->
    <!-- The chart takes the body's height (Jon, 2026-11-25: "use all
         available vertical space"): a star column in PinnedHeader's bounded
         body, the chart at 100% of it, 240px at least.
         https://www.xmlui.org/docs/howto/build-a-full-height-scroll-layout -->
    <VStack
      when="{sort === 'growth' &amp;&amp; $props.stack &amp;&amp; !window.__bramStackUnsupportedLine($props.stack)}"
      height="*"
      minHeight="240px">
      <EChart when="{!!growth}" option="{growth}" height="100%" />
      <Text when="{!growth}" color="$textColor-secondary" value="{history.inProgress ? 'Loading token history…' : history.error ? 'Could not load token history.' : 'No recorded calls for this session.'}" />
    </VStack>
    <!-- A List, not Items: a long session has many hundreds of blocks
         (#427's lesson on the Transcript), so the rows are virtualized. The
         List is unbounded and delegates to PinnedHeader's body scroller. -->
    <List
      when="{sort !== 'growth' &amp;&amp; $props.stack &amp;&amp; !window.__bramStackUnsupportedLine($props.stack)}"
      data="{window.__bramStackRows($props.stack, sort, kinds)}">
      <Link onClick="selectedI = $item.i; picked = $item" noIndicator="true">
        <HStack
          gap="$space-2"
          verticalAlignment="center"
          paddingVertical="$space-0_5"
          paddingHorizontal="$space-1"
          backgroundColor="{selectedI === $item.i ? '$color-surface-100' : 'transparent'}">
          <Stack width="8px" height="8px" backgroundColor="{window.__bramStackKindColor($item.kind)}" />
          <Text width="84px" fontSize="$fontSize-xs" color="$textColor-secondary" value="{window.__bramStackKindLabel($item.kind)}" />
          <Text
            width="*"
            fontSize="$fontSize-sm"
            fontFamily="{window.__bramStackLabelFont($item)}"
            whiteSpace="nowrap"
            overflowMode="ellipsis"
            maxLines="1"
            value="{window.__bramStackRowLabel($item)}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" whiteSpace="nowrap" value="{window.__bramStackSizeLabel($item)}" />
        </HStack>
      </Link>
    </List>
    </PinnedHeader>
  </VStack>
</Component>
