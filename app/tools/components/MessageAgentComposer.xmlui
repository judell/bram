<Component
  name="MessageAgentComposer"
  var.voiceRecording="{false}"
  var.skillsRequestTick="{0}"
  var.toChat="{false}">
  <!-- A user-defined component is the deliberate performance boundary: the
       TextArea's high-frequency internal state cannot invalidate Main.xmlui's
       App-scope footer sources, listeners, pages, or status bindings. See
       https://docs.xmlui.org/howto/confine-a-hot-input-to-its-own-component . -->
  <!-- issue-278: one message box. The Worklist's own "Message about the
       selection" box is gone; this one names its target instead. -->
  <PushSource id="w2Sel" subscribe="{window.bramSubscribeW2Selection()}" />
  <!-- composer-addressee-line: the per-message chat override resets when the
       selection changes, so a fresh tick defaults to feedback. -->
  <ChangeListener
    listenTo="{(w2Sel.value || []).join(',')}"
    onDidChange="toChat = false" />
  <PushSource
    id="composerClear"
    initial="{0}"
    subscribe="{window.bramSubscribeComposerClear()}" />
  <!-- ChangeListener fires once at mount with the initial value (0); only a
       real clear request (tick 1 or more) may empty the box. Without that
       guard, every reload and relaunch cleared a restored draft (Inspector
       export, 2026-09-29: composerBox.setValue("") at mount). -->
  <ChangeListener
    listenTo="{composerClear.value}"
    onDidChange="(change) => window.__bramComposerClearOnTick(composerBox, change)" />
  <!-- message-box-on-draft-editor-pattern: the host's saved draft arrives
       after mount; it fills the box only if the box is still empty. -->
  <PushSource
    id="draftHydrated"
    initial="{0}"
    subscribe="{window.bramSubscribeDraftHydrated()}" />
  <ChangeListener
    listenTo="{draftHydrated.value}"
    onDidChange="() => window.__bramApplyDraftHydration(composerBox)" />
  <PushSource
    id="voiceArrival"
    initial="{null}"
    subscribe="{window.bramSubscribeVoiceArrival()}" />
  <ChangeListener
    listenTo="{voiceArrival.value &amp;&amp; voiceArrival.value.at}"
    onDidChange="() => { const ev = voiceArrival.value || null; const t = (ev &amp;&amp; ev.transcript) || ''; const target = (ev &amp;&amp; ev.meta &amp;&amp; ev.meta.target) || ''; if (target === 'message-agent') { window.__bramVoiceFinalizeInto(composerBox, 'message-agent', t); voiceRecording = false; worklistVoiceRecordingActive = false; } }" />
  <PushSource
    id="sendRestore"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('send-restore')}" />
  <ChangeListener
    listenTo="{sendRestore.value &amp;&amp; sendRestore.value.tick}"
    onDidChange="() => window.__bramApplySendRestore(sendRestore.value, composerBox, toast)" />

  <!-- Form is retained only for TextArea.enterSubmits. Draft persistence is
       debounced in helpers.js; blur and submit flush/clear explicitly. -->
  <Form
    width="100%"
    onSubmit="window.__bramComposerEnterSubmit(composerBox, toChat)">
    <property name="buttonRowTemplate"><Fragment/></property>
    <!-- composer-addressee-line: where Enter will send, shown BEFORE sending.
         Replaces the Chat button: with items ticked, "Send as chat instead"
         switches this one message to chat without unticking anything.
         Wrapped with the input row in one tight VStack: as separate Form
         children they sat gap-Form ($space-4) apart and the line read as
         unrelated to the box (https://www.xmlui.org/docs/reference/components/Form). -->
    <VStack width="100%" gap="0">
    <HStack width="100%" gap="$space-2" verticalAlignment="center" paddingLeft="3rem">
      <Text fontSize="$fontSize-sm" color="$textColor-secondary"
        value="{window.__bramComposerAddressee(w2Sel.value || [], toChat, $props.activeProvider)}"
        tooltip="{window.__bramComposerAddresseeTooltip(w2Sel.value || [], toChat)}" />
      <Button
        when="{(w2Sel.value || []).length > 0 &amp;&amp; !toChat}"
        label="Send as chat instead"
        variant="ghost"
        size="xs"
        onClick="toChat = true" />
      <Button
        when="{(w2Sel.value || []).length > 0 &amp;&amp; toChat}"
        label="Back to feedback"
        variant="ghost"
        size="xs"
        onClick="toChat = false" />
    </HStack>
    <!-- composer-addressee-hugs-box: the gap under the addressee line was
         this row centering the box against a taller 6rem ▲/▼ column (found
         by a plain-XMLUI bisect, 2026-10-08). Both side columns are now
         tight stacks shorter than the box, so the row is the box's height
         and centering them on it leaves no gap.
         https://www.xmlui.org/docs/reference/components/HStack -->
    <HStack width="100%" gap="$space-2" verticalAlignment="center">
      <!-- composer-addressee-hugs-box (Jon): mic with Esc under it, one
           tight stack, centered on the box. -->
      <VStack width="2.5rem" gap="$space-2" horizontalAlignment="center">
        <Button
          label="{voiceRecording ? (worklistVoiceRecordingActive ? '⏹' : '⏳') : '🎤'}"
          variant="ghost"
          size="xs"
          width="2.5rem"
          tooltip="Voice message"
          enabled="{!isWorklistVoiceProcessingTarget('message-agent') &amp;&amp; (!voiceRecording || worklistVoiceRecordingActive)}">
          <event name="click">
            setWorklistVoiceTarget('message-agent');
            voiceRecording = toggleVoiceForCurrentTarget(voiceRecording);
          </event>
        </Button>
        <!-- composer-addressee-line: the Chat button retired; the addressee
             line above the box ("Send as chat instead") replaces it.
             switch-to-transcript-on-action: the Feedback button retired one
             round after it arrived — with a selection, Enter and every gate
             button already send the message as feedback, so a third
             affordance was redundant (Jon: "clicking any button already
             sends Feedback"). The placeholder carries the teaching; Chat
             stays as the per-message escape to general discussion. Enter's
             selection routing (__bramComposerEnterSubmit) is unchanged.
             The skip-worklist button also remains retired (the typed
             skip-worklist: prefix and the "just do it" phrase are the
             direct-edit grants until that design settles). Idle-Chat is
             retired too: with no Worklist selection the button is hidden
             entirely, so there is deliberately no pointer-device send
             affordance — Enter is the whole story (counterpoint recorded
             in the item draft). -->
        <Button
          label="Esc"
          variant="ghost"
          size="xs"
          tooltip="Send the Escape key"
          onClick="escToolbarClick()" />
        <Button
          when="{false}"
          label="skills"
          variant="ghost"
          size="xs"
          tooltip="Launch a project skill (.claude/skills)">
          <event name="click">
            emitEvent('skillsRequested');
            skillsRequestTick = skillsRequestTick + 1;
          </event>
        </Button>
      </VStack>
      <!-- switch-to-transcript-on-action: quieter placeholder — it carries
           the addressee signal now, and instruction-sized text read as
           content. Theme var per
           https://www.xmlui.org/docs/reference/components/TextArea#styling -->
      <Theme fontSize-placeholder-TextArea="$fontSize-sm" width="*">
        <TextArea
          id="composerBox"
          initialValue="{window.__bramRestoreWorklistDraft()}"
          placeholder="{window.__bramComposerPlaceholder($props.route, w2Sel.value || [], toChat)}"
          enterSubmits="true"
          autoSize="true"
          minRows="3"
          maxRows="5"
          width="*"
          onDidChange="(value) => window.__bramMessageAgentInputChanged(value)">
          <event name="gotFocus">
            setWorklistVoiceTarget('message-agent');
            setFocusedFeedbackItemId('');
          </event>
          <event name="lostFocus">
            window.__bramMessageAgentBlur();
          </event>
        </TextArea>
      </Theme>
      <!-- composer-addressee-hugs-box (Jon): ▲ and ▼ as one tight stack,
           centered on the box like the mic/Esc stack on the left. They used
           to ride opposite ends of a 6rem column (SpaceFiller, explicit
           height); that column was taller than the box, and centering the box
           against it opened the gap under the addressee line.

           The glyph size does NOT come from the `size` prop. Button's
           `size` selects padding only — the docs define
           paddingVertical-Button-{xs,sm,md,lg} but a single
           fontSize-Button ($fontSize-sm) shared by every size, so
           xs → sm → md moved the box and left the arrow identical.
           Making the arrows bigger means fontSize-Button; making them
           hug the ends means zero padding. Both go through this Theme
           wrapper, which is why size stays xs.
           https://docs.xmlui.org/components/Button -->
      <Theme fontSize-Button="$fontSize-xl"
             paddingVertical-Button-xs="0" paddingHorizontal-Button-xs="0">
        <VStack
          when="{$pathname === '/transcript'}"
          width="2rem"
          gap="0"
          horizontalAlignment="center">
          <Button
            label="▲"
            variant="ghost"
            size="xs"
            tooltip="Scroll transcript to top"
            onClick="window.__bramTranscriptScroll('top')" />
          <Button
            label="▼"
            variant="ghost"
            size="xs"
            tooltip="Scroll transcript to bottom"
            onClick="window.__bramTranscriptScroll('bottom')" />
        </VStack>
      </Theme>
    </HStack>
    </VStack>
  </Form>
  <!-- issue-407: live dictation. Each partial is written into composerBox
       (window.__bramVoiceShowLive); the delivered transcript restores the
       pre-dictation text before appending. -->
  <PushSource
    id="voicePartial"
    initial="{null}"
    subscribe="{window.bramSubscribeVoicePartial()}" />
  <ChangeListener
    listenTo="{voicePartial.value &amp;&amp; voicePartial.value.at}"
    onDidChange="() => window.__bramVoiceShowLive(composerBox, voicePartial.value, 'message-agent')" />
  <PastedImageStrip target="message-agent" />
</Component>
