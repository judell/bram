<Component name="Search" var.query="">
  <!-- issue-230 unified search across the local FTS5 index (sessions,
       commits, issues, worklist-history). Each type is queried independently
       (its own top-100) so a length-penalized bucket isn't squeezed out of a
       global top-100; the pills count per-type and the list merges the
       selected buckets by rank. Clicking a title inline-expands that row
       (single-open) and fetches the real per-type source. -->
  <variable name="typeColors"
    value="{{ session: 'blue', commit: 'green', issue: '#c2410c', history: 'purple' }}" />
  <variable name="facetColors"
    value="{{ Sessions: 'blue', Commits: 'green', Issues: '#c2410c', History: 'purple' }}" />
  <variable name="selectedTypes" value="{['session', 'commit', 'issue', 'worklist-history']}" />
  <variable name="ready" value="{!!query &amp;&amp; query.trim().length >= 2}" />
  <variable name="expandedHit" value="{null}" />
  <!-- Selected date window [lo, hi] (epoch seconds); null = no date filter. -->
  <variable name="dateFilter" value="{null}" />

  <DataSource id="rSession" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'session' }}" when="{ready}" />
  <DataSource id="rCommit" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'commit' }}" when="{ready}" />
  <DataSource id="rIssue" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'issue' }}" when="{ready}" />
  <DataSource id="rHistory" url="/__search"
    queryParams="{{ q: query, limit: 100, types: 'worklist-history' }}" when="{ready}" />

  <!-- Full relevance-ordered set of the selected buckets (no date filter) — the
       stable domain the slider measures, so moving the handles never shifts it. -->
  <variable name="merged" value="{
    [].concat(
      selectedTypes.includes('session') ? (rSession.value || []) : [],
      selectedTypes.includes('commit') ? (rCommit.value || []) : [],
      selectedTypes.includes('issue') ? (rIssue.value || []) : [],
      selectedTypes.includes('worklist-history') ? (rHistory.value || []) : []
    ).sort((a, b) => a.rank - b.rank)
  }" />

  <!-- Date-slider domain: [min, max] hit date across merged; widen by a day when
       all hits share one date so the two thumbs aren't coincident. -->
  <variable name="hitDates" value="{merged.map(h => Number(h.date)).filter(n => n > 0)}" />
  <variable name="dateLo" value="{hitDates.length ? hitDates.reduce((a, b) => a &lt; b ? a : b) : null}" />
  <variable name="dateHi" value="{hitDates.length ? hitDates.reduce((a, b) => a &gt; b ? a : b) : null}" />
  <variable name="dateRange"
    value="{dateLo === null ? null : [dateLo, dateHi > dateLo ? dateHi : dateLo + 86400]}" />

  <!-- New query => new domain; reset the filter and snap the handles to the full
       span (a stale window from the prior query would mis-narrow). Moving the
       slider doesn't touch dateRange, so this never loops. Two listeners because
       ChangeListener.onDidChange is a sync callback: it must be a single arrow
       expression, not a statement block. -->
  <ChangeListener
    listenTo="{dateRange ? (dateRange[0] + '-' + dateRange[1]) : ''}"
    onDidChange="() => dateFilter = null" />
  <ChangeListener
    listenTo="{dateRange ? (dateRange[0] + '-' + dateRange[1]) : ''}"
    onDidChange="() => (dateSlider &amp;&amp; dateRange) ? dateSlider.setValue(dateRange) : null" />

  <variable name="displayed" value="{
    merged
      .filter(h => !dateFilter || (Number(h.date) >= dateFilter[0] &amp;&amp; Number(h.date) &lt;= dateFilter[1]))
      .slice(0, 100)
  }" />

  <!-- Real per-type source for the single open row: sessions via /__turns
       (matching turns), everything else via the stored indexed content. -->
  <!-- History detail: look up the WorklistHistoryGroup by the item id parsed
       from the hit source ("id (summary)"). /search skips gh commit
       resolution, so it's fast; the raw commit URL still links. -->
  <DataSource id="historyGroups" url="/__worklist-history/search"
    queryParams="{{ q: (expandedHit &amp;&amp; expandedHit.source || '').split(' (')[0] }}"
    when="{expandedHit &amp;&amp; expandedHit.type === 'worklist-history'}" />
  <variable name="historyGroup"
    value="{(expandedHit &amp;&amp; expandedHit.type === 'worklist-history' &amp;&amp; historyGroups.value &amp;&amp; historyGroups.value.results) ? (historyGroups.value.results.find(g => g.title === (expandedHit.source || '').split(' (')[0]) || null) : null}" />

  <VStack padding="$space-4" gap="$space-3" overflowY="auto">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">Search</Heading>
      <SearchBox
        boxWidth="26rem"
        placeholder="Search sessions, commits, issues, history…"
        inProgress="{rSession.inProgress || rCommit.inProgress || rIssue.inProgress || rHistory.inProgress}"
        onQueryChange="(q) => query = q"
        onClear="query = ''; expandedHit = null" />
      <!-- Two-handled date-range filter; fills the rest of the row. The dates
           are shown as Text labels above the thumbs (top-level bindings) rather
           than via the Slider's valueFormat, which is a sync render callback the
           xs engine rejects for anything but a bare arrow expression. -->
      <VStack when="{dateRange}" width="*" gap="$space-0">
        <HStack>
          <Text fontSize="$fontSize-xs" color="$textColor-secondary"
            value="{formatDateTime(new Date((dateFilter ? dateFilter[0] : dateRange[0]) * 1000), 'yyyy-MM-dd')}" />
          <SpaceFiller />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary"
            value="{formatDateTime(new Date((dateFilter ? dateFilter[1] : dateRange[1]) * 1000), 'yyyy-MM-dd')}" />
        </HStack>
        <Slider
          id="dateSlider"
          minValue="{dateRange[0]}"
          maxValue="{dateRange[1]}"
          step="{86400}"
          initialValue="{dateRange}"
          showValues="false"
          onDidChange="(v) => dateFilter = v" />
      </VStack>
    </HStack>

    <HStack gap="$space-3" verticalAlignment="center">
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'session', !selectedTypes.includes('session'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('session') ? 1 : 0.4}">
          <Badge value="Sessions" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rSession.value || []).length}" />
        </HStack>
      </Link>
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'commit', !selectedTypes.includes('commit'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('commit') ? 1 : 0.4}">
          <Badge value="Commits" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rCommit.value || []).length}" />
        </HStack>
      </Link>
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'issue', !selectedTypes.includes('issue'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('issue') ? 1 : 0.4}">
          <Badge value="Issues" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rIssue.value || []).length}" />
        </HStack>
      </Link>
      <Link noIndicator onClick="selectedTypes = window.__bramToggleType(selectedTypes, 'worklist-history', !selectedTypes.includes('worklist-history'))">
        <HStack gap="$space-1" verticalAlignment="center" opacity="{selectedTypes.includes('worklist-history') ? 1 : 0.4}">
          <Badge value="History" colorMap="{facetColors}" />
          <Text fontSize="$fontSize-xs" color="$textColor-secondary" value="{(rHistory.value || []).length}" />
        </HStack>
      </Link>
    </HStack>

    <Text when="{!ready}"
      color="$textColor-secondary"
      value="Type at least 2 characters to search the index." />
    <Text when="{ready &amp;&amp; rSession.loaded &amp;&amp; rCommit.loaded &amp;&amp; rIssue.loaded &amp;&amp; rHistory.loaded &amp;&amp; displayed.length === 0}"
      color="$textColor-secondary"
      value="No matches." />

    <Theme fontSize-Badge="0.55em">
      <Items data="{displayed}">
        <VStack gap="$space-1" paddingVertical="$space-2" borderBottom="1px solid $borderColor">
          <HStack gap="$space-3" verticalAlignment="start">
            <VStack gap="$space-0_5" width="7rem">
              <Badge value="{$item.type === 'worklist-history' ? 'history' : $item.type}" colorMap="{typeColors}" />
              <Text fontSize="$fontSize-xs" color="$textColor-secondary"
                value="{$item.date ? formatDateTime(new Date(Number($item.date) * 1000), 'yyyy-MM-dd HH:mm') : ''}" />
            </VStack>
            <VStack width="*" gap="$space-0_5">
              <Link noIndicator onClick="expandedHit = (expandedHit &amp;&amp; expandedHit.key === $item.key) ? null : $item">
                <Text maxLines="1" fontWeight="$fontWeight-bold" value="{$item.source}" />
              </Link>
              <Text when="{!(expandedHit &amp;&amp; expandedHit.key === $item.key)}"
                fontSize="$fontSize-sm" color="$textColor-secondary" value="…{$item.snippet}…" />
            </VStack>
          </HStack>

          <!-- Inline expander: real per-type source + a footer link. -->
          <VStack when="{expandedHit &amp;&amp; expandedHit.key === $item.key}"
            gap="$space-2" paddingLeft="7rem" paddingTop="$space-1">
            <VStack when="{$item.type === 'session'}" maxHeight="420px" overflowY="auto">
              <SessionDetail sessionId="{$item.id}" provider="{$item.provider || 'claude'}" />
            </VStack>
            <VStack when="{$item.type === 'commit'}" maxHeight="420px" overflowY="auto">
              <CommitDetail sha="{($item.key || '').split(':')[1]}" url="{$item.link}" />
            </VStack>
            <VStack when="{$item.type === 'issue'}" maxHeight="420px" overflowY="auto">
              <IssueDetail number="{($item.key || '').split(':')[1]}" />
            </VStack>
            <VStack when="{$item.type === 'worklist-history'}" maxHeight="420px" overflowY="auto">
              <Text when="{historyGroups.inProgress}" color="$textColor-secondary" value="Loading…" />
              <HistoryDetail when="{historyGroup}" group="{historyGroup}" />
            </VStack>
          </VStack>
        </VStack>
      </Items>
    </Theme>
  </VStack>
</Component>
