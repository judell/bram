<Component
  name="History"
  var.historyExpanded="{false}"
  var.searchQuery="{getLastSearchQuery()}"
  var.searchNeedle="{searchQuery.trim().toLowerCase()}"
  var.historyBlobbed="{blobHistoryRows(historyList.value)}"
  var.filteredHistory="{filterHistoryList(historyBlobbed, searchNeedle)}"
  var.visibleHistory="{filteredHistory.slice(0, searchNeedle ? 9999 : (historyExpanded ? 9999 : 50))}"
  var.historyRows="{visibleHistory.map(h => Object.assign({}, h, {
    key: 'history:' + h.id,
    type: 'worklist-history',
    source: h.title || ''
  }))}"
  var.deepLinkedGroup="{$queryParams.entry ? (((historyList.value || []).find(h => h.id === $queryParams.entry)) || null) : null}">

  <!-- issue-67: CommitDetail's "Worklist history" link deep-links here as
       /history?entry=<item id> — h.id is the worklist item id (the group
       id every history row is keyed by; recent_worklist_history_groups /
       lib.rs groups per item, not per snapshot timestamp), so it's the one
       addressable unit History already exposes. Var default covers landing
       here fresh (mount-time read of $queryParams, per
       https://www.xmlui.org/docs/howto/deep-link-to-a-tab-or-section); the
       ChangeListener below covers historyList finishing its async load
       after mount, and a second Open while already on this tab — same
       belt-and-suspenders shape as Worklist.xmlui's expand param. -->

  <!-- issue-230: reverse-chron browse of worklist history as a simplified
       inline-expander table (matching Commits/Sessions), not the old cards.
       Served from the FTS index via /__history-index (indexed ORDER BY date) —
       the file-scanning /__worklist-history/list was O(files) and hit 131s at
       limit 200. Each row carries its full group in `extra`, so the expander
       renders HistoryDetail with no re-fetch. -->
  <DataSource id="historyList" url="/__history-index" queryParams="{{ limit: 300 }}" />
  <!-- tab-refresh-after-index: the history pass emits worklist-history-changed
       once a new snapshot is indexed; refetch the list on it so the tab stays
       live instead of only loading on mount. -->
  <PushSource
    id="historyIndexedEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTauriEvent('worklist-history-changed')}" />
  <ChangeListener
    listenTo="{historyIndexedEvt.value &amp;&amp; historyIndexedEvt.value.tick}"
    onDidChange="() => historyList.refetch()" />
  <!-- issue-67: same shape as ResultList's own combined listenTo key
       (data length + query) — one composite string so either historyList
       finishing its load OR $queryParams.entry changing (a second Open
       while already mounted) re-derives deepLinkedGroup. -->
  <ChangeListener
    listenTo="{($queryParams.entry || '') + '|' + (historyList.value ? historyList.value.length : 0)}"
    onDidChange="deepLinkedGroup = ($queryParams.entry ? (((historyList.value || []).find(h => h.id === $queryParams.entry)) || null) : null)" />
  <!-- The needle/filter/rows chain lives in ROOT var. attributes: element-
       declared <variable>s went stale against the root searchQuery (the
       Commits DEBUG receipt, 2026-08-16). Filtering is filterHistoryList
       (Globals.xs), matching the row's OWN payload (title + the full group
       in `extra`) so the match surface equals what HistoryDetail renders —
       the former FTS union admitted rows whose match lived in indexed prose
       the detail never displays ("subagent": 9 FTS hits vs 5 title
       matches). -->
  <VStack padding="$space-4" gap="$space-4" overflowY="auto" height="100%">
    <HStack gap="$space-3" verticalAlignment="center">
      <Heading level="h2">History</Heading>
      <SearchBox
        boxWidth="22rem"
        placeholder="Filter history…"
        initialValue="{searchQuery}"
        inProgress="{historyList.inProgress}"
        onQueryChange="(q) => { searchQuery = q; setLastSearchQuery(q) }"
        onClear="searchQuery = ''; setLastSearchQuery('')" />
    </HStack>

    <Spinner when="{historyList.inProgress &amp;&amp; !historyList.loaded}" />

    <VStack gap="$space-1" when="{historyList.value &amp;&amp; historyList.value.length > 0}">
      <!-- browse-tabs-adopt-searchresults: rows render through the shared
           ResultList shell; the history row anatomy (date / title / phase
           path) stays History-owned in the slot. Inline HistoryDetail
           expansion and expandedId retire in favor of the shell's modal. -->
      <ResultList data="{historyRows}" query="{searchQuery.trim()}">
        <property name="rowTemplate">
          <HStack gap="$space-3" verticalAlignment="center">
            <Text
              value="{formatDateTime(new Date(Number($item.date) * 1000), 'yyyy-MM-dd HH:mm')}"
              fontSize="$fontSize-xs"
              color="$textColor-secondary"
              overflowMode="none"
              width="120px" />
            <Text
              value="{$item.title}"
              fontSize="$fontSize-sm"
              width="*"
              maxLines="1" />
            <Text
              when="{$item.extra}"
              value="{window.__bramHistoryPhasePath($item.extra)}"
              fontSize="$fontSize-xs"
              color="$textColor-secondary"
              overflowMode="none"
              maxLines="1" />
          </HStack>
        </property>
      </ResultList>
      <Link
        when="{!searchNeedle &amp;&amp; historyList.value &amp;&amp; historyList.value.length > 50}"
        onClick="historyExpanded = !historyExpanded"
        noIndicator="true">
        <Text fontSize="$fontSize-xs" color="$textColor-secondary"
          value="{historyExpanded ? 'Show fewer' : 'More (' + (historyList.value.length - 50) + ' more)'}" />
      </Link>
      <Text when="{searchNeedle &amp;&amp; filteredHistory.length === 0}"
        color="$textColor-secondary" fontSize="$fontSize-sm" value="No matching history entries." />
    </VStack>

    <Text
      when="{historyList.loaded &amp;&amp; historyList.value &amp;&amp; historyList.value.length === 0}"
      color="$textColor-secondary"
      fontSize="$fontSize-sm"
      value="No worklist history yet." />
  </VStack>

  <!-- issue-67: opens the deep-linked entry directly, independent of
       ResultList's own row-click modal — ResultList's selectedHit is
       internal to that component (var.selectedHit, ResultList.xmlui), with
       no prop to preselect a row from outside it, so this owns its own
       ModalDialog rather than reaching into ResultList's. Same detail
       component + props ResultList itself uses for a worklist-history hit
       (group="{selectedHit.extra}" there); maxWidth/height match too. -->
  <Theme maxWidth-ModalDialog="95vw">
    <ModalDialog
      when="{!!deepLinkedGroup}"
      onClose="deepLinkedGroup = null"
      title="{deepLinkedGroup ? deepLinkedGroup.title : ''}">
      <HistoryDetail when="{deepLinkedGroup}" group="{deepLinkedGroup.extra}" height="70vh" />
    </ModalDialog>
  </Theme>
</Component>
