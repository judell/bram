<Component name="TerminalAttentionBanner">
  <!-- pane-sources-move-to-their-readers (judell/bram#470): the
       terminal-attention banner owns its push source, so its updates (which
       follow terminal show/hide) redraw the banner, not the whole pane.
       Banner unchanged from issue-234: fires only when the host detector is
       active AND the terminal pane is hidden (derived in the
       bramSubscribeTerminalAttention bridge, helpers.js). No dismiss button
       by design — it clears itself on PTY activity (host-side) or when the
       terminal becomes visible (client-side join). The source is push-only;
       it adds no polling or independent refresh loop. -->
  <PushSource
    id="terminalAttentionEvt"
    initial="{null}"
    subscribe="{window.bramSubscribeTerminalAttention()}" />
  <VStack
    when="{terminalAttentionEvt.value &amp;&amp; terminalAttentionEvt.value.active}"
    padding="$space-2"
    gap="$space-1"
    backgroundColor="$color-warn-50"
    borderTop="1px solid $color-warn-200">
    <HStack gap="$space-2" verticalAlignment="center">
      <Text
        fontSize="$fontSize-sm"
        width="*"
        color="$color-warn-700"
        value="{window.__bramTerminalAttentionText(terminalAttentionEvt.value)}" />
      <!-- terminal-attention-login-screen (#448): a logged-out agent can
           be traded for the other one, when the host found its CLI. -->
      <Button
        when="{!!(terminalAttentionEvt.value &amp;&amp; terminalAttentionEvt.value.switchTo)}"
        label="{window.__bramTerminalAttentionSwitchLabel(terminalAttentionEvt.value)}"
        variant="outlined"
        size="xs"
        onClick="window.__bramTerminalAttentionSwitch(terminalAttentionEvt.value, toast)" />
      <Button
        label="Open terminal"
        variant="outlined"
        size="xs"
        onClick="window.__bramOpenTerminalForAttention()" />
    </HStack>
  </VStack>
</Component>
